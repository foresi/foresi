{
    "name": "foresi/instance",
    "description": "The instance: its clock, schedule, operator tasks and health.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/module-api": "^3.0",
        "foresi/shared": "self.version",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/cache-contracts": "^3.8",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/lock": "^7.4.24",
        "symfony/messenger": "^7.4.24",
        "symfony/rate-limiter": "7.4.*",
        "symfony/routing": "^7.4",
        "symfony/scheduler": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Instance\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "instance",
            "kind": "core",
            "namespace": "Foresi\\Instance\\",
            "bundle": "Foresi\\Instance\\InstanceBundle",
            "optional": []
        }
    }
}
