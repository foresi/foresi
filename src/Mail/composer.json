{
    "name": "foresi/mail",
    "description": "Inbound mail: the operator mailbox and the webhook, the verdict on who sent a message, and the raw files it is kept in.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "directorytree/imapengine": "~1.25.7",
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/audit": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/module-api": "^3.0",
        "foresi/shared": "self.version",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/cache": "7.4.*",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/rate-limiter": "7.4.*",
        "symfony/routing": "^7.4",
        "zbateson/mail-mime-parser": "^4.0.8",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Mail\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "mail",
            "kind": "module",
            "namespace": "Foresi\\Mail\\",
            "bundle": "Foresi\\Mail\\MailBundle",
            "optional": [],
            "scopes": [
                "mail_addresses"
            ]
        }
    }
}
