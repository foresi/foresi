{#
    The signed copy of a document: one PDF chosen with the file field, as the plain file upload of
    GOV.UK, refused at the field when it is not a PDF or too large. A small dialog over the document;
    the same URL is a page. Variables: document, errors.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set heading = 'documents.action.signed_copy'|trans %}
{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'documents.list.title'|trans, href: path('app_documents')}, {label: document.title, href: path('app_document', {id: document.id})}, {label: heading}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'sm' %}
{% set dialog_description = 'documents.signed_copy.description'|trans %}

{% block title %}{{ heading }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="signed-copy-form" action="{{ path('app_document_signed_copy', {id: document.id}) }}" enctype="multipart/form-data" class="grid gap-2" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Documents\\Infrastructure\\Controller\\DocumentController::TOKEN')) }}">
        <label for="file" class="text-small text-ink">{{ 'documents.signed_copy.file'|trans }}</label>
        <input type="file" id="file" name="file" accept="application/pdf" required class="text-small text-text"{% if errors.file is defined %} aria-invalid="true" aria-describedby="file-error"{% endif %} data-dialog-untracked>
        <p class="m-0 text-caption text-muted">{{ 'documents.signed_copy.help'|trans }}</p>
        {% if errors.file is defined %}<p id="file-error" class="m-0 text-small text-badge-red-text">{{ errors.file }}</p>{% endif %}
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'documents.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="signed-copy-form" variant="primary" icon="upload">{{ 'documents.signed_copy.submit'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="heading" icon="upload" class="max-w-2xl">
        <p class="m-0 mb-4 text-small text-muted">{{ 'documents.signed_copy.description'|trans }}</p>
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_document', {id: document.id})">{{ 'documents.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="signed-copy-form" variant="primary" icon="upload">{{ 'documents.signed_copy.submit'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
