{#
    The template editor, a page to work in. The HTML source on the left with the variables beside it,
    as PandaDoc, HubSpot and Pipedrive Smart Docs list the merge fields next to the text: each with its
    name, label and example, and a click puts its placeholder at the cursor (template-editor). Under
    them the paper and its margins, and the preview: the source filled with the examples in a
    sandboxed frame, renewed while typing; a refused source shows why. The note says which version is
    edited: in place until a document is generated from it, then saving makes the next one, as Odoo
    edits a copy of a used template. Variables: template, type, version, values, errors, variables,
    preview, papers.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'documents.settings.title'|trans, href: path('app_document_settings')}, {label: template.name}] %}
{% set token = csrf_token(constant('Foresi\\Documents\\Infrastructure\\Controller\\DocumentController::TOKEN')) %}
{% set form_invalid = errors is not empty %}

{% block title %}{{ template.name }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="template-actions">
        <twig:block name="primary">
            <twig:Ui:Button type="submit" form="template-form" variant="primary" icon="check" data-template-save>{{ 'documents.save'|trans }}</twig:Ui:Button>
        </twig:block>
        <twig:block name="last">
            {% if not template.archived %}
                <form method="post" action="{{ path('app_document_template_archive', {id: template.id}) }}" role="none" data-controller="confirm-submit" data-action="submit->confirm-submit#ask"
                    data-confirm-title="{{ 'documents.settings.confirm.archive_template'|trans({name: template.name}) }}" data-confirm-text="{{ 'documents.settings.confirm.archive_template_text'|trans }}"
                    data-confirm-accept="{{ 'documents.settings.action.archive'|trans }}" data-confirm-cancel="{{ 'documents.keep'|trans }}" data-confirm-tone="danger" data-template-archive>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:MenuItem type="submit" tone="danger" icon="archive">{{ 'documents.settings.action.archive'|trans }}</twig:Ui:MenuItem>
                </form>
            {% endif %}
        </twig:block>
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    {{ include('@Documents/_flashes.html.twig') }}
    <div class="grid gap-4" data-controller="template-editor" data-template-editor-url-value="{{ path('app_document_template_preview', {id: template.id}) }}">
        <twig:Ui:Alert tone="info" data-template-version="{{ version.number }}" data-template-frozen="{{ version.frozen ? 1 : 0 }}">
            {{ (version.frozen ? 'documents.settings.version_frozen' : 'documents.settings.version_editing')|trans({number: version.number, next: version.number + 1}) }}
        </twig:Ui:Alert>
        {% if type %}<p class="m-0 text-small text-muted">{{ 'documents.settings.template_of'|trans({type: type.name}) }}</p>{% endif %}

        <form method="post" id="template-form" action="{{ path('app_document_template', {id: template.id}) }}" class="grid gap-4" novalidate data-template-editor-target="form">
            <input type="hidden" name="_token" value="{{ token }}">
            <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                <twig:Ui:Textarea name="body" id="body" :label="'documents.settings.field.body'|trans" :help="'documents.settings.field.body_help'|trans" :value="values.body" :error="errors.body|default(null)" :rows="24" class="font-mono text-small" spellcheck="false" data-template-editor-target="body" data-action="input->template-editor#changed" />
                <section class="grid content-start gap-2" aria-labelledby="template-variables-title" data-template-variables>
                    <h2 id="template-variables-title" class="m-0 text-small font-semibold text-ink">{{ 'documents.settings.variables'|trans }}</h2>
                    {% if variables is empty %}
                        <p class="m-0 text-small text-muted" data-template-variables-empty>{{ 'documents.settings.variables_none'|trans }}</p>
                    {% else %}
                        <p class="m-0 text-caption text-muted">{{ 'documents.settings.variables_help'|trans }}</p>
                        {% for group in variables %}
                            <ul class="m-0 grid list-none gap-0 rounded-panel border border-container bg-white p-0" aria-label="{{ group.prefix }}">
                                {% for item in group.items %}
                                    <li class="border-b border-divider last:border-b-0">
                                        <button type="button" class="grid w-full gap-0.5 px-3 py-2 text-left hover:bg-frame-hover {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}" data-action="template-editor#insert" data-template-editor-placeholder-param="{{ item.placeholder }}" data-template-variable="{{ item.placeholder }}">
                                            <code class="text-caption text-ink">{{ item.placeholder }}</code>
                                            <span class="text-small text-ink">{{ item.label }}</span>
                                            <span class="text-caption text-muted">{{ 'documents.settings.example'|trans({example: item.example}) }}</span>
                                        </button>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endfor %}
                    {% endif %}
                </section>
            </div>
            <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-6">
                <twig:Ui:Select name="paper" id="paper" :label="'documents.settings.field.paper'|trans" :options="papers" :value="values.paper" :error="errors.paper|default(null)" data-action="change->template-editor#changed" />
                {% for field in ['marginTop', 'marginRight', 'marginBottom', 'marginLeft'] %}
                    <twig:Ui:TextInput :name="field" :id="field" :label="('documents.settings.field.' ~ field)|trans" :value="values[field]" :error="errors[field]|default(null)" inputmode="numeric" maxlength="2" autocomplete="off" data-action="input->template-editor#changed" />
                {% endfor %}
                <div class="flex items-end pb-2.5">
                    <twig:Ui:Checkbox name="landscape" id="landscape" value="1" :checked="values.landscape == '1'" :label="'documents.settings.field.landscape'|trans" />
                </div>
            </div>
        </form>

        <section class="grid gap-2" aria-labelledby="template-preview-title" data-template-preview>
            <h2 id="template-preview-title" class="m-0 text-body font-semibold text-ink">{{ 'documents.settings.preview'|trans }}</h2>
            <p class="m-0 text-caption text-muted">{{ 'documents.settings.preview_help'|trans }}</p>
            <p role="alert" class="m-0 text-small font-medium text-badge-red-text"{% if not preview.error %} hidden{% endif %} data-template-editor-target="error" data-template-preview-refused>{{ preview.error }}</p>
            <iframe sandbox="" srcdoc="{{ preview.html ?? '' }}" title="{{ 'documents.settings.preview'|trans }}" class="block h-dvh max-h-[75vh] w-full rounded-panel border border-container bg-white" data-template-editor-target="frame" data-template-preview-frame></iframe>
        </section>
    </div>
{% endblock %}
