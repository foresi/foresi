{#
    Settings → Documents: the document types and the templates. A type is a small record: a new one and
    a change open in a dialog over the page, and archiving asks first, as it cannot be undone here. A
    template opens in its editor page. Each table is a list with its own views, search, filters, columns
    and widths (docs/design/list-pages.md, rules 8 and 9): the types keep the address's bare keys, the
    templates theirs under the "templates" list slot, so one table's links keep the other's state.
    Variables: types, templates, each the table ListTable gives; hasTypes.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'documents.settings.title'|trans}] %}
{% set token = csrf_token(constant('Foresi\\Documents\\Infrastructure\\Controller\\DocumentController::TOKEN')) %}

{% block title %}{{ 'documents.settings.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="document-settings-actions">
        <twig:block name="primary">
            {% if hasTypes %}
                <twig:Ui:Button variant="primary" icon="plus" :href="path('app_document_template_new')" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-template-new>{{ 'documents.settings.new_template'|trans }}</twig:Ui:Button>
            {% endif %}
        </twig:block>
        <twig:block name="buttons">
            <twig:Ui:Button icon="plus" :href="path('app_document_type_new')" data-dialog aria-haspopup="dialog" data-type-new>{{ 'documents.settings.new_type'|trans }}</twig:Ui:Button>
        </twig:block>
        <twig:block name="phone">
            <twig:Ui:MenuItem icon="plus" :href="path('app_document_type_new')" data-dialog aria-haspopup="dialog">{{ 'documents.settings.new_type'|trans }}</twig:Ui:MenuItem>
        </twig:block>
    </twig:Ui:MoreActions>
{% endblock %}

{% macro table(t, caption, token, empty) %}
    {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: t.tabs, toolbarMore: t.moreViews, toolbarLabel: 'documents.settings.views'|trans({list: caption}), toolsFilter: t.id ~ '-filters', toolsSearch: t.search, toolsColumns: {id: t.id ~ '-columns', action: path('app_document_settings')}, picker: t.picker, pinnable: t.pinnable, manageViews: t.manageViews, viewBar: t.viewBar}) }}
    <twig:Ui:FilterBar :id="t.id ~ '-filters'" :search="t.search" :action="path('app_document_settings')" :keep="t.keep"
        :conditions="t.chips" :quick="t.quick" :viewBar="t.viewBar" :builder="t.builder" :empty="t.rows is empty">
    </twig:Ui:FilterBar>
    <twig:Ui:DataTable :caption="caption" :columns="t.columns" :rows="t.rows" :resizable="true" :widthsParam="t.widthsParam" :actionToken="token">
        <twig:block name="empty">
            {% if t.filtered or t.view != '' %}
                <twig:Ui:EmptyState icon="search" :title="'documents.settings.empty.filtered_title'|trans">
                    <twig:Ui:Button :href="t.resetHref">{{ 'documents.settings.empty.reset'|trans }}</twig:Ui:Button>
                </twig:Ui:EmptyState>
            {% elseif empty == 'types' %}
                <twig:Ui:EmptyState icon="file-text" :title="'documents.settings.types_empty'|trans">
                    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_document_type_new')" data-dialog aria-haspopup="dialog">{{ 'documents.settings.new_type'|trans }}</twig:Ui:Button>
                </twig:Ui:EmptyState>
            {% else %}
                <twig:Ui:EmptyState icon="file-text" :title="'documents.settings.templates_empty'|trans" :text="'documents.settings.templates_empty_text'|trans" />
            {% endif %}
        </twig:block>
    </twig:Ui:DataTable>
    {{ include('@Ui/components/_view_dialogs.html.twig', {viewBar: t.viewBar, manageViews: t.manageViews}) }}
{% endmacro %}

{% block content %}
    {{ include('@Documents/_flashes.html.twig') }}
    <div class="grid gap-6">
        <section class="grid gap-2" aria-labelledby="document-types-title" data-document-types>
            <h2 id="document-types-title" class="m-0 text-body font-semibold text-ink">{{ 'documents.settings.types'|trans }}</h2>
            {{ _self.table(types, 'documents.settings.types'|trans, token, 'types') }}
        </section>
        <section class="grid gap-2" aria-labelledby="document-templates-title" data-document-templates>
            <h2 id="document-templates-title" class="m-0 text-body font-semibold text-ink">{{ 'documents.settings.templates'|trans }}</h2>
            {{ _self.table(templates, 'documents.settings.templates'|trans, token, 'templates') }}
        </section>
    </div>
{% endblock %}
