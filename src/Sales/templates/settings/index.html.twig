{#
    Settings → Sales: the stages of a deal in their order and the reasons a deal is lost, as Pipedrive lets a
    team rename, add and order its stages and keep predefined lost reasons. A new one and a rename open in a
    dialog over the page, Up and Down move a stage, and archiving asks first; a stage that holds open deals
    is not archived and the message says why. Each table is a list with its own views, search, filters,
    columns, density and widths (docs/design/list-pages.md, rule 8): the stages keep the address's bare
    keys, the reasons theirs under the "reasons" list slot, so one table's links keep the other's state.
    Variables: stages, reasons, each the table SalesSettingsController::table() gives.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'sales.settings.title'|trans}] %}
{% set token = csrf_token(constant('Foresi\\Sales\\Infrastructure\\Controller\\DealController::TOKEN')) %}

{% block title %}{{ 'sales.settings.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_sales_stage_new')" data-dialog aria-haspopup="dialog" data-sales-stage-new>{{ 'sales.settings.new_stage'|trans }}</twig:Ui:Button>
    <twig:Ui:Button icon="plus" :href="path('app_sales_lost_reason_new')" data-dialog aria-haspopup="dialog" data-sales-reason-new>{{ 'sales.settings.new_reason'|trans }}</twig:Ui:Button>
{% endblock %}

{% macro table(t, caption, token) %}
    {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: t.tabs, toolbarMore: t.moreViews, toolbarLabel: 'sales.settings.views'|trans({list: caption}), toolsFilter: t.id ~ '-filters', toolsSearch: t.search, toolsColumns: {id: t.id ~ '-columns', action: path('app_sales_settings')}, picker: t.picker, pinnable: t.pinnable, manageViews: t.manageViews, viewBar: t.viewBar}) }}
    <twig:Ui:FilterBar :id="t.id ~ '-filters'" :search="t.search" :action="path('app_sales_settings')" :keep="t.keep"
        :conditions="t.chips" :quick="t.quick" :viewBar="t.viewBar" :builder="t.builder" :empty="t.rows is empty">
    </twig:Ui:FilterBar>
    <twig:Ui:DataTable :caption="caption" :columns="t.columns" :rows="t.rows" :density="t.density" :resizable="true" :widthsParam="t.widthsParam" :actionToken="token">
        <twig:block name="empty">
            {% if t.filtered or t.view != '' %}
                <twig:Ui:EmptyState icon="search" :title="'sales.settings.empty.filtered_title'|trans">
                    <twig:Ui:Button :href="t.resetHref">{{ 'sales.settings.empty.reset'|trans }}</twig:Ui:Button>
                </twig:Ui:EmptyState>
            {% endif %}
        </twig:block>
    </twig:Ui:DataTable>
    {{ include('@Ui/components/_view_dialogs.html.twig', {viewBar: t.viewBar, manageViews: t.manageViews}) }}
{% endmacro %}

{% block content %}
    {{ include('@Sales/_flashes.html.twig') }}
    <div class="grid gap-6">
        <section class="grid gap-2" aria-labelledby="sales-stages-title" data-sales-stages>
            <h2 id="sales-stages-title" class="m-0 text-body font-semibold text-ink">{{ 'sales.settings.stages'|trans }}</h2>
            <p class="m-0 text-small text-muted">{{ 'sales.settings.stages_text'|trans }}</p>
            {{ _self.table(stages, 'sales.settings.stages'|trans, token) }}
        </section>
        <section class="grid gap-2" aria-labelledby="sales-reasons-title" data-sales-reasons>
            <h2 id="sales-reasons-title" class="m-0 text-body font-semibold text-ink">{{ 'sales.settings.reasons'|trans }}</h2>
            {{ _self.table(reasons, 'sales.settings.reasons'|trans, token) }}
        </section>
    </div>
{% endblock %}
