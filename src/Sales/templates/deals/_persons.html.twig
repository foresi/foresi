{#
    The contact persons of the deal's client in the deal's dialog: the client's persons to tick, and under
    them "Add a person", the same two ways as the contact's own dialog: a person from the address book or a
    new one, linked to the client and added to the deal when the deal is saved. Rendered inside the form,
    and on its own (GET /sales/deals/client-persons) when the client changes (deal-client). A person as the
    client has no contact persons, so nothing shows for one, nor without a client.
    Variables: personsShown, persons (id, name), candidates (by id), person (mode, personId, name, email,
    position), personModes, personOpen, values (contactPersonIds), errors.
#}
{% if personsShown %}
    <div class="grid gap-3" data-deal-persons>
        <fieldset class="m-0 grid gap-2 border-0 p-0">
            <legend class="mb-1 p-0 text-small text-ink">{{ 'sales.deal.field.contact_persons'|trans }}</legend>
            {% for contact in persons %}
                <twig:Ui:Checkbox name="contactPersonIds[]" :id="'person-' ~ contact.id" :label="contact.name" :value="contact.id" :checked="contact.id in values.contactPersonIds" />
            {% else %}
                <p class="m-0 text-small text-muted" data-deal-no-persons>{{ 'sales.deal.person.none'|trans }}</p>
            {% endfor %}
            {% if errors.contactPersonIds is defined %}<p class="m-0 text-small text-badge-red-text">{{ errors.contactPersonIds }}</p>{% endif %}
        </fieldset>
        <twig:Ui:Disclosure :label="'sales.deal.person.add'|trans" :open="personOpen" data-deal-add-person>
            <twig:Ui:RadioCards name="personMode" id="personMode" :legend="'sales.deal.person.mode.label'|trans" :options="personModes" :value="person.mode" data-action="change->deal-client#mode" />
            <div class="grid gap-3" data-deal-client-target="existing" data-deal-person-existing>
                {% if candidates is empty %}
                    <p class="m-0 text-small text-muted" data-no-candidates>{{ 'sales.deal.person.no_candidates'|trans }}</p>
                {% else %}
                    <twig:Ui:Select name="personId" id="personId" :label="'sales.deal.person.person'|trans" :options="{'': 'sales.deal.person.person_placeholder'|trans}|merge(candidates)" :value="person.personId" :error="errors.personId|default(null)" />
                {% endif %}
            </div>
            <div class="grid gap-3 sm:grid-cols-2" data-deal-client-target="new" data-deal-person-new>
                <twig:Ui:TextInput name="personName" id="personName" :label="'sales.deal.person.name'|trans" :value="person.name" :error="errors.personName|default(null)" maxlength="255" autocomplete="off" />
                <twig:Ui:TextInput name="personEmail" id="personEmail" type="email" :label="'sales.deal.person.email'|trans" :value="person.email" :error="errors.personEmail|default(null)" maxlength="254" autocomplete="off" />
            </div>
            <twig:Ui:TextInput name="personPosition" id="personPosition" :label="'sales.deal.person.position'|trans" :help="'sales.deal.person.position_help'|trans" :value="person.position" :error="errors.personPosition|default(null)" maxlength="100" autocomplete="off" />
        </twig:Ui:Disclosure>
    </div>
{% endif %}
