{#
    The deals on saved views, as every list has them: All, Open, Won, Lost and Trash, the person's own views,
    "+ Filter" (status, owner, client) and the Columns sheet. The deals are grouped by stage, one table per
    stage in the order of the stages with its count and value, as Odoo's list grouped by stage shows only the
    groups it holds. A row opens the deal's page. A new deal starts in a dialog over the list; without
    JavaScript the same link is a page.
    Variables: sections (id, title, rows, count, total), columns, density, tabs, moreViews, chips, builder,
    picker, view, working, sortKept, workingQuery, filtered, resetHref, emptyTitle.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'sales.deals.title'|trans}] %}

{% block title %}{{ 'sales.deals.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_sales_deal_new')" id="deal-new" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'sales.deal.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {{ include('@Sales/_flashes.html.twig') }}
    <div class="grid grid-cols-1 gap-4">
        <div class="flex flex-wrap items-end gap-x-4 gap-y-2 sm:flex-nowrap">
            <twig:Ui:Tabs :items="tabs" :more="moreViews" :moreLabel="'saved_view.more_views'|trans" :label="'sales.deals.views'|trans" class="min-w-0 sm:flex-1">
                <twig:block name="actions">{{ include('@Ui/components/_view_menu.html.twig') }}</twig:block>
            </twig:Ui:Tabs>
            {{ include('@Ui/components/_view_actions.html.twig') }}
        </div>
        {# The status, the owner and the client are conditions of "+ Filter" (saved views D11). #}
        <twig:Ui:FilterBar id="deal-filters" :action="path('app_sales_deals')" :keep="{view: view != '' ? view : null, sort: sortKept, f: working != '' ? working : null}|merge(workingQuery)"
            :conditions="chips" :builder="builder" :empty="sections is empty">
            <twig:block name="end">
                <twig:Ui:ColumnPicker id="deal-columns" :action="path('app_sales_deals')" :keep="picker.keep" :columns="picker.columns" :density="picker.density" :resetHref="picker.resetHref" :modified="picker.modified" />
            </twig:block>
        </twig:Ui:FilterBar>

        {% for section in sections %}
            <section class="grid gap-2" aria-labelledby="deal-stage-{{ section.id }}" data-deal-stage="{{ section.id }}">
                <h2 id="deal-stage-{{ section.id }}" class="m-0 flex flex-wrap items-baseline gap-x-2 text-body font-semibold text-ink">
                    {{ section.title }}
                    <span class="num font-normal text-muted">{{ section.count }}{% if section.total %} · {{ section.total }}{% endif %}</span>
                </h2>
                <twig:Ui:DataTable :caption="section.title" :columns="columns" :rows="section.rows" :density="density" />
            </section>
        {% else %}
            <twig:Ui:DataTable :caption="'sales.deals.title'|trans" :columns="columns" :rows="[]" :density="density">
                <twig:block name="empty">
                    {% if filtered %}
                        <twig:Ui:EmptyState icon="search" :title="'sales.deals.empty.filtered_title'|trans">
                            <twig:Ui:Button :href="resetHref">{{ 'sales.deals.empty.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% elseif view == '' %}
                        <twig:Ui:EmptyState icon="trending-up" :title="'sales.deals.empty.title'|trans" :text="'sales.deals.empty.text'|trans">
                            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_sales_deal_new')" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'sales.deal.new'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% else %}
                        <twig:Ui:EmptyState :icon="view == 'trashed' ? 'trash-2' : 'trending-up'" :title="emptyTitle" />
                    {% endif %}
                </twig:block>
            </twig:Ui:DataTable>
        {% endfor %}
    </div>
    {{ include('@Ui/components/_view_dialogs.html.twig') }}
{% endblock %}
