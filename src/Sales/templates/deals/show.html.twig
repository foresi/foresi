{#
    One deal, a page of its own, laid out as a record page (research note "Foresi research - Record detail
    page layout"): a main column for the work on the deal and a narrow side column for its properties, as
    Polaris' Layout pairs a two-thirds section with a one-third secondary one and HubSpot's, Pipedrive's and
    Salesforce's record pages keep the properties in a sidebar and the activity in the main area. On a phone
    the side column follows the main one, as on the task page.

    The header holds the title and one badge: the stage while the deal is open (after its Open status), the
    status alone once it is won or lost, where a stage would contradict it. Its actions follow the Calm UI
    rule of one primary action and the rest in the header's "⋯": Won while it is open, Reopen once it is
    closed, Restore in the trash (Pipedrive's and Odoo's deal header); beside it the one action another
    module marks prominent (SalesSlots::DEAL_ACTIONS), Log activity, a button from sm up and a menu row on a
    phone; in the menu Lost, Edit, the other modules' actions and New follow-up deal; Trash last. Under the
    header the stages, the current one pressed, to move an open deal (Pipedrive's pipeline on a deal).

    The main column: the lines with their value in the table's footer under the Amount column (Polaris
    DataTable's totals in its footer): one-off and monthly apart, per currency, a kind with no line left
    out, "≈" when a monthly value is approximate. Then what other modules add (SalesSlots::DEAL_SECTIONS)
    as link tabs, the first, Activities, by default and only the active one loaded, in its lazy frame
    (NN/g, Tabs, used right: the most used tab first and selected). The side column: the details, the
    notes and the linked deals.
    Variables: deal, badge, stageName, stages (id, name, current), details, lines, totals, links, linkable,
    slotActions, tabs, section, context.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'sales.deals.title'|trans, href: path('app_sales_deals')}, {label: deal.title}] %}
{% set token = csrf_token(constant('Foresi\\Sales\\Infrastructure\\Controller\\DealController::TOKEN')) %}
{% set open = deal.open and not deal.trashed %}
{# A won or lost deal shows its status alone: the stage it was closed in is no longer where it stands. #}
{% set badges = open ? [{label: stageName, tone: 'gray', icon: null}] : [] %}
{# The one module action beside the primary one; the others go to the menu. #}
{% set prominent = slotActions|filter(action => action.prominent)|first %}
{% set menuActions = slotActions|filter(action => action is not same as(prominent)) %}

{% block title %}{{ deal.title }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="deal-actions">
        <twig:block name="primary">
            {% if deal.trashed %}
                <form method="post" action="{{ path('app_sales_deal_restore', {id: deal.id}) }}" class="contents" data-deal-restore>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:Button type="submit" variant="primary" icon="archive-restore">{{ 'sales.deal.restore'|trans }}</twig:Ui:Button>
                </form>
            {% elseif open %}
                <form method="post" action="{{ path('app_sales_deal_win', {id: deal.id}) }}" class="contents" data-deal-win>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:Button type="submit" variant="primary" icon="circle-check">{{ 'sales.deal.win'|trans }}</twig:Ui:Button>
                </form>
            {% else %}
                <form method="post" action="{{ path('app_sales_deal_reopen', {id: deal.id}) }}" class="contents" data-deal-reopen>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:Button type="submit" variant="primary" icon="refresh-cw">{{ 'sales.deal.reopen'|trans }}</twig:Ui:Button>
                </form>
            {% endif %}
        </twig:block>
        <twig:block name="buttons">
            {% if prominent %}
                {% if prominent.dialog %}
                    <twig:Ui:Button :icon="prominent.icon" :href="prominent.href" data-dialog aria-haspopup="dialog" data-deal-action="{{ prominent.key }}">{{ prominent.label }}</twig:Ui:Button>
                {% else %}
                    <twig:Ui:Button :icon="prominent.icon" :href="prominent.href" data-deal-action="{{ prominent.key }}">{{ prominent.label }}</twig:Ui:Button>
                {% endif %}
            {% endif %}
        </twig:block>
        <twig:block name="phone">
            {% if prominent %}
                {% if prominent.dialog %}
                    <twig:Ui:MenuItem :icon="prominent.icon" :href="prominent.href" data-dialog aria-haspopup="dialog">{{ prominent.label }}</twig:Ui:MenuItem>
                {% else %}
                    <twig:Ui:MenuItem :icon="prominent.icon" :href="prominent.href">{{ prominent.label }}</twig:Ui:MenuItem>
                {% endif %}
            {% endif %}
        </twig:block>
        {% if open %}
            <twig:Ui:MenuItem icon="x" :href="path('app_sales_deal_lose', {id: deal.id})" data-dialog aria-haspopup="dialog" data-deal-lose>{{ 'sales.deal.lose'|trans }}</twig:Ui:MenuItem>
        {% endif %}
        {% if not deal.trashed %}
            <twig:Ui:MenuItem icon="pencil" :href="path('app_sales_deal_edit', {id: deal.id})" data-dialog aria-haspopup="dialog" data-deal-edit>{{ 'sales.deal.edit'|trans }}</twig:Ui:MenuItem>
        {% endif %}
        {% for action in menuActions %}
            {% if action.dialog %}
                <twig:Ui:MenuItem :icon="action.icon" :href="action.href" data-dialog aria-haspopup="dialog" data-deal-action="{{ action.key }}">{{ action.label }}</twig:Ui:MenuItem>
            {% else %}
                <twig:Ui:MenuItem :icon="action.icon" :href="action.href" data-deal-action="{{ action.key }}">{{ action.label }}</twig:Ui:MenuItem>
            {% endif %}
        {% endfor %}
        {% if not deal.trashed %}
            <twig:Ui:MenuItem icon="plus" :href="path('app_sales_deal_follow_up', {id: deal.id})" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-deal-follow-up>{{ 'sales.deal.follow_up'|trans }}</twig:Ui:MenuItem>
        {% endif %}
        <twig:block name="last">
            {% if not deal.trashed %}
                <form method="post" action="{{ path('app_sales_deal_trash', {id: deal.id}) }}" role="none" data-deal-trash>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:MenuItem type="submit" icon="trash-2" tone="danger">{{ 'sales.deal.trash'|trans }}</twig:Ui:MenuItem>
                </form>
            {% endif %}
        </twig:block>
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    <div class="grid gap-4">
        {{ include('@Sales/_flashes.html.twig') }}
        {% if open and stages is not empty %}
            {# The stages in their order, the current one pressed, as Pipedrive's deal shows its pipeline under the title. #}
            <div role="group" aria-label="{{ 'sales.deal.field.stage'|trans }}" class="flex flex-wrap gap-1" data-deal-stage>
                {% for stage in stages %}
                    <form method="post" action="{{ path('app_sales_deal_stage', {id: deal.id}) }}" class="contents">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="stageId" value="{{ stage.id }}">
                        <twig:Ui:Button type="submit" size="sm" :pressed="stage.current">{{ stage.name }}</twig:Ui:Button>
                    </form>
                {% endfor %}
            </div>
        {% endif %}
        {% if deal.trashed %}
            <twig:Ui:Alert tone="info" data-deal-in-trash>{{ 'sales.deal.in_trash'|trans }}</twig:Ui:Alert>
        {% endif %}

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]" data-deal-layout>
            <div class="grid min-w-0 content-start gap-6" data-deal-main>
                <section class="grid gap-2" aria-labelledby="deal-lines-title" data-deal-lines>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <h2 id="deal-lines-title" class="m-0 text-heading font-semibold text-ink">{{ 'sales.line.title'|trans }}</h2>
                        {% if not deal.trashed %}
                            <twig:Ui:Button icon="plus" size="sm" :href="path('app_sales_deal_line_new', {id: deal.id})" data-dialog aria-haspopup="dialog" data-deal-line-new>{{ 'sales.line.new'|trans }}</twig:Ui:Button>
                        {% endif %}
                    </div>
                    <twig:Ui:DataTable :caption="'sales.line.title'|trans" :actionToken="token" :rows="lines" :columns="[
                        {key: 'name', label: 'sales.line.column.name'|trans, truncate: true},
                        {key: 'quantity', label: 'sales.line.column.quantity'|trans, phone: false},
                        {key: 'billing', label: 'sales.line.column.billing'|trans, phone: false},
                        {key: 'total', label: 'sales.line.column.total'|trans, align: 'right'},
                    ]" :totals="totals ?: null">
                        <twig:block name="empty">
                            <twig:Ui:EmptyState icon="tag" :title="'sales.line.empty_title'|trans" :text="'sales.line.empty_text'|trans" />
                        </twig:block>
                    </twig:Ui:DataTable>
                </section>

                {% if tabs is not empty %}
                    <div class="grid gap-4" data-deal-tabs>
                        <twig:Ui:Tabs :items="tabs" :label="'sales.deal.sections'|trans" data-in-place />
                        {% if section %}
                            <section class="grid gap-2" data-deal-section="{{ section.key }}">
                                {% if section.template %}
                                    {{ include(section.template, section.data) }}
                                {% else %}
                                    <turbo-frame id="{{ constant('Foresi\\Sales\\Contract\\SalesSlots::SECTION_FRAME') ~ section.key }}" src="{{ section.href }}" loading="lazy" target="_top"></turbo-frame>
                                {% endif %}
                            </section>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            <aside class="grid content-start gap-4 border-t border-divider pt-6 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0" aria-labelledby="deal-details-title" data-deal-details>
                <h2 id="deal-details-title" class="m-0 text-heading font-semibold text-ink">{{ 'sales.deal.details'|trans }}</h2>
                <dl class="m-0 grid gap-3">
                    {% for item in details %}
                        <div class="grid gap-0.5">
                            <dt class="text-small text-muted">{{ item.label }}</dt>
                            <dd class="m-0 min-w-0 text-small font-medium text-ink"><twig:Ui:Value :value="item.value" :empty="item.empty ?? null" /></dd>
                        </div>
                    {% endfor %}
                </dl>

                {% if deal.description != '' %}
                    <section class="grid gap-1.5 border-t border-divider pt-3" aria-labelledby="deal-description-title">
                        <h3 id="deal-description-title" class="m-0 text-small font-medium text-ink">{{ 'sales.deal.field.description'|trans }}</h3>
                        <div class="markdown text-small text-ink" data-deal-description>{{ deal.description|markdown }}</div>
                    </section>
                {% endif %}

                <section class="grid gap-1.5 border-t border-divider pt-3" aria-labelledby="deal-links-title" data-deal-links>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h3 id="deal-links-title" class="m-0 text-small font-medium text-ink">{{ 'sales.link.title'|trans }}</h3>
                        {% if linkable %}
                            <twig:Ui:Button icon="link-2" size="sm" variant="ghost" :href="path('app_sales_deal_link_new', {id: deal.id})" data-dialog aria-haspopup="dialog" data-deal-link-new>{{ 'sales.link.new'|trans }}</twig:Ui:Button>
                        {% endif %}
                    </div>
                    {% if links is empty %}
                        <p class="m-0 text-small text-muted">{{ 'sales.link.none'|trans }}</p>
                    {% else %}
                        <ul class="m-0 grid list-none gap-2 p-0">
                            {% for link in links %}
                                <li class="grid gap-1 text-small" data-deal-link="{{ link.id }}">
                                    <span class="text-caption text-muted">{{ link.relation }}</span>
                                    <span class="flex min-w-0 flex-wrap items-center gap-1.5">
                                        <a href="{{ link.href }}" class="min-w-0 font-medium text-ink {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">{{ link.title }}</a>
                                        <twig:Ui:Badge :tone="link.status.tone">{{ link.status.label }}</twig:Ui:Badge>
                                        {% if link.remove %}
                                            <form method="post" action="{{ link.remove }}" class="contents" data-deal-link-remove>
                                                <input type="hidden" name="_token" value="{{ token }}">
                                                <twig:Ui:Button type="submit" size="sm" variant="ghost" icon="x">{{ 'sales.link.remove'|trans }}</twig:Ui:Button>
                                            </form>
                                        {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>
            </aside>
        </div>
    </div>
{% endblock %}
