{#
    The day a planned invoice of a won deal is expected to be invoiced on, alone, as the cash-flow forecast
    sets it for an item under No date (Float and Xero's expected date): Save moves it into its period and
    into the balance, Clear takes the day away again. A small dialog; the same URL is a page.
    Variables: deal, label, action, back, values, errors, set.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set heading = 'sales.billing.day.title'|trans %}
{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'sales.deals.title'|trans, href: path('app_sales_deals')}, {label: deal.title, href: path('app_sales_deal', {id: deal.id})}, {label: heading}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'sm' %}
{% set dialog_description = 'sales.billing.day.description'|trans({deal: deal.title, entry: label}) %}

{% block title %}{{ heading }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="billing-day-form" action="{{ action }}" class="grid gap-4" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Sales\\Infrastructure\\Controller\\DealController::TOKEN')) }}">
        <twig:Ui:TextInput type="date" name="expectedOn" id="expectedOn" :label="'sales.billing.field.expected_on'|trans" :value="values.expectedOn" :error="errors.expectedOn|default(null)" required />
    </form>
{% endblock %}

{% block dialog_footer %}
    {% if set %}<twig:Ui:Button type="submit" form="billing-day-form" name="clear" value="1" variant="danger" class="mr-auto" data-billing-day-clear>{{ 'sales.billing.day.clear'|trans }}</twig:Ui:Button>{% endif %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'sales.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="billing-day-form" variant="primary">{{ 'sales.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="heading" icon="calendar" class="max-w-2xl">
        <p class="mt-0 mb-4 text-small text-muted">{{ dialog_description }}</p>
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            {% if set %}<twig:Ui:Button type="submit" form="billing-day-form" name="clear" value="1" variant="danger">{{ 'sales.billing.day.clear'|trans }}</twig:Ui:Button>{% endif %}
            <twig:Ui:Button :href="back">{{ 'sales.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="billing-day-form" variant="primary">{{ 'sales.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
