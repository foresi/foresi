{
    "name": "foresi/exchange-rate",
    "description": "Daily exchange rates.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/instance": "self.version",
        "foresi/shared": "self.version",
        "psr/clock": "^1.0",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\ExchangeRate\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "exchange-rate",
            "kind": "module",
            "namespace": "Foresi\\ExchangeRate\\",
            "bundle": "Foresi\\ExchangeRate\\ExchangeRateBundle",
            "optional": []
        }
    }
