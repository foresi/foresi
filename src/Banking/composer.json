{
    "name": "foresi/banking",
    "description": "Bank accounts, statements and payment matching.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "directorytree/imapengine": "~1.25.7",
        "foresi/audit": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/invoicing": "self.version",
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version",
        "zbateson/mail-mime-parser": "^4.0.8"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Banking\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "banking",
            "kind": "module",
            "namespace": "Foresi\\Banking\\",
            "bundle": "Foresi\\Banking\\BankingBundle",
            "optional": [
                "cash-flow"
            ]
        }
    }
}
