{
    "name": "foresi/purchasing",
    "description": "Received documents from suppliers.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "brick/math": "^1.0",
        "doctrine/collections": "^3.1",
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "doctrine/persistence": "^4.2",
        "foresi/attachment": "self.version",
        "foresi/audit": "self.version",
        "foresi/exchange-rate": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/module-api": "^1.0",
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "smalot/pdfparser": "^2.13",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4.23",
        "symfony/routing": "^7.4",
        "symfony/serializer": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.8",
        "symfony/validator": "7.4.*",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Purchasing\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "purchasing",
            "kind": "module",
            "namespace": "Foresi\\Purchasing\\",
            "bundle": "Foresi\\Purchasing\\PurchasingBundle",
            "optional": [
                "cash-flow",
                "margin",
                "taxes-and-contributions",
                "vat"
            ],
            "scopes": [
                "received_documents"
            ]
        }
    }
}
