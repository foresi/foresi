{#
    The received documents, as Fakturoid lists its costs and Xero its bills, on saved views: All, the
    drafts to complete, the recorded ones and the trash, each a tab with its count, and the person's own
    views; the quick filters, the filter sheet, the search and the Settings sheet as the invoice list has
    them. Uploading and a new document open a dialog from the header.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'purchasing.list.title'|trans}] %}

{% block title %}{{ 'purchasing.list.title'|trans }}{% endblock %}

{% block actions %}
    {% if not noFirm %}
        <twig:Ui:Button icon="plus" :href="path('app_purchasing_new')" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-purchasing-new>{{ 'purchasing.new'|trans }}</twig:Ui:Button>
        <twig:Ui:Button variant="primary" icon="upload" :href="path('app_purchasing_upload')" data-dialog aria-haspopup="dialog" data-purchasing-upload>{{ 'purchasing.upload.open'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% set messages %}
        {% for message in app.flashes('success') %}<twig:Ui:Alert tone="success" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('warning') %}<twig:Ui:Alert tone="warning" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('error') %}<twig:Ui:Alert tone="error" role="alert">{{ message }}</twig:Ui:Alert>{% endfor %}
    {% endset %}
    {% if messages|trim %}<div class="mb-4 grid gap-2">{{ messages }}</div>{% endif %}

    {% if noFirm %}
        <twig:Ui:EmptyState icon="building-2" :title="'purchasing.list.no_firm_title'|trans" :text="'purchasing.list.no_firm_text'|trans">
            <twig:Ui:Button :href="path('app_firm')" variant="primary" icon="plus">{{ 'purchasing.list.add_firm'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            {# The tabs, then the search field and the Filter and Settings icons; the view's unsaved changes are saved from the filter row under them (saved views D10). #}
            {% set search = {name: 'q', value: filter.text, label: 'purchasing.list.search_label'|trans} %}
            {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: tabs, toolbarMore: moreViews, toolbarLabel: 'purchasing.list.views'|trans, toolsFilter: 'purchasing-filters', toolsSearch: search, toolsColumns: {id: 'purchasing-columns', action: path('app_purchasing')}}) }}
            {# The month, the supplier, the kind and the treatment are conditions; the view pins its quick filters (saved views D11). #}
            <twig:Ui:FilterBar id="purchasing-filters" :action="path('app_purchasing')" :keep="{view: view != '' ? view : null, f: working != '' ? working : null}|merge(workingQuery)"
                :search="search"
                :conditions="chips" :quick="quick" :viewBar="viewBar" :builder="builder" :empty="rows is empty" data-purchasing-filter>
            </twig:Ui:FilterBar>

            <twig:Ui:DataTable :caption="'purchasing.list.title'|trans" :columns="columns" :rows="rows" :density="density">
                <twig:block name="empty">
                    {% if filtered %}
                        <twig:Ui:EmptyState icon="search" :title="'purchasing.list.empty.filtered_title'|trans" :text="'purchasing.list.empty.filtered_text'|trans">
                            <twig:Ui:Button :href="resetHref">{{ 'purchasing.list.empty.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% elseif filter.tab == 'trash' %}
                        <twig:Ui:EmptyState icon="trash-2" :title="'purchasing.list.empty.trash_title'|trans" />
                    {% elseif filter.tab == 'recorded' %}
                        <twig:Ui:EmptyState icon="file-text" :title="'purchasing.list.empty.recorded_title'|trans" :text="'purchasing.list.empty.recorded_text'|trans" />
                    {% elseif filter.tab == 'all' %}
                        <twig:Ui:EmptyState icon="file-text" :title="'purchasing.list.empty.all_title'|trans" :text="'purchasing.list.empty.all_text'|trans">
                            <twig:Ui:Button variant="primary" icon="upload" :href="path('app_purchasing_upload')" data-dialog aria-haspopup="dialog">{{ 'purchasing.upload.open'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% else %}
                        <twig:Ui:EmptyState icon="circle-check" :title="'purchasing.list.empty.drafts_title'|trans" :text="'purchasing.list.empty.drafts_text'|trans">
                            <twig:Ui:Button variant="primary" icon="upload" :href="path('app_purchasing_upload')" data-dialog aria-haspopup="dialog">{{ 'purchasing.upload.open'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% endif %}
                </twig:block>
                <twig:block name="footer">
                    <span class="num">{{ 'purchasing.list.summary'|trans({total: page.total}) }}</span>
                    <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                </twig:block>
            </twig:Ui:DataTable>
        </div>
        {{ include('@Ui/components/_view_dialogs.html.twig') }}
    {% endif %}
{% endblock %}
