{
    "name": "foresi/ui",
    "description": "Screen components, layout and navigation.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "foresi/module-api": "^2.0",
        "foresi/shared": "self.version",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4",
        "symfony/service-contracts": "^3.8",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.8",
        "symfony/ux-icons": "^3.6",
        "symfony/ux-live-component": "^3.6",
        "symfony/ux-turbo": "^3.6",
        "symfony/ux-twig-component": "^3.6",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tempest/highlight": "^2.30",
        "twig/twig": "^3.30"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Ui\\": ""
        }
    },
    "extra": {
        "foresi": {
            "module": "ui",
            "kind": "ui",
            "namespace": "Foresi\\Ui\\",
            "bundle": "Foresi\\Ui\\UiBundle",
            "optional": [],
            "config-requires": [
                "symfony/stimulus-bundle",
                "symfony/ux-icons",
                "symfony/ux-live-component",
                "symfony/ux-turbo",
                "symfonycasts/tailwind-bundle"
            ]
        }
    }
}
