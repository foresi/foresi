{# Choosing a row closes the menu and puts the focus back on the trigger, which the page keeps when it comes back morphed. #}
{% set edit = this %}
{% set shown = edit.shown %}
{% set buttonId = id ~ '-button' %}
{% set menuId = id ~ '-menu' %}
{#- The value as it reads: a badge, a text or, for none, the empty badge with the empty label (or the card's icon, which a screen reader hears as the empty label). -#}
{% macro value(shown, tone, emptyLabel, emptyIcon) %}
    {%- if shown is same as('') -%}
        {%- if emptyIcon %}{{ ux_icon('lucide:' ~ emptyIcon, {class: 'size-4 shrink-0 text-muted', 'aria-hidden': 'true'}) }}<span class="sr-only">{{ emptyLabel }}</span>{% else %}<twig:Ui:EmptyValue :label="emptyLabel ?: null" />{% endif -%}
    {%- elseif tone -%}
        <twig:Ui:Badge :tone="tone">{{ shown }}</twig:Ui:Badge>
    {%- else -%}
        <span class="min-w-0 truncate">{{ shown }}</span>
    {%- endif -%}
{% endmacro %}
{% set read = _self.value(shown, tone, emptyLabel, emptyIcon) %}
<form method="post" action="{{ action }}" {{ attributes.defaults({class: 'flex min-w-0', 'data-inline-edit': name}) }}{% if kind == 'date' %} data-controller="inline-date"{% endif %}>
    {% for field, fieldValue in edit.hidden %}<input type="hidden" name="{{ field }}" value="{{ fieldValue }}">{% endfor %}
    {% if kind == 'person' %}
        <twig:Ui:PersonPicker :name="name" :id="id" :label="label" :people="people" :value="value" :noneLabel="noneLabel" :compact="true" />
    {% else %}
        {# The picker needs JavaScript; without it (scripting: none) the value reads as plain text. #}
        <div class="flex min-w-0 [@media(scripting:none)]:hidden">
            {% if kind == 'menu' %}
                <twig:Ui:Menu :id="menuId" :buttonId="buttonId" :label="label" :menuLabel="label" align="start" :float="true" class="min-w-0" menuClass="max-h-80 min-w-48 overflow-y-auto">
                    <twig:block name="trigger">
                        {# Named by its own text, the label first (WCAG 2.5.3), as Ui:PersonPicker is. #}
                        <button type="button" id="{{ buttonId }}" aria-haspopup="menu" aria-expanded="false" aria-controls="{{ menuId }}" data-dropdown-target="button" data-action="dropdown#toggle keydown->dropdown#openFromButton" class="{{ constant('Foresi\\Ui\\Component\\InlineEdit::TRIGGER') }}" data-inline-edit-trigger><span class="sr-only">{{ label }}: </span>{{ read }}</button>
                    </twig:block>
                    {% for option in edit.rows %}
                        <twig:Ui:MenuItem type="submit" :name="name" :value="option.value" :checked="option.value == value" data-action="dropdown#close" data-inline-edit-option="{{ option.value }}">
                            {%- if option.dot %}<span class="size-2 shrink-0 rounded-sm {{ option.dot }}" aria-hidden="true"></span>{% endif -%}
                            <span class="min-w-0 truncate">{{ option.label }}</span>
                        </twig:Ui:MenuItem>
                    {% endfor %}
                </twig:Ui:Menu>
            {% else %}
                <span class="relative flex min-w-0">
                    <button type="button" id="{{ buttonId }}" class="{{ constant('Foresi\\Ui\\Component\\InlineEdit::TRIGGER') }}" data-inline-date-target="button" data-action="inline-date#open" data-inline-edit-trigger><span class="sr-only">{{ label }}: </span>{{ read }}</button>
                    {# The browser's date picker opens from the button; the field itself stays out of the way until a browser has no picker to open. #}
                    <input type="date" name="{{ name }}" value="{{ value }}" id="{{ id }}" aria-label="{{ label }}" tabindex="-1" class="sr-only h-control-sm rounded-option border border-control-line bg-white px-1.5 text-small text-ink {{ constant('Foresi\\Ui\\Component\\Style::FIELD_FOCUS') }}" data-inline-date-target="input" data-action="change->inline-date#save">
                </span>
            {% endif %}
        </div>
        <span class="hidden min-w-0 items-center gap-1.5 [@media(scripting:none)]:flex"><span class="sr-only">{{ label }}: </span>{{ read }}</span>
    {% endif %}
</form>
