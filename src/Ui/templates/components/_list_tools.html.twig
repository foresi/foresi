{#
    The tools at the end of a list's tabs, the same on every list: the filter icon, which opens the
    filter bar under the tabs, and the Columns icon, as Shopify Polaris IndexFilters puts its search,
    filter and sort icons on the row of view tabs. Takes:
    - toolsFilter: the id of the list's Ui:FilterBar (collapsible), or null for a list without one;
    - toolsSearch: whether that bar has a search (the icon then says "Search and filter");
    - toolsColumns: {id, action} of the list's Ui:ColumnPicker, its state from `picker`, or null.
    The names are the partial's own, so a page's `columns` or `filters` never reach it.
#}
{% set filters = toolsFilter ?? null %}
{% set columns = toolsColumns ?? null %}
<div class="flex shrink-0 items-center gap-1 self-center" data-list-tools>
    {% if filters %}
        <twig:Ui:IconButton icon="list-filter" variant="ghost" size="sm" :label="((toolsSearch ?? false) ? 'ui.filter_bar.toggle_search' : 'ui.filter_bar.toggle')|trans"
            aria-controls="{{ filters }}" aria-expanded="false" class="[@media(scripting:none)]:hidden" data-controller="filter-toggle" data-action="filter-toggle#toggle" data-filter-toggle="" />
    {% endif %}
    {% if columns %}
        {{ component('Ui:ColumnPicker', {id: columns.id, action: columns.action, keep: picker.keep, columns: picker.columns, density: picker.density, resetHref: picker.resetHref, modified: picker.modified}) }}
    {% endif %}
</div>
