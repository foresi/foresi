{#
    The row of quick filters under a list's tabs (Shopify Polaris IndexFilters, Linear, Notion,
    Attio): the view's pinned fields as chips, "Stage ▾", each opening a panel of its values, and
    "Stage: Offer ✕" once set; then the conditions set in the sheet on other fields, each with its
    ✕; then "Clear all", which clears every filter and the search; and, while the view shows
    changes nobody saved, "Save as new view" and "Save to view" at the end. The row is there while
    it has something to show. The search field itself stands on the row of the tabs
    (_list_tools); this bar keeps the form it sends, with what the list keeps. The filter icon of
    that row opens the sheet with every filter. The chips and the sheet need JavaScript, so
    without it (scripting: none) they step aside for the <noscript> form.
#}
{% set bar = this %}
{% set noJs = '[@media(scripting:none)]:hidden' %}
{% set setCount = bar.setCount %}
{% set hasSheet = filters is not empty or builder %}
{% import '@Ui/components/_filter_rows.html.twig' as rows %}
{# Inside the sheet's blocks id is the sheet's own. #}
{% set formId = id ~ '-sheet-form' %}
{% macro condition(chip) %}
    {# A condition set in the sheet on a field the view does not pin: changed there, removed with its ✕ (Linear, Notion). #}
    <span class="inline-flex h-control max-w-full items-center rounded-control border border-green bg-green-tint text-green" data-filter-condition>
        <span class="truncate pl-3 pr-1 font-medium">{{ chip.label }}</span>
        <a href="{{ chip.href }}" aria-label="{{ chip.removeLabel }}" class="mr-1 grid size-7 shrink-0 place-items-center rounded-control text-green no-underline hover:bg-white/60 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}" data-filter-condition-remove>{{ ux_icon('lucide:x', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
    </span>
{% endmacro %}
{% macro options(groups, multi) %}
    {# The values of a chip: checkboxes where several are picked at once, each applying at once; else one link a value. #}
    {% set option = 'group flex min-h-control w-full cursor-pointer items-center gap-2 rounded-option border-0 bg-transparent px-3 py-2.5 text-left font-medium text-ink no-underline transition-colors hover:bg-frame' %}
    {% for group in groups %}
        {% if group.label %}<p class="m-0 px-3 pt-2 pb-1 text-small font-medium text-muted">{{ group.label }}</p>{% endif %}
        {% for item in group.options %}
            {% if multi %}
                <label class="{{ option }} has-focus-visible:outline-2 has-focus-visible:-outline-offset-2 has-focus-visible:outline-green"><input type="checkbox" class="size-4 shrink-0 accent-green"{% if item.checked %} checked{% endif %} data-href="{{ item.href }}" data-action="change->quick-filter#go"><span class="min-w-0 flex-1 truncate">{{ item.label }}</span></label>
            {% else %}
                <a href="{{ item.href }}" role="menuitemradio" aria-checked="{{ item.checked ? 'true' : 'false' }}" class="{{ option }} focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-green"><span class="min-w-0 flex-1 truncate">{{ item.label }}</span>{% if item.checked %}{{ ux_icon('lucide:check', {class: 'size-4 shrink-0 text-green', 'aria-hidden': 'true'}) }}{% endif %}</a>
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endmacro %}
{% macro chip(key, label, text, set, clearHref, panel, lookup, attrs, hook, menu) %}
    {#
        One quick filter: a secondary button with the field's name and a chevron, or, set, the green
        "Field: value" with its ✕. Its panel opens under it.
    #}
    {% set focus = constant('Foresi\\Ui\\Component\\Style::FOCUS') %}
    {% set details %}
        <details class="relative" data-controller="quick-filter" data-action="toggle->quick-filter#toggled keydown->quick-filter#keydown"{{ attrs|raw }}>
            <summary class="{{ set ? 'flex h-control max-w-64 cursor-pointer list-none items-center truncate rounded-control pl-3 pr-1 font-medium text-green hover:bg-white/60' : 'inline-flex h-control cursor-pointer list-none items-center justify-center gap-1.5 whitespace-nowrap rounded-control border border-control-line bg-white px-3.5 font-semibold text-ink transition-colors hover:bg-head' }} [&::-webkit-details-marker]:hidden {{ focus }}" aria-haspopup="{{ menu ? 'menu' : 'true' }}">
                {%- if set %}<span class="truncate">{{ label }}: {{ text }}</span>{% else %}{{ label }}{{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-muted', 'aria-hidden': 'true'}) }}{% endif -%}
            </summary>
            <div role="{{ menu ? 'menu' : 'group' }}" aria-label="{{ label }}" class="absolute top-full left-0 z-50 mt-1 max-h-80 min-w-56 overflow-y-auto rounded-control border border-container bg-white p-1 text-left shadow-floating {{ lookup ? 'w-72' : 'w-max' }}" data-quick-filter-panel>{{ panel }}</div>
        </details>
    {% endset %}
    {% if set %}
        <span class="inline-flex h-control max-w-full items-center rounded-control border border-green bg-green-tint text-green" data-quick-filter="{{ key }}"{{ hook|raw }} data-set>
            {{ details }}
            <a href="{{ clearHref }}" aria-label="{{ 'ui.filter_bar.clear_one'|trans({label: label}) }}" class="mr-1 grid size-7 shrink-0 place-items-center rounded-control text-green no-underline hover:bg-white/60 {{ focus }}" data-filter-clear>{{ ux_icon('lucide:x', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
        </span>
    {% else %}
        <span class="inline-flex" data-quick-filter="{{ key }}"{{ hook|raw }}>{{ details }}</span>
    {% endif %}
{% endmacro %}
{% macro quick(item, sheetId) %}
    {# A quick filter of the view (FilterSheet), as its field declares it: its values, a search of the records it points to, a small field for a text, or the sheet with a row for its field. #}
    {% set lookup = item.lookup %}
    {% if not item.menu %}
        {# A number: nothing to list, so the chip opens the sheet with a row for its field. #}
        {% if item.set %}
            <span class="inline-flex h-control max-w-full items-center rounded-control border border-green bg-green-tint text-green" data-quick-filter="{{ item.key }}" data-set>
                <button type="button" class="h-control truncate rounded-control pl-3 pr-1 font-medium text-green hover:bg-white/60 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}" aria-haspopup="dialog" aria-controls="{{ sheetId }}" data-action="filter-bar#open">{{ item.label }}: {{ item.text }}</button>
                <a href="{{ item.clearHref }}" aria-label="{{ 'ui.filter_bar.clear_one'|trans({label: item.label}) }}" class="mr-1 grid size-7 shrink-0 place-items-center rounded-control text-green no-underline hover:bg-white/60 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}" data-filter-clear>{{ ux_icon('lucide:x', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
            </span>
        {% else %}
            <button type="button" class="inline-flex h-control cursor-pointer items-center justify-center gap-1.5 whitespace-nowrap rounded-control border border-control-line bg-white px-3.5 font-semibold text-ink transition-colors hover:bg-head {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}" aria-haspopup="dialog" aria-controls="{{ sheetId }}" data-action="filter-bar#pick" data-field="{{ item.key }}" data-quick-filter="{{ item.key }}">{{ item.label }}{{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-muted', 'aria-hidden': 'true'}) }}</button>
        {% endif %}
    {% else %}
        {% set attrs %}{% if lookup %} data-quick-filter-url-value="{{ lookup.url }}" data-quick-filter-base-value="{{ lookup.base }}" data-quick-filter-param-value="{{ lookup.param }}" data-quick-filter-conditions-value="{{ lookup.conditions }}" data-quick-filter-field-value="{{ lookup.field }}" data-quick-filter-op-value="{{ lookup.op }}" data-quick-filter-single-value="{{ lookup.single ? 'true' : 'false' }}" data-quick-filter-selected-value="{{ lookup.selected|map(s => s.id)|json_encode }}" data-quick-filter-empty-value="{{ 'ui.view_filter.quick.none_found'|trans }}"{% endif %}{% endset %}
        {% set id = sheetId ~ '-quick-' ~ item.key|replace({'.': '-', '_': '-'}) %}
        {% set panel %}
            {% if item.pick == 'text' %}
                <div class="p-1"><input type="text" id="{{ id }}-text" value="{{ lookup.value }}" aria-label="{{ 'ui.view_filter.quick.contains'|trans({field: item.label}) }}" placeholder="{{ 'ui.view_filter.quick.contains'|trans({field: item.label}) }}" maxlength="100" autocomplete="off" class="h-control w-64 rounded-control border border-control-line bg-white px-3 text-ink placeholder:text-muted transition-colors {{ constant('Foresi\\Ui\\Component\\Style::FIELD_FOCUS') }}" data-quick-filter-target="input" data-action="keydown->quick-filter#type"></div>
            {% elseif item.pick in ['lookup', 'choices'] %}
                {% if item.pick == 'lookup' %}<div class="p-1"><input type="search" id="{{ id }}-search" aria-label="{{ 'ui.view_filter.quick.search'|trans({field: item.label}) }}" placeholder="{{ 'ui.view_filter.quick.search'|trans({field: item.label}) }}" autocomplete="off" class="h-control w-full rounded-control border border-control-line bg-white px-3 text-ink placeholder:text-muted transition-colors {{ constant('Foresi\\Ui\\Component\\Style::FIELD_FOCUS') }}" data-quick-filter-target="input" data-action="input->quick-filter#search"></div>{% endif %}
                {% if item.pick == 'lookup' and lookup.selected is not empty %}
                    <div data-quick-filter-selected>{{ _self.options([{label: null, options: lookup.selected|map(s => {label: s.label, href: s.href, checked: true})}], true) }}</div>
                {% endif %}
                <ul class="m-0 list-none p-0" data-quick-filter-target="results"></ul>
                <p class="m-0 px-3 py-2 text-small text-muted empty:hidden" role="status" aria-live="polite" data-quick-filter-target="status"></p>
            {% else %}
                {{ _self.options(item.groups, item.multi) }}
                {% if item.pick == 'months' %}<button type="button" role="menuitem" class="group flex min-h-control w-full cursor-pointer items-center gap-2 rounded-option border-0 bg-transparent px-3 py-2.5 text-left font-medium text-green transition-colors hover:bg-frame focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-green" data-action="filter-bar#pick" data-field="{{ item.key }}" aria-haspopup="dialog" aria-controls="{{ sheetId }}">{{ 'ui.view_filter.quick.custom'|trans }}</button>{% endif %}
            {% endif %}
        {% endset %}
        {{ _self.chip(item.key, item.label, item.text, item.set, item.clearHref, panel, lookup and item.pick == 'lookup', attrs, '', item.pick in ['values', 'months'] and not item.multi) }}
    {% endif %}
{% endmacro %}
{% macro select(view) %}
    {# A filter of a list without saved views, pinned by QuickPins or set in the sheet: one value at a time; a day is changed in the sheet. #}
    {% if view.type == 'date' %}
        {{ _self.condition({label: view.label ~ ': ' ~ view.text, href: view.clearHref, removeLabel: 'ui.filter_bar.clear_one'|trans({label: view.label})}) }}
    {% else %}
        {% set panel %}{{ _self.options(view.groups, false) }}{% endset %}
        {{ _self.chip(view.name, view.label, view.text, view.set, view.clearHref, panel, false, '', ' data-filter-chip="' ~ view.name|e('html_attr') ~ '"', true) }}
    {% endif %}
{% endmacro %}
{% if search %}
    {# The form of the search field on the row of the tabs (its form attribute names this one): what the list keeps goes with it, the page and the search itself not. #}
    <form method="get" action="{{ action }}" id="{{ id }}-search" role="search" hidden data-filter-search>
        {% for name, value in bar.hidden(false, true) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
    </form>
{% endif %}
{% if bar.shown %}
    {# The row is there while it has chips, a filter set or unsaved changes; without JavaScript it is always open. #}
    <div {{ attributes.defaults({id: id, class: 'grid min-w-0 gap-2 [@media(scripting:enabled)]:data-[collapsed]:hidden', 'data-controller': 'filter-bar', 'data-filter-bar-dialog-outlet': '#' ~ id ~ '-sheet', 'data-filter-bar': ''}) }}{% if not bar.hasRow %} data-collapsed{% endif %}{% if bar.hasRow %} data-row{% endif %}{% if bar.narrowed %} data-filtered{% endif %}{% if setCount > 0 %} data-filters-set{% endif %}>
        {% if hasSheet or bar.narrowed or bar.modified %}
            <div class="flex min-w-0 flex-wrap items-center gap-2" data-filter-chips>
                {% if hasSheet %}
                    {% for item in quick %}<span class="contents {{ noJs }}">{{ _self.quick(item, id ~ '-sheet') }}</span>{% endfor %}
                    {% for view in bar.pinnedViews %}<span class="contents {{ noJs }}">{{ _self.select(view) }}</span>{% endfor %}
                    {% for view in bar.rest %}{% if view.set %}<span class="contents {{ noJs }}">{{ _self.select(view) }}</span>{% endif %}{% endfor %}
                    {% for chip in bar.loose %}<span class="contents {{ noJs }}">{{ _self.condition(chip) }}</span>{% endfor %}
                {% endif %}
                {% block end %}{% endblock %}
                {% if bar.narrowed %}<a href="{{ bar.clearHref }}" class="px-2 font-medium text-green no-underline hover:underline {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}" data-filter-clear-all>{{ 'ui.filter_bar.clear_all'|trans }}</a>{% endif %}
                {% if bar.modified %}
                    {# The view's unsaved changes, at the end of the row (Polaris IndexFilters: Cancel, Save as, Save). #}
                    <div class="ml-auto flex shrink-0 flex-wrap items-center gap-2" data-filter-row-actions>{{ include('@Ui/components/_view_actions.html.twig', {viewBar: viewBar}) }}</div>
                {% endif %}
            </div>
        {% endif %}
        {% if hasSheet %}
            <twig:Ui:Sheet :id="id ~ '-sheet'" :title="'ui.filter_bar.title'|trans" :description="'ui.filter_bar.description'|trans" size="sm">
                <form method="get" action="{{ bar.action }}" id="{{ formId }}" class="grid gap-4" data-filter-sheet-form data-action="change->filter-bar#sync">
                    {% for name, value in bar.hidden(true, false) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                    {% for view in bar.views %}
                        {# Every filter is here, a pinned one too: the filter icon opens this sheet at once. #}
                        <div class="min-w-0">
                            {% if view.type == 'date' %}
                                <twig:Ui:TextInput type="date" :name="view.name" :id="view.id ~ '-field'" :label="view.label" :value="view.value" />
                            {% else %}
                                <twig:Ui:Select :name="view.name" :id="view.id ~ '-field'" :label="view.label" :options="view.options" :value="view.value" />
                            {% endif %}
                        </div>
                    {% endfor %}
                    {% if builder %}
                        {# Macros imported above are out of reach inside the sheet's block. #}
                        {% import '@Ui/components/_filter_rows.html.twig' as rows %}
                        {% set fields = bar.builderFields %}
                        <input type="hidden" name="{{ builder.marker ?? constant('Foresi\\Shared\\Application\\View\\FilterRows::MARKER') }}" value="1">
                        <div class="grid gap-3" data-filter-rows>
                            {% for row in builder.rows %}{{ rows.row(fields[row.field], row, loop.index0, formId, false, builder.rules, builder.name ?? 'c') }}{% endfor %}
                        </div>
                        {{ rows.kept(builder, builder.rows|length) }}
                        <twig:Ui:Menu :id="id ~ '-add-menu'" :label="'ui.view_filter.add_row'|trans" icon="plus" variant="chip" align="start" :menuLabel="'ui.view_filter.add_row'|trans" menuClass="max-h-80 min-w-56 overflow-y-auto" data-filter-add>
                            {% for field in builder.fields %}<twig:Ui:MenuItem type="button" data-action="filter-bar#addRow" data-field="{{ field.key }}">{{ field.label }}</twig:Ui:MenuItem>{% endfor %}
                        </twig:Ui:Menu>
                        {% for field in builder.fields %}
                            <template data-filter-template="{{ field.key }}">{{ rows.row(field, field.blank|merge({op: field.ops|keys|first}), '__i__', formId, false, builder.rules, builder.name ?? 'c') }}</template>
                        {% endfor %}
                    {% endif %}
                </form>
                <twig:block name="footer">
                    {% if setCount > 0 %}<twig:Ui:Button variant="ghost" :href="bar.clearHref" data-filter-sheet-clear>{{ 'ui.filter_bar.clear_all'|trans }}</twig:Ui:Button>{% endif %}
                    <twig:Ui:Button type="submit" variant="primary" form="{{ formId }}" data-filter-apply>{{ 'ui.filter_bar.apply'|trans }}</twig:Ui:Button>
                </twig:block>
            </twig:Ui:Sheet>
            <noscript>
                <form method="get" action="{{ action }}" class="flex flex-wrap items-end gap-2" data-filter-noscript>
                    {% for name, value in bar.hidden(true, false) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                    {% if builder %}
                        {% set fields = bar.builderFields %}
                        {% set start = builder.rows|length + builder.kept|length %}
                        <input type="hidden" name="{{ builder.marker ?? constant('Foresi\\Shared\\Application\\View\\FilterRows::MARKER') }}" value="1">
                        {# The conditions set, then one row a field with its operator left empty. #}
                        <div class="grid w-full gap-3 sm:grid-cols-2 lg:grid-cols-3">
                            {% for row in builder.rows %}{{ rows.row(fields[row.field], row, loop.index0, id ~ '-noscript', true, builder.rules, builder.name ?? 'c') }}{% endfor %}
                            {% for field in builder.fields %}{{ rows.row(field, field.blank, start + loop.index0, id ~ '-noscript', true, builder.rules, builder.name ?? 'c') }}{% endfor %}
                        </div>
                        {{ rows.kept(builder, builder.rows|length) }}
                    {% endif %}
                    {% for view in bar.views %}
                        <div class="w-full min-w-0 sm:w-48">
                            {% if view.type == 'date' %}
                                <twig:Ui:TextInput type="date" :name="view.name" :id="view.id ~ '-noscript'" :label="view.label" :value="view.value" />
                            {% else %}
                                <twig:Ui:Select :name="view.name" :id="view.id ~ '-noscript'" :label="view.label" :options="view.options" :value="view.value" />
                            {% endif %}
                        </div>
                    {% endfor %}
                    <twig:Ui:Button type="submit" icon="list-filter">{{ 'ui.filter_bar.apply'|trans }}</twig:Ui:Button>
                </form>
            </noscript>
        {% endif %}
    </div>
{% endif %}
