{% set emptySlot %}{% block empty %}{% endblock %}{% endset %}
{% set footerSlot %}{% block footer %}{% endblock %}{% endset %}
{% set bulkSlot %}{% block bulk %}{% endblock %}{% endset %}
{% set focus = constant('Foresi\\Ui\\Component\\Style::FOCUS') %}
{# Columns of long text share the room the others leave and cut their text short; numbers, badges and actions keep their width. #}
{% set share = this.shareClass %}
{# A list row is 56 px, a dense one 44 px; the header is 44 px on the tint either way (level.io's tables). #}
{#
    On a phone a checkbox keeps its 16 px box but its label grows to a 44 px target, pulled back by a
    negative margin so the column does not widen, and a sortable header link is 44 px high (Apple
    HIG, Buttons; WCAG 2.2 SC 2.5.8).
#}
{% set rowHeight = this.rowHeight %}
{% macro alert(alert, focus) %}{{ ux_icon('lucide:triangle-alert', {class: 'mt-0.5 size-3.5 shrink-0', 'aria-hidden': 'true'}) }}<span>{{ alert.text }}{% if alert.href %} <a href="{{ alert.href }}" data-turbo="false" class="font-medium text-badge-red-text underline {{ focus }}">{{ alert.action }}</a>{% endif %}</span>{% endmacro %}
{# A table in an overlay (a record in the sheet) asks with confirm-submit: its host posts the form itself, so data-turbo-confirm would never ask. #}
{% macro confirm(confirm) %}{% if confirm %}{% if confirm.overlay %} data-controller="confirm-submit" data-action="submit->confirm-submit#ask" data-confirm-title="{{ confirm.title }}"{% else %} data-turbo-confirm="{{ confirm.title }}"{% endif %}{% if confirm.text %} data-confirm-text="{{ confirm.text }}"{% endif %}{% if confirm.accept %} data-confirm-accept="{{ confirm.accept }}"{% endif %}{% if confirm.cancel %} data-confirm-cancel="{{ confirm.cancel }}"{% endif %}{% if confirm.tone %} data-confirm-tone="{{ confirm.tone }}"{% endif %}{% endif %}{% endmacro %}
{# A click anywhere on a row follows its first cell's link (row-link); the link stays the one way in for a keyboard. #}
<div {{ attributes.defaults({class: 'relative' ~ (selectable ? ' pb-24' : '')}) }} data-controller="row-link{{ selectable ? ' table-selection' : '' }}" data-action="click->row-link#click{{ selectable ? ' keydown->table-selection#keydown click->table-selection#rowClick' : '' }}">
    {% if this.rowViews is empty %}
        {% if emptySlot %}{{ emptySlot|raw }}{% else %}<twig:Ui:EmptyState />{% endif %}
    {% else %}
        <div class="overflow-hidden rounded-panel border border-container bg-white">
            {# relative: absolute screen-reader texts in the cells stay inside the scroll box instead of widening the page. #}
            <div class="relative overflow-x-auto">
                <table class="w-full border-collapse">
                    <caption class="sr-only">{{ caption ?: 'ui.table.caption'|trans }}</caption>
                    {#- The widths a view gives its columns, from the sm breakpoint up; a column with none sizes to its content. A col leaves the table where its column does, so the rest keep their place. -#}
                    {% if this.hasWidths %}
                        <colgroup>
                            {%- if selectable %}<col class="w-12">{% endif -%}
                            {%- for column in this.columnViews -%}
                                <col{% if column.width %} style="--col-w: {{ column.width }}px"{% endif %} class="{{ column.width ? 'sm:w-(--col-w)' : '' }}{{ column.phone ? '' : ' max-sm:hidden' }}{{ column.wide ? ' max-xl:hidden' : '' }}" data-column="{{ column.key }}">
                            {%- endfor -%}
                            {%- if this.hasActions %}<col>{% endif -%}
                        </colgroup>
                    {% endif %}
                    <thead>
                        <tr>
                            {% if selectable %}
                                <th scope="col" class="h-row w-12 border-b border-divider bg-head px-4 text-left">
                                    <label class="inline-grid size-6 place-items-center max-shell:-m-2.5 max-shell:size-touch">
                                        <input type="checkbox" aria-label="{{ 'ui.table.select_all'|trans }}" data-table-selection-target="all" data-action="change->table-selection#toggleAll" class="size-4 accent-green {{ focus }}">
                                    </label>
                                </th>
                            {% endif %}
                            {% for column in this.columnViews %}
                                <th scope="col"{% if column.sortable %} aria-sort="{{ this.ariaSort(column.sort) }}"{% endif %} class="h-row whitespace-nowrap border-b border-divider bg-head px-4 text-caption font-medium text-muted {{ this.alignClass(column.align) }}{{ column.phone ? '' : ' max-sm:hidden' }}{{ column.wide ? ' max-xl:hidden' : '' }}{{ column.truncate ? ' sm:max-w-0 ' ~ share : '' }}">
                                    {%- if column.sortable -%}
                                        <a href="{{ column.href }}" class="inline-flex min-h-6 items-center max-shell:min-h-touch gap-1 text-muted no-underline hover:text-ink {{ focus }}">
                                            {{- column.label -}}
                                            {{- ux_icon('lucide:' ~ (column.sort ? 'chevron-down' : 'chevrons-up-down'), {class: 'size-3.5 shrink-0' ~ (column.sort == 'asc' ? ' rotate-180' : ''), 'aria-hidden': 'true'}) -}}
                                        </a>
                                    {%- else -%}
                                        {{- column.label -}}
                                    {%- endif -%}
                                </th>
                            {% endfor %}
                            {% if this.hasActions %}
                                <th scope="col" class="h-row border-b border-divider bg-head px-2"><span class="sr-only">{{ 'ui.table.actions'|trans }}</span></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in this.rowViews %}
                            <tr data-table-selection-target="row" data-id="{{ row.id }}"{% if row.selected %} data-selected="true"{% endif %} class="group scroll-mb-24{{ row.href ? ' cursor-pointer' : '' }}{{ row.child ? ' text-small' : '' }}"{% if row.child %} data-row-child{% endif %}>
                                {% if selectable %}
                                    <td class="{{ rowHeight }} w-12 border-b border-divider px-4 group-last:border-b-0 group-hover:bg-frame group-focus-within:bg-frame group-data-[selected=true]:bg-green-tint group-data-[selected=true]:inset-shadow-selected">
                                        <label class="inline-grid size-6 place-items-center max-shell:-m-2.5 max-shell:size-touch">
                                            <input type="checkbox"{% if selectionName %} name="{{ selectionName }}"{% endif %} value="{{ row.id }}" aria-label="{{ 'ui.table.select_row'|trans({label: row.label}) }}"{% if row.selected %} checked{% endif %} data-table-selection-target="check" data-action="click->table-selection#rowCheck change->table-selection#sync" class="size-4 accent-green {{ focus }}">
                                        </label>
                                    </td>
                                {% endif %}
                                {% for cell in row.cells %}
                                    <td class="{{ rowHeight }} whitespace-nowrap border-b border-divider px-4 text-text group-last:border-b-0 group-hover:bg-frame group-focus-within:bg-frame group-data-[selected=true]:bg-green-tint {{ this.alignClass(cell.align) }}{{ cell.phone ? '' : ' max-sm:hidden' }}{{ cell.wide ? ' max-xl:hidden' : '' }}{{ cell.truncate ? ' sm:max-w-0 ' ~ share : '' }}{{ (row.secondary or row.alert) and loop.first ? ' max-sm:w-full max-sm:max-w-0 max-sm:py-2' : '' }}{{ row.alert and cell.key == row.alert.column ? ' py-2' : '' }}{{ row.child and loop.first ? ' pl-10' : '' }}">
                                        {%- set unreadMark = loop.first and row.unread is not null -%}
                                        {%- if unreadMark %}<span class="flex min-w-0 items-center gap-2 [&>*]:min-w-0 {{ row.unread ? '[&_a]:font-semibold' : '[&_a]:font-normal' }}" data-unread="{{ row.unread ? 'true' : 'false' }}"><span class="size-2 shrink-0 rounded-sm{{ row.unread ? ' bg-green' : '' }}" aria-hidden="true"></span>{% if row.unread %}<span class="sr-only">{{ 'ui.table.unread'|trans }}: </span>{% endif %}{% endif -%}
                                        {%- if cell.edit -%}
                                            {{ component('Ui:InlineEdit', cell.edit|merge({id: 'edit-' ~ row.id ~ '-' ~ cell.key, text: cell.edit.kind|default('menu') == 'person' ? null : cell.text, tone: cell.tone})) }}
                                        {%- elseif cell.links -%}
                                            {#- Each record the row refers to is a chip of its own that opens it, apart from the row's link (Atlassian Tag: interactive metadata). -#}
                                            <span class="flex min-w-0 {{ cell.truncate ? '' : 'max-w-[32ch] ' }}items-center gap-1 overflow-hidden"{% if cell.title %} title="{{ cell.title }}"{% endif %} data-links>
                                                {%- for link in cell.links -%}
                                                    <a href="{{ link.href }}"{% if cell.plain %} data-turbo="false"{% elseif link.opens != 'page' %} data-{{ link.opens }} aria-haspopup="dialog"{% endif %} data-chip class="inline-flex h-6 min-w-0 max-w-full items-center rounded-sm border border-container bg-white px-2 text-caption font-medium text-ink no-underline transition-colors hover:border-control-line hover:bg-head {{ focus }}"><span class="truncate">{{ link.text }}</span></a>
                                                {%- endfor -%}
                                            </span>
                                        {%- elseif cell.flag -%}
                                            <span class="flex min-w-0 items-center gap-2" data-flag-cell>
                                                {%- if cell.link -%}
                                                    <a href="{{ cell.link }}" data-row-link{% if cell.plain %} data-turbo="false"{% elseif cell.opens != 'page' %} data-{{ cell.opens }} aria-haspopup="dialog"{% endif %}{% if cell.title %} title="{{ cell.title }}"{% endif %} class="block min-w-0 {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate font-medium text-ink no-underline {{ focus }}">{{ cell.text }}</a>
                                                {%- else -%}
                                                    <span class="block min-w-0 {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                                {%- endif -%}
                                                <twig:Ui:Badge :tone="cell.flag.tone" class="shrink-0 gap-1">{% if cell.flag.icon %}{{ ux_icon('lucide:' ~ cell.flag.icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}{% endif %}{{ cell.flag.label }}</twig:Ui:Badge>
                                            </span>
                                        {%- elseif cell.badges -%}
                                            <twig:Ui:Value :value="{badges: cell.badges}" />
                                        {%- elseif cell.avatar -%}
                                            <span class="flex min-w-0 items-center gap-2" data-avatar-cell>
                                                <twig:Ui:Avatar :name="cell.avatar.name" :seed="cell.avatar.seed" />
                                                {%- if cell.link -%}
                                                    <a href="{{ cell.link }}" data-row-link{% if cell.plain %} data-turbo="false"{% elseif cell.opens != 'page' %} data-{{ cell.opens }} aria-haspopup="dialog"{% endif %}{% if cell.title %} title="{{ cell.title }}"{% endif %} class="block min-w-0 max-w-[32ch] truncate font-medium text-ink no-underline {{ focus }}">{{ cell.text }}</a>
                                                {%- else -%}
                                                    <span class="block min-w-0 max-w-[32ch] truncate font-medium text-ink"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                                {%- endif -%}
                                            </span>
                                        {%- elseif cell.icon -%}
                                            <span class="inline-flex items-center gap-1.5"{% if cell.hint %} title="{{ cell.hint }}"{% endif %} data-icon-cell="{{ cell.icon }}">{{ ux_icon('lucide:' ~ cell.icon, {class: 'size-4 shrink-0 ' ~ cell.iconClass, 'aria-hidden': 'true'}) }}<span>{{ cell.text }}</span></span>
                                        {%- elseif cell.text is same as('') -%}
                                            <twig:Ui:Value :empty="cell.empty" />
                                        {%- elseif cell.tone -%}
                                            <twig:Ui:Value :value="{label: cell.text, tone: cell.tone, hint: cell.hint}" />
                                        {%- elseif cell.link -%}
                                            <a href="{{ cell.link }}" data-row-link{% if cell.plain %} data-turbo="false"{% elseif cell.opens != 'page' %} data-{{ cell.opens }} aria-haspopup="dialog"{% endif %}{% if cell.title %} title="{{ cell.title }}"{% endif %} class="block {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate font-medium text-ink no-underline {{ focus }}">{{ cell.text }}</a>
                                        {%- elseif cell.numeric -%}
                                            <span class="num"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                        {%- else -%}
                                            <span class="block {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                        {%- endif -%}
                                        {%- if unreadMark %}</span>{% endif -%}
                                        {%- if row.alert and cell.key == row.alert.column %}<span class="mt-0.5 flex items-start gap-1 whitespace-normal break-words text-caption text-badge-red-text max-sm:hidden" data-row-alert>{{ _self.alert(row.alert, focus) }}</span>{% endif -%}
                                        {%- if row.secondary and loop.first %}<span class="mt-0.5 block whitespace-normal break-words text-caption text-muted sm:hidden" data-row-secondary>{{ row.secondary }}</span>{% endif -%}
                                        {%- if row.alert and loop.first %}<span class="mt-1 flex items-start gap-1 whitespace-normal break-words text-caption text-badge-red-text sm:hidden" data-row-alert-phone>{{ _self.alert(row.alert, focus) }}</span>{% endif -%}
                                    </td>
                                {% endfor %}
                                {% if this.hasActions %}
                                    <td class="{{ rowHeight }} whitespace-nowrap border-b border-divider px-2 text-right group-last:border-b-0 group-hover:bg-frame group-focus-within:bg-frame group-data-[selected=true]:bg-green-tint" data-row-actions>
                                        <div class="flex items-center justify-end gap-0.5">
                                            {% set menuId = 'row-menu-' ~ row.id %}
                                            {# Macros of this template are out of reach inside the menu's content block. #}
                                            {% set confirms = row.actions|map(action => _self.confirm(action.confirm)) %}
                                            <twig:Ui:Menu :id="menuId" :label="'ui.table.more_actions'|trans({label: row.label})" icon="ellipsis" :iconOnly="true" variant="ghost" size="sm" :float="true">
                                                {% for action in row.actions %}
                                                    {% if action.method == 'POST' %}
                                                        <form method="post" action="{{ action.href }}" role="none"{{ confirms[loop.index0] }}>
                                                            <input type="hidden" name="_token" value="{{ actionToken }}">
                                                            {% for name, value in action.fields %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                                                            <twig:Ui:MenuItem type="submit" size="sm">{{ action.label }}</twig:Ui:MenuItem>
                                                        </form>
                                                    {% else %}
                                                        <twig:Ui:MenuItem size="sm" :href="action.href" :data-turbo="action.plain ? 'false' : null" :data-dialog="action.dialog ? true : null" :aria-haspopup="action.dialog ? 'dialog' : null">{{ action.label }}</twig:Ui:MenuItem>
                                                    {% endif %}
                                                {% endfor %}
                                            </twig:Ui:Menu>
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                    {% if totals is not null %}
                        <tfoot>
                            <tr>
                                {% if selectable %}<td class="h-row border-t border-divider bg-head px-4"></td>{% endif %}
                                {% for cell in this.totalCells %}
                                    <td class="num h-row whitespace-nowrap border-t border-divider bg-head px-4 font-semibold text-ink {{ this.alignClass(cell.align) }}{{ cell.phone ? '' : ' max-sm:hidden' }}{{ cell.wide ? ' max-xl:hidden' : '' }}">
                                        {{- cell.text is not same as('') ? cell.text : (loop.first ? 'ui.table.total'|trans : '') -}}
                                    </td>
                                {% endfor %}
                                {% if this.hasActions %}<td class="h-row border-t border-divider bg-head px-2"></td>{% endif %}
                            </tr>
                        </tfoot>
                    {% endif %}
                </table>
            </div>
            {% if footerSlot or count or total %}
                {# The footer: the count and the total of the list, then what the page adds (its pagination). #}
                <div data-table-footer class="flex flex-wrap items-center justify-between gap-2.5 border-t border-divider px-4 py-2.5 text-small text-muted">
                    {%- if count or total -%}
                        <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                            {%- if count %}<span class="num" data-table-count>{{ count }}</span>{% endif -%}
                            {%- if total %}<span class="num font-semibold text-ink" data-table-total>{{ total }}</span>{% endif -%}
                        </span>
                    {%- endif -%}
                    {{ footerSlot|raw }}
                </div>
            {% endif %}
        </div>
    {% endif %}
    {% if selectable %}<twig:Ui:BulkBar>{{ bulkSlot|raw }}</twig:Ui:BulkBar>{% endif %}
</div>
