<div class="grid gap-5">
{% embed '@Ui/catalogue/_state.html.twig' with {state: 'default'} %}{% block sample %}
<twig:Ui:Menu id="cat-menu" label="Export" icon="download" chevron="down">
    <twig:Ui:MenuItem type="submit">Export as CSV</twig:Ui:MenuItem>
    <twig:Ui:MenuItem type="submit">Export as Excel (XLSX)</twig:Ui:MenuItem>
</twig:Ui:Menu>
<twig:Ui:Menu id="cat-menu-row" label="More actions for 20260001" icon="ellipsis" :iconOnly="true" variant="ghost" size="sm" :float="true">
    <twig:Ui:MenuItem href="/_catalogue">Edit</twig:Ui:MenuItem>
    <twig:Ui:MenuItem href="/_catalogue">Duplicate</twig:Ui:MenuItem>
    <twig:Ui:MenuSection>
        <twig:Ui:MenuItem type="button" icon="trash-2" tone="danger">Delete</twig:Ui:MenuItem>
    </twig:Ui:MenuSection>
</twig:Ui:Menu>
{% endblock %}{% endembed %}
{% embed '@Ui/catalogue/_state.html.twig' with {state: 'open'} %}{% block sample %}
{# The open popup, drawn in place: groups, a selected row, a disabled row and a destructive row. #}
<div role="menu" aria-label="Views" class="w-72 {{ constant('Foresi\\Ui\\Component\\Menu::PANEL') }}">
    <twig:Ui:MenuSection label="Your views">
        <twig:Ui:MenuItem :checked="true">Unpaid invoices</twig:Ui:MenuItem>
        <twig:Ui:MenuItem :checked="false">Due this week</twig:Ui:MenuItem>
    </twig:Ui:MenuSection>
    <twig:Ui:MenuSection label="Shared views">
        <twig:Ui:MenuItem :checked="false">Příliš žluťoučký kůň úpěl ďábelské ódy</twig:Ui:MenuItem>
    </twig:Ui:MenuSection>
    <twig:Ui:MenuSection>
        <twig:Ui:MenuItem icon="plus">Save new view</twig:Ui:MenuItem>
        <twig:Ui:MenuItem icon="user" :disabled="true">Profile</twig:Ui:MenuItem>
        <twig:Ui:MenuItem icon="trash-2" tone="danger">Delete view</twig:Ui:MenuItem>
    </twig:Ui:MenuSection>
</div>
{% endblock %}{% endembed %}
</div>
