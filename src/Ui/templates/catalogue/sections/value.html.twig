{# One renderer per value type: a list cell, a description list and a facts grid all show a value through Ui:Value. #}
<div class="grid gap-5">
{% embed '@Ui/catalogue/_state.html.twig' with {state: 'default'} %}{% block sample %}
<twig:Ui:Value value="Example Company s.r.o." />
<twig:Ui:Value :value="{label: 'Paid', tone: 'green'}" />
<twig:Ui:Value :value="{badges: [{label: 'Customer', tone: 'green'}, {label: 'Supplier', tone: 'green'}]}" />
<twig:Ui:Value :value="{links: [{text: 'billing@example.com', href: 'mailto:billing@example.com'}]}" />
{% endblock %}{% endembed %}
{% embed '@Ui/catalogue/_state.html.twig' with {state: 'empty'} %}{% block sample %}
<twig:Ui:Value /><twig:Ui:Value :value="[]" empty="No response" />
{% endblock %}{% endembed %}
</div>
