{#
    The Settings sheet of a list (Ui:ColumnPicker), "Nastavení seznamu", behind the Settings icon at the end
    of the tabs: its views (shown in tabs, order, "⋯" with Přejmenovat, Zobrazit počet v záložce, Duplikovat
    and Skrýt or Smazat, "+ Nový pohled"), its quick filters (every filter field, checked ones are chips under
    the tabs, at most four), its columns and the row density, with "Obnovit výchozí" and "Použít". A list
    without views or columns shows the rest only.
#}
{% set columns = [
    {key: 'number', label: 'Číslo', visible: true, locked: true},
    {key: 'customer', label: 'Zákazník', visible: true, locked: false},
    {key: 'due_date', label: 'Splatnost', visible: true, locked: false},
    {key: 'firm', label: 'Firma', visible: false, locked: false},
    {key: 'tax_point_date', label: 'DUZP', visible: false, locked: false},
    {key: 'vat', label: 'DPH', visible: false, locked: false},
] %}
{% set quick = [
    {key: 'issue_date', label: 'Datum vystavení', pinned: true},
    {key: 'customer', label: 'Zákazník', pinned: true},
    {key: 'payment', label: 'Stav platby', pinned: false},
    {key: 'due_date', label: 'Splatnost', pinned: false},
] %}
{% set manage = {
    all: {name: 'Vše', translated: false},
    tabs: [
        {ref: 'v1', key: 'unpaid', name: 'Nezaplacené', translated: false, private: false, primary: true, showCount: true, editable: true, shipped: true, href: '#'},
        {ref: 'v2', key: 'overdue', name: 'Po splatnosti', translated: false, private: false, primary: true, showCount: false, editable: true, shipped: true, href: '#'},
    ],
    more: [{ref: 'v3', key: 'mine', name: 'Moje velké', translated: false, private: true, primary: false, showCount: false, editable: true, shipped: false, href: '#'}],
    hidden: [], canReorder: true, maxTabs: 6, primaryFull: false, canRestore: true, list: 'catalogue', return: '/_catalogue',
} %}
<div class="grid gap-5">
{% embed '@Ui/catalogue/_state.html.twig' with {state: 'default'} %}{% block sample %}
<div class="flex"><twig:Ui:ColumnPicker id="catalogue-columns" action="/_catalogue" :keep="{}" :columns="columns" :quick="quick" :manage="manage" density="comfortable" resetHref="/_catalogue" /></div>
{% endblock %}{% endembed %}
{% embed '@Ui/catalogue/_state.html.twig' with {state: 'modified'} %}{% block sample %}
<div class="flex"><twig:Ui:ColumnPicker id="catalogue-columns-modified" action="/_catalogue" :keep="{}" :columns="columns" :quick="quick" density="dense" resetHref="/_catalogue" :modified="true" /></div>
{% endblock %}{% endembed %}
{% embed '@Ui/catalogue/_state.html.twig' with {state: 'quick_only'} %}{% block sample %}
<div class="flex"><twig:Ui:ColumnPicker id="catalogue-display-quick" action="/_catalogue" :keep="{}" :quick="[{key: 'responsible', label: 'Řešitel', pinned: true}, {key: 'due', label: 'Termín', pinned: true}]" :density="null" resetHref="/_catalogue" /></div>
{% endblock %}{% endembed %}
</div>
