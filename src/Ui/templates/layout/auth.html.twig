{# Frame of the pages shown before sign-in: login, two-factor and invitation. #}
{% extends '@Ui/base.html.twig' %}

{% block body %}
    <main class="mx-auto grid min-h-dvh w-full max-w-[420px] content-center gap-5 px-[max(1rem,env(safe-area-inset-left,0px),env(safe-area-inset-right,0px))] py-10">
        <p class="m-0 flex items-center justify-center gap-2.5 text-heading font-semibold text-ink">
            <span class="grid size-8 place-items-center rounded-control bg-green font-semibold text-white" aria-hidden="true">{{ product_name|first|upper }}</span>
            <span>{{ product_name }}</span>
        </p>
        <div class="rounded-panel border border-container bg-white p-6 shadow-raised">
            <h1 class="m-0 mb-4 text-title font-semibold text-ink">{% block heading %}{{ block('title') }}{% endblock %}</h1>
            {% block content %}{% endblock %}
        </div>
    </main>
{% endblock %}
