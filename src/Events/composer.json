{
    "name": "foresi/events",
    "description": "Domain events: the catalogue of contract events, their recording and delivery.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/audit": "self.version",
        "foresi/instance": "self.version",
        "foresi/module-api": "^1.0",
        "foresi/shared": "self.version",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/lock": "^7.4.24",
        "symfony/messenger": "^7.4.24",
        "symfony/routing": "^7.4",
        "symfony/service-contracts": "^3.8",
        "symfony/validator": "7.4.*",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Events\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "events",
            "kind": "core",
            "namespace": "Foresi\\Events\\",
            "bundle": "Foresi\\Events\\EventsBundle",
            "optional": [],
            "scopes": [
                "events"
            ]
        }
    }
}
