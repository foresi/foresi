{
    "name": "foresi/webhooks",
    "description": "Outbound webhooks: endpoints that receive the domain events as signed Standard Webhooks requests.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "doctrine/persistence": "^4.2",
        "foresi/audit": "self.version",
        "foresi/events": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/module-api": "^1.0",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "^7.4.24",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4.24",
        "symfony/routing": "^7.4",
        "symfony/serializer": "7.4.*",
        "symfony/service-contracts": "^3.8",
        "symfony/translation-contracts": "^3.8",
        "symfony/validator": "7.4.*",
        "twig/twig": "^3.30",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Webhooks\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "webhooks",
            "kind": "core",
            "namespace": "Foresi\\Webhooks\\",
            "bundle": "Foresi\\Webhooks\\WebhooksBundle",
            "optional": [],
            "scopes": [
                "webhooks"
            ]
        }
    }
}
