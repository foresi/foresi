{
    "name": "foresi/webhooks",
    "description": "Outbound webhooks: endpoints that receive the domain events as signed Standard Webhooks requests.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "require": {
        "foresi/audit": "*",
        "foresi/events": "*",
        "foresi/identity": "*",
        "foresi/instance": "*",
        "foresi/shared": "*",
        "foresi/ui": "*"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Webhooks\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "webhooks",
            "kind": "core",
            "namespace": "Foresi\\Webhooks\\",
            "bundle": "Foresi\\Webhooks\\WebhooksBundle",
            "optional": [],
            "scopes": [
                "webhooks"
            ]
        }
    }
}
