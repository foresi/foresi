{
    "name": "foresi/webhooks",
    "description": "Outbound webhooks: endpoints that receive the domain events as signed Standard Webhooks requests.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "foresi/audit": "self.version",
        "foresi/events": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Webhooks\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "webhooks",
            "kind": "core",
            "namespace": "Foresi\\Webhooks\\",
            "bundle": "Foresi\\Webhooks\\WebhooksBundle",
            "optional": [],
            "scopes": [
                "webhooks"
            ]
        }
    }
}
