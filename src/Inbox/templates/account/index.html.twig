{#
    The person's inbox addresses: the address that takes the mail they forward into their inbox, with its
    label, when it was made and how many mails were dropped today (over the daily limit). A new address
    opens in a dialog from the header (one active address at a time); each row's menu has Rename, Replace
    and Revoke. The full address is never shown here, only once when it is made. Below, how to forward mail
    from Gmail, Outlook and Apple Mail, with each provider's own help page.
    Variables: columns, rows, canCreate, help.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'inbox.account.title'|trans}] %}
{% set focus = constant('Foresi\\Ui\\Component\\Style::FOCUS') %}

{% block title %}{{ 'inbox.account.title'|trans }}{% endblock %}

{% block actions %}
    {% if canCreate %}
        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_account_inbox_new')" id="inbox-address-new" data-dialog aria-haspopup="dialog">{{ 'inbox.account.new'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <div class="grid max-w-4xl gap-4">
        <p class="m-0 text-text">{{ 'inbox.account.intro'|trans }}</p>
        <section data-inbox-addresses>
            <twig:Ui:DataTable :caption="'inbox.account.title'|trans" :columns="columns" :rows="rows" :actionToken="csrf_token(constant('Foresi\\Inbox\\Infrastructure\\Controller\\AccountInboxController::TOKEN'))">
                <twig:block name="empty">
                    <div data-inbox-addresses-empty>
                        <twig:Ui:EmptyState icon="mail" :title="'inbox.account.empty.title'|trans" :text="'inbox.account.empty.text'|trans">
                            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_account_inbox_new')" data-dialog aria-haspopup="dialog">{{ 'inbox.account.new'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    </div>
                </twig:block>
            </twig:Ui:DataTable>
        </section>
        {{ include('@Inbox/account/_forwarding.html.twig') }}
    </div>
{% endblock %}
