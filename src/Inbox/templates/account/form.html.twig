{#
    A new inbox address or a new label for one: only its label. A dialog over the addresses; the same URL
    is a page of its own. A new address answers with the page that shows it once.
    Variables: mode (new or rename), action, label, error.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set title = ('inbox.account.' ~ mode ~ '_title')|trans %}
{% set crumbs = [{label: 'inbox.account.title'|trans, href: path('app_account_inbox')}, {label: title}] %}
{% set form_invalid = error is not null %}
{% set dialog_size = 'md' %}

{% block title %}{{ title }}{% endblock %}

{% block dialog_body %}
    {# A new address answers with the page of its address, which Turbo would refuse as a form answer without a redirect. #}
    <form method="post" id="inbox-address-form" action="{{ action }}" class="grid gap-4"{% if mode == 'new' %} data-turbo="false"{% endif %} novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Inbox\\Infrastructure\\Controller\\AccountInboxController::TOKEN')) }}">
        <twig:Ui:TextInput name="label" id="label" :label="'inbox.account.field.label'|trans" :help="'inbox.account.field.label_help'|trans" :value="label" :error="error" maxlength="80" required autocomplete="off" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'inbox.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="inbox-address-form" variant="primary">{{ ('inbox.account.' ~ mode ~ '_submit')|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="mail" class="max-w-2xl">
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_account_inbox')">{{ 'inbox.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="inbox-address-form" variant="primary">{{ ('inbox.account.' ~ mode ~ '_submit')|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
