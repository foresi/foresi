{#
    Reject a suggestion an agent proposed on an inbox item, with an optional reason (HubSpot's reject of
    a suggestion). A dialog over the item; the same URL is a page of its own. Nothing of the suggestion
    runs. Variables: id, suggestionId, reason, error, token.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set title = 'inbox.suggestion.reject.title'|trans %}
{% set crumbs = [{label: 'nav.item.inbox'|trans, href: path('app_inbox')}, {label: title}] %}
{% set form_invalid = error is not null %}
{% set dialog_size = 'md' %}

{% block title %}{{ title }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="inbox-suggestion-reject-form" action="{{ path('app_inbox_suggestion_reject', {id: id, suggestionId: suggestionId}) }}" class="grid gap-4" novalidate data-inbox-suggestion-reject-form>
        <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
        <p class="m-0 text-text">{{ 'inbox.suggestion.reject.intro'|trans }}</p>
        <twig:Ui:Textarea name="reason" id="inbox-suggestion-reason" :label="'inbox.suggestion.reject.reason'|trans" :help="'inbox.suggestion.reject.reason_help'|trans" :value="reason" :error="error" :rows="3" maxlength="500" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'inbox.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="inbox-suggestion-reject-form" variant="primary">{{ 'inbox.suggestion.reject.submit'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="x" class="max-w-2xl">
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_inbox_item', {id: id})">{{ 'inbox.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="inbox-suggestion-reject-form" variant="primary">{{ 'inbox.suggestion.reject.submit'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
