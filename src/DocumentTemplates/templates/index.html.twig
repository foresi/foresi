{#
    Documents under Sales: every document, newest first, with its type, status and the records it
    belongs to. The type and the status are its quick filters (Ui:FilterBar), under the search, filter
    and Settings icons every list has, pinned again in the Settings sheet. A row opens the
    document in the side sheet; the status "In the trash" lists the cancelled documents in the trash
    instead. "+ New document" in the header opens the dialog and follows to the new document. Variables:
    columns, rows, more, filters, narrowed, trash, hasTypes.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'document_templates.list.title'|trans}] %}

{% block title %}{{ 'document_templates.list.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_document_new')" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-document-new>{{ 'document_templates.action.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {{ include('@DocumentTemplates/_flashes.html.twig') }}
    <section class="grid gap-3" data-documents>
        {# A list with no tabs keeps its tools where the tabs end on every other list. #}
        {% set search = {name: 'q', value: text ?? '', label: 'document_templates.list.search_label'|trans} %}
        {{ include('@Ui/components/_list_toolbar.html.twig', {toolsFilter: 'documents-filters', toolsSearch: search, toolsColumns: {id: 'documents-display', action: path('app_documents')}}) }}
        <twig:Ui:FilterBar id="documents-filters" :search="search" :action="path('app_documents')" :keep="pinsQuery" :pinned="pinned" :filters="filters" :empty="rows is empty" data-documents-filter />
        <twig:Ui:DataTable :caption="'document_templates.list.title'|trans" :columns="columns" :rows="rows">
            <twig:block name="empty">
                {% if trash %}
                    <twig:Ui:EmptyState icon="trash-2" :title="'document_templates.empty.trash_title'|trans" :text="'document_templates.empty.trash_text'|trans" data-documents-trash-empty>
                        <twig:Ui:Button :href="path('app_documents')">{{ 'document_templates.empty.reset'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% elseif narrowed %}
                    <twig:Ui:EmptyState icon="search" :title="'document_templates.empty.filtered_title'|trans" data-documents-filtered-empty>
                        <twig:Ui:Button :href="path('app_documents')">{{ 'document_templates.empty.reset'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% elseif not hasTypes %}
                    <twig:Ui:EmptyState icon="file-text" :title="'document_templates.empty.no_types_title'|trans" :text="'document_templates.empty.no_types_text'|trans">
                        <twig:Ui:Button :href="path('app_document_settings')" icon="settings">{{ 'document_templates.empty.no_types_action'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% else %}
                    <twig:Ui:EmptyState icon="file-text" :title="'document_templates.empty.title'|trans" :text="'document_templates.empty.text'|trans">
                        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_document_new')" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'document_templates.action.new'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% endif %}
            </twig:block>
        </twig:Ui:DataTable>
        {% if more %}<p class="m-0 text-caption text-muted" data-documents-more>{{ 'document_templates.list.more'|trans }}</p>{% endif %}
    </section>
{% endblock %}
