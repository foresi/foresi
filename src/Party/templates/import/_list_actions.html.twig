{# The export and import of the address book, in the overflow menu of its header (ContactListActions::HEADER). #}
{% if not firstRun %}
    <form method="post" action="{{ path('app_contacts_export') }}" data-turbo="false" role="none">
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Party\\Infrastructure\\Controller\\PartyController::ACTION_TOKEN')) }}">
        <input type="hidden" name="scope" value="view">
        <input type="hidden" name="view" value="{{ query.view }}">
        <input type="hidden" name="q" value="{{ query.q }}">
        {% if query.import is defined %}
            <input type="hidden" name="import" value="{{ query.import }}">
            <input type="hidden" name="outcome" value="{{ query.outcome }}">
        {% endif %}
        <twig:Ui:MenuItem type="submit" name="format" value="csv" icon="download">{{ 'party.header.export_csv'|trans }}</twig:Ui:MenuItem>
        <twig:Ui:MenuItem type="submit" name="format" value="xlsx" icon="download">{{ 'party.header.export_xlsx'|trans }}</twig:Ui:MenuItem>
    </form>
{% endif %}
<twig:Ui:MenuItem icon="upload" :href="path('app_import_new', {target: 'party'})">{{ 'party.header.import'|trans }}</twig:Ui:MenuItem>
