{#
    Adding or editing an address of a contact: a small dialog over the contact, and the same form as a
    page of its own. The billing address keeps its type; another address is a delivery, postal or
    other one.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set editing = address is not null %}
{% set crumbs = [{label: 'party.title'|trans, href: path('app_contacts')}, {label: party.displayName, href: cancel}, {label: (editing ? 'party.addresses.edit' : 'party.addresses.add')|trans}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'sm' %}

{% block title %}{{ (editing ? 'party.addresses.edit' : 'party.addresses.add')|trans }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="contact-address-form" action="{{ action }}" class="grid gap-4" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Party\\Infrastructure\\Controller\\ContactPartsController::FORM_TOKEN')) }}">

        {% if errors.form is defined %}
            <twig:Ui:Alert tone="error" tabindex="-1" data-error-summary :autofocus="true">{{ errors.form }}</twig:Ui:Alert>
        {% endif %}

        <div class="grid gap-4 sm:grid-cols-2">
            {% if billing %}
                <div class="grid gap-1.5" id="type">
                    <p class="m-0 text-small font-medium text-ink">{{ 'party.column.type'|trans }}</p>
                    <p class="m-0 text-body text-ink">{{ 'party.address_type.billing'|trans }}</p>
                </div>
            {% else %}
                <twig:Ui:Select name="type" id="type" :label="'party.column.type'|trans" :options="types" :value="values.type" :error="errors.type|default(null)" required />
            {% endif %}
            <twig:Ui:TextInput name="label" id="label" :label="'party.column.label'|trans" :help="'party.addresses.label_help'|trans" :value="values.label" :error="errors.label|default(null)" maxlength="100" />
        </div>
        <twig:Ui:TextInput name="street" id="street" :label="'party.field.street'|trans" :value="values.street" :error="errors.street|default(null)" maxlength="255" autocomplete="street-address" required />
        <div class="grid gap-4 sm:grid-cols-[1fr_8rem]">
            <twig:Ui:TextInput name="city" id="city" :label="'party.field.city'|trans" :value="values.city" :error="errors.city|default(null)" maxlength="128" autocomplete="address-level2" required />
            <twig:Ui:TextInput name="postalCode" id="postalCode" :label="'party.field.postalCode'|trans" :value="values.postalCode" :error="errors.postalCode|default(null)" maxlength="32" autocomplete="postal-code" required />
        </div>
        <twig:Ui:Select name="countryCode" id="countryCode" :label="'party.field.countryCode'|trans" :options="countries" :value="values.countryCode" :error="errors.countryCode|default(null)" required />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'party.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="contact-address-form" variant="primary">{{ (editing ? 'party.save' : 'party.addresses.submit')|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set form %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="(editing ? 'party.addresses.edit' : 'party.addresses.add')|trans" icon="building-2" class="max-w-2xl">
        {{ form }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="cancel">{{ 'party.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="contact-address-form" variant="primary">{{ (editing ? 'party.save' : 'party.addresses.submit')|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
