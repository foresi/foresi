{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.contacts'|trans}, {label: 'party.title'|trans}] %}

{% block title %}{{ 'party.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="contacts-actions">
        <twig:block name="primary">
            {% if not firstRun %}<twig:Ui:Button variant="primary" icon="plus" :href="path('app_contact_new', {for: constant('Foresi\\Party\\Infrastructure\\Controller\\PartyFormController::FOR_CONTACTS')})" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-contact-new>{{ 'party.new'|trans }}</twig:Ui:Button>{% endif %}
        </twig:block>
        {% for action in slot_items(constant('Foresi\\Party\\Contract\\ContactListActions::HEADER'), {firstRun: firstRun, query: listQuery}) %}{{ include(action.template, action.data|merge({firstRun: firstRun, query: listQuery})) }}{% endfor %}
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    {% for message in app.flashes('success') %}
        <twig:Ui:Alert tone="success" class="mb-4">{{ message }}</twig:Ui:Alert>
    {% endfor %}

    {% if firstRun %}
        <twig:Ui:EmptyState icon="users" :title="'party.empty.title'|trans" :text="'party.empty.text'|trans">
            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_contact_new', {for: constant('Foresi\\Party\\Infrastructure\\Controller\\PartyFormController::FOR_CONTACTS')})" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-contact-new>{{ 'party.new'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            <twig:Ui:Tabs :items="tabs" :label="'party.views'|trans" />
            <twig:Ui:FilterBar id="contact-filters" :action="path('app_contacts')" :keep="{view: view != 'all' ? view : null, sort: sort != 'name' ? sort : null}|merge(workingQuery)"
                :search="{name: 'q', value: text, label: 'party.search.label'|trans, placeholder: 'party.search.placeholder'|trans}" :empty="rows is empty">
                <twig:block name="end">
                    <twig:Ui:ColumnPicker id="contact-columns" :action="path('app_contacts')" :keep="picker.keep" :columns="picker.columns" :density="picker.density" :resetHref="picker.resetHref" :modified="picker.modified" />
                </twig:block>
            </twig:Ui:FilterBar>

            {% if importedBy %}
                <twig:Ui:Alert tone="info" data-imported-by>
                    <span>{{ importedBy.text }}</span>
                    <a href="{{ importedBy.href }}" class="ml-1 font-semibold text-current underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">{{ 'party.imported_by.summary'|trans }}</a>
                    <a href="{{ path('app_contacts') }}" class="ml-1 font-semibold text-current underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">{{ 'party.empty_filtered.reset'|trans }}</a>
                </twig:Ui:Alert>
            {% endif %}

            {% set bulkActions = slot_items(constant('Foresi\\Party\\Contract\\ContactListActions::BULK'), {view: view}) %}
            <form method="post" action="{{ path('app_contacts_archive') }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Party\\Infrastructure\\Controller\\PartyController::ACTION_TOKEN')) }}">
                <twig:Ui:DataTable :caption="'party.title'|trans" :columns="columns" :rows="rows" :density="density" :selectable="view != 'archived' or bulkActions is not empty" selectionName="ids[]">
                    <twig:block name="empty">
                        <twig:Ui:EmptyState icon="search" :title="'party.empty_filtered.title'|trans" :text="'party.empty_filtered.text'|trans">
                            <twig:Ui:Button :href="path('app_contacts')">{{ 'party.empty_filtered.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    </twig:block>
                    <twig:block name="footer">
                        <span class="num">{{ 'party.pagination.summary'|trans({total: page.total}) }}</span>
                        <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                    </twig:block>
                    <twig:block name="bulk">
                        {% if view != 'archived' %}
                            <twig:Ui:Button type="submit" size="sm" icon="archive" formaction="{{ path('app_contacts_archive') }}">{{ 'party.bulk.archive'|trans }}</twig:Ui:Button>
                        {% endif %}
                        {% for action in bulkActions %}{{ include(action.template, action.data|merge({view: view})) }}{% endfor %}
                    </twig:block>
                </twig:Ui:DataTable>
            </form>
        </div>
    {% endif %}
{% endblock %}
