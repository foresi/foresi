{% extends '@Ui/layout/record.html.twig' %}

{% set crumbs = [{label: 'party.title'|trans, href: path('app_contacts')}, {label: party.displayName}] %}
{% set formatTime = 'format.datetime'|trans %}
{% set token = csrf_token(constant('Foresi\\Party\\Infrastructure\\Controller\\PartyController::ACTION_TOKEN')) %}

{% block title %}{{ party.displayName }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="contact-actions" :menuSize="record_action_size">
        <twig:block name="primary">
            <twig:Ui:Button variant="primary" icon="pencil" :size="record_action_size" :href="path('app_contact_edit', {id: id})" data-in-place>{{ 'party.edit'|trans }}</twig:Ui:Button>
        </twig:block>
        <twig:block name="last">
            {% if party.archived %}
                <form method="post" action="{{ path('app_contact_restore', {id: id}) }}" role="none">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:MenuItem type="submit" icon="archive-restore">{{ 'party.restore'|trans }}</twig:Ui:MenuItem>
                </form>
            {% else %}
                <form method="post" action="{{ path('app_contact_archive', {id: id}) }}" role="none">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:MenuItem type="submit" icon="archive">{{ 'party.archive'|trans }}</twig:Ui:MenuItem>
                </form>
            {% endif %}
        </twig:block>
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 gap-4">
        {% for id in app.flashes(constant('Foresi\\Party\\Infrastructure\\Controller\\PartyFormController::CREATED_FLASH')) %}<div hidden data-controller="contact-created" data-contact-created-id-value="{{ id }}"></div>{% endfor %}
        {% for message in app.flashes('success') %}
            <twig:Ui:Alert tone="success">{{ message }}</twig:Ui:Alert>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <twig:Ui:Alert tone="error">{{ message }}</twig:Ui:Alert>
        {% endfor %}

        <div class="flex flex-wrap items-center gap-2" data-party-summary>
            <twig:Ui:Value list="party.contacts" attribute="kind" :value="party.kind" />
            <twig:Ui:Value list="party.contacts" attribute="roles" :value="party.roles" />
            {% if party.archived %}<twig:Ui:Badge tone="gray">{{ 'party.archived'|trans }}</twig:Ui:Badge>{% endif %}
            {% for check in checks %}
                <span class="inline-flex items-center gap-1.5 text-small text-muted">
                    <twig:Ui:Badge :tone="check.tone">{{ check.text }}</twig:Ui:Badge>
                    <time datetime="{{ check.checkedAt|date('c') }}">{{ 'party.check.at'|trans({time: check.checkedAt|date(formatTime)}) }}</time>
                </span>
            {% endfor %}
        </div>

        <twig:Ui:FactsGrid :items="facts" />

        <twig:Ui:Tabs :items="tabs" :label="'party.sections'|trans" data-in-place />

        {% if tab == 'overview' %}
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                <twig:Ui:Card :title="'party.card.checks'|trans" icon="circle-check">
                    <twig:block name="actions">
                        {% if hasVatId %}
                            <form method="post" action="{{ path('app_contact_refresh_checks', {id: id}) }}">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <twig:Ui:Button type="submit" size="sm" variant="ghost" icon="refresh-cw">{{ 'party.checks.refresh'|trans }}</twig:Ui:Button>
                            </form>
                        {% endif %}
                    </twig:block>
                    {% if not hasVatId %}
                        <p class="m-0 text-muted">{{ 'party.checks.no_vat_id'|trans }}</p>
                    {% elseif checks is empty %}
                        <p class="m-0 text-muted">{{ 'party.checks.never'|trans }}</p>
                    {% else %}
                        {% set checkItems = [] %}
                        {% for check in checks %}
                            {% set checkItems = checkItems|merge([{label: check.label, value: {label: check.text, tone: check.tone}, note: 'party.check.at'|trans({time: check.checkedAt|date(formatTime)})}]) %}
                        {% endfor %}
                        <twig:Ui:DescriptionList :items="checkItems" data-party-checks />
                        {% if accounts is not empty %}
                            <twig:Ui:Alert tone="error" role="note" :title="'party.checks.accounts'|trans" class="mt-3" data-published-accounts>
                                <ul class="m-0 list-none p-0">
                                    {% for account in accounts %}<li class="num font-normal">{{ account }}</li>{% endfor %}
                                </ul>
                            </twig:Ui:Alert>
                        {% endif %}
                    {% endif %}
                </twig:Ui:Card>

                <twig:Ui:Card :title="'party.card.billing'|trans" icon="building-2">
                    {% if billing %}
                        <address class="not-italic text-text">
                            {{ billing.street }}<br>{{ billing.postalCode }} {{ billing.city }}<br>{{ billing.countryCode }}
                        </address>
                    {% else %}
                        <p><twig:Ui:EmptyValue /></p>
                    {% endif %}
                </twig:Ui:Card>

                <twig:Ui:Card :title="'party.card.defaults'|trans" icon="receipt-text">
                    <twig:Ui:DescriptionList :items="defaults" />
                </twig:Ui:Card>

                <twig:Ui:Card :title="'party.card.note'|trans" icon="pencil">
                    {% if note %}<p class="whitespace-pre-line text-text">{{ note }}</p>{% else %}<p class="text-muted">{{ 'party.card.note_empty'|trans }}</p>{% endif %}
                </twig:Ui:Card>
            </div>
        {% elseif tab == 'contacts' %}
            {# Each tab adds in a dialog over the contact; the sheet then shows the tab again (docs/design/overlays.md). #}
            {% set addPerson = path('app_contact_person_new', {id: id}) %}
            <twig:Ui:Card :title="'party.tab.contacts'|trans" icon="users">
                <twig:block name="actions">
                    {% if not isPerson and contactRows is not empty %}
                        <twig:Ui:Button :href="addPerson" size="sm" icon="user-plus" id="contact-person-add" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'party.contacts.add'|trans }}</twig:Ui:Button>
                    {% endif %}
                </twig:block>
                {% if contactRows is empty %}
                    <twig:Ui:EmptyState icon="users" :title="(isPerson ? 'party.contacts.empty_person' : 'party.contacts.empty')|trans" :text="isPerson ? null : 'party.contacts.empty_text'|trans" class="py-10">
                        {% if not isPerson %}
                            <twig:Ui:Button :href="addPerson" variant="primary" icon="user-plus" id="contact-person-add" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'party.contacts.add'|trans }}</twig:Ui:Button>
                        {% endif %}
                    </twig:Ui:EmptyState>
                {% else %}
                    <twig:Ui:DataTable :caption="'party.tab.contacts'|trans" :columns="[{key: 'name', label: 'party.column.name'|trans}, {key: 'position', label: 'party.column.position'|trans}, {key: 'primary', label: 'party.column.primary'|trans}]" :rows="contactRows" :actionToken="token" />
                {% endif %}
            </twig:Ui:Card>
        {% elseif tab == 'addresses' %}
            {% set addAddress = path('app_contact_address_new', {id: id}) %}
            <twig:Ui:Card :title="'party.tab.addresses'|trans" icon="building-2">
                <twig:block name="actions">
                    <twig:Ui:Button :href="addAddress" size="sm" icon="plus" id="contact-address-add" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'party.addresses.add'|trans }}</twig:Ui:Button>
                </twig:block>
                <twig:Ui:DataTable :caption="'party.tab.addresses'|trans" :columns="[{key: 'type', label: 'party.column.type'|trans}, {key: 'label', label: 'party.column.label'|trans}, {key: 'address', label: 'party.column.address'|trans}]" :rows="addressRows" :actionToken="token" />
            </twig:Ui:Card>
        {% elseif tab == 'bank-accounts' %}
            {% set addAccount = path('app_contact_account_new', {id: id}) %}
            <twig:Ui:Card :title="'party.tab.bank-accounts'|trans" icon="landmark">
                <twig:block name="actions">
                    {% if accountRows is not empty %}
                        <twig:Ui:Button :href="addAccount" size="sm" icon="plus" id="contact-account-add" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'party.accounts.add'|trans }}</twig:Ui:Button>
                    {% endif %}
                </twig:block>
                {% if accountRows is empty %}
                    <twig:Ui:EmptyState icon="landmark" :title="'party.accounts.empty'|trans" :text="'party.accounts.empty_text'|trans" class="py-10">
                        <twig:Ui:Button :href="addAccount" variant="primary" icon="plus" id="contact-account-add" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'party.accounts.add'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% else %}
                    <twig:Ui:DataTable :caption="'party.tab.bank-accounts'|trans" :columns="[{key: 'iban', label: 'party.column.iban'|trans}, {key: 'bic', label: 'party.column.bic'|trans}, {key: 'label', label: 'party.column.label'|trans}, {key: 'primary', label: 'party.column.primary'|trans}]" :rows="accountRows" :actionToken="token" />
                {% endif %}
            </twig:Ui:Card>
        {% elseif tab == 'history' %}
            {% if timeline is empty %}
                <twig:Ui:EmptyState icon="history" :title="'party.history.empty'|trans" />
            {% else %}
                <twig:Ui:Card :title="'party.tab.history'|trans" icon="history">
                    <twig:Ui:Timeline :items="timeline" data-party-history />
                </twig:Ui:Card>
            {% endif %}
        {% else %}
            {# A module's tab: its own page fragment, loaded into the contact (Foresi\Party\Contract\ContactTabs). #}
            <turbo-frame id="{{ constant('Foresi\\Party\\Contract\\ContactTabs::FRAME') }}" src="{{ contributed }}" loading="lazy" target="_top" data-contact-tab="{{ tab }}"></turbo-frame>
        {% endif %}
    </div>
{% endblock %}
