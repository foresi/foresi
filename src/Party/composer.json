{
    "name": "foresi/party",
    "description": "Address book of people and organisations.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "require": {
        "foresi/audit": "*",
        "foresi/instance": "*",
        "foresi/shared": "*",
        "foresi/ui": "*"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Party\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "party",
            "kind": "core",
            "namespace": "Foresi\\Party\\",
            "bundle": "Foresi\\Party\\PartyBundle",
            "optional": [
                "import"
            ],
            "scopes": [
                "contacts"
            ]
        }
    }
}
