{#
    Add a change: one status from a day on, until the next of its kind. It loads in place of the
    statuses in their dialog (layout/record.html.twig); Save and Cancel go back to them. The change is
    one choice, grouped by kind, so no script has to swap the values; sickness insurance that is on
    also takes its monthly base. The same URL is a page. Variables: values, errors, choices.
#}
{% extends '@Ui/layout/record.html.twig' %}

{% set record_overlay = 'dialog' %}
{% set record_size = 'sm' %}
{% set record_fields = true %}
{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'taxes.profile.title'|trans, href: path('app_taxes_profile')}, {label: 'taxes.profile.statuses'|trans, href: path('app_taxes_profile_statuses')}, {label: 'taxes.profile.status.new'|trans}] %}

{% block title %}{{ 'taxes.profile.status.new'|trans }}{% endblock %}

{% block content %}
    <div class="grid max-w-2xl gap-4">
        <p class="m-0 text-small text-muted">{{ 'taxes.profile.status.description'|trans }}</p>
        <form method="post" id="taxes-status-form" action="{{ path('app_taxes_profile_status_new') }}" class="grid gap-4" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\TaxesAndContributions\\Infrastructure\\Controller\\ProfileController::TOKEN')) }}">
            <twig:Ui:Select name="change" id="change" :label="'taxes.profile.field.change'|trans" :options="choices" :value="values.change" :error="errors.change is defined ? errors.change|trans : null" />
            <twig:Ui:TextInput name="validFrom" id="validFrom" type="date" :label="'taxes.profile.field.valid_from'|trans" :help="'taxes.profile.field.valid_from_help'|trans" :value="values.validFrom" :error="errors.validFrom is defined ? errors.validFrom|trans : null" />
            <twig:Ui:TextInput name="base" id="base" :label="'taxes.profile.field.base'|trans" :help="'taxes.profile.field.base_help'|trans" :value="values.base" :error="errors.base is defined ? errors.base|trans : null" inputmode="decimal" autocomplete="off" />
        </form>
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_taxes_profile_statuses')" data-in-place>{{ 'taxes.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="taxes-status-form" variant="primary">{{ 'taxes.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
