{#
    The owner profile under Money → Taxes and contributions, for the owner only (B7). The statuses change
    a few times in a firm's life, so they are one line of what holds today, and "Statuses" in the page
    header opens their dated list in a dialog, where a change is added; a year names the changes that
    fall in it. The years are the content: each has three sections (expenses; children, credits and
    deductions; other details), each opening its form in the side sheet, each authority its account
    in a small dialog (docs/design/overlays.md). Variables: summary, years, authorities.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'taxes.title'|trans, href: path('app_taxes')}, {label: 'taxes.profile.title'|trans}] %}
{% set token = csrf_token(constant('Foresi\\TaxesAndContributions\\Infrastructure\\Controller\\ProfileController::TOKEN')) %}
{# A row is one link stretched over it, so its focus ring is the row's edge, not a box around the
   link's words (the ring that came back around "Expenses" on closing the sheet). #}
{% set focus = 'outline-none after:rounded-panel focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-green' %}

{% block title %}{{ 'taxes.profile.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button icon="history" :href="path('app_taxes_profile_statuses')" data-dialog aria-haspopup="dialog" data-taxes-statuses-open>{{ 'taxes.profile.statuses'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <div class="grid gap-6">
        <div class="grid max-w-3xl gap-1">
            <p class="m-0 text-small text-muted">{{ 'taxes.profile.description'|trans }}</p>
            <p class="m-0 text-text" data-taxes-status-summary>
                <span class="font-medium text-ink">{{ 'taxes.profile.statuses'|trans }}:</span>
                {% if summary is not empty %}{{ summary|join(' · ') }}{% else %}<span class="text-muted">{{ 'taxes.profile.summary.no_statuses'|trans }}</span>{% endif %}
            </p>
        </div>

        <section class="grid gap-3" aria-labelledby="taxes-years" data-taxes-years>
            <h2 id="taxes-years" class="m-0 text-h3 font-semibold text-ink">{{ 'taxes.profile.years'|trans }}</h2>
            {% for year in years %}
                <div class="grid gap-2" data-taxes-year="{{ year.year }}">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h3 class="m-0 text-small font-semibold text-ink">{{ 'taxes.profile.year.title'|trans({year: year.year}) }}</h3>
                        {% if year.changes is not empty %}<span class="text-small text-muted" data-taxes-year-changes>{{ year.changes|join(' · ') }}</span>{% endif %}
                    </div>
                    <ul class="m-0 grid list-none gap-2 p-0">
                        {% for part in year.sections %}
                            <li class="relative flex min-h-row-list flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-panel border border-container bg-white px-4 py-2" data-taxes-year-section="{{ part.section }}">
                                <a href="{{ part.href }}" data-sheet aria-haspopup="dialog" class="font-medium text-ink no-underline after:absolute after:inset-0 hover:text-green {{ focus }}">{{ part.title }}<span class="sr-only"> {{ 'taxes.profile.year.title'|trans({year: year.year}) }}</span></a>
                                <span class="text-small text-muted">{{ part.summary }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </section>

        <section class="grid gap-3" aria-labelledby="taxes-authorities" data-taxes-authorities>
            <h2 id="taxes-authorities" class="m-0 text-h3 font-semibold text-ink">{{ 'taxes.profile.authorities'|trans }}</h2>
            <p class="m-0 text-small text-muted">{{ 'taxes.profile.authorities_note'|trans }}</p>
            <ul class="m-0 grid list-none gap-2 p-0">
                {% for authority in authorities %}
                    <li class="relative flex min-h-row-list flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-panel border border-container bg-white px-4 py-2" data-taxes-authority="{{ authority.authority }}">
                        <a href="{{ authority.href }}" data-dialog aria-haspopup="dialog" class="font-medium text-ink no-underline after:absolute after:inset-0 hover:text-green {{ focus }}">{{ authority.title }}</a>
                        {% if authority.account %}
                            <span class="text-small text-text">{{ authority.account }}{% if authority.variableSymbol %} · {{ 'taxes.profile.authority.vs'|trans({symbol: authority.variableSymbol}) }}{% endif %}</span>
                        {% else %}
                            <span class="text-small text-muted">{{ 'taxes.profile.authority.not_set'|trans }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}
