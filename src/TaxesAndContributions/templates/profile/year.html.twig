{#
    The inputs of one year, a form in the side sheet over the profile (docs/design/overlays.md); the
    same URL is a page of its own. The expense methods to compare and the chosen one, the children and
    the spouse claimed, the deductions, the other partial bases, the last known tax, the previous year
    and the return route. One blank child follows those claimed; a child left blank is not saved.
    Variables: year, values, errors, methods, deductionTypes, routes.
#}
{% extends in_dialog() ? '@Ui/layout/sheet.html.twig' : '@Ui/layout/app.html.twig' %}

{% set title = 'taxes.profile.year.title'|trans({year: year}) %}
{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'taxes.profile.title'|trans, href: path('app_taxes_profile')}, {label: title}] %}
{% set sheet_size = 'md' %}
{% set sheet_fields = true %}
{% set sheet_description = 'taxes.profile.year.description'|trans %}
{% set action = path('app_taxes_profile_year', {year: year}) %}

{% block title %}{{ title }}{% endblock %}

{% block sheet_body %}
    <form id="taxes-year-form" method="post" action="{{ action }}" class="grid gap-6" novalidate data-taxes-year-form>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\TaxesAndContributions\\Infrastructure\\Controller\\ProfileController::TOKEN')) }}">
        {% if errors.form is defined %}<twig:Ui:Alert tone="error">{{ errors.form|trans }}</twig:Ui:Alert>{% endif %}

        <twig:Ui:FieldGroup :title="'taxes.profile.year.methods'|trans">
            {% if errors.expenseMethods is defined %}<twig:Ui:Alert tone="error">{{ errors.expenseMethods|trans }}</twig:Ui:Alert>{% endif %}
            {% for method, label in methods %}
                <twig:Ui:Checkbox name="expenseMethods[]" :id="'method-' ~ method" :value="method" :checked="method in values.expenseMethods" :label="label" />
            {% endfor %}
            <twig:Ui:Select name="chosenMethod" id="chosenMethod" :label="'taxes.profile.field.chosen_method'|trans" :options="{'': 'taxes.profile.field.chosen_open'|trans}|merge(methods)" :value="values.chosenMethod" :error="errors.chosenMethod is defined ? errors.chosenMethod|trans : null" />
        </twig:Ui:FieldGroup>

        <twig:Ui:FieldGroup :title="'taxes.profile.year.children_title'|trans">
            {% if errors.children is defined %}<twig:Ui:Alert tone="error">{{ errors.children|trans }}</twig:Ui:Alert>{% endif %}
            {% for child in values.children %}
                {% set i = loop.index0 %}
                <fieldset class="m-0 grid gap-3 border-0 border-t border-divider p-0 pt-3" data-taxes-child>
                    <legend class="sr-only">{{ 'taxes.profile.year.child'|trans({number: loop.index}) }}</legend>
                    <twig:Ui:TextInput :name="'children[' ~ i ~ '][label]'" :id="'child-' ~ i ~ '-label'" :label="'taxes.profile.field.child_label'|trans" :help="loop.first ? 'taxes.profile.field.child_label_help'|trans : null" :value="child.label" autocomplete="off" />
                    <twig:Ui:TextInput :name="'children[' ~ i ~ '][birthDate]'" :id="'child-' ~ i ~ '-birth'" type="date" :label="'taxes.profile.field.birth_date'|trans" :value="child.birthDate" />
                    <twig:Ui:Select :name="'children[' ~ i ~ '][order]'" :id="'child-' ~ i ~ '-order'" :label="'taxes.profile.field.order'|trans" :options="{'1': 'taxes.profile.order.1'|trans, '2': 'taxes.profile.order.2'|trans, '3': 'taxes.profile.order.3'|trans}" :value="child.order" />
                    <twig:Ui:TextInput :name="'children[' ~ i ~ '][months]'" :id="'child-' ~ i ~ '-months'" :label="'taxes.profile.field.months'|trans" :value="child.months" inputmode="numeric" autocomplete="off" />
                    <twig:Ui:Checkbox :name="'children[' ~ i ~ '][ztpP]'" :id="'child-' ~ i ~ '-ztpp'" value="1" :checked="child.ztpP" :label="'taxes.profile.field.ztp_p'|trans" />
                </fieldset>
            {% endfor %}
        </twig:Ui:FieldGroup>

        <twig:Ui:FieldGroup :title="'taxes.profile.year.spouse'|trans">
            <twig:Ui:TextInput name="spouseMonths" id="spouseMonths" :label="'taxes.profile.field.spouse_months'|trans" :help="'taxes.profile.field.spouse_months_help'|trans" :value="values.spouseMonths" :error="errors.spouseMonths is defined ? errors.spouseMonths|trans : null" inputmode="numeric" autocomplete="off" />
            <twig:Ui:Checkbox name="spouseZtpP" id="spouseZtpP" value="1" :checked="values.spouseZtpP" :label="'taxes.profile.field.ztp_p'|trans" />
            <twig:Ui:Checkbox name="spouseLowIncome" id="spouseLowIncome" value="1" :checked="values.spouseLowIncome" :label="'taxes.profile.field.spouse_low_income'|trans" />
        </twig:Ui:FieldGroup>

        <twig:Ui:FieldGroup :title="'taxes.profile.year.deductions'|trans">
            {% if errors.deductions is defined %}<twig:Ui:Alert tone="error">{{ errors.deductions|trans }}</twig:Ui:Alert>{% endif %}
            {% for type in deductionTypes %}
                <twig:Ui:TextInput :name="'deductions[' ~ type ~ ']'" :id="'deduction-' ~ type" :label="('taxes.deduction.' ~ type)|trans" :value="values.deductions[type]|default('')" inputmode="decimal" autocomplete="off" />
            {% endfor %}
        </twig:Ui:FieldGroup>

        <twig:Ui:FieldGroup :title="'taxes.profile.year.bases'|trans">
            {% for name in ['employmentBase', 'employmentTaxWithheld', 'rentalBase', 'otherBase', 'lastKnownTax'] %}
                <twig:Ui:TextInput :name="name" :id="name" :label="('taxes.profile.field.' ~ name)|trans" :value="values[name]" :error="errors[name] is defined ? errors[name]|trans : null" inputmode="decimal" autocomplete="off" />
            {% endfor %}
        </twig:Ui:FieldGroup>

        <twig:Ui:FieldGroup :title="'taxes.profile.year.previous'|trans">
            {% for name in ['previousSocialBase', 'previousHealthBase'] %}
                <twig:Ui:TextInput :name="name" :id="name" :label="('taxes.profile.field.' ~ name)|trans" :value="values[name]" :error="errors[name] is defined ? errors[name]|trans : null" inputmode="decimal" autocomplete="off" />
            {% endfor %}
            <twig:Ui:TextInput name="previousOverviewFiledOn" id="previousOverviewFiledOn" type="date" :label="'taxes.profile.field.previousOverviewFiledOn'|trans" :value="values.previousOverviewFiledOn" :error="errors.previousOverviewFiledOn is defined ? errors.previousOverviewFiledOn|trans : null" />
        </twig:Ui:FieldGroup>

        <twig:Ui:FieldGroup :title="'taxes.profile.year.other'|trans">
            {% set routeChoices = {} %}
            {% for route in routes %}{% set routeChoices = routeChoices|merge({(route): ('taxes.route.' ~ route)|trans}) %}{% endfor %}
            <twig:Ui:Select name="returnRoute" id="returnRoute" :label="'taxes.profile.field.returnRoute'|trans" :options="routeChoices" :value="values.returnRoute" />
            <twig:Ui:TextInput name="activityStart" id="activityStart" type="date" :label="'taxes.profile.field.activityStart'|trans" :help="'taxes.profile.field.activityStart_help'|trans" :value="values.activityStart" :error="errors.activityStart is defined ? errors.activityStart|trans : null" />
            <twig:Ui:TextInput name="averageWageOverride" id="averageWageOverride" :label="'taxes.profile.field.averageWageOverride'|trans" :help="'taxes.profile.field.averageWageOverride_help'|trans" :value="values.averageWageOverride" :error="errors.averageWageOverride is defined ? errors.averageWageOverride|trans : null" inputmode="decimal" autocomplete="off" />
        </twig:Ui:FieldGroup>
    </form>
{% endblock %}

{% block sheet_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'taxes.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="taxes-year-form" variant="primary">{{ 'taxes.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('sheet_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="calendar" class="max-w-3xl">
        <p class="mt-0 mb-4 text-small text-muted">{{ 'taxes.profile.year.description'|trans }}</p>
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-3xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_taxes_profile')">{{ 'taxes.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="taxes-year-form" variant="primary">{{ 'taxes.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
