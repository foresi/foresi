{
    "name": "foresi/taxes-and-contributions",
    "description": "The taxes and contributions of the owner: the owner profile with dated statuses, and the estimate to date and to the year end.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "foresi/audit": "self.version",
        "foresi/exchange-rate": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\TaxesAndContributions\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "taxes-and-contributions",
            "kind": "module",
            "namespace": "Foresi\\TaxesAndContributions\\",
            "bundle": "Foresi\\TaxesAndContributions\\TaxesAndContributionsBundle",
            "optional": [
                "cash-flow",
                "invoicing",
                "purchasing"
            ],
            "scopes": [
                "taxes"
            ]
        }
    }
}
