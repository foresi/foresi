{
    "name": "foresi/deals",
    "description": "Deals with a client, stages, won and lost, lines from the catalog and their one-off and monthly value.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "brick/math": "^1.0",
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/audit": "self.version",
        "foresi/catalog": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/module-api": "^2.0",
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4",
        "symfony/service-contracts": "^3.8",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.8",
        "symfony/uid": "7.4.*",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Deals\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "deals",
            "kind": "module",
            "namespace": "Foresi\\Deals\\",
            "bundle": "Foresi\\Deals\\DealsBundle",
            "optional": [
                "activities",
                "cash-flow",
                "document-templates",
                "invoicing",
                "timesheet",
                "work",
                "inbox",
                "contacts"
            ],
            "scopes": [
                "deals"
            ]
        }
    }
}
