{#
    The contact persons of the deal's client in the deal's dialog: the client's persons to tick, and right
    under them the plain action "Add a person", which reveals in place, in the same fieldset, the same two
    ways as the contact's own dialog: a person from the address book or a new one, linked to the client and
    added to the deal when the deal is saved. The action is a native details/summary styled as a plain link
    (as "Edit" of the invoice's send dialog), hidden once open, so it works without JavaScript; a dialog
    never opens over a dialog. Rendered inside the form, and on its own (GET /sales/deals/client-persons)
    when the client changes (deal-client). A person as the client has no contact persons, so nothing shows
    for one, nor without a client.
    Variables: personsShown, persons (id, name), candidates (by id), person (mode, personId, name, email,
    position), personModes, personOpen, values (contactPersonIds), errors.
#}
{% if personsShown %}
    <fieldset class="m-0 grid min-w-0 gap-2 border-0 p-0" data-deal-persons>
        <legend class="mb-1 p-0 text-small text-ink">{{ 'deals.deal.field.contact_persons'|trans }}</legend>
        {% for contact in persons %}
            <twig:Ui:Checkbox name="contactPersonIds[]" :id="'person-' ~ contact.id" :label="contact.name" :value="contact.id" :checked="contact.id in values.contactPersonIds" />
        {% else %}
            <p class="m-0 text-small text-muted" data-deal-no-persons>{{ 'deals.deal.person.none'|trans }}</p>
        {% endfor %}
        {% if errors.contactPersonIds is defined %}<p class="m-0 text-small text-badge-red-text">{{ errors.contactPersonIds }}</p>{% endif %}
        <details class="min-w-0 [&[open]>summary]:hidden" data-deal-add-person{% if personOpen %} open{% endif %}>
            <summary class="inline-flex min-h-6 w-fit cursor-pointer list-none items-center gap-2 text-small font-medium text-ink hover:text-green [&::-webkit-details-marker]:hidden {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">
                {{- ux_icon('lucide:plus', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) -}}
                <span class="underline underline-offset-2">{{ 'deals.deal.person.add'|trans }}</span>
            </summary>
            <div class="mt-2 grid gap-3">
                <twig:Ui:RadioCards name="personMode" id="personMode" :legend="'deals.deal.person.mode.label'|trans" :options="personModes" :value="person.mode" data-action="change->deal-client#mode" />
                <div class="grid gap-3" data-deal-client-target="existing" data-deal-person-existing>
                    {% if candidates is empty %}
                        <p class="m-0 text-small text-muted" data-no-candidates>{{ 'deals.deal.person.no_candidates'|trans }}</p>
                    {% else %}
                        <twig:Ui:Select name="personId" id="personId" :label="'deals.deal.person.person'|trans" :options="{'': 'deals.deal.person.person_placeholder'|trans}|merge(candidates)" :value="person.personId" :error="errors.personId|default(null)" />
                    {% endif %}
                </div>
                <div class="grid gap-3 sm:grid-cols-2" data-deal-client-target="new" data-deal-person-new>
                    <twig:Ui:TextInput name="personName" id="personName" :label="'deals.deal.person.name'|trans" :value="person.name" :error="errors.personName|default(null)" maxlength="255" autocomplete="off" />
                    <twig:Ui:TextInput name="personEmail" id="personEmail" type="email" :label="'deals.deal.person.email'|trans" :value="person.email" :error="errors.personEmail|default(null)" maxlength="254" autocomplete="off" />
                </div>
                <twig:Ui:TextInput name="personPosition" id="personPosition" :label="'deals.deal.person.position'|trans" :help="'deals.deal.person.position_help'|trans" :value="person.position" :error="errors.personPosition|default(null)" maxlength="100" autocomplete="off" />
            </div>
        </details>
    </fieldset>
{% endif %}
