{#
    A new deal, or one changed. New is a dialog over the list or the contact it was opened from (the client
    then set); Edit is a dialog over the deal, with its title, client, notes, owner and contact persons. The
    client is chosen in a combobox, except when it is fixed: a deal opened from a contact, or a deal linked to
    other deals (a link joins deals of one client). Once the client is known its contact persons and a person
    to add show (_persons), and they reload when the client changes (deal-client). Each URL is a page of its own too.
    Variables: deal (null for a new one), action, values, errors, client (PartySummary or null), clientFixed,
    clientLinked, the variables of _persons, owners (by user id), stages (by id; none for Edit), customValues
    (null for the deal's own) and customErrors of its custom fields, under "Additional details".
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set heading = deal ? 'deals.deal.edit'|trans : 'deals.deal.new'|trans %}
{% set back = deal ? path('app_sales_deal', {id: deal.id}) : path('app_sales_deals') %}
{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'deals.deals.title'|trans, href: path('app_sales_deals')}]|merge(deal ? [{label: deal.title, href: back}] : [])|merge([{label: heading}]) %}
{% set form_invalid = errors is not empty or customErrors|default({}) is not empty %}
{% set dialog_size = 'md' %}

{% block title %}{{ heading }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="deal-form" action="{{ action }}" class="grid gap-4" novalidate data-controller="deal-client" data-deal-client-url-value="{{ path('app_sales_deal_client_persons') }}">
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Deals\\Infrastructure\\Controller\\DealController::TOKEN')) }}">
        <twig:Ui:TextInput name="title" id="title" :label="'deals.deal.field.title'|trans" :placeholder="'deals.deal.field.title_placeholder'|trans" :value="values.title" :error="errors.title|default(null)" maxlength="200" autocomplete="off" required />
        {% if clientFixed and client %}
            {% if not deal %}
                <input type="hidden" name="clientId" value="{{ client.id }}">
                <input type="hidden" name="clientFixed" value="1">
            {% endif %}
            {# Read-only: the label and the client's name as a link to the contact (Ui:Field plain, the link of Ui:Value). #}
            <twig:Ui:Field id="client" :plain="true" :label="'deals.deal.field.client'|trans" :error="errors.clientId|default(null)" data-deal-client>
                {% set clientPage = contact_url(client.id) %}
                <p class="m-0 text-ink">{% if clientPage %}<a href="{{ clientPage }}" data-turbo="false" class="underline decoration-control-line underline-offset-2 hover:decoration-ink {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}" data-deal-client-link>{{ client.displayName }}</a>{% else %}{{ client.displayName }}{% endif %}</p>
                {% if clientLinked %}<p class="m-0 mt-0.5 text-caption text-muted" data-deal-client-linked>{{ 'deals.deal.field.client_linked_help'|trans }}</p>{% endif %}
            </twig:Ui:Field>
        {% else %}
            <div data-action="combobox:pick->deal-client#load combobox:clear->deal-client#clear">
                <twig:Ui:Combobox name="clientId" id="client" textName="clientQuery" :label="'deals.deal.field.client'|trans" :placeholder="'deals.deal.field.client_placeholder'|trans" :value="values.clientId" :text="values.clientQuery" :url="path('app_sales_deal_clients')" :emptyText="'deals.deal.field.client_empty'|trans" :error="errors.clientId|default(null)" required />
            </div>
        {% endif %}
        <div class="contents" data-deal-client-target="persons">{% include '@Deals/deals/_persons.html.twig' %}</div>
        <div class="grid gap-4 sm:grid-cols-2">
            <twig:Ui:Select name="ownerUserId" id="ownerUserId" :label="'deals.deal.field.owner'|trans" :options="owners" :value="values.ownerUserId" :error="errors.ownerUserId|default(null)" />
            {% if stages is not empty %}
                <twig:Ui:Select name="stageId" id="stageId" :label="'deals.deal.field.stage'|trans" :options="stages" :value="values.stageId" :error="errors.stageId|default(null)" />
            {% endif %}
        </div>
        <twig:Ui:Textarea name="description" id="description" :label="'deals.deal.field.description'|trans" :help="'deals.deal.field.description_help'|trans" :value="values.description" :error="errors.description|default(null)" :rows="4" />
        <twig:Ui:CustomFields :record="constant('Foresi\\Deals\\Contract\\Field\\DealExtension::RECORD')" :id="deal ? deal.id : null" :values="customValues|default(null)" :errors="customErrors|default({})" :card="false" :heading="true" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'deals.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="deal-form" variant="primary">{{ (deal ? 'deals.save' : 'deals.deal.create')|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="heading" :icon="deal ? 'pencil' : 'plus'" class="max-w-2xl">{{ body }}</twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="back">{{ 'deals.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="deal-form" variant="primary">{{ (deal ? 'deals.save' : 'deals.deal.create')|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
