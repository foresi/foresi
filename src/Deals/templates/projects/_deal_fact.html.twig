{#
    The deal of a project in the project's header, for Work's ProjectSlots::HEADER_FACTS (DealProjectFacts):
    the deal linked to its page, the hourly line and its rate. Variables: deal, href, line, rate (null for a line without a price).
#}
<p class="m-0" data-project-deal>{{ 'deals.project_fact.label'|trans }}: <a href="{{ href }}" class="font-medium text-ink no-underline hover:underline">{{ deal }}</a> · {{ line }}{% if rate %} · {{ 'deals.value.hourly_rate'|trans({rate: rate}) }}{% endif %}</p>
