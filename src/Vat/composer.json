{
    "name": "foresi/vat",
    "description": "The VAT of the firm: its VAT periods with the due dates from the country's rules and the amounts from its documents and schedules, the flow of each into the cash flow, the bank payments that settle them, and where it pays its VAT.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/audit": "self.version",
        "foresi/exchange-rate": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/module-api": "^2.0",
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.8",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Vat\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "vat",
            "kind": "module",
            "namespace": "Foresi\\Vat\\",
            "bundle": "Foresi\\Vat\\VatBundle",
            "optional": [
                "cash-flow",
                "invoicing",
                "received-documents"
            ],
            "scopes": [
                "vat"
            ]
        }
    }
}
