{#
    Where the firm pays its VAT: the account of its tax office and the variable symbol, which match the
    bank payments to the VAT periods. A small dialog over the VAT page, with what the country suggests
    and where that comes from. Variables: suggestion, values, errors.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set title = 'vat.page.settings'|trans %}
{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'vat.title'|trans, href: path('app_vat')}, {label: title}] %}
{% set dialog_size = 'sm' %}
{% set dialog_description = 'vat.page.settings_form.description'|trans %}
{% set focus = constant('Foresi\\Ui\\Component\\Style::FOCUS') %}

{% block title %}{{ title }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="vat-settings-form" action="{{ path('app_vat_settings') }}" class="grid gap-4" novalidate data-vat-settings-form>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Vat\\Infrastructure\\Controller\\VatController::TOKEN')) }}">
        <twig:Ui:TextInput name="officeAccount" id="officeAccount" :label="'vat.page.settings_form.office_account'|trans" :help="suggestion ? 'vat.page.settings_form.office_account_hint'|trans({hint: suggestion.accountHint}) : null" :value="values.officeAccount" :error="errors.officeAccount is defined ? errors.officeAccount|trans : null" autocomplete="off" />
        <twig:Ui:TextInput name="variableSymbol" id="variableSymbol" :label="'vat.page.settings_form.variable_symbol'|trans" :help="suggestion and suggestion.variableSymbol != '' ? 'vat.page.settings_form.variable_symbol_help'|trans({symbol: suggestion.variableSymbol}) : 'vat.page.settings_form.variable_symbol_help_plain'|trans" :value="values.variableSymbol" :error="errors.variableSymbol is defined ? errors.variableSymbol|trans : null" inputmode="numeric" autocomplete="off" />
        {% if suggestion %}
            <p class="m-0 text-small">
                <a href="{{ suggestion.sourceUrl }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-ink underline decoration-control-line underline-offset-2 hover:decoration-ink {{ focus }}" data-vat-settings-source>{{ ux_icon('lucide:external-link', {class: 'size-3.5 shrink-0 text-muted', 'aria-hidden': 'true'}) }}{{ 'vat.page.settings_form.source'|trans }}<span class="sr-only"> ({{ 'vat.page.settings_form.new_tab'|trans }})</span></a>
            </p>
        {% endif %}
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'vat.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="vat-settings-form" variant="primary">{{ 'vat.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="settings" class="max-w-2xl">
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_vat')">{{ 'vat.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="vat-settings-form" variant="primary">{{ 'vat.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
