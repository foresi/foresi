{#
    The person's calendar feeds: secret addresses for their calendar apps, with name, created and when an
    app last fetched each. A new feed opens in a dialog from the header; each feed's menu has Rename (a
    dialog) and Revoke (asks first). The addresses are never shown here, only once when a feed is made.
    The feeds are a list with views, search, filters, columns and widths (docs/design/list-pages.md,
    rule 8). Variables: feeds, the table ListTable gives.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'calendar.feeds.title'|trans}] %}

{% block title %}{{ 'calendar.feeds.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_calendar_feed_new')" id="calendar-feed-new" data-dialog aria-haspopup="dialog">{{ 'calendar.feeds.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <div class="grid max-w-4xl gap-4">
        <p class="m-0 text-text">{{ 'calendar.feeds.intro'|trans }}</p>
        {% set t = feeds %}
        <section class="grid gap-2" data-calendar-feeds>
            {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: t.tabs, toolbarMore: t.moreViews, toolbarLabel: 'calendar.feeds.views'|trans, toolsFilter: t.id ~ '-filters', toolsSearch: t.search, toolsColumns: {id: t.id ~ '-columns', action: path('app_calendar_feeds')}, picker: t.picker, pinnable: t.pinnable, manageViews: t.manageViews, viewBar: t.viewBar}) }}
            <twig:Ui:FilterBar :id="t.id ~ '-filters'" :search="t.search" :action="path('app_calendar_feeds')" :keep="t.keep"
                :conditions="t.chips" :quick="t.quick" :viewBar="t.viewBar" :builder="t.builder" :empty="t.rows is empty">
            </twig:Ui:FilterBar>
            <twig:Ui:DataTable :caption="'calendar.feeds.title'|trans" :columns="t.columns" :rows="t.rows" :resizable="true" :widthsParam="t.widthsParam" :actionToken="csrf_token(constant('Foresi\\Calendar\\Infrastructure\\Controller\\AccountCalendarController::TOKEN'))">
                <twig:block name="empty">
                    {% if t.filtered or t.view != '' %}
                        <twig:Ui:EmptyState icon="search" :title="'calendar.feeds.empty.filtered_title'|trans">
                            <twig:Ui:Button :href="t.resetHref">{{ 'calendar.feeds.empty.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% else %}
                        <div data-calendar-feeds-empty>
                            <twig:Ui:EmptyState icon="calendar" :title="'calendar.feeds.empty.title'|trans" :text="'calendar.feeds.empty.text'|trans">
                                <twig:Ui:Button variant="primary" icon="plus" :href="path('app_calendar_feed_new')" data-dialog aria-haspopup="dialog">{{ 'calendar.feeds.new'|trans }}</twig:Ui:Button>
                            </twig:Ui:EmptyState>
                        </div>
                    {% endif %}
                </twig:block>
            </twig:Ui:DataTable>
            {{ include('@Ui/components/_view_dialogs.html.twig', {viewBar: t.viewBar, manageViews: t.manageViews}) }}
        </section>
        <p class="m-0 text-caption text-muted" data-calendar-refresh-note>{{ 'calendar.feeds.refresh_note'|trans }}</p>
    </div>
{% endblock %}
