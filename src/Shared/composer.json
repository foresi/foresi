{
    "name": "foresi/shared",
    "description": "Shared kernel: ids, money, mail and infrastructure.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "composer/semver": "^3.4",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/module-api": "^1.0",
        "guzzlehttp/psr7": "^3.2",
        "league/commonmark": "^2.10",
        "mcp/sdk": "^0.9",
        "monolog/monolog": "^3.12",
        "nelmio/api-doc-bundle": "^5.13",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "scheb/2fa-backup-code": "^8.7",
        "scheb/2fa-totp": "^8.7",
        "scheb/2fa-trusted-device": "^8.7",
        "symfony/cache-contracts": "^3.8",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/doctrine-messenger": "^7.4.24",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/mailer": "7.4.*",
        "symfony/mcp-bundle": "^0.15",
        "symfony/messenger": "^7.4.24",
        "symfony/mime": "^7.4 || ^8.0",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "7.4.*",
        "symfony/routing": "^7.4",
        "symfony/service-contracts": "^3.8",
        "symfony/translation-contracts": "^3.8",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/ux-icons": "^3.6",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tecnickcom/tc-lib-pdf": "^8.82.2",
        "twig/twig": "^3.30",
        "zircote/swagger-php": "^7.5"
    },
    "provide": {
        "foresi/module-api": "1.8.0"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Shared\\": ""
        },
        "files": [
            "deprecated.php"
        ],
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "shared",
            "kind": "core",
            "namespace": "Foresi\\Shared\\",
            "bundle": "Foresi\\Shared\\SharedBundle",
            "optional": [],
            "scopes": [
                "views"
            ],
            "config-requires": [
                "doctrine/doctrine-migrations-bundle",
                "guzzlehttp/psr7",
                "scheb/2fa-backup-code",
                "scheb/2fa-totp",
                "scheb/2fa-trusted-device",
                "symfony/doctrine-messenger",
                "symfony/mcp-bundle",
                "symfony/monolog-bundle",
                "symfony/twig-bundle",
                "symfony/ux-icons",
                "symfony/yaml",
                "symfonycasts/tailwind-bundle"
            ]
        }
    }
}
