{
    "name": "foresi/shared",
    "description": "Shared kernel: ids, money, mail and infrastructure.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "league/commonmark": "^2.10",
        "mcp/sdk": "^0.9",
        "monolog/monolog": "^3.12",
        "nelmio/api-doc-bundle": "^5.13",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "^7.4.23",
        "symfony/mime": "^7.4 || ^8.0",
        "symfony/rate-limiter": "7.4.*",
        "symfony/routing": "^7.4",
        "symfony/translation-contracts": "^3.8",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "twig/twig": "^3.30",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Shared\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "shared",
            "kind": "core",
            "namespace": "Foresi\\Shared\\",
            "bundle": "Foresi\\Shared\\SharedBundle",
            "optional": [],
            "scopes": [
                "views"
            ]
        }
    }
}
