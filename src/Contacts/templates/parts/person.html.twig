{#
    Adding a contact person to a company: a small dialog over the contact, and the same form as a
    page of its own. Two ways, chosen at the top: a person already in the address book, or a new one,
    written and linked in one go. The new person has no address of its own.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'contacts.title'|trans, href: path('app_contacts')}, {label: party.displayName, href: cancel}, {label: 'contacts.contacts.add'|trans}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'sm' %}
{% set existing = mode == constant('Foresi\\Contacts\\Infrastructure\\Controller\\ContactPartsController::MODE_EXISTING') %}

{% block title %}{{ 'contacts.contacts.add'|trans }}{% endblock %}

{% block dialog_body %}
    <div class="grid gap-4">
        <twig:Ui:Tabs :items="modes" :label="'contacts.contacts.mode.label'|trans" data-in-place data-person-modes />

        <form method="post" id="contact-person-form" action="{{ action }}" class="grid gap-4" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Contacts\\Infrastructure\\Controller\\ContactPartsController::FORM_TOKEN')) }}">
            <input type="hidden" name="mode" value="{{ mode }}">

            {% if errors.form is defined %}
                <twig:Ui:Alert tone="error" tabindex="-1" data-error-summary :autofocus="true">{{ errors.form }}</twig:Ui:Alert>
            {% endif %}

            {% if existing %}
                {% if candidates is empty %}
                    {% if errors.person is defined %}<twig:Ui:Alert tone="error" data-link-error>{{ errors.person }}</twig:Ui:Alert>{% endif %}
                    <p class="m-0 text-small text-muted" data-no-candidates>{{ 'contacts.contacts.no_candidates'|trans }}</p>
                {% else %}
                    <twig:Ui:Select name="person" id="person" :label="'contacts.contacts.person'|trans" :options="{'': 'contacts.contacts.person_placeholder'|trans}|merge(candidates)" :value="values.person" :error="errors.person|default(null)" required />
                {% endif %}
            {% else %}
                <twig:Ui:TextInput name="name" id="name" :label="'contacts.contacts.name'|trans" :value="values.name" :error="errors.name|default(null)" maxlength="255" autocomplete="off" required />
                <div class="grid gap-4 sm:grid-cols-2">
                    <twig:Ui:TextInput name="email" id="email" type="email" :label="'party.field.email'|trans" :value="values.email" :error="errors.email|default(null)" maxlength="254" autocomplete="off" />
                    <twig:Ui:TextInput name="phone" id="phone" type="tel" :label="'party.field.phone'|trans" :value="values.phone" :error="errors.phone|default(null)" maxlength="64" autocomplete="off" />
                </div>
            {% endif %}

            {% if not existing or candidates is not empty %}
                <twig:Ui:TextInput name="position" id="position" :label="'party.column.position'|trans" :help="'contacts.contacts.position_help'|trans" :value="values.position" :error="errors.position|default(null)" maxlength="100" />
                <twig:Ui:Checkbox name="primary" id="primary" value="1" :label="'contacts.contacts.primary'|trans" :help="'contacts.contacts.primary_help'|trans" :checked="values.primary" />
            {% endif %}
        </form>
    </div>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'party.cancel'|trans }}</twig:Ui:Button>
    {% if not existing or candidates is not empty %}
        <twig:Ui:Button type="submit" form="contact-person-form" variant="primary" icon="user-plus">{{ (existing ? 'contacts.contacts.link' : 'contacts.contacts.create')|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% set form %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="'contacts.contacts.add'|trans" icon="user-plus" class="max-w-2xl">
        {{ form }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="cancel">{{ 'party.cancel'|trans }}</twig:Ui:Button>
            {% if not existing or candidates is not empty %}
                <twig:Ui:Button type="submit" form="contact-person-form" variant="primary" icon="user-plus">{{ (existing ? 'contacts.contacts.link' : 'contacts.contacts.create')|trans }}</twig:Ui:Button>
            {% endif %}
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
