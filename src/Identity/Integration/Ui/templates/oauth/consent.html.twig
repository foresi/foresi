{#
    The consent screen of an OAuth client (ADR 0036), laid out as the consent screens of GitHub,
    Google, Slack and Atlassian: who asks and who vouches for its name, which account signs in and
    where the answer goes, then the access, the whole account first and then each module with its
    resources, each with reading and changing (GitHub: permissions by resource; Atlassian: scopes
    by product; Slack: what the app may view and what it may do). Read access the client asked for
    stays ticked (it is sent as a hidden field), the rest can be changed, as on Cloudflare's
    consent screen. A guest sees the same layout with only the scopes a guest may hold (ADR 0041).
#}
{% extends '@Ui/layout/auth.html.twig' %}

{% set form_invalid = error is not null %}

{% block title %}{{ 'oauth.consent.title'|trans({client: client.name}) }}{% endblock %}

{% macro level(row, label, resource) %}
    {% if row is null %}
        <span aria-hidden="true"></span>
    {% else %}
        {% set id = 'scope-' ~ row.value|replace({':': '-'}) %}
        {% if row.required %}
            <input type="hidden" name="scopes[]" value="{{ row.value }}">
            <twig:Ui:Checkbox name="" :id="id" :value="row.value" :label="label" :checked="true" :disabled="true" />
        {% else %}
            <twig:Ui:Checkbox name="scopes[]" :id="id" :value="row.value" :label="label" :checked="row.checked" />
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro resource(item, idPrefix) %}
    {% import _self as consent %}
    {% set labelId = idPrefix ~ '-label' %}
    {# Fixed columns, so reading and changing line up in every row, also where one is not offered. #}
    <div role="group" aria-labelledby="{{ labelId }}" class="grid grid-cols-[minmax(0,1fr)_4.5rem_5rem] items-center gap-x-3 py-2">
        <span id="{{ labelId }}" class="min-w-0 text-small text-ink">{{ item.label }}</span>
        {{ consent.level(item.read, 'oauth.consent.read'|trans) }}
        {{ consent.level(item.write, 'oauth.consent.write'|trans) }}
    </div>
{% endmacro %}

{% block content %}
    {% import _self as consent %}
    <div class="grid gap-5">
        {# Who asks, and who vouches for that name. #}
        <div class="flex items-center gap-3">
            <twig:Ui:Avatar :name="client.name" size="lg" />
            <div class="grid min-w-0 gap-1">
                <p class="m-0 truncate font-semibold text-ink">{{ client.name }}</p>
                <p class="m-0">
                    {% if verifiedHost %}
                        <twig:Ui:Badge tone="green">{{ ux_icon('lucide:badge-check', {class: 'mr-1 size-3.5', 'aria-hidden': 'true'}) }}{{ 'oauth.consent.verified_badge'|trans({host: verifiedHost}) }}</twig:Ui:Badge>
                    {% else %}
                        <twig:Ui:Badge tone="amber">{{ 'oauth.consent.unverified_badge'|trans }}</twig:Ui:Badge>
                    {% endif %}
                </p>
            </div>
        </div>

        <p class="m-0 text-small text-text">{{ 'oauth.consent.intro'|trans({client: client.name}) }}</p>

        {% if verifiedHost %}
            <p class="m-0 text-small text-muted">{{ 'oauth.consent.verified'|trans({host: verifiedHost}) }}</p>
        {% else %}
            <twig:Ui:Alert tone="warning">{{ 'oauth.consent.unverified'|trans }}</twig:Ui:Alert>
        {% endif %}

        {# Which account signs in and where the answer goes (Google: the account chip; GitHub: "will redirect to"). #}
        {% set facts = [] %}
        {% if person %}
            {% set facts = facts|merge([{label: 'oauth.consent.account'|trans, value: person.displayName, note: guest ? 'oauth.consent.guest'|trans({email: person.email}) : person.email}]) %}
        {% endif %}
        {% set facts = facts|merge([{label: 'oauth.consent.redirect'|trans, value: redirectHost}]) %}
        <twig:Ui:DescriptionList :items="facts" class="rounded-control border border-container px-3 py-2.5 text-small" />

        {% if not canConnect %}
            <twig:Ui:Alert tone="warning">
                <span>{{ 'oauth.consent.two_factor'|trans }}</span>
                <a href="{{ path(constant('Foresi\\Identity\\Integration\\Ui\\Controller\\TwoFactorSetupController::SETUP_ROUTE')) }}" data-turbo="false" class="ml-1 font-semibold text-current underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">{{ 'api_tokens.two_factor.link'|trans }}</a>
            </twig:Ui:Alert>
        {% endif %}

        {# The answer redirects to the client, another site or an app: never through Turbo. #}
        <form method="post" id="oauth-consent" action="{{ path('oauth_authorize') }}" class="grid gap-4" data-turbo="false" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Identity\\Integration\\Ui\\OAuth\\OAuthAuthorizeController::TOKEN')) }}">
            {% for name, value in parameters %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}

            {% if error %}<twig:Ui:Alert tone="error">{{ error }}</twig:Ui:Alert>{% endif %}

            {% if canConnect %}
                <fieldset class="m-0 grid gap-2 border-0 p-0">
                    <legend class="mb-1 p-0 text-small font-semibold text-ink">{{ 'oauth.consent.access'|trans }}</legend>
                    <p class="m-0 text-caption text-muted">{{ 'oauth.consent.access_help'|trans }} {{ 'oauth.consent.asked_read'|trans }}</p>

                    {% if access.account.read or access.account.write %}
                        <div class="rounded-control border border-container px-3">
                            {{ consent.resource({label: 'oauth.consent.account_all'|trans, read: access.account.read, write: access.account.write}, 'access-all') }}
                        </div>
                    {% endif %}

                    {% if access.modules is not empty %}
                        {% set modules %}
                            <div class="rounded-control border border-container px-3">
                                {% for module in access.modules %}
                                    {% set moduleId = 'access-' ~ loop.index %}
                                    {% if module.resources|length == 1 %}
                                        <div class="border-b border-divider last:border-b-0">
                                            {{ consent.resource(module.resources|first, moduleId) }}
                                        </div>
                                    {% else %}
                                        <div role="group" aria-labelledby="{{ moduleId }}-module" class="border-b border-divider py-1 last:border-b-0">
                                            <p id="{{ moduleId }}-module" class="m-0 pt-2 text-caption font-semibold uppercase tracking-wide text-muted">{{ module.label }}</p>
                                            {% for resource in module.resources %}
                                                <div class="pl-3">{{ consent.resource(resource, moduleId ~ '-' ~ loop.index) }}</div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endset %}
                        {% if access.account.read or access.account.write %}
                            <twig:Ui:Disclosure :label="'oauth.consent.by_module'|trans" :open="byModuleOpen" class="mt-2">{{ modules }}</twig:Ui:Disclosure>
                        {% else %}
                            {{ modules }}
                        {% endif %}
                    {% endif %}
                </fieldset>
            {% endif %}

            <p class="m-0 text-caption text-muted">{{ 'oauth.consent.revoke'|trans }}</p>

            <div class="grid gap-2">
                {% if canConnect %}
                    <twig:Ui:Button type="submit" name="decision" value="allow" variant="primary" class="w-full">{{ 'oauth.consent.allow'|trans }}</twig:Ui:Button>
                {% endif %}
                <twig:Ui:Button type="submit" name="decision" value="deny" class="w-full">{{ 'oauth.consent.deny'|trans }}</twig:Ui:Button>
            </div>
        </form>
    </div>
{% endblock %}
