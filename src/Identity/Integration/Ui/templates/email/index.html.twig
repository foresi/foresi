{#
    The person's sign-in e-mail, in the security part of their account. Change e-mail opens a dialog
    from the header after "Confirm it's you"; a change waiting for its link shows here with Cancel
    change beside it in the header (GitHub, Pipedrive).
    Variables: email, pending (the address waiting, or null), expiresAt (formatted, in the firm's time zone).
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'email.title'|trans}] %}

{% block title %}{{ 'email.title'|trans }}{% endblock %}

{% block actions %}
    {% if pending %}
        <form method="post" action="{{ path('app_account_email_cancel') }}" class="contents" data-email-cancel>
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Identity\\Integration\\Ui\\Controller\\EmailController::TOKEN')) }}">
            <twig:Ui:Button type="submit" icon="x" id="email-cancel">{{ 'email.cancel_change'|trans }}</twig:Ui:Button>
        </form>
    {% endif %}
    <twig:Ui:Button variant="primary" icon="mail" :href="path('app_account_email_change')" id="email-change" data-dialog aria-haspopup="dialog">{{ 'email.change'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <div class="grid max-w-2xl gap-4" data-email>
        {% if pending %}
            <twig:Ui:Alert tone="info" data-email-pending>{{ 'email.pending'|trans({email: pending, time: expiresAt}) }}</twig:Ui:Alert>
        {% endif %}
        <twig:Ui:Card>
            <p class="m-0 mb-4 text-small text-muted">{{ 'email.intro'|trans }}</p>
            <twig:Ui:DescriptionList :items="[
                {label: 'email.field.email'|trans, value: email},
                {label: 'email.field.after'|trans, value: 'email.field.after_value'|trans},
            ]" />
        </twig:Ui:Card>
    </div>
{% endblock %}
