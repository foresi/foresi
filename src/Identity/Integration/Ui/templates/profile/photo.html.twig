{#
    The person's photo in a dialog over the profile: choose a file, move and zoom it in the square with
    the circle the avatar shows, save. With JavaScript the browser sends the square the person cropped;
    without it the server takes the middle square. Remove photo, when there is one, is a form of its
    own and brings the initials back (GitHub, Linear). The same URL is a page of its own.
    Variables: user (Foresi\Identity\Domain\User), error.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set title = 'profile.photo_title'|trans %}
{% set crumbs = [{label: 'profile.title'|trans, href: path('app_account_profile')}, {label: title}] %}
{% set form_invalid = error is not null %}
{% set dialog_size = 'md' %}
{% set token = csrf_token(constant('Foresi\\Identity\\Integration\\Ui\\Controller\\ProfileController::TOKEN')) %}
{% set fileClass = 'py-0.5 pl-0.5 file:mr-3 file:h-control-sm file:cursor-pointer file:rounded-sm file:border-0 file:bg-badge-gray file:px-2.5 file:text-small file:font-medium file:text-ink' %}

{% block title %}{{ title }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="profile-photo-form" action="{{ path('app_account_profile_photo') }}" enctype="multipart/form-data" class="grid gap-4" novalidate data-controller="photo-crop" data-photo-crop-side-value="{{ constant('Foresi\\Identity\\Application\\UserPhotos::SIDE') }}">
        <input type="hidden" name="_token" value="{{ token }}">
        <twig:Ui:TextInput type="file" name="photo" id="photo" :label="'profile.field.photo'|trans" :help="'profile.field.photo_help'|trans" :error="error" accept="image/jpeg,image/png,image/webp" required :class="fileClass" data-photo-crop-target="input" data-action="change->photo-crop#load" />
        <div class="grid justify-items-center gap-3" data-photo-crop-target="editor" hidden>
            <div class="relative size-64 max-w-full touch-none overflow-hidden rounded-panel bg-frame" data-action="pointerdown->photo-crop#grab pointermove->photo-crop#drag pointerup->photo-crop#drop pointercancel->photo-crop#drop">
                <canvas class="size-full cursor-move" width="512" height="512" data-photo-crop-target="canvas" aria-label="{{ 'profile.photo_preview'|trans }}" role="img"></canvas>
                {# The circle the avatar shows; what lies outside it is dimmed. #}
                <svg class="pointer-events-none absolute inset-0 size-full fill-ink/50" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path fill-rule="evenodd" d="M0 0H100V100H0Z M50 0A50 50 0 1 0 50 100A50 50 0 1 0 50 0Z" /></svg>
            </div>
            <label class="grid w-64 max-w-full gap-1 text-small text-ink" for="photo-zoom">
                {{ 'profile.photo_zoom'|trans }}
                <input type="range" id="photo-zoom" min="1" max="4" step="0.01" value="1" class="w-full accent-green" data-photo-crop-target="zoom" data-action="input->photo-crop#draw">
            </label>
            <p class="m-0 text-caption text-muted">{{ 'profile.photo_drag'|trans }}</p>
        </div>
    </form>
    {% if user.photoVersion %}
        <form method="post" id="profile-photo-remove" action="{{ path('app_account_profile_photo_remove') }}" hidden>
            <input type="hidden" name="_token" value="{{ token }}">
        </form>
    {% endif %}
{% endblock %}

{% block dialog_footer %}
    {% if user.photoVersion %}
        <twig:Ui:Button type="submit" form="profile-photo-remove" variant="ghost" class="mr-auto" data-profile-photo-remove>{{ 'profile.remove_photo'|trans }}</twig:Ui:Button>
    {% endif %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'profile.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="profile-photo-form" variant="primary">{{ 'profile.save_photo'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="upload" class="max-w-2xl">
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            {% if user.photoVersion %}
                <twig:Ui:Button type="submit" form="profile-photo-remove" variant="ghost" class="mr-auto">{{ 'profile.remove_photo'|trans }}</twig:Ui:Button>
            {% endif %}
            <twig:Ui:Button :href="path('app_account_profile')">{{ 'profile.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="profile-photo-form" variant="primary">{{ 'profile.save_photo'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
