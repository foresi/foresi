{#
    The owner changes the role of a person, the contact they represent (a guest needs one) and their
    hourly rate. A person is a small record: a modal over the people (docs/design/overlays.md); the
    same URL is a page of its own.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'people.title'|trans, href: path('app_people')}, {label: person.displayName}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'md' %}

{% block title %}{{ 'people.edit_title'|trans({name: person.displayName}) }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="person-form" action="{{ action }}" class="grid gap-3 sm:grid-cols-2" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Identity\\Infrastructure\\Controller\\PeopleController::TOKEN')) }}">
        <twig:Ui:TextInput id="email" :label="'people.field.email'|trans" :value="person.email" readonly />
        <twig:Ui:Select name="role" id="role" :label="'people.field.role'|trans" :help="'people.field.role_help'|trans" :options="roles" :value="values.role" :error="errors.role|default(null)" />
        <div class="sm:col-span-2"><twig:Ui:Combobox name="contactId" id="contact" textName="contactQuery" width="long" :label="'people.field.contact'|trans" :help="'people.field.contact_edit_help'|trans" :placeholder="'people.field.contact_placeholder'|trans" :value="values.contactId" :text="values.contactQuery" :url="path('app_people_contacts')" :emptyText="'people.field.contact_empty'|trans" :error="errors.contact|default(null)" /></div>
        <twig:Ui:TextInput name="rate" id="rate" inputmode="decimal" maxlength="20" :label="'people.field.rate'|trans" :help="'people.field.rate_help'|trans" :value="values.rate" :error="errors.rate|default(null)" autocomplete="off" />
        <twig:Ui:Select name="rateCurrency" id="rate-currency" :label="'people.field.rate_currency'|trans" :options="currencies" :value="values.rateCurrency" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'people.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="person-form" variant="primary">{{ 'people.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <div class="grid max-w-4xl gap-4">
        <twig:Ui:Card :title="'people.edit_card'|trans" icon="user">
            {{ body }}
        </twig:Ui:Card>
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_people')">{{ 'people.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="person-form" variant="primary">{{ 'people.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
