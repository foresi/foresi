{#
    How to connect Claude and other MCP clients to this installation: the server's address, a
    copy-ready setup for each client, a first prompt that checks the connection, what the access
    means and how to keep it safe. Clients sign in with OAuth (ADR 0036): they open Foresi in the
    browser, where the person signs in and approves the access on a consent screen. A token in the
    Authorization header remains for scripts and clients without OAuth; it is <token> here, and the
    window of a new token shows the Claude Code command with the real one. docs/mcp.md says the
    same at length. Variables: canIssue, server, scopes (scope => label).
#}
{#
    How to connect Claude and other MCP clients to this installation: the server's address, a
    copy-ready setup for each client, a first prompt that checks the connection, what the access of a
    token means and how to keep it safe. The token itself is <token> here; the window of a new token
    shows the Claude Code command with the real one. docs/mcp.md says the same at length.
    Variables: canIssue, server, setup (the setup file for an agent), scopes (scope => label).
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'api_tokens.title'|trans, href: path('app_api_tokens')}, {label: 'api_tokens.tab.connect'|trans}] %}

{% block title %}{{ 'api_tokens.title'|trans }}{% endblock %}

{% block actions %}
    {% if canIssue %}<twig:Ui:Button variant="primary" icon="plus" :href="path('app_api_token_new')" id="api-token-new" data-dialog aria-haspopup="dialog">{{ 'api_tokens.new'|trans }}</twig:Ui:Button>{% endif %}
{% endblock %}

{% block content %}
    {% set token = '<token>' %}
    {% set header = 'Authorization: Bearer ' ~ token %}
    {% set claudeCode = 'claude mcp add --transport http foresi ' ~ server %}
    {% set cursor = {mcpServers: {foresi: {url: server}}} %}
    {% set vscode = {servers: {foresi: {type: 'http', url: server}}} %}
    {% set tokenClaudeCode = claudeCode ~ ' --header "' ~ header ~ '"' %}
    {% set tokenDesktop = {mcpServers: {foresi: {command: 'npx', args: ['-y', 'mcp-remote', server, '--header', 'Authorization:${FORESI_AUTH}'], env: {FORESI_AUTH: 'Bearer ' ~ token}}}} %}
    {% set tokenCursor = {mcpServers: {foresi: {url: server, headers: {Authorization: 'Bearer ' ~ token}}}} %}
    {% set tokenVscode = {inputs: [{type: 'promptString', id: 'foresi-token', description: 'Foresi API token', password: true}], servers: {foresi: {type: 'http', url: server, headers: {Authorization: 'Bearer ${input:foresi-token}'}}}} %}
    {% set json = constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') %}

    <div class="mb-4">{% include '@Identity/api/_tabs.html.twig' with {active: 'connect'} only %}</div>
    {% if not canIssue %}
        <twig:Ui:Alert tone="warning" class="mb-4" data-api-token-two-factor>
            <span>{{ 'api_tokens.two_factor.text'|trans }}</span>
            <a href="{{ path(constant('Foresi\\Identity\\Infrastructure\\Controller\\TwoFactorSetupController::SETUP_ROUTE')) }}" class="ml-1 font-semibold text-current underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">{{ 'api_tokens.two_factor.link'|trans }}</a>
        </twig:Ui:Alert>
    {% endif %}
    <div class="grid max-w-3xl gap-6" data-api-connect>
        <twig:Ui:Card>
            <div class="grid gap-4">
                <p class="m-0 text-text">{{ 'api_tokens.connect.intro'|trans }}</p>
                <twig:Ui:CodeBlock id="mcp-server" :label="'api_tokens.connect.server'|trans" :code="server" />
                <section aria-labelledby="api-connect-steps-title" class="grid gap-2">
                    <h2 id="api-connect-steps-title" class="m-0 text-heading font-semibold text-ink">{{ 'api_tokens.connect.steps.title'|trans }}</h2>
                    <ol class="m-0 grid list-decimal gap-1 pl-5 text-text">
                        <li>{{ 'api_tokens.connect.steps.client'|trans }}</li>
                        <li>{{ 'api_tokens.connect.steps.sign_in'|trans }}</li>
                        <li>{{ 'api_tokens.connect.steps.check'|trans }}</li>
                    </ol>
                </section>
            </div>
        </twig:Ui:Card>

        <twig:Ui:Card :title="'api_tokens.connect.install.title'|trans" data-mcp-install>
            <div class="grid gap-3">
                <p class="m-0 text-text">{{ 'api_tokens.connect.install.text'|trans }}</p>
                <twig:Ui:CodeBlock id="mcp-install" :label="'api_tokens.connect.install.title'|trans" :code="'api_tokens.connect.install.prompt'|trans({url: setup})" :wrap="true" />
                <p class="m-0 text-small text-muted">{{ 'api_tokens.connect.install.file'|trans }} <a href="{{ setup }}" class="font-medium text-green underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">{{ setup }}</a></p>
            </div>
        </twig:Ui:Card>

        <section aria-labelledby="api-connect-clients-title" class="grid gap-3">
            <h2 id="api-connect-clients-title" class="m-0 text-heading font-semibold text-ink">{{ 'api_tokens.connect.clients'|trans }}</h2>
            {{ _self.clients('api_tokens.connect.client.', [
                {key: 'claude_code', snippets: [{id: 'mcp-claude-code', text: claudeCode, language: 'bash'}]},
                {key: 'claude_ai', snippets: [{id: 'mcp-claude-ai-url', label: 'api_tokens.connect.server'|trans, text: server}]},
                {key: 'cursor', snippets: [{id: 'mcp-cursor', text: cursor|json_encode(json), language: 'json'}]},
                {key: 'vscode', snippets: [{id: 'mcp-vscode', text: vscode|json_encode(json), language: 'json'}]},
            ]) }}
        </section>

        <section aria-labelledby="api-connect-token-title" class="grid gap-3" data-api-connect-token>
            <h2 id="api-connect-token-title" class="m-0 text-heading font-semibold text-ink">{{ 'api_tokens.connect.token.title'|trans }}</h2>
            <p class="m-0 text-text">{{ 'api_tokens.connect.token.text'|trans }}</p>
            {{ _self.clients('api_tokens.connect.token.client.', [
                {key: 'claude_code', snippets: [{id: 'mcp-token-claude-code', text: tokenClaudeCode, language: 'bash'}]},
                {key: 'desktop', snippets: [{id: 'mcp-claude-desktop', text: tokenDesktop|json_encode(json), language: 'json'}]},
                {key: 'cursor', snippets: [{id: 'mcp-token-cursor', text: tokenCursor|json_encode(json), language: 'json'}]},
                {key: 'vscode', snippets: [{id: 'mcp-token-vscode', text: tokenVscode|json_encode(json), language: 'json'}]},
                {key: 'other', snippets: [{id: 'mcp-other', label: 'api_tokens.connect.token.header'|trans, text: header}]},
            ], 'token-') }}
        </section>

        <twig:Ui:Card :title="'api_tokens.connect.check.title'|trans">
            <div class="grid gap-3">
                <p class="m-0 text-text">{{ 'api_tokens.connect.check.text'|trans }}</p>
                <twig:Ui:CodeBlock id="mcp-prompt" :label="'api_tokens.connect.check.title'|trans" :code="'api_tokens.connect.check.prompt'|trans" :wrap="true" />
            </div>
        </twig:Ui:Card>

        <twig:Ui:Card :title="'api_tokens.connect.scopes.title'|trans">
            <div class="grid gap-3">
                <p class="m-0 text-text">{{ 'api_tokens.connect.scopes.text'|trans }}</p>
                <p class="m-0 text-text">{{ 'api_tokens.connect.scopes.hint'|trans }}</p>
                <h3 class="m-0 text-small font-semibold text-ink">{{ 'api_tokens.connect.scopes.list'|trans }}</h3>
                <ul class="m-0 flex flex-wrap gap-1.5 p-0" role="list" data-api-scopes>
                    {% for label in scopes %}<li class="list-none"><twig:Ui:Badge tone="gray">{{ label }}</twig:Ui:Badge></li>{% endfor %}
                </ul>
            </div>
        </twig:Ui:Card>

        <twig:Ui:Card :title="'api_tokens.connect.safety.title'|trans">
            <ul class="m-0 grid list-disc gap-1 pl-5 text-text">
                {% for key in ['consent', 'secret', 'approve', 'injection', 'disconnect', 'revoke'] %}<li>{{ ('api_tokens.connect.safety.' ~ key)|trans }}</li>{% endfor %}
            </ul>
            <p class="m-0 mt-3 text-small text-muted">{{ 'api_tokens.connect.docs'|trans }}: <a href="https://github.com/foresi/foresi/blob/main/docs/mcp.md" class="font-medium text-green underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">docs/mcp.md</a>, <a href="https://github.com/foresi/foresi/blob/main/docs/api.md" class="font-medium text-green underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">docs/api.md</a></p>
        </twig:Ui:Card>
    </div>
{% endblock %}

{# One card for each client: its name, what to do and the copy-ready setup. #}
{% macro clients(prefix, clients, data = '') %}
    {% for client in clients %}
        {% set title = (prefix ~ client.key ~ '.title')|trans %}
        <twig:Ui:Card :title="title" data-mcp-client="{{ data ~ client.key }}">
            <div class="grid gap-3">
                <p class="m-0 text-text">{{ (prefix ~ client.key ~ '.text')|trans }}</p>
                {% for snippet in client.snippets %}
                    <twig:Ui:CodeBlock :id="snippet.id" :label="snippet.label ?? title" :code="snippet.text" :language="snippet.language ?? 'text'" />
                {% endfor %}
            </div>
        </twig:Ui:Card>
    {% endfor %}
{% endmacro %}
