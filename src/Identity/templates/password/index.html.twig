{#
    The person's password, in the security part of their account. Change password opens a dialog
    from the header (Google Account, GitHub).
    Variables: email, twoFactor.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'password.title'|trans}] %}

{% block title %}{{ 'password.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="key-round" :href="path('app_account_password_change')" id="password-change" data-dialog aria-haspopup="dialog">{{ 'password.change'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <div class="grid max-w-2xl gap-4" data-password>
        <twig:Ui:Card>
            <p class="m-0 mb-4 text-small text-muted">{{ 'password.intro'|trans }}</p>
            <twig:Ui:DescriptionList :items="[
                {label: 'password.field.email'|trans, value: email},
                {label: 'password.field.password'|trans, value: 'password.field.password_value'|trans, note: 'password.field.password_note'|trans},
                {label: 'password.field.after'|trans, value: (twoFactor ? 'password.field.after_value_two_factor' : 'password.field.after_value')|trans},
            ]" />
        </twig:Ui:Card>
    </div>
{% endblock %}
