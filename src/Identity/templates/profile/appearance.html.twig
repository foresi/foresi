{#
    The person's appearance, the size of the text and the density of the rows, in a dialog over the
    profile; the same URL is a page of its own (ABRA Flexi, Vzhled: per user, for the whole app).
    Variables: textSize, density, textSizes and densities (RadioCards options), errors (field => message).
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set title = 'profile.appearance_title'|trans %}
{% set crumbs = [{label: 'profile.title'|trans, href: path('app_account_profile')}, {label: title}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'md' %}

{% block title %}{{ title }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="appearance-form" action="{{ path('app_account_profile_appearance') }}" class="grid gap-5" novalidate data-appearance-form>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Identity\\Infrastructure\\Controller\\ProfileController::TOKEN')) }}">
        <twig:Ui:RadioCards name="textSize" id="textSize" :legend="'profile.field.text_size'|trans" :options="textSizes" :value="textSize" :error="errors.textSize|default(null)" />
        <twig:Ui:RadioCards name="density" id="density" :legend="'profile.field.density'|trans" :options="densities" :value="density" :error="errors.density|default(null)" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'profile.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="appearance-form" variant="primary">{{ 'profile.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="sliders-horizontal" class="max-w-2xl">
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_account_profile')">{{ 'profile.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="appearance-form" variant="primary">{{ 'profile.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
