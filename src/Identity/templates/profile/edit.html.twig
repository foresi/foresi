{#
    The person's name and language, in a dialog over the profile; the same URL is a page of its own.
    Variables: name, language, languages (code => label), errors (field => message).
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set title = 'profile.edit_title'|trans %}
{% set crumbs = [{label: 'profile.title'|trans, href: path('app_account_profile')}, {label: title}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'md' %}

{% block title %}{{ title }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="profile-form" action="{{ path('app_account_profile_edit') }}" class="grid gap-4" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Identity\\Infrastructure\\Controller\\ProfileController::TOKEN')) }}">
        <twig:Ui:TextInput name="displayName" id="displayName" :label="'profile.field.name'|trans" :value="name" :error="errors.displayName|default(null)" maxlength="255" required autocomplete="name" />
        <twig:Ui:Select name="language" id="language" :label="'profile.field.language'|trans" :options="languages" :value="language" :error="errors.language|default(null)" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'profile.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="profile-form" variant="primary">{{ 'profile.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="user" class="max-w-2xl">
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_account_profile')">{{ 'profile.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="profile-form" variant="primary">{{ 'profile.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
