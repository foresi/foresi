{
    "name": "foresi/identity",
    "description": "People, sign-in, memberships and roles.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/audit": "self.version",
        "foresi/instance": "self.version",
        "foresi/module-api": "^3.0",
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "scheb/2fa-bundle": "^8.7",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/event-dispatcher-contracts": "^3.8",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "^7.4.24",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/password-hasher": "^7.4",
        "symfony/rate-limiter": "7.4.*",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-core": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/security-http": "^7.4",
        "symfony/service-contracts": "^3.8",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.8",
        "symfony/validator": "7.4.*",
        "tecnickcom/tc-lib-barcode": "^2.17.2",
        "twig/twig": "^3.30",
        "zircote/swagger-php": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Identity\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "identity",
            "kind": "core",
            "namespace": "Foresi\\Identity\\",
            "bundle": "Foresi\\Identity\\IdentityBundle",
            "optional": [
                "ui"
            ],
            "scopes": [
                {
                    "resource": "profile",
                    "guest": "write"
                }
            ]
        }
    }
}
