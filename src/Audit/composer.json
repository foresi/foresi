{
    "name": "foresi/audit",
    "description": "Audit log of changes to records.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/module-api": "^2.0",
        "foresi/shared": "self.version",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Audit\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "audit",
            "kind": "core",
            "namespace": "Foresi\\Audit\\",
            "bundle": "Foresi\\Audit\\AuditBundle",
            "optional": []
        }
    }
}
