{
    "name": "foresi/audit",
    "description": "Audit log of changes to records.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "foresi/instance": "self.version",
        "foresi/shared": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Audit\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "audit",
            "kind": "core",
            "namespace": "Foresi\\Audit\\",
            "bundle": "Foresi\\Audit\\AuditBundle",
            "optional": []
        }
    }
}
