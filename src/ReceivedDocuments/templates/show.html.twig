{#
    A received document, as iDoklad and Xero show a bill: the original file on the left, its values on
    the right (under it on a narrower screen), the amounts in CZK, the lines as saved and the history
    below; a document without lines of its own is one line per rate, named by its kind. Recording,
    saving, the trash, a restore and deleting a draft sit in the page header; the trash asks for a
    reason in a dialog, deleting a draft asks first. A save that went through tells its warnings, which
    never stop it; a refusal is told next to its field and in the summary over the form. A row of the
    list opens it in the side sheet (layout/record.html.twig, docs/design/overlays.md); a document
    with lines is a form all the time, so the sheet shows it full screen. Over the values of a draft,
    the reading of its file says where it stands (_reading), with Read again and the rows other modules add
    (PurchasingSlots::DOCUMENT_ACTIONS) in the menu of the page header, and the values it found that the draft does not hold are offered to take.
#}
{% extends '@Ui/layout/record.html.twig' %}

{% set record_fields = true %}
{% set record_full = true %}

{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'received_documents.list.title'|trans, href: path('app_received_documents')}, {label: title}] %}
{% set form_invalid = errors is not empty %}
{% set token = csrf_token(constant('Foresi\\ReceivedDocuments\\Infrastructure\\Controller\\ReceivedDocumentListController::TOKEN')) %}
{% set draft = not document.recorded %}

{% block title %}{{ title }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="document-actions">
        <twig:block name="primary">
            {% if not editable %}
                <form method="post" action="{{ path('app_received_document_restore', {id: document.id}) }}" data-purchasing-restore>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:Button :size="record_action_size" type="submit" icon="archive-restore" variant="primary">{{ 'received_documents.restore'|trans }}</twig:Ui:Button>
                </form>
            {% elseif draft %}
                <twig:Ui:Button :size="record_action_size" type="submit" form="received-document-form" name="_action" value="record" variant="primary" icon="circle-check" data-purchasing-record>{{ 'received_documents.record'|trans }}</twig:Ui:Button>
            {% else %}
                <twig:Ui:Button :size="record_action_size" type="submit" form="received-document-form" name="_action" value="save" variant="primary" data-purchasing-save>{{ 'received_documents.save'|trans }}</twig:Ui:Button>
            {% endif %}
        </twig:block>
        <twig:block name="buttons">{% if editable and draft %}<twig:Ui:Button :size="record_action_size" type="submit" form="received-document-form" name="_action" value="save" data-purchasing-save>{{ 'received_documents.save'|trans }}</twig:Ui:Button>{% endif %}</twig:block>
        <twig:block name="phone">{% if editable and draft %}<twig:Ui:MenuItem type="submit" form="received-document-form" name="_action" value="save">{{ 'received_documents.save'|trans }}</twig:Ui:MenuItem>{% endif %}</twig:block>
        <twig:block name="last">
            {% if editable and draft and reading and reading.retry %}
                <form method="post" action="{{ path('app_received_document_read_again', {id: document.id}) }}" role="none" data-purchasing-read-again>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Ui:MenuItem type="submit" icon="refresh-cw">{{ 'received_documents.reading.again'|trans }}</twig:Ui:MenuItem>
                </form>
                {# Rows of other modules' integrations, such as a reader that runs on request (PurchasingSlots::DOCUMENT_ACTIONS). #}
                {% for item in slot_items(constant('Foresi\\ReceivedDocuments\\Contract\\PurchasingSlots::DOCUMENT_ACTIONS'), {documentId: document.id}) %}
                    {{ include(item.template, item.data|merge({documentId: document.id, token: token})) }}
                {% endfor %}
            {% endif %}
            {% if editable %}
                <twig:Ui:MenuItem icon="trash-2" :href="path('app_received_document_trash', {id: document.id})" data-dialog aria-haspopup="dialog" data-purchasing-trash>{{ 'received_documents.trash.open'|trans }}</twig:Ui:MenuItem>
                {% if draft %}
                    <form method="post" action="{{ path('app_received_document_delete', {id: document.id}) }}" role="none" data-controller="confirm-submit" data-action="submit->confirm-submit#ask"
                        data-confirm-title="{{ 'received_documents.delete.confirm_title'|trans }}" data-confirm-text="{{ 'received_documents.delete.confirm_text'|trans }}"
                        data-confirm-accept="{{ 'received_documents.delete.submit'|trans }}" data-confirm-cancel="{{ 'received_documents.cancel'|trans }}" data-confirm-tone="danger" data-purchasing-delete>
                        <input type="hidden" name="_token" value="{{ token }}">
                        <twig:Ui:MenuItem type="submit" tone="danger" icon="trash-2">{{ 'received_documents.delete.submit'|trans }}</twig:Ui:MenuItem>
                    </form>
                {% endif %}
            {% endif %}
        </twig:block>
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    {% set focus = constant('Foresi\\Ui\\Component\\Style::FOCUS') %}
    {% set notices %}
        {% for message in app.flashes('success') %}<twig:Ui:Alert tone="success" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('warning') %}<twig:Ui:Alert tone="warning" role="status" data-purchasing-warning>{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('error') %}<twig:Ui:Alert tone="error" role="alert">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% if stale %}
            <twig:Ui:Alert tone="error" role="alert" data-reload-prompt>
                <span>{{ 'received_documents.refused.stale'|trans }}</span>
                <a href="{{ path('app_received_document', {id: document.id}) }}" class="ml-1 font-semibold text-current underline underline-offset-2 {{ focus }}">{{ 'received_documents.reload'|trans }}</a>
            </twig:Ui:Alert>
        {% endif %}
        {% if document.trashed %}<twig:Ui:Alert tone="warning" data-purchasing-trashed>{{ 'received_documents.detail.trashed'|trans({reason: document.deletedReason ?? ''}) }}</twig:Ui:Alert>{% endif %}
    {% endset %}
    {% if notices|trim %}<div class="mb-4 grid gap-2">{{ notices }}</div>{% endif %}

    <div class="grid grid-cols-1 gap-4 {{ file ? 'xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]' : '' }}">
        {% if file %}
            <section class="grid content-start gap-2 xl:sticky xl:top-4 xl:self-start" aria-labelledby="original-title" data-purchasing-original>
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h2 id="original-title" class="m-0 text-heading font-semibold text-ink">{{ 'received_documents.detail.original'|trans }}</h2>
                    <a href="{{ file.url }}" download="{{ file.name }}" class="inline-flex items-center gap-1.5 text-small font-medium text-text underline underline-offset-2 {{ focus }}">{{ ux_icon('lucide:download', {class: 'size-4', 'aria-hidden': 'true'}) }}{{ file.name }}</a>
                </div>
                {% if file.preview == 'pdf' %}
                    <iframe src="{{ file.url }}" title="{{ file.name }}" class="block h-dvh max-h-[75vh] w-full rounded-panel border border-container bg-white" data-purchasing-preview="pdf"></iframe>
                {% elseif file.preview == 'image' %}
                    <img src="{{ file.url }}" alt="{{ file.name }}" class="block h-auto max-w-full rounded-panel border border-container" data-purchasing-preview="image">
                {% else %}
                    <p class="m-0 text-small text-muted">{{ 'received_documents.detail.no_preview'|trans }}</p>
                {% endif %}
            </section>
        {% endif %}

        <div class="grid min-w-0 content-start gap-4">
            {% if mailSource %}
                {# The sender's own text, escaped by Twig and with the capture address cut out. #}
                <p class="m-0 break-words text-small text-muted" data-purchasing-mail-source>{{ 'received_documents.detail.from_mail'|trans }}: {{ [mailSource.from, mailSource.subject, mailSource.date]|filter(part => part)|join(', ') }}</p>
            {% endif %}
            {% if draft and reading %}
                {{ include('@ReceivedDocuments/_reading.html.twig') }}
                {% if editable and reading.suggestions is not empty %}
                    <twig:Ui:Card :title="'received_documents.reading.suggestions'|trans" icon="file-text" data-purchasing-suggestions>
                        <form method="post" action="{{ path('app_received_document_accept_reading', {id: document.id}) }}" class="grid gap-3" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input type="hidden" name="version" value="{{ version }}">
                            <p class="m-0 text-small text-muted">{{ 'received_documents.reading.suggestions_help'|trans }}</p>
                            <div class="grid gap-2">
                                {% for suggestion in reading.suggestions %}
                                    <twig:Ui:Checkbox name="fields[]" :id="'reading-' ~ suggestion.field" :value="suggestion.field" :label="suggestion.label ~ ': ' ~ suggestion.value" />
                                {% endfor %}
                            </div>
                            <div><twig:Ui:Button type="submit" size="sm" icon="check">{{ 'received_documents.reading.use_selected'|trans }}</twig:Ui:Button></div>
                        </form>
                    </twig:Ui:Card>
                {% endif %}
            {% endif %}
            <twig:Ui:Card>
                <form method="post" id="received-document-form" action="{{ path('app_received_document', {id: document.id}) }}" class="grid gap-4" novalidate data-turbo="false" data-purchasing-form>
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="version" value="{{ version }}">
                    {{ include('@ReceivedDocuments/_form_errors.html.twig') }}
                    {% if corrected and values.kind == 'credit_note' %}<p class="m-0 text-small text-muted" data-purchasing-corrects>{{ 'received_documents.detail.corrects'|trans({document: corrected}) }}</p>{% endif %}
                    {{ include('@ReceivedDocuments/_fields.html.twig', {contactDialog: true}) }}
                </form>
            </twig:Ui:Card>

            {% set facts = [
                {label: 'received_documents.figures.base_czk'|trans, value: figures.base ?? ''},
                {label: (figures.selfAssessed ? 'received_documents.figures.vat_self_assessed_czk' : 'received_documents.figures.vat_czk')|trans, value: figures.vat ?? ''},
                {label: 'received_documents.figures.total_czk'|trans, value: figures.total ?? '', big: true},
            ]|filter(fact => fact.value != '') %}
            {% if facts is not empty or figures.rows is not empty or deduction.period %}
                <section class="grid gap-2" aria-labelledby="figures-title" data-purchasing-figures>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                        <h2 id="figures-title" class="m-0 text-small font-semibold text-ink">{{ 'received_documents.figures.title'|trans }}</h2>
                        {% if app.request.method == 'POST' %}<p class="m-0 text-caption text-muted">{{ 'received_documents.figures.after_save'|trans }}</p>{% endif %}
                    </div>
                    {% if facts is not empty %}<twig:Ui:FactsGrid :items="facts" />{% endif %}
                    {% if deduction.period %}
                        <p class="m-0 text-small text-muted" data-purchasing-deduction>
                            {{- deduction.latest ? 'received_documents.figures.deduction_until'|trans({period: deduction.period, date: deduction.latest}) : 'received_documents.figures.deduction'|trans({period: deduction.period}) -}}
                        </p>
                    {% endif %}
                    {% if figures.rows is not empty %}
                        {# ARIA table roles, as the sums under the invoice list. #}
                        <div role="table" aria-labelledby="figures-title" tabindex="0" class="overflow-x-auto rounded-panel border border-container bg-white text-small {{ focus }}" data-purchasing-figure-rows>
                            <div role="row" class="grid grid-cols-[minmax(4rem,1fr)_repeat(2,minmax(0,auto))] gap-x-4 bg-head px-4 py-2 text-caption text-muted sm:grid-cols-[minmax(0,1fr)_repeat(2,10rem)]">
                                <span role="columnheader" class="font-medium">{{ 'received_documents.recap.rate'|trans }}</span>
                                <span role="columnheader" class="text-right font-medium">{{ 'received_documents.figures.base_czk'|trans }}</span>
                                <span role="columnheader" class="text-right font-medium">{{ 'received_documents.figures.vat_czk'|trans }}</span>
                            </div>
                            {% for row in figures.rows %}
                                <div role="row" class="grid grid-cols-[minmax(4rem,1fr)_repeat(2,minmax(0,auto))] gap-x-4 border-t border-divider px-4 py-2 sm:grid-cols-[minmax(0,1fr)_repeat(2,10rem)]">
                                    <span role="rowheader" class="num text-ink">{{ row.rate }}</span>
                                    <span role="cell" class="num whitespace-nowrap text-right">{% if row.baseCzk is null %}<twig:Ui:EmptyValue />{% else %}{{ row.baseCzk }}{% endif %}</span>
                                    <span role="cell" class="num whitespace-nowrap text-right">{% if row.vatCzk is null %}<twig:Ui:EmptyValue />{% else %}{{ row.vatCzk }}{% endif %}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            {% endif %}

            {% set foreign = document.currency.code != 'CZK' %}
            {% if lines.rows is not empty %}
                <section class="grid gap-2" aria-labelledby="lines-title" data-purchasing-lines>
                    <h2 id="lines-title" class="m-0 text-small font-semibold text-ink">{{ 'received_documents.lines.title'|trans }}</h2>
                    {% if lines.whole %}<p class="m-0 text-small text-muted">{{ 'received_documents.lines.whole'|trans }}</p>{% endif %}
                    {# The same ARIA table as the rows in CZK above. #}
                    {% set columns = foreign ? 'grid-cols-[minmax(4rem,1fr)_repeat(3,minmax(0,auto))] sm:grid-cols-[minmax(0,1fr)_5rem_repeat(2,10rem)]' : 'grid-cols-[minmax(4rem,1fr)_repeat(2,minmax(0,auto))] sm:grid-cols-[minmax(0,1fr)_5rem_10rem]' %}
                    <div role="table" aria-labelledby="lines-title" tabindex="0" class="overflow-x-auto rounded-panel border border-container bg-white text-small {{ focus }}">
                        <div role="row" class="grid {{ columns }} gap-x-4 bg-head px-4 py-2 text-caption text-muted">
                            <span role="columnheader" class="font-medium">{{ 'received_documents.lines.text'|trans }}</span>
                            <span role="columnheader" class="text-right font-medium">{{ 'received_documents.lines.rate'|trans }}</span>
                            <span role="columnheader" class="text-right font-medium">{{ 'received_documents.lines.base'|trans }}</span>
                            {% if foreign %}<span role="columnheader" class="text-right font-medium">{{ 'received_documents.figures.base_czk'|trans }}</span>{% endif %}
                        </div>
                        {% for line in lines.rows %}
                            <div role="row" class="grid {{ columns }} gap-x-4 border-t border-divider px-4 py-2" data-purchasing-line>
                                <span role="rowheader" class="break-words text-ink">{{ line.text }}</span>
                                <span role="cell" class="num whitespace-nowrap text-right">{{ line.rate }}</span>
                                <span role="cell" class="num whitespace-nowrap text-right">{{ line.base }}</span>
                                {% if foreign %}<span role="cell" class="num whitespace-nowrap text-right">{% if line.baseCzk is null %}<twig:Ui:EmptyValue />{% else %}{{ line.baseCzk }}{% endif %}</span>{% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {# Panels of other modules' integrations, such as the Plan panel of Cash flow (ADR 0038). #}
            {% if document.recorded and not document.trashed %}
                {% for item in slot_items(constant('Foresi\\ReceivedDocuments\\Contract\\PurchasingSlots::DOCUMENT_SECTIONS'), {documentId: document.id}) %}{{ include(item.template, item.data|merge({documentId: document.id})) }}{% endfor %}
            {% endif %}

            <twig:Ui:Card :title="'received_documents.history.title'|trans" icon="history">
                <twig:Ui:Timeline :items="timeline" data-purchasing-history />
            </twig:Ui:Card>
        </div>
    </div>
{% endblock %}
