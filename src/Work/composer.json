{
    "name": "foresi/work",
    "description": "Projects and tasks.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "foresi/attachment": "self.version",
        "foresi/audit": "self.version",
        "foresi/identity": "self.version",
        "foresi/instance": "self.version",
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "foresi/ui": "self.version",
        "openspout/openspout": "^5.12"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Work\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "work",
            "kind": "module",
            "namespace": "Foresi\\Work\\",
            "bundle": "Foresi\\Work\\WorkBundle",
            "optional": [],
            "scopes": [
                {
                    "resource": "projects",
                    "guest": "read"
                },
                {
                    "resource": "tasks",
                    "guest": "write"
                },
                "time_entries"
            ]
        }
    }
}
