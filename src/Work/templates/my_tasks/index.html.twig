{#
    My unfinished tasks, in groups by when they are due, on saved views: All, Assigned to me and Watching,
    and the person's own views; the filter sheet (the client is one of its fields) and the Settings sheet as every
    list has them. A group with nothing in it is left out. The status, the responsible person, the due date
    and the priority change in the row.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.my_tasks.title'|trans}] %}

{% block title %}{{ 'work.my_tasks.title'|trans }}{% endblock %}

{% block actions %}{{ include('@Work/_new_task.html.twig') }}{% endblock %}

{# A change made in a row comes back to this page: Turbo morphs it in place and keeps the scroll. #}
{% block head %}{{ include('@Work/_morph_refresh.html.twig') }}{% endblock %}

{% block content %}
    {{ include('@Work/_flashes.html.twig') }}
    <div class="grid grid-cols-1 gap-4">
        {# The tabs, then the search field and the Filter and Settings icons; the view's unsaved changes are saved from the filter row under them (saved views D10). #}
        {% set search = {name: 'q', value: text ?? '', label: 'work.my_tasks.search_label'|trans} %}
        {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: tabs, toolbarMore: moreViews, toolbarLabel: 'work.my_tasks.views'|trans, toolsFilter: 'my-tasks-filters', toolsSearch: search, toolsColumns: {id: 'my-tasks-columns', action: path('app_my_tasks')}}) }}
        {# The client is a condition of the filter sheet (saved views D11). #}
        <twig:Ui:FilterBar id="my-tasks-filters" :search="search" :action="path('app_my_tasks')" :keep="{view: view != '' ? view : null, f: working != '' ? working : null}|merge(workingQuery)"
            :conditions="chips" :quick="quick" :viewBar="viewBar" :builder="builder" :empty="groups is empty" data-my-tasks-filter>
        </twig:Ui:FilterBar>

        {% for group in groups %}
            <section class="grid gap-2" aria-labelledby="group-{{ group.key }}-title" data-task-group="{{ group.key }}">
                <h2 id="group-{{ group.key }}-title" class="m-0 text-heading font-semibold text-ink">{{ group.name }} <span class="num font-normal text-muted">({{ group.count }})</span></h2>
                <twig:Ui:DataTable :caption="group.name" :columns="columns" :rows="group.rows" :density="density" />
            </section>
        {% else %}
            {% if empty == 'filtered' %}
                <twig:Ui:EmptyState icon="search" :title="'work.my_tasks.empty.filtered_title'|trans" :text="'work.my_tasks.empty.filtered'|trans">
                    <twig:Ui:Button :href="resetHref">{{ 'work.my_tasks.empty.reset'|trans }}</twig:Ui:Button>
                </twig:Ui:EmptyState>
            {% else %}
                <twig:Ui:EmptyState icon="square-check-big" :title="('work.my_tasks.empty.' ~ empty ~ '_title')|trans" :text="('work.my_tasks.empty.' ~ empty ~ '_text')|trans" />
            {% endif %}
        {% endfor %}
    </div>
    {{ include('@Ui/components/_view_dialogs.html.twig') }}
{% endblock %}
