{#
    The time report on saved views, as every list has them: All, This month (where it opens) and Last month,
    the person's own views, "+ Filter" (day, project, client, person, billable, invoiced) and the Display sheet
    of the entries; what the totals add up by is the view's display. Then the sums, the totals and the
    entries, newest first, as Freelo reports and Productive do. The header downloads the entries as CSV with
    the same view and filter. Only the time the person sees is in it. On a phone the tables keep the work and
    the time, with when, who and where under it.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set title = 'work.time.report.title'|trans %}
{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.time.title'|trans, href: path('app_time')}, {label: title}] %}

{% block title %}{{ title }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="time-report-actions">
        <twig:block name="primary">{% if billing %}{% for item in slot_items(constant('Foresi\\Work\\Contract\\TimeBillingActions::REPORT'), {clientId: billing.clientId}) %}{{ include(item.template, item.data) }}{% endfor %}{% endif %}</twig:block>
        {% if not empty %}
            <form method="post" action="{{ path('app_time_report_export') }}" data-turbo="false" role="none" data-time-report-export>
                <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\TimeReportController::TOKEN')) }}">
                {% for name, value in query|filter((value, name) => name in ['view', 'f']) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                <twig:Ui:MenuItem type="submit" icon="download">{{ 'work.time.report.export'|trans }}</twig:Ui:MenuItem>
            </form>
        {% endif %}
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    {{ include('@Work/_flashes.html.twig') }}
    <div class="grid grid-cols-1 gap-4">
        {{ include('@Work/time/_tabs.html.twig', {active: 'report'}) }}

        {# The tabs, then the search, filter and Display icons; the view's unsaved changes are saved from the filter row under them (saved views D10). #}
        <div class="flex flex-wrap items-end gap-x-4 gap-y-2 sm:flex-nowrap">
            <twig:Ui:Tabs :items="tabs" :more="moreViews" :moreLabel="'saved_view.more_views'|trans" :label="'work.time.report.views'|trans" class="min-w-0 flex-1">
                <twig:block name="actions">{{ include('@Ui/components/_view_menu.html.twig') }}</twig:block>
            </twig:Ui:Tabs>
            {{ include('@Ui/components/_list_tools.html.twig', {toolsFilter: 'report-filters', toolsSearch: false, toolsColumns: {id: 'report-columns', action: path('app_time_report')}}) }}
        </div>
        {# The day, the project, the client, the person, billable and invoiced are conditions of "+ Filter" (saved views D11). #}
        <twig:Ui:FilterBar id="report-filters" :collapsible="true" :action="path('app_time_report')" :keep="{view: view, f: working != '' ? working : null}|merge(workingQuery)"
            :conditions="chips" :quick="quick" :viewBar="viewBar" :builder="builder" :empty="empty" data-time-report-filter>
        </twig:Ui:FilterBar>

        <section class="grid gap-3" aria-labelledby="report-range" data-time-report>
            <h2 id="report-range" class="m-0 text-heading font-semibold text-ink">{{ range }}</h2>
            <twig:Ui:KpiStrip :items="kpis" />
            {% if empty %}
                <twig:Ui:EmptyState icon="clock-3" data-time-report-empty :title="'work.time.report.empty_title'|trans" :text="'work.time.report.empty_text'|trans" />
            {% else %}
                <section class="grid gap-2" aria-labelledby="report-totals-title" data-time-report-totals>
                    <div class="flex items-center justify-between gap-3">
                        <h3 id="report-totals-title" class="m-0 text-small font-semibold text-ink">{{ ('work.time.report.totals.' ~ grouping)|trans }}</h3>
                        {# What the totals add up by is the view's display, saved with it as its columns are (D-display-2). #}
                        <twig:Ui:Menu id="report-group" :label="'work.time.report.group'|trans ~ ': ' ~ ('work.time.report.by.' ~ grouping)|trans" size="sm" chevron="down" data-time-report-group>
                            {% for group in groupings %}
                                <twig:Ui:MenuItem :href="group.href" :checked="group.checked" size="sm">{{ group.label }}</twig:Ui:MenuItem>
                            {% endfor %}
                        </twig:Ui:Menu>
                    </div>
                    <twig:Ui:DataTable :caption="('work.time.report.totals.' ~ grouping)|trans" :columns="totalColumns" density="dense" :rows="totalRows" :totals="totalSums" />
                </section>
                <section class="grid gap-2" aria-labelledby="report-entries-title" data-time-report-entries>
                    <h3 id="report-entries-title" class="m-0 text-small font-semibold text-ink">{{ 'work.time.report.entries'|trans }}</h3>
                    <twig:Ui:DataTable :caption="'work.time.report.entries'|trans" :columns="entryColumns" :density="density" :rows="entryRows">
                        <twig:block name="footer">
                            {%- if pages > 1 -%}
                                <span class="num">{{ 'work.time.report.entries_count'|trans({count: entryCount}) }}</span>
                                <twig:Ui:Pagination :page="page" :pages="pages" :baseUrl="baseUrl" />
                            {%- endif -%}
                        </twig:block>
                    </twig:Ui:DataTable>
                </section>
            {% endif %}
        </section>
    </div>
    {{ include('@Ui/components/_view_dialogs.html.twig') }}
{% endblock %}
