{#
    The projects of the organisation on saved views, as every list has them: All (the projects not
    archived) and Archived, the person's own views, the filter sheet and the Settings sheet; with what is left
    of each project. A new project starts in a dialog over the list; without JavaScript the same link is
    a page.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans}] %}

{% block title %}{{ 'work.projects.title'|trans }}{% endblock %}

{% block actions %}
    {{ include('@Work/_new_task.html.twig', {variant: 'secondary'}) }}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_project_new')" id="project-new" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'work.projects.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <div class="grid grid-cols-1 gap-4">
        {# The tabs, then the search field and the Filter and Settings icons; the view's unsaved changes are saved from the filter row under them (saved views D10). #}
        {% set search = {name: 'q', value: text ?? '', label: 'work.projects.search_label'|trans} %}
        {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: tabs, toolbarMore: moreViews, toolbarLabel: 'work.projects.views'|trans, toolsFilter: 'project-filters', toolsSearch: search, toolsColumns: {id: 'project-columns', action: path('app_projects')}}) }}
        {# The client, the visibility and the billing are conditions of the filter sheet (saved views D11). #}
        <twig:Ui:FilterBar id="project-filters" :search="search" :action="path('app_projects')" :keep="{view: view != '' ? view : null, sort: sortKept, f: working != '' ? working : null}|merge(workingQuery)"
            :conditions="chips" :quick="quick" :viewBar="viewBar" :builder="builder" :empty="rows is empty">
        </twig:Ui:FilterBar>

        <twig:Ui:DataTable :caption="'work.projects.title'|trans" :columns="columns" :rows="rows" :density="density">
            <twig:block name="empty">
                {% if filtered %}
                    <twig:Ui:EmptyState icon="search" :title="'work.projects.empty.filtered_title'|trans">
                        <twig:Ui:Button :href="resetHref">{{ 'work.projects.empty.reset'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% elseif view == '' %}
                    <twig:Ui:EmptyState icon="columns-3" :title="'work.projects.empty.title'|trans" :text="'work.projects.empty.text'|trans">
                        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_project_new')" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'work.projects.new'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% else %}
                    <twig:Ui:EmptyState :icon="view == 'archived' ? 'archive' : 'columns-3'" :title="emptyTitle" />
                {% endif %}
            </twig:block>
        </twig:Ui:DataTable>
    </div>
    {{ include('@Ui/components/_view_dialogs.html.twig') }}
{% endblock %}
