{#
    A new section of a project: its name. It goes to the end of the sections. A dialog over the
    settings; the same URL is a page of its own. A missing name or a refusal is told here.
#}
{% extends in_dialog() ? 'layout/dialog.html.twig' : 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans, href: path('app_projects')}, {label: project.name, href: path('app_project', {id: project.id})}, {label: 'work.settings.title'|trans, href: path('app_project_settings', {id: project.id})}, {label: 'work.settings.add_section'|trans}] %}
{% set form_invalid = error is not null %}
{% set dialog_size = 'sm' %}

{% block title %}{{ 'work.settings.add_section'|trans }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="section-new-form" action="{{ path('app_project_section_add', {id: project.id}) }}" class="grid gap-4" novalidate data-settings-section-new>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\ProjectSettingsController::TOKEN')) }}">
        <twig:Ui:TextInput name="name" id="section-name" :label="'work.settings.section_name'|trans" :value="name" :error="error" maxlength="120" required autocomplete="off" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'work.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="section-new-form" variant="primary">{{ 'work.settings.add_section'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set form %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="'work.settings.add_section'|trans" icon="columns-3" class="max-w-2xl">
        {{ form }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_project_settings', {id: project.id})">{{ 'work.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="section-new-form" variant="primary">{{ 'work.settings.add_section'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
