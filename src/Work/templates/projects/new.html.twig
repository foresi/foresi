{#
    A new project: its name, the client it is for, what it is about and its custom fields, with what other modules add
    to the form (ProjectSlots::NEW_FORM). It starts with the simple workflow, changed later in its settings. A dialog over the projects; the same URL is a page of its own.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans, href: path('app_projects')}, {label: 'work.projects.new'|trans}] %}
{% set form_invalid = errors is not empty or customErrors|default({}) is not empty %}
{% set dialog_size = 'md' %}

{% block title %}{{ 'work.projects.new'|trans }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="project-form" action="{{ path('app_project_new') }}" class="grid gap-4" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\ProjectController::TOKEN')) }}">

        {% if errors is not empty %}
            {# A problem of no field takes the focus itself; otherwise the first field to fix does. #}
            {% set fieldErrors = errors|filter((message, field) => field != 'form') %}
            <twig:Ui:Alert tone="error" tabindex="-1" data-error-summary :autofocus="fieldErrors is empty">
                <p class="m-0 mb-1 font-semibold">{{ 'work.project.errors_title'|trans }}</p>
                <ul class="m-0 grid list-none gap-0.5 p-0">
                    {% for field, message in errors %}
                        <li>
                            {%- if field == 'form' %}{{ message }}
                            {%- else %}<a href="#{{ field }}" class="text-current underline underline-offset-2 {{ constant('Foresi\\Ui\\Component\\Style::FOCUS') }}">{{ ('work.project.field.' ~ field)|trans }}</a>: {{ message }}
                            {%- endif -%}
                        </li>
                    {% endfor %}
                </ul>
            </twig:Ui:Alert>
        {% endif %}

        <twig:Ui:TextInput name="name" id="name" :label="'work.project.field.name'|trans" :value="values.name" :error="errors.name|default(null)" maxlength="200" required autocomplete="off" />
        {# The client, only where the address book is installed (Work's Contacts integration). #}
        {% if clientPicker %}{{ include('@Work/projects/_client_field.html.twig') }}{% endif %}
        <twig:Ui:Textarea name="description" id="description" :label="'work.project.field.description'|trans" :value="values.description" :rows="3" />
        <twig:Ui:CustomFields :record="constant('Foresi\\Work\\Contract\\Field\\ProjectExtension::RECORD')" :values="customValues|default(null)" :errors="customErrors|default({})" :card="false" :heading="true" />
        {# What other modules add to the form (ProjectSlots::NEW_FORM). #}
        {% for item in formItems|default([]) %}{{ include(item.template, item.data) }}{% endfor %}
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'work.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="project-form" variant="primary">{{ 'work.project.create'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set form %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="'work.projects.new'|trans" icon="columns-3" class="max-w-2xl">
        {{ form }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_projects')">{{ 'work.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="project-form" variant="primary">{{ 'work.project.create'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
