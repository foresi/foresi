{#
    A new change of a project's time budget: the hours, plus or minus, the day it counts from and a note,
    such as who approved the hours. A dialog over the Budget tab it goes back to; the same URL is a page of
    its own. Variables: project, values, errors.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set back = path('app_project', {id: project.id, tab: 'budget'}) %}
{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans, href: path('app_projects')}, {label: project.name, href: back}, {label: 'work.budget.add'|trans}] %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'sm' %}

{% block title %}{{ 'work.budget.add'|trans }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="budget-change-form" action="{{ path('app_project_budget_change_new', {id: project.id}) }}" class="grid gap-4" novalidate data-budget-change-new>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\ProjectBudgetController::TOKEN')) }}">
        {{ include('@Work/_form_errors.html.twig', {prefix: 'budget-change-'}) }}
        <twig:Ui:TextInput name="hours" id="budget-change-hours" :label="'work.budget.field.hours'|trans" :help="'work.budget.field.hours_help'|trans" :value="values.hours" :error="errors.hours|default(null)" inputmode="decimal" required autocomplete="off" />
        <twig:Ui:TextInput type="date" name="effectiveOn" id="budget-change-effectiveOn" :label="'work.budget.field.effective_on'|trans" :value="values.effectiveOn" :error="errors.effectiveOn|default(null)" required />
        <twig:Ui:TextInput name="note" id="budget-change-note" :label="'work.budget.field.note'|trans" :placeholder="'work.budget.field.note_placeholder'|trans" :value="values.note" :error="errors.note|default(null)" maxlength="500" autocomplete="off" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'work.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="budget-change-form" variant="primary">{{ 'work.budget.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set form %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="'work.budget.add'|trans" icon="clock-3" class="max-w-2xl">
        {{ form }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="back">{{ 'work.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="budget-change-form" variant="primary">{{ 'work.budget.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
