{#
    The header actions of a project's list and board: a new task first, then the buttons other modules add
    (ProjectSlots::HEADER_ACTIONS, such as logging time) and sharing, the items they add to "⋯" (such as billing),
    a new recurring task and settings last in it.
#}
{% set shareHref = path('app_sharing', {kind: 'projects', id: project.id, return: app.request.requestUri}) %}
<twig:Ui:MoreActions menuId="project-actions">
    <twig:block name="primary">{% if not project.archivedAt and project.taskable %}{{ newTask }}{% endif %}</twig:block>
    <twig:block name="buttons">
        {% for action in headerActions|default([]) %}{{ include(action.template, action.data|merge({place: 'buttons'})) }}{% endfor %}
        {% if project.shareable %}<twig:Ui:Button icon="share-2" :href="shareHref" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-project-share>{{ 'work.sharing.open'|trans }}</twig:Ui:Button>{% endif %}
    </twig:block>
    <twig:block name="phone">
        {% for action in headerActions|default([]) %}{{ include(action.template, action.data|merge({place: 'phone'})) }}{% endfor %}
        {% if project.shareable %}<twig:Ui:MenuItem icon="share-2" :href="shareHref" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'work.sharing.open'|trans }}</twig:Ui:MenuItem>{% endif %}
    </twig:block>
    {% for action in headerActions|default([]) %}{{ include(action.template, action.data|merge({place: 'menu'})) }}{% endfor %}
    {% if project.manageable and not project.archivedAt %}<twig:Ui:MenuItem icon="refresh-cw" :href="path('app_work_recurring_task_new', {project: project.id})" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-project-recurring-task>{{ 'work.recurring.new'|trans }}</twig:Ui:MenuItem>{% endif %}
    {% if project.manageable %}<twig:Ui:MenuItem icon="settings" :href="path('app_project_settings', {id: project.id})" data-project-settings>{{ 'work.settings.title'|trans }}</twig:Ui:MenuItem>{% endif %}
</twig:Ui:MoreActions>
