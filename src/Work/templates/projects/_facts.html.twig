{#
    The facts under a project's header: its client where the address book is installed (clientFact, the
    template of Work's Contacts integration), then the short facts other modules add through
    ProjectSlots::HEADER_FACTS, each its own template with its data. Variables: project, clientFact, headerFacts, focus.
#}
{% if clientFact or headerFacts is not empty %}
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-small text-muted" data-project-facts>
        {% if clientFact %}
            {{ include(clientFact) }}
        {% endif %}
        {% for fact in headerFacts %}
            <div data-project-fact>{{ include(fact.template, fact.data) }}</div>
        {% endfor %}
    </div>
{% endif %}
