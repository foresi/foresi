{#
    The inbox: one row per task, newest first, the latest event and who did it. "Nové" holds what is
    not done, "Hotové" what is, kept three months; the filter narrows both to mentions or assignments.
    Opening a task reads its row; the links are not prefetched on hover, which would read it too.
#}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'work.notifications.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="notifications-actions">
        <twig:block name="primary">
            {% if unread > 0 %}
                <form method="post" action="{{ readAllUrl }}" data-notifications-read-all>
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\NotificationController::TOKEN')) }}">
                    <twig:Ui:Button type="submit" icon="check">{{ 'work.notifications.read_all'|trans }}</twig:Ui:Button>
                </form>
            {% endif %}
        </twig:block>
        <twig:Ui:MenuItem :href="path('app_notification_settings')" icon="settings" data-notifications-settings>{{ 'work.notifications.settings'|trans }}</twig:Ui:MenuItem>
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 gap-4">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <twig:Ui:Tabs :items="tabs" :label="'work.notifications.views'|trans" class="min-w-0 flex-1" />
            <twig:Ui:FilterBar id="notification-filters" :action="path('app_notifications')" :keep="{tab: done ? 'done' : null}" :empty="rows is empty" class="w-full sm:w-auto" data-notifications-filter
                :filters="[{name: 'filter', label: 'work.notifications.filter.label'|trans, options: filters, value: filter, default: 'all', pinned: true}]" />
        </div>

        {% if done %}<p class="m-0 text-small text-muted" data-notifications-kept>{{ 'work.notifications.kept'|trans }}</p>{% endif %}

        <twig:Ui:DataTable :caption="'work.notifications.title'|trans" :columns="columns" :rows="rows" :actionToken="csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\NotificationController::TOKEN'))" data-notifications data-turbo-prefetch="false">
            <twig:block name="empty">
                {% set empty = done ? 'done' : 'new' %}
                <twig:Ui:EmptyState icon="inbox" :title="('work.notifications.empty.' ~ empty ~ '_title')|trans" :text="(filter != 'all' ? 'work.notifications.empty.filtered' : 'work.notifications.empty.' ~ empty ~ '_text')|trans" data-notifications-empty />
            </twig:block>
            <twig:block name="footer">
                {%- if pages > 1 -%}
                    <span></span>
                    <twig:Ui:Pagination :page="page" :pages="pages" :baseUrl="baseUrl" />
                {%- endif -%}
            </twig:block>
        </twig:Ui:DataTable>
    </div>
{% endblock %}
