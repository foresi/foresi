{#
    The inbox: one row per task, newest first, the latest event and who did it. Its saved views are
    tabs as on every list: "Nové" holds what is not done, "Hotové" what is, kept three months; the
    builder narrows them to mentions, assignments, unread rows or a time. Guests have no saved views,
    so they get the tabs and the filter without the view menu. Opening a task reads its row; the
    links are not prefetched on hover, which would read it too.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% block title %}{{ 'work.notifications.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:MoreActions menuId="notifications-actions">
        <twig:block name="primary">
            {% if unread > 0 %}
                <form method="post" action="{{ readAllUrl }}" data-notifications-read-all>
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\NotificationController::TOKEN')) }}">
                    <twig:Ui:Button type="submit" icon="check">{{ 'work.notifications.read_all'|trans }}</twig:Ui:Button>
                </form>
            {% endif %}
        </twig:block>
        <twig:Ui:MenuItem :href="path('app_notification_settings')" icon="settings" data-notifications-settings>{{ 'work.notifications.settings'|trans }}</twig:Ui:MenuItem>
    </twig:Ui:MoreActions>
{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 gap-4">
        {# The view's unsaved changes sit at the end of its tabs, as on every list (saved views D10). #}
        <div class="flex flex-wrap items-end gap-x-4 gap-y-2 sm:flex-nowrap">
            <twig:Ui:Tabs :items="tabs" :more="moreViews" :moreLabel="'saved_view.more_views'|trans" :label="'work.notifications.views'|trans" class="min-w-0 sm:flex-1">
                <twig:block name="actions">{% if staff %}{{ include('@Ui/components/_view_menu.html.twig') }}{% endif %}</twig:block>
            </twig:Ui:Tabs>
            {% if staff %}{{ include('@Ui/components/_view_actions.html.twig') }}{% endif %}
        </div>
        <twig:Ui:FilterBar id="notification-filters" :action="path('app_notifications')" :keep="{view: view != '' ? view : null, f: working != '' ? working : null}|merge(workingQuery)"
            :conditions="chips" :builder="builder" :empty="rows is empty" data-notifications-filter>
            <twig:block name="end">
                <twig:Ui:ColumnPicker id="notification-columns" :action="path('app_notifications')" :keep="picker.keep" :columns="picker.columns" :density="picker.density" :resetHref="picker.resetHref" :modified="picker.modified" />
            </twig:block>
        </twig:Ui:FilterBar>

        {% if done %}<p class="m-0 text-small text-muted" data-notifications-kept>{{ 'work.notifications.kept'|trans }}</p>{% endif %}

        <twig:Ui:DataTable :caption="'work.notifications.title'|trans" :columns="columns" :rows="rows" :density="density" :actionToken="csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\NotificationController::TOKEN'))" data-notifications data-turbo-prefetch="false">
            <twig:block name="empty">
                {% if filtered %}
                    <twig:Ui:EmptyState icon="search" :title="emptyState.title" :text="'work.notifications.empty.filtered'|trans" data-notifications-empty>
                        <twig:Ui:Button :href="path('app_notifications', view != '' ? {view: view} : {})">{{ 'work.notifications.empty.reset'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% else %}
                    <twig:Ui:EmptyState icon="inbox" :title="emptyState.title" :text="emptyState.text" data-notifications-empty />
                {% endif %}
            </twig:block>
            <twig:block name="footer">
                {%- if pages > 1 -%}
                    <span></span>
                    <twig:Ui:Pagination :page="page" :pages="pages" :baseUrl="baseUrl" />
                {%- endif -%}
            </twig:block>
        </twig:Ui:DataTable>
    </div>
    {% if staff %}{{ include('@Ui/components/_view_dialogs.html.twig') }}{% endif %}
{% endblock %}
