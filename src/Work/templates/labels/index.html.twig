{#
    The labels of the organisation: each with how it looks and how many tasks carry it, as a list with
    views, search, filters, columns and widths (docs/design/list-pages.md, rule 8). A new label and a
    change of one open in a dialog over the list; delete puts it in the trash, which its message undoes.
    The Trash view lists the labels deleted, the last first, with who deleted them and when; each comes
    back on its tasks when restored by its button.
    Variables: labels, the table ListTable gives; trash, whether the Trash view is shown; days.
#}
{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'work.labels.title'|trans}] %}
{% set t = labels %}

{% block title %}{{ 'work.labels.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_label_new')" id="label-new" data-dialog aria-haspopup="dialog">{{ 'work.labels.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {{ include('@Work/_flashes.html.twig') }}
    <div class="grid grid-cols-1 gap-2" data-labels>
        {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: t.tabs, toolbarMore: t.moreViews, toolbarLabel: 'work.labels.views'|trans, toolsFilter: t.id ~ '-filters', toolsSearch: t.search, toolsColumns: {id: t.id ~ '-columns', action: path('app_labels')}, picker: t.picker, pinnable: t.pinnable, manageViews: t.manageViews, viewBar: t.viewBar}) }}
        <twig:Ui:FilterBar :id="t.id ~ '-filters'" :search="t.search" :action="path('app_labels')" :keep="t.keep"
            :conditions="t.chips" :quick="t.quick" :viewBar="t.viewBar" :builder="t.builder" :empty="t.rows is empty">
        </twig:Ui:FilterBar>
        {% if trash %}
            <p class="m-0 text-small text-muted" data-trash-purge>{{ 'work.labels.trash.purge'|trans({days: days}) }}</p>
        {% endif %}
        <twig:Ui:DataTable :caption="'work.labels.title'|trans" :columns="t.columns" :rows="t.rows" :resizable="true" :widthsParam="t.widthsParam" :actionToken="csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\LabelController::TOKEN'))">
            <twig:block name="empty">
                {% if t.filtered %}
                    <twig:Ui:EmptyState icon="search" :title="'work.labels.empty.filtered_title'|trans">
                        <twig:Ui:Button :href="t.resetHref">{{ 'work.labels.empty.reset'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% elseif trash %}
                    <twig:Ui:EmptyState icon="trash-2" :title="'work.trash.empty.title'|trans" :text="'work.labels.trash.empty'|trans" />
                {% elseif t.view == '' %}
                    <twig:Ui:EmptyState icon="tag" :title="'work.labels.empty.title'|trans" :text="'work.labels.empty.text'|trans">
                        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_label_new')" data-dialog aria-haspopup="dialog">{{ 'work.labels.new'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% else %}
                    <twig:Ui:EmptyState icon="search" :title="'work.labels.empty.filtered_title'|trans">
                        <twig:Ui:Button :href="t.resetHref">{{ 'work.labels.empty.reset'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% endif %}
            </twig:block>
        </twig:Ui:DataTable>
        {{ include('@Ui/components/_view_dialogs.html.twig', {viewBar: t.viewBar, manageViews: t.manageViews}) }}
    </div>
{% endblock %}
