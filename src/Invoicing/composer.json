{
    "name": "foresi/invoicing",
    "description": "Issued invoices, credit notes and their delivery.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "require": {
        "foresi/audit": "*",
        "foresi/identity": "*",
        "foresi/instance": "*",
        "foresi/party": "*",
        "foresi/shared": "*",
        "foresi/ui": "*",
        "openspout/openspout": "^5.12",
        "tecnickcom/tc-lib-barcode": "^2.17.2",
        "tecnickcom/tc-lib-pdf": "^8.82.2"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Invoicing\\": ""
        },
        "exclude-from-classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "invoicing",
            "kind": "module",
            "namespace": "Foresi\\Invoicing\\",
            "bundle": "Foresi\\Invoicing\\InvoicingBundle",
            "optional": [
                "cash-flow",
                "taxes-and-contributions"
            ],
            "scopes": [
                "invoices",
                "payments"
            ]
        }
    }
}
