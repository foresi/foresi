{#
    Frame of the public link pages: no application shell, no script (the page's policy allows none),
    and nothing that would start a session. Texts are in the language the page passes as "locale";
    the stylesheet's address comes as "stylesheet", as no script loads it here.
#}
{% extends '@Ui/base.html.twig' %}

{# A customer reads these pages: the title names the issuer the page gives, not the product. #}
{% block document_title %}{{ block('title')|striptags|html_decode|trim }}{% endblock %}

{# Nor does the browser icon: the Foresi mark is not the issuer's, and the page's policy allows no data: image. #}
{% block icon %}{% endblock %}

{% block head %}
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="{{ stylesheet }}">{% endblock %}

{% block javascripts %}{% endblock %}

{% block body %}
    <main class="mx-auto grid min-h-dvh w-full max-w-4xl content-start gap-4 px-[max(1rem,env(safe-area-inset-left,0px),env(safe-area-inset-right,0px))] py-6 sm:gap-5 sm:py-10">
        {% block content %}{% endblock %}
    </main>
{% endblock %}
