{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'invoice.sends.title'|trans}] %}

{% block title %}{{ 'invoice.sends.title'|trans }}{% endblock %}

{% block content %}
    {% if nothingSent %}
        <twig:Ui:EmptyState icon="send" :title="'invoice.sends.empty.title'|trans" :text="'invoice.sends.empty.text'|trans">
            <twig:Ui:Button :href="path('app_invoices')" icon="receipt-text">{{ 'invoice.list.title'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            {# The tabs, then the search field and the Filter and Settings icons; the view's unsaved changes are saved from the filter row under them (saved views D10). #}
            {% set search = {name: 'q', value: text ?? '', label: 'invoice.sends.search_label'|trans} %}
            {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: tabs, toolbarMore: moreViews, toolbarLabel: 'invoice.sends.views'|trans, toolsFilter: 'send-filters', toolsSearch: search, toolsColumns: {id: 'send-columns', action: path('app_invoice_sends')}}) }}
            {# The state and the type of a send are conditions of the filter sheet (saved views D11). #}
            <twig:Ui:FilterBar id="send-filters" :search="search" :action="path('app_invoice_sends')" :keep="{view: view != '' ? view : null, f: working != '' ? working : null}|merge(workingQuery)"
                :conditions="chips" :quick="quick" :viewBar="viewBar" :builder="builder" :empty="rows is empty">
            </twig:Ui:FilterBar>

            <twig:Ui:DataTable :caption="'invoice.sends.title'|trans" :columns="columns" :resizable="true" :rows="rows" data-send-log>
                <twig:block name="empty">
                    <twig:Ui:EmptyState icon="search" :title="'invoice.sends.empty.filtered_title'|trans">
                        <twig:Ui:Button :href="resetHref">{{ 'invoice.sends.empty.reset'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                </twig:block>
                <twig:block name="footer">
                    <span class="num">{{ 'invoice.sends.summary'|trans({total: page.total}) }}</span>
                    <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                </twig:block>
            </twig:Ui:DataTable>
        </div>
        {{ include('@Ui/components/_view_dialogs.html.twig') }}
    {% endif %}
{% endblock %}
