{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'recurring.list.title'|trans}] %}

{% block title %}{{ 'recurring.list.title'|trans }}{% endblock %}

{% block actions %}
    {% if not firstRun %}
        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_recurring_new')" data-turbo="false">{{ 'recurring.form.new_title'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% set messages %}
        {% for message in app.flashes('success') %}<twig:Ui:Alert tone="success" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('warning') %}<twig:Ui:Alert tone="warning" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('error') %}<twig:Ui:Alert tone="error" role="alert">{{ message }}</twig:Ui:Alert>{% endfor %}
    {% endset %}
    {% if messages|trim %}<div class="mb-4 grid gap-2">{{ messages }}</div>{% endif %}

    {% if firstRun %}
        <twig:Ui:EmptyState icon="refresh-cw" :title="'recurring.list.empty.title'|trans" :text="'recurring.list.empty.text'|trans">
            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_recurring_new')" data-turbo="false">{{ 'recurring.form.new_title'|trans }}</twig:Ui:Button>
            <twig:Ui:Button :href="path('app_invoices')">{{ 'recurring.list.empty.from_invoice'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            {# The view's unsaved changes sit at the end of its tabs, as on every list (saved views D10). #}
            <div class="flex flex-wrap items-end gap-x-4 gap-y-2 sm:flex-nowrap">
                <twig:Ui:Tabs :items="tabs" :more="moreViews" :moreLabel="'saved_view.more_views'|trans" :label="'recurring.list.views'|trans" class="min-w-0 sm:flex-1">
                    <twig:block name="actions">{{ include('components/Ui/_view_menu.html.twig') }}</twig:block>
                </twig:Ui:Tabs>
                {{ include('components/Ui/_view_actions.html.twig') }}
            </div>
            <twig:Ui:FilterBar id="recurring-filters" :action="path('app_recurring')" :keep="{view: view != '' ? view : null, sort: sortKept, f: working != '' ? working : null}|merge(workingQuery)"
                :conditions="chips" :builder="builder" :empty="rows is empty">
                <twig:block name="end">
                    <twig:Ui:ColumnPicker id="recurring-columns" :action="path('app_recurring')" :keep="picker.keep" :columns="picker.columns" :density="picker.density" :resetHref="picker.resetHref" :modified="picker.modified" />
                </twig:block>
            </twig:Ui:FilterBar>

            <twig:Ui:DataTable :caption="'recurring.list.title'|trans" :columns="columns" :rows="rows" :density="density">
                <twig:block name="empty">
                    {% if filtered %}
                        <twig:Ui:EmptyState icon="search" :title="'recurring.list.empty.filtered_title'|trans">
                            <twig:Ui:Button :href="path('app_recurring', view != '' ? {view: view} : {})">{{ 'recurring.list.empty.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% else %}
                        <twig:Ui:EmptyState :icon="view == 'failing' ? 'circle-check' : 'refresh-cw'" :title="emptyTitle" />
                    {% endif %}
                </twig:block>
                <twig:block name="footer">
                    <span class="num">{{ 'recurring.list.summary'|trans({total: page.total}) }}</span>
                    <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                </twig:block>
            </twig:Ui:DataTable>
        </div>
        {{ include('components/Ui/_view_dialogs.html.twig') }}
    {% endif %}
{% endblock %}
