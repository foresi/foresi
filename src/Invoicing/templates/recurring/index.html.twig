{% extends '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'recurring.list.title'|trans}] %}

{% block title %}{{ 'recurring.list.title'|trans }}{% endblock %}

{% block actions %}
    {% if not firstRun %}
        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_recurring_new')" data-turbo="false">{{ 'recurring.form.new_title'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% set messages %}
        {% for message in app.flashes('success') %}<twig:Ui:Alert tone="success" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('warning') %}<twig:Ui:Alert tone="warning" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('error') %}<twig:Ui:Alert tone="error" role="alert">{{ message }}</twig:Ui:Alert>{% endfor %}
    {% endset %}
    {% if messages|trim %}<div class="mb-4 grid gap-2">{{ messages }}</div>{% endif %}

    {% if firstRun %}
        <twig:Ui:EmptyState icon="refresh-cw" :title="'recurring.list.empty.title'|trans" :text="'recurring.list.empty.text'|trans">
            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_recurring_new')" data-turbo="false">{{ 'recurring.form.new_title'|trans }}</twig:Ui:Button>
            <twig:Ui:Button :href="path('app_invoices')">{{ 'recurring.list.empty.from_invoice'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            {# The tabs, then the search field and the Filter and Settings icons; the view's unsaved changes are saved from the filter row under them (saved views D10). #}
            {% set search = {name: 'q', value: text ?? '', label: 'recurring.list.search_label'|trans} %}
            {{ include('@Ui/components/_list_toolbar.html.twig', {toolbarTabs: tabs, toolbarMore: moreViews, toolbarLabel: 'recurring.list.views'|trans, toolsFilter: 'recurring-filters', toolsSearch: search, toolsColumns: {id: 'recurring-columns', action: path('app_recurring')}}) }}
            <twig:Ui:FilterBar id="recurring-filters" :search="search" :action="path('app_recurring')" :keep="{view: view != '' ? view : null, sort: sortKept, f: working != '' ? working : null}|merge(workingQuery)"
                :conditions="chips" :quick="quick" :viewBar="viewBar" :builder="builder" :empty="rows is empty">
            </twig:Ui:FilterBar>

            <twig:Ui:DataTable :caption="'recurring.list.title'|trans" :columns="columns" :rows="rows" :density="density" :actionToken="csrf_token(constant('Foresi\\Invoicing\\Infrastructure\\Controller\\RecurringListController::ACTION_TOKEN'))">
                <twig:block name="empty">
                    {% if filtered %}
                        <twig:Ui:EmptyState icon="search" :title="'recurring.list.empty.filtered_title'|trans">
                            <twig:Ui:Button :href="path('app_recurring', view != '' ? {view: view} : {})">{{ 'recurring.list.empty.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% else %}
                        <twig:Ui:EmptyState :icon="view == 'failing' ? 'circle-check' : (view == 'trash' ? 'trash-2' : 'refresh-cw')" :title="emptyTitle" />
                    {% endif %}
                </twig:block>
                <twig:block name="footer">
                    <span class="num">{{ 'recurring.list.summary'|trans({total: page.total}) }}</span>
                    <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                </twig:block>
            </twig:Ui:DataTable>
        </div>
        {{ include('@Ui/components/_view_dialogs.html.twig') }}
    {% endif %}
{% endblock %}
