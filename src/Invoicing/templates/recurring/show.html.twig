{#
    A recurring invoice, read only (layout/record.html.twig): a row of its list opens it in the
    sheet. Edit loads the form in the same sheet, full screen while the lines are edited, and
    Save or Cancel bring this detail back (docs/design/overlays.md).
#}
{% extends '@Ui/layout/record.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'recurring.list.title'|trans, href: path('app_recurring')}, {label: title}] %}
{% set doc = {id: template.id} %}
{% set state = template.state.value %}

{% block title %}{{ title }}{% endblock %}

{% block actions %}
    {% if template.trashed %}
        <form method="post" action="{{ path('app_recurring_restore', doc) }}">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Invoicing\\Infrastructure\\Controller\\RecurringListController::ACTION_TOKEN')) }}">
            <twig:Ui:Button type="submit" variant="primary" icon="archive-restore" :size="record_action_size">{{ 'recurring.list.action.restore'|trans }}</twig:Ui:Button>
        </form>
    {% else %}
    <twig:Ui:MoreActions menuId="recurring-detail-more" :menuSize="record_action_size">
        <twig:block name="primary">
            {% if state != 'ended' %}
                <twig:Ui:Button variant="primary" icon="pencil" :size="record_action_size" :href="path('app_recurring_edit', doc)" data-in-place data-recurring-edit>{{ 'recurring.list.action.edit'|trans }}</twig:Ui:Button>
            {% endif %}
        </twig:block>
        <twig:block name="content">
            {% if state == 'active' %}
                <twig:Ui:MenuItem :href="path('app_recurring_issue_now', doc)" data-dialog aria-haspopup="dialog">{{ 'recurring.list.action.issue_now'|trans }}</twig:Ui:MenuItem>
                <twig:Ui:MenuItem :href="path('app_recurring_pause', doc)" data-dialog aria-haspopup="dialog">{{ 'recurring.list.action.pause'|trans }}</twig:Ui:MenuItem>
            {% elseif state == 'paused' %}
                <twig:Ui:MenuItem :href="path('app_recurring_resume', doc)" data-dialog aria-haspopup="dialog">{{ 'recurring.list.action.resume'|trans }}</twig:Ui:MenuItem>
            {% endif %}
            {% if state != 'ended' %}
                <twig:Ui:MenuItem :href="path('app_recurring_end', doc)" data-dialog aria-haspopup="dialog">{{ 'recurring.list.action.end'|trans }}</twig:Ui:MenuItem>
            {% endif %}
        </twig:block>
        <twig:block name="last">
            {% if not template.issued %}
                <twig:Ui:MenuItem :href="path('app_recurring_delete', doc)" tone="danger" data-dialog aria-haspopup="dialog">{{ 'recurring.list.action.delete'|trans }}</twig:Ui:MenuItem>
            {% endif %}
        </twig:block>
    </twig:Ui:MoreActions>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 gap-4" data-recurring-detail>
        {% set flashes %}
            {% for type, tone in {success: 'success', warning: 'warning', error: 'error'} %}
                {% for message in app.flashes(type) %}<twig:Ui:Alert :tone="tone" :role="type == 'error' ? 'alert' : 'status'">{{ message }}</twig:Ui:Alert>{% endfor %}
            {% endfor %}
        {% endset %}
        {% if flashes|trim %}<div class="grid gap-2">{{ flashes }}</div>{% endif %}
        {% if template.trashed %}<twig:Ui:Alert tone="warning">{{ 'recurring.trash.notice'|trans }}</twig:Ui:Alert>{% endif %}
        {% if failure %}
            <twig:Ui:Alert tone="error" role="alert">
                {{ failure.text }}
                {% if failure.href is defined %}<a href="{{ failure.href }}" class="underline">{{ failure.action }}</a>{% endif %}
            </twig:Ui:Alert>
        {% endif %}

        <div class="flex flex-wrap items-center gap-2" data-recurring-status>
            <twig:Ui:Badge :tone="badge.tone">{{ badge.label }}</twig:Ui:Badge>
        </div>

        <twig:Ui:FactsGrid :items="facts" />

        {% if description %}<p class="m-0 text-text [overflow-wrap:anywhere]">{{ description }}</p>{% endif %}

        {# What other modules add to a line, as a badge under its text and entries of its row menu (InvoicingSlots); the column of the menu is there only when one has an entry. #}
        {% set extras = {} %}
        {% set hasActions = false %}
        {% for line in lines %}
            {% set badges %}{% for item in slot_items(constant('Foresi\\Invoicing\\Contract\\InvoicingSlots::RECURRING_LINE_BADGES'), {templateId: template.id, lineId: line.id}) %}{{ include(item.template, item.data) }}{% endfor %}{% endset %}
            {% set actions %}{% if not template.trashed %}{% for item in slot_items(constant('Foresi\\Invoicing\\Contract\\InvoicingSlots::RECURRING_LINE_ACTIONS'), {templateId: template.id, lineId: line.id}) %}{{ include(item.template, item.data) }}{% endfor %}{% endif %}{% endset %}
            {% set extras = extras|merge({(line.id): {badges: badges, actions: actions}}) %}
            {% if actions|trim %}{% set hasActions = true %}{% endif %}
        {% endfor %}
        <twig:Ui:Card :title="'invoice.card.lines'|trans ~ ' (' ~ lines|length ~ ')'">
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-small" data-recurring-lines>
                    <thead>
                        <tr class="border-b border-divider text-left text-muted">
                            <th scope="col" class="py-2 pr-3 font-medium">{{ 'invoice.line.text'|trans }}</th>
                            <th scope="col" class="py-2 pr-3 text-right font-medium">{{ 'invoice.line.quantity'|trans }}</th>
                            <th scope="col" class="py-2 pr-3 text-right font-medium">{{ 'invoice.line.price'|trans }}</th>
                            <th scope="col" class="py-2 pr-3 text-right font-medium">{{ 'invoice.line.rate'|trans }}</th>
                            <th scope="col" class="py-2 text-right font-medium">{{ 'invoice.line.total'|trans }}</th>
                            {% if hasActions %}<th scope="col" class="w-12 py-2 pl-3 text-right font-medium"><span class="sr-only">{{ 'invoice.line.actions'|trans }}</span></th>{% endif %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-divider">
                        {% for line in lines %}
                            <tr data-recurring-line="{{ line.id }}">
                                <td class="py-2 pr-3 text-ink [overflow-wrap:anywhere]">
                                    {{ line.text }}
                                    {% if extras[line.id].badges|trim %}<div class="mt-1 flex flex-wrap items-center gap-1.5">{{ extras[line.id].badges }}</div>{% endif %}
                                </td>
                                <td class="num whitespace-nowrap py-2 pr-3 text-right">{{ line.quantity }}</td>
                                <td class="num whitespace-nowrap py-2 pr-3 text-right">{{ line.price }}</td>
                                <td class="num whitespace-nowrap py-2 pr-3 text-right">{{ line.rate }}</td>
                                <td class="num whitespace-nowrap py-2 text-right font-medium text-ink">{{ line.total }}</td>
                                {% if hasActions %}
                                    <td class="py-2 pl-3 text-right">
                                        {% if extras[line.id].actions|trim %}
                                            <twig:Ui:Menu id="recurring-line-{{ line.id }}-actions" buttonId="recurring-line-{{ line.id }}-menu" :label="'invoice.line.actions'|trans" icon="ellipsis" :iconOnly="true" variant="ghost" size="sm" :float="true">{{ extras[line.id].actions }}</twig:Ui:Menu>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if totals %}
                <dl class="m-0 ml-auto mt-3 grid w-fit gap-1 text-small" data-recurring-totals>
                    {% if totals.vat %}
                        <div class="flex justify-end gap-6"><dt class="text-muted">{{ 'invoice.total.net'|trans }}</dt><dd class="num m-0 w-32 text-right">{{ totals.net }}</dd></div>
                        <div class="flex justify-end gap-6"><dt class="text-muted">{{ 'invoice.total.vat'|trans }}</dt><dd class="num m-0 w-32 text-right">{{ totals.vat }}</dd></div>
                    {% endif %}
                    {% if totals.rounding %}<div class="flex justify-end gap-6"><dt class="text-muted">{{ 'invoice.total.rounding'|trans }}</dt><dd class="num m-0 w-32 text-right">{{ totals.rounding }}</dd></div>{% endif %}
                    <div class="flex justify-end gap-6 text-heading font-semibold text-ink"><dt>{{ 'invoice.total.payable'|trans }}</dt><dd class="num m-0 w-32 text-right">{{ totals.payable }}</dd></div>
                </dl>
            {% endif %}
        </twig:Ui:Card>
    </div>
{% endblock %}
