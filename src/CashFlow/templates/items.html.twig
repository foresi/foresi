{#
    The items of one cell of the period table, in the side sheet over the Cash flow page, as QuickBooks
    lists the items behind its planner: what each is, a badge for where it comes from (an invoice, a
    recurring invoice, a received document, a plan), the day it is counted on and the amount in its own
    currency. The same URL without the dialog header is a page.
#}
{% extends overlay() == 'sheet' ? '@Ui/layout/sheet.html.twig' : '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'cash_flow.title'|trans, href: path('app_cash_flow')}, {label: title}] %}
{% set sheet_size = 'md' %}

{% block title %}{{ title }}{% endblock %}

{% block sheet_body %}
    {% if items is empty %}
        <p class="m-0 text-small text-muted">{{ 'cash_flow.items.empty'|trans }}</p>
    {% else %}
        <ol class="m-0 grid list-none gap-0 p-0" data-cash-flow-items>
            {% for item in items %}
                <li class="flex min-w-0 items-start gap-3 border-b border-divider py-3 last:border-b-0" data-cash-flow-item>
                    <div class="min-w-0 flex-1">
                        <p class="m-0 truncate font-medium text-ink" title="{{ item.label }}">{{ item.label }}</p>
                        <div class="mt-1 flex flex-wrap items-center gap-1.5 text-caption text-muted">
                            <twig:Ui:Badge tone="gray" data-source>{{ item.source }}</twig:Ui:Badge>
                            <span>{{ item.day }}</span>
                            {% for flag in item.flags %}<twig:Ui:Badge tone="amber">{{ flag }}</twig:Ui:Badge>{% endfor %}
                        </div>
                    </div>
                    <div class="shrink-0 text-right">
                        <p class="num m-0 font-semibold text-ink">{{ item.amount }}</p>
                        {% if item.czk %}<p class="num m-0 text-caption text-muted">{{ item.czk }}</p>{% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
        <p class="mt-3 mb-0 flex items-baseline justify-between gap-3 border-t border-divider pt-3 text-small">
            <span class="font-semibold text-ink">{{ 'cash_flow.items.total'|trans }}</span>
            <span class="num font-semibold text-ink" data-cash-flow-items-total>{{ total }}</span>
        </p>
    {% endif %}
{% endblock %}

{% block content %}
    {% set body %}{{ block('sheet_body') }}{% endset %}
    <twig:Ui:Card :title="title" icon="trending-up" class="max-w-2xl">{{ body }}</twig:Ui:Card>
{% endblock %}
