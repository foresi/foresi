{#
    The items of one cell of the period table, in the side sheet over the Cash flow page, as QuickBooks
    lists the items behind its planner and Fathom opens what makes up a forecast cell in a panel at the
    right: what each is, a badge for how sure it is (a document, a schedule, a plan, or an estimate in
    its own outlined badge), where it comes from when that says more, the day it is counted on (and the
    due day when an expected day moved it) and the amount in its own currency. An item links to its
    record, which opens in place in the same sheet (docs/design/overlays.md); a document sets its
    expected day in the small dialog over the sheet. A record of its own, so the same URL is a page too.
#}
{% extends '@Ui/layout/record.html.twig' %}

{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'cash_flow.title'|trans, href: path('app_cash_flow')}, {label: title}] %}
{% set focus = constant('Foresi\\Ui\\Component\\Style::FOCUS') %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="{{ overlay() is null ? 'max-w-2xl rounded-panel border border-container bg-white px-4' : '' }}">
    {% if items is empty %}
        <p class="m-0 py-3 text-small text-muted">{{ 'cash_flow.items.empty'|trans }}</p>
    {% else %}
        <ol class="m-0 grid list-none gap-0 p-0" data-cash-flow-items>
            {% for item in items %}
                <li class="flex min-w-0 items-start gap-3 border-b border-divider py-3 last:border-b-0" data-cash-flow-item data-subject="{{ item.subject }}">
                    <div class="min-w-0 flex-1">
                        <p class="m-0 truncate font-medium text-ink" title="{{ item.label }}"{% if item.inPlace %} data-in-place{% endif %}>
                            {%- if item.href -%}
                                <a href="{{ item.href }}" class="text-current underline decoration-control-line underline-offset-2 hover:decoration-ink {{ focus }}" data-cash-flow-item-link>{{ item.label }}</a>
                            {%- else -%}
                                {{ item.label }}
                            {%- endif -%}
                        </p>
                        <div class="mt-1 flex flex-wrap items-center gap-1.5 text-caption text-muted">
                            <twig:Ui:Badge :tone="item.certaintyTone" data-certainty>{{ item.certainty }}</twig:Ui:Badge>
                            {% if item.source %}<span data-source>{{ item.source }}</span>{% endif %}
                            <span>{{ item.day }}</span>
                            {% if item.due %}<span data-due>{{ item.due }}</span>{% endif %}
                            {% for flag in item.flags %}<twig:Ui:Badge :tone="flag.tone" data-flag>{{ flag.label }}</twig:Ui:Badge>{% endfor %}
                        </div>
                        {% if item.expected %}
                            <a href="{{ item.expected.href }}" data-dialog aria-haspopup="dialog" class="mt-1.5 inline-flex items-center gap-1 text-caption font-medium text-ink underline decoration-control-line underline-offset-2 hover:decoration-ink {{ focus }}" data-cash-flow-item-expected>{{ ux_icon('lucide:calendar', {class: 'size-3.5 shrink-0 text-muted', 'aria-hidden': 'true'}) }}{{ item.expected.label }}</a>
                        {% endif %}
                    </div>
                    <div class="shrink-0 text-right">
                        <p class="num m-0 font-semibold text-ink">{{ item.amount }}</p>
                        {% if item.czk %}<p class="num m-0 text-caption text-muted">{{ item.czk }}</p>{% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
        <p class="mt-3 mb-0 flex items-baseline justify-between gap-3 border-t border-divider py-3 text-small">
            <span class="font-semibold text-ink">{{ 'cash_flow.items.total'|trans }}</span>
            <span class="num font-semibold text-ink" data-cash-flow-items-total>{{ total }}</span>
        </p>
    {% endif %}
    </div>
{% endblock %}
