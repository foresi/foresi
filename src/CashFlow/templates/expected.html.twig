{#
    When a document is really expected to be paid, as Float and Xero's expected payment date: the day
    replaces the due day in the forecast. Save, and Clear once it is set, which brings the due day back.
#}
{% extends in_dialog() ? '@Ui/layout/dialog.html.twig' : '@Ui/layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'cash_flow.title'|trans, href: path('app_cash_flow')}, {label: 'cash_flow.expected.dialog_title'|trans}] %}
{% set dialog_size = 'sm' %}
{% set dialog_description = due ? 'cash_flow.expected.description'|trans({document: document, due: due}) : 'cash_flow.expected.description_no_due'|trans({document: document}) %}
{% set action = path('app_cash_flow_expected', {type: type, id: id}|merge(view ? {view: view} : {})) %}
{% set back = path('app_cash_flow', view ? {view: view} : {}) %}

{% block title %}{{ 'cash_flow.expected.dialog_title'|trans }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="cash-flow-expected-form" action="{{ action }}" class="grid gap-4" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\CashFlow\\Infrastructure\\Controller\\CashFlowController::EXPECTED_TOKEN')) }}">
        <twig:Ui:TextInput type="date" name="expectedOn" id="expectedOn" :label="'cash_flow.expected.field.day'|trans" :help="'cash_flow.expected.field.day_help'|trans" :value="values.expectedOn" :error="errors.expectedOn|default(null)" required />
    </form>
{% endblock %}

{% block dialog_footer %}
    {% if set %}<twig:Ui:Button type="submit" form="cash-flow-expected-form" name="clear" value="1" variant="danger" class="mr-auto" data-cash-flow-expected-clear>{{ 'cash_flow.expected.clear'|trans }}</twig:Ui:Button>{% endif %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'cash_flow.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="cash-flow-expected-form" variant="primary">{{ 'cash_flow.save'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="'cash_flow.expected.dialog_title'|trans" icon="calendar" class="max-w-2xl">
        <p class="mt-0 mb-4 text-small text-muted">{{ dialog_description }}</p>
        {{ body }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            {% if set %}<twig:Ui:Button type="submit" form="cash-flow-expected-form" name="clear" value="1" variant="danger">{{ 'cash_flow.expected.clear'|trans }}</twig:Ui:Button>{% endif %}
            <twig:Ui:Button :href="back">{{ 'cash_flow.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="cash-flow-expected-form" variant="primary">{{ 'cash_flow.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
