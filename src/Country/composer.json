{
    "name": "foresi/country",
    "description": "Country-specific rules, registers and formats.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "homepage": "https://foresi.app",
    "support": {
        "issues": "https://github.com/foresi/foresi/issues",
        "source": "https://github.com/foresi/foresi"
    },
    "require": {
        "foresi/party": "self.version",
        "foresi/shared": "self.version",
        "psr/clock": "^1.0",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Country\\": ""
        }
    },
    "extra": {
        "foresi": {
            "module": "country",
            "kind": "module",
            "namespace": "Foresi\\Country\\",
            "bundle": "Foresi\\Country\\CountryBundle",
            "optional": [
                "banking",
                "exchange-rate",
                "invoicing",
                "taxes-and-contributions",
                "vat"
            ]
        }
    }
}
