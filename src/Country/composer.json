{
    "name": "foresi/country",
    "description": "Country-specific rules, registers and formats.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "require": {
        "foresi/party": "*",
        "foresi/shared": "*"
    },
    "autoload": {
        "psr-4": {
            "Foresi\\Country\\": ""
        }
    },
    "extra": {
        "foresi": {
            "module": "country",
            "kind": "module",
            "namespace": "Foresi\\Country\\",
            "bundle": "Foresi\\Country\\CountryBundle",
            "optional": [
                "banking",
                "exchange-rate",
                "invoicing"
            ]
        }
    }
}
