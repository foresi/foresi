{#
    The Budget tab of a project (ProjectBudgetFacts, ProjectSlots::SECTIONS): budget, used, left and the sum
    of the task estimates, then the change log, the latest first, as Primavera Unifier keeps budget changes.
    "Counting" and "Add change" open dialogs from the tab's header; a row's menu removes a wrong change.
    For the people of the organisation only. Variables: budget, editable, addHref, countingHref, columns, rows.
#}
<div class="grid gap-4" data-project-budget-section>
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="m-0 text-heading font-semibold text-ink">{{ 'timesheet.budget.title'|trans }}</h2>
        {% if editable %}
            <div class="flex flex-wrap gap-2">
                <twig:Ui:Button icon="settings" size="sm" :href="countingHref" data-dialog aria-haspopup="dialog" data-budget-counting>{{ 'timesheet.budget.counting.open'|trans }}</twig:Ui:Button>
                <twig:Ui:Button variant="primary" icon="plus" size="sm" :href="addHref" data-dialog aria-haspopup="dialog" data-budget-add>{{ 'timesheet.budget.add'|trans }}</twig:Ui:Button>
            </div>
        {% endif %}
    </div>
    {% if budget.budget is not null %}
        <twig:Ui:KpiStrip :items="[
            {label: 'timesheet.budget.kpi.budget'|trans, value: 'timesheet.budget.hours'|trans({hours: budget.budget})},
            {label: ('timesheet.budget.kpi.used_' ~ budget.counting)|trans, value: 'timesheet.budget.hours'|trans({hours: budget.used})},
            {label: 'timesheet.budget.kpi.left'|trans, value: 'timesheet.budget.hours'|trans({hours: budget.left}), badge: budget.over ? {label: 'timesheet.budget.over'|trans, tone: 'amber'} : null},
            {label: 'timesheet.budget.kpi.estimate'|trans, value: 'timesheet.budget.hours'|trans({hours: budget.estimate})},
        ]" data-budget-kpis />
    {% endif %}
    <twig:Ui:DataTable :caption="'timesheet.budget.changes'|trans" :columns="columns" :rows="rows" :actionToken="csrf_token(constant('Foresi\\Timesheet\\Infrastructure\\Controller\\ProjectBudgetController::TOKEN'))" data-budget-changes>
        <twig:block name="empty">
            <twig:Ui:EmptyState icon="clock-3" :title="'timesheet.budget.empty.title'|trans" :text="'timesheet.budget.empty.text'|trans">
                {% if editable %}<twig:Ui:Button variant="primary" icon="plus" :href="addHref" data-dialog aria-haspopup="dialog">{{ 'timesheet.budget.add'|trans }}</twig:Ui:Button>{% endif %}
            </twig:Ui:EmptyState>
        </twig:block>
    </twig:Ui:DataTable>
</div>
