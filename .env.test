# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="sqlite:///:memory:"
# Test only: a fixed, public key that seals nothing real.
MAIL_SECRET_KEYS='test1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='
WEBHOOK_SECRET_KEYS='test1:ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8='
# Test only: the receiving server and the ARC sealer of the synthetic bank mail.
BANK_INBOX_TRUSTED_AUTHSERV=mx.example.com
BANK_INBOX_TRUSTED_ARC=arc.example.com
# Test only: the inbound address template of the synthetic bank inbox.
BANK_INBOX_ADDRESS='bank+{token}@example.com'
# Test only: the bearer secret of the inbound mail webhook.
INBOUND_WEBHOOK_SECRET=test-inbound-secret
# Test only: the receiving servers of the synthetic relay; the tests post most bank mail as it would.
INBOUND_WEBHOOK_TRUSTED_AUTHSERV=mx.example.com,relay.example.net
# Test only: the disk of the machine running the tests is not under test.
HEALTH_DISK_MIN_FREE_PERCENT=0
# Test only: most tests sign in without the two-factor enrolment; its own tests turn it on.
APP_REQUIRE_2FA=false
# Test only: system mail goes nowhere; the tests send it through a recording transport.
SYSTEM_MAILER_DSN=null://null
SYSTEM_MAIL_FROM='Foresi <noreply@example.com>'
