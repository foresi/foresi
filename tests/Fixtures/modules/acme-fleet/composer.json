{
    "name": "acme/fleet",
    "description": "The vehicles of a firm: an example module of another vendor, built on the module API only.",
    "type": "foresi-module",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7.5",
        "foresi/identity": "*",
        "foresi/module-api": "^1.1",
        "foresi/party": "*",
        "foresi/shared": "*",
        "foresi/ui": "*",
        "psr/clock": "^1.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4",
        "symfony/uid": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "Acme\\Fleet\\": ""
        },
        "exclude-from-classmap": [
            "migrations/",
            "tests/"
        ]
    },
    "extra": {
        "foresi": {
            "module": "acme-fleet",
            "kind": "module",
            "namespace": "Acme\\Fleet\\",
            "bundle": "Acme\\Fleet\\AcmeFleetBundle",
            "optional": [],
            "scopes": [
                "acme_fleet_vehicles"
            ]
        }
    }
}
