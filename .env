# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

# Keys that seal the passwords of the firms' mail servers: "id:base64key", comma
# separated, the first is the one in use; older ones only open what they sealed.
# A key is 32 random bytes: php -r 'echo base64_encode(random_bytes(32)), "\n";'
# Empty means no firm can save a mail server. Set it outside committed files.
MAIL_SECRET_KEYS=

# Every user must set up two-factor sign-in (an authenticator app) before
# reaching any page. The TOTP secrets are sealed with MAIL_SECRET_KEYS. Only
# automated tests turn this off; a user who has set it up is always asked.
APP_REQUIRE_2FA=true

# Bank mail polled over IMAP is believed only on the word of the bank inbox's own
# receiving server: the authserv-ids it writes into Authentication-Results, comma
# separated (webhook mail has INBOUND_WEBHOOK_TRUSTED_AUTHSERV below). That
# server must add the header to every message, above all others. Optionally, the
# signing domains (d=) of forwarders whose ARC seal may vouch for a signature
# broken on the way; list the inbox provider too when it seals with ARC on
# receipt. Empty verifies no bank message, so nothing pays an invoice by itself;
# the movements still appear, unverified, and a person pairs them by hand after
# confirming each one in their internet banking. See docs/bank-pairing.md.
BANK_INBOX_TRUSTED_AUTHSERV=
BANK_INBOX_TRUSTED_ARC=

# The inbound address of a bank account, with "{token}" where its secret token
# goes, such as bank+{token}@example.com: an address of the bank inbox, which
# must deliver plus-addressed mail. Empty means bank mail is not set up on this
# server, and no account gets an address.
BANK_INBOX_ADDRESS=

# The bank inbox itself, polled over IMAP every five minutes. Handled mail is moved
# to Foresi/Done, Foresi/Unknown or Foresi/Rejected, never deleted. Encryption is
# ssl (port 993) or starttls (port 143). An empty host turns polling off. Set the
# password outside committed files.
BANK_INBOX_HOST=
BANK_INBOX_PORT=993
BANK_INBOX_ENCRYPTION=ssl
BANK_INBOX_USER=
BANK_INBOX_PASSWORD=
BANK_INBOX_FOLDER=INBOX

# Optional: the bearer secret of POST /inbound/mail, where a relay such as an
# e-mail worker posts raw bank mail. Empty turns the webhook off (404). Use a long
# random value: php -r 'echo bin2hex(random_bytes(32)), "\n";'
INBOUND_WEBHOOK_SECRET=
# The authserv-ids of the relay's own receiving server, comma separated: mail
# posted to the webhook is believed only on its word, never on the bank inbox's
# (BANK_INBOX_TRUSTED_AUTHSERV). The relay must add its own Authentication-Results
# at the top of every message. Empty verifies no webhook mail, so none pays by
# itself; it still appears, unverified, for a person to pair after checking it in
# the bank. See docs/bank-pairing.md.
INBOUND_WEBHOOK_TRUSTED_AUTHSERV=
###> foresi/health ###
# GET /health and bin/console app:health report degraded when less of the disk of
# APP_SHARE_DIR is free, in percent.
HEALTH_DISK_MIN_FREE_PERCENT=5
###< foresi/health ###
###> foresi/operator-alerts ###
# Errors of the production log are mailed to the operator of the installation, at
# most once an hour per distinct message, through this mailer only: never a firm's
# own server. Both empty sends no mail. Check with bin/console app:ops:test-alert.
# See docs/logging.md. Example: smtp://user:pass@smtp.example.com:587
OPERATOR_MAILER_DSN=
OPERATOR_EMAIL=
###< foresi/operator-alerts ###
###> foresi/system-mail ###
# Mail of the installation itself, such as invitations, through this mailer only:
# never a firm's own server. Queued on the mail transport. Either empty sends no
# such mail, and /health reports system_mail as degraded. Check with
# bin/console app:ops:test-mail <to>. Example: smtp://user:pass@smtp.example.com:587
SYSTEM_MAILER_DSN=
# The sender, an address with an optional name: Foresi <noreply@example.com>
SYSTEM_MAIL_FROM=
###< foresi/system-mail ###
