# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Empty (or flock) locks with files in <APP_SHARE_DIR>/<APP_ENV>/lock, one directory
# per instance. Several hosts need a store they share, for example:
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=
###< symfony/lock ###

# Keys that seal the passwords of the firms' mail servers: "id:base64key", comma
# separated, the first is the one in use; older ones only open what they sealed.
# A key is 32 random bytes: php -r 'echo base64_encode(random_bytes(32)), "\n";'
# Empty means no firm can save a mail server. Set it outside committed files.
MAIL_SECRET_KEYS=

# The keys that seal the signing secrets of webhook endpoints, in the same
# format as MAIL_SECRET_KEYS and rotated apart from them. Empty means no
# endpoint can be saved. Set it outside committed files.
WEBHOOK_SECRET_KEYS=

# Every user must set up two-factor sign-in (an authenticator app) before
# reaching any page. The TOTP secrets are sealed with MAIL_SECRET_KEYS. Only
# automated tests turn this off; a user who has set it up is always asked.
APP_REQUIRE_2FA=true

# The time zone of the instance's days (due dates, the schedule), a canonical
# name of the tz database such as Europe/Prague. Empty follows the country of
# the first active firm, else UTC. A wrong name stops the instance at start.
APP_TIMEZONE=

# Inbound mail (the Mail module). The old names BANK_INBOX_* still work for one more
# release, with a deprecation warning in the log; rename them to MAIL_INBOUND_*.
#
# Mail polled over IMAP is believed only on the word of the operator mailbox's own
# receiving server: the authserv-ids it writes into Authentication-Results, comma
# separated (webhook mail has INBOUND_WEBHOOK_TRUSTED_AUTHSERV below). That
# server must add the header to every message, above all others. Optionally, the
# signing domains (d=) of forwarders whose ARC seal may vouch for a signature
# broken on the way; list the mailbox provider too when it seals with ARC on
# receipt. Empty verifies no message, so nothing pays an invoice by itself;
# bank movements still appear, unverified, and a person pairs them by hand after
# confirming each one in their internet banking. See docs/mail.md.
MAIL_INBOUND_TRUSTED_AUTHSERV=
MAIL_INBOUND_TRUSTED_ARC=

# The inbound address of a purpose such as a bank account, with "{token}" where
# its secret token goes, such as mail+{token}@example.com: an address of the
# operator mailbox, which must deliver plus-addressed mail. Empty means inbound
# mail is not set up on this server, and no address can be generated.
MAIL_INBOUND_ADDRESS=

# How many mails one inbound address takes per day of the instance (APP_TIMEZONE);
# the rest is dropped unread, and the address shows how many on its list. The
# default, 500, is far above any bank or supplier.
MAIL_INBOUND_DAILY_LIMIT=500

# The operator mailbox itself, polled over IMAP every five minutes. Handled mail is
# moved to Foresi/Done, Foresi/Unknown or Foresi/Rejected, never deleted. Encryption
# is ssl (port 993) or starttls (port 143). An empty host turns polling off. Set
# the password outside committed files. Left empty, the port is 993, the
# encryption ssl and the folder INBOX.
MAIL_INBOUND_HOST=
MAIL_INBOUND_PORT=
MAIL_INBOUND_ENCRYPTION=
MAIL_INBOUND_USER=
MAIL_INBOUND_PASSWORD=
MAIL_INBOUND_FOLDER=

# Optional: the bearer secret of POST /inbound/mail, where a relay such as an
# e-mail worker posts raw mail. Empty turns the webhook off (404). Use a long
# random value: php -r 'echo bin2hex(random_bytes(32)), "\n";'
INBOUND_WEBHOOK_SECRET=
# The authserv-ids of the relay's own receiving server, comma separated: mail
# posted to the webhook is believed only on its word, never on the mailbox's
# (MAIL_INBOUND_TRUSTED_AUTHSERV). The relay must add its own Authentication-Results
# at the top of every message. Empty verifies no webhook mail, so none pays by
# itself; it still appears, unverified, for a person to pair after checking it in
# the bank. See docs/mail.md.
INBOUND_WEBHOOK_TRUSTED_AUTHSERV=

# Reading received documents with an AI model (the AI Reader module). It reads only the
# files the structured readers left without a total, an issue date or a supplier, and any
# file a person asks it to read. The provider is "claude", or empty for none; without a
# provider and a key the module does nothing. The file is sent to the provider. Set the
# key outside committed files. The model, when empty, is claude-sonnet-5-5. The trigger is
# "arrival" (the default: when a file arrives) or "click" (only when a person asks).
AI_READER_PROVIDER=
AI_READER_API_KEY=
AI_READER_MODEL=
AI_READER_TRIGGER=
###> foresi/health ###
# GET /health and bin/console app:health report degraded when less of the disk of
# APP_SHARE_DIR is free, in percent.
HEALTH_DISK_MIN_FREE_PERCENT=5
###< foresi/health ###
###> foresi/operator-alerts ###
# Errors of the production log are mailed to the operator of the installation, at
# most once an hour per distinct message, through this mailer only: never a firm's
# own server. Both empty sends no mail. Check with bin/console app:ops:test-alert.
# See docs/logging.md. Example: smtp://user:pass@smtp.example.com:587
OPERATOR_MAILER_DSN=
OPERATOR_EMAIL=
###< foresi/operator-alerts ###
###> foresi/system-mail ###
# Mail of the installation itself, such as invitations, through this mailer only:
# never a firm's own server. Queued on the mail transport. Either empty sends no
# such mail, and /health reports system_mail as degraded. Check with
# bin/console app:ops:test-mail <to>. Example: smtp://user:pass@smtp.example.com:587
SYSTEM_MAILER_DSN=
# The sender, an address with an optional name: Foresi <noreply@example.com>
SYSTEM_MAIL_FROM=
###< foresi/system-mail ###
###> foresi/mcp ###
# The hostnames, without port, the MCP server at /mcp answers for, comma separated:
# its protection against DNS rebinding. Add the host of DEFAULT_URI in production,
# such as app.example.com. The stdio server (bin/console mcp:server) ignores it and
# signs in with FORESI_API_TOKEN, which is set by the MCP client, never here.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
###< foresi/mcp ###
###> foresi/security-headers ###
# Strict-Transport-Security over HTTPS: one year with the subdomains, off in dev.
# 0 sends none (docs/operations.md#security-headers).
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=1
# Where browsers report Content-Security-Policy violations; empty sends no reports.
# CSP_REPORT_URI=
###< foresi/security-headers ###
