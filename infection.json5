{
    // SPDX-License-Identifier: AGPL-3.0-only
    //
    // The timeout is raised from the default of 10 seconds on purpose. With the default, Infection
    // skips every mutant whose covering tests take longer than that (most of them for code that many
    // integration tests touch) and leaves them out of the score. 120 seconds stopped being enough
    // once the invoicing tests arrived, so the limit is 30 minutes. A mutant's own time limit still
    // follows from how long its tests take, so a looping mutant stops long before that. The CI
    // merge of the shards fails when any mutant is skipped, which shows when this needs raising again.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": ["Kernel.php", "Controller", "Infrastructure", "migrations"]
    },
    "phpUnit": {
        "configDir": "."
    },
    "timeout": 1800,
    // Not the shared system temp directory: two runs at once (two checkouts) would overwrite each other's coverage
    // files.
    "tmpDir": "var/infection",
    "logs": {
        "text": "var/infection/infection.log"
    },
    "minMsi": 80,
    "minCoveredMsi": 90,
    "mutators": {
        "@default": true,
        // Column lengths and join columns in mapping attributes are verified by doctrine:schema:validate; the jsonb
        // option only picks PostgreSQL's column type, which the migrations create, and the tests run on SQLite.
        // The lengths an API field declares are read from its attribute by reflection, which covers no line, so the
        // tests of the operation's input schema assert them instead.
        "global-ignoreSourceCodeByRegex": [".*#\\[ORM\\\\.*\\blength: .*", ".*#\\[ORM\\\\.*'jsonb' => .*", ".*#\\[ORM\\\\JoinColumn\\(.*", ".*#\\[Field\\(.*\\bmaxLength: .*"],
        // Equivalent mutants: a numeric string added to an int yields the same value, and so it does when
        // compared with an int or taken by max(); false from strrpos() plus one is one, cast or not.
        "CastInt": {"ignore": [
            // The same for Margin: the whole and the decimals of a percent are numeric strings that multiply and add as integers.
            "Foresi\\Margin\\Domain\\Percent::hundredths",
            "Foresi\\Instance\\Domain\\TenantId::generate",
            "Foresi\\Invoicing\\Contract\\Percent::fromString",
            "Foresi\\Invoicing\\Contract\\Quantity::fromString",
            "Foresi\\Invoicing\\Domain\\SeriesFormat::beyondCounter",
            "Foresi\\Country\\CzechRepublic\\Party\\CzechBankAccount::toIban",
            "Foresi\\Country\\CzechRepublic\\Party\\CzechRegistrationNumberValidator::validate",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate",
            "Foresi\\Invoicing\\Domain\\PeriodText::value",
            "Foresi\\Invoicing\\Application\\RecurringPreview::next",
            "Foresi\\Invoicing\\Application\\RecurringAlerts::message",
            "Foresi\\Invoicing\\Application\\MailVariables::valuesForReminder",
            "Foresi\\Instance\\Application\\Schedule\\DailyPeriod::of",
            // bindec() of five bits is an int, and the logged money columns are ints.
            "Foresi\\Banking\\Application\\InboundToken::generate::32",
            "Foresi\\Invoicing\\Application\\InvoiceHistory::minor::135",
            // The year and the digits compared with it are numeric strings.
            "Foresi\\Idoklad\\Application\\Import\\DocumentsStage::shapeOf",
            // The month number subtracted from is a numeric string.
            "Foresi\\Shared\\Application\\View\\DateRange::quarter"
        ]},
        // Equivalent mutants: the whole match of a percentage reads as a number up to its dot, which is the same
        // integer part. Of recurring dates: RecurringSchedule::estimate() only has to stay at or before the first
        // date on or after a day, and next() walks on from it, so a lower estimate gives the same dates; an issued
        // count of -1 is below every end count (at least 1) as 0 is; setDate() carries any month into its year, so
        // inMonth() gives the same day whatever year it splits off; a schedule that never ends gives the same first
        // date when asked for two.
        "DecrementInteger": {"ignore": [
            // Equivalent mutants of the splitter: an allocation is checked when it is made, so every percent of a percent split reads and the fallback is never used; the place kept for the share that takes the rest is overwritten with what is left.
            "Foresi\\Margin\\Domain\\ShareSplitter::percent",
            "Foresi\\Margin\\Domain\\ShareSplitter::fixed",
            "Foresi\\Invoicing\\Contract\\Percent::fromString::31",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::inMonth::99",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::115",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::118",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::126",
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::__construct::196",
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::firstOccurrenceFrom::212",
            "Foresi\\Invoicing\\Application\\RecurringPreview::next::38",
            "Foresi\\Invoicing\\Application\\RecurringRules::schedule::177",
            // Equivalent mutants: &#127; decodes back to DEL; the amount groups are never empty, and "150." reads as
            // 150; a depth of -1 is not above zero as 0 is not; the log always has both money columns of an allocation.
            "Foresi\\Banking\\Contract\\NotificationLines::textOf::58",
            "Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::amount::372",
            "Foresi\\Banking\\Application\\AuthenticationResultsParser::segments::85",
            "Foresi\\Invoicing\\Application\\InvoiceHistory::minor::133",
            "Foresi\\Invoicing\\Application\\InvoiceHistory::minor::135",
            // Equivalent mutant: the sums of a filter add up all its pages, whatever page it names.
            "Foresi\\Invoicing\\Application\\InvoicingOverview::month::96",
            // Equivalent mutant: the party search reads page 0 as its first page.
            "Foresi\\Purchasing\\Application\\Query\\SupplierChoices::search::43",
            "Foresi\\CashFlow\\Application\\CashFlowAccess::contacts::108"
        ]},
        // The same, and the length of a month read from its second day instead of its first.
        "IncrementInteger": {"ignore": [
            // Equivalent mutant: the fallback of a percent that always reads is never used.
            "Foresi\\Margin\\Domain\\ShareSplitter::percent",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::monthLength::82",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::inMonth::99",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::118",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::121",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::123",
            "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::126",
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::firstOccurrenceFrom::212",
            // A date written as Ymd has eight characters, so a limit of nine cuts nothing more.
            "Foresi\\Country\\Integration\\Invoicing\\CzechRepublic\\QrPlatba::invoice::94",
            // The same; no code point lies above U+10FFFF; a backslash before the last character keeps the same
            // characters; a template holds exactly one placeholder, so a limit of 3 gives the same two parts.
            "Foresi\\Banking\\Contract\\NotificationLines::textOf::58",
            "Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::amount::372",
            "Foresi\\Banking\\Application\\AuthenticationResultsParser::segments::101",
            "Foresi\\Banking\\Application\\InboundAddresses::masked::63",
            "Foresi\\Banking\\Application\\InboundAddresses::tokenIn::94",
            "Foresi\\Invoicing\\Application\\InvoiceHistory::minor::133",
            "Foresi\\Invoicing\\Application\\InvoiceHistory::minor::135",
            // The same: an amount QR Platba takes is at most 9999999.99, ten characters, so its key never meets a
            // limit of 11.
            "Foresi\\Country\\Integration\\Invoicing\\CzechRepublic\\QrPlatba::for::64"
        ,
            "Foresi\\Invoicing\\Application\\InvoicingOverview::month::96",
            // Equivalent mutant: a sequence of 1 renders as wide as one of 0, the width being at least one digit.
            "Foresi\\Idoklad\\Application\\Import\\DocumentsStage::fixedLength::616"
        ]},
        "LessThanOrEqualTo": {"ignore": ["Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::114"]},
        "Plus": {"ignore": ["Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::estimate::118"]},
        // Equivalent mutants: a day equal to the one compared with sets the same day again.
        "LessThan": {"ignore": [
            // Equivalent mutant: a base of zero gives the amounts zero, and a sign of -1 times zero is zero.
            "Foresi\\Margin\\Domain\\ShareSplitter::split",
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::nextOccurrenceUnder::224",
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::resume::308",
            "Foresi\\Idoklad\\Application\\Import\\RunIdokladImport::defaultOptions::106"
        ]},
        // Equivalent mutants: dates come oldest first, and a date on or after the day, or past the end rule, is
        // followed by more of them only; nothing due stays not due, and a refused issue is refused again.
        "Break_": {"ignore": [
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::resume::312",
            "Foresi\\Invoicing\\Application\\RecurringPreview::next",
            "Foresi\\Invoicing\\Application\\IssueRecurringInvoices::runTemplate::155",
            "Foresi\\Invoicing\\Application\\IssueRecurringInvoices::runTemplate::161",
            // Equivalent mutant: the decision was just made unmatched, so the loop ends on its condition anyway.
            "Foresi\\Banking\\Application\\PairMovement::autoUnderLocks::153",
            // Equivalent mutant: the amount left never drops below zero and every open invoice has something to pay,
            // so once nothing is left every later part is zero and skipped as well.
            "Foresi\\Banking\\Application\\PairingChoices::prefill::115"
        ]},
        // Equivalent mutant: when the template's run throws, nothing was refused yet, and alerting nothing does
        // nothing.
        "UnwrapFinally": {"ignore": [
            "Foresi\\Invoicing\\Application\\IssueRecurringInvoices::runOne",
            // Equivalent mutant: loadHTML() does not throw for the non-empty string it gets.
            "Foresi\\Banking\\Contract\\NotificationLines::textOf"
        ]},
        // Unreachable: IssueRules refuses a firm of an unsupported country (firm_country_unsupported) before any lookup
        // throws.
        "CatchBlockRemoval": {"ignore": [
            "Foresi\\Invoicing\\Application\\IssueRecurringInvoices::runTemplate",
            // Equivalent mutant: an unknown message counts no failed attempt either way (the update finds no row) and
            // is rethrown.
            "Foresi\\Banking\\Application\\ProcessMessage::run"
        ]},
        // Equivalent mutant: a spent firm is checked with isset(), which false passes as true does.
        "TrueValue": {"ignore": [
            "Foresi\\Invoicing\\Application\\IssueRecurringInvoices::runTemplate",
            // Equivalent mutant: only the number of contested signers is read, never the values.
            "Foresi\\Banking\\Application\\MailAuthentication::contestedSigners::113"
        ]},
        // Equivalent mutant: the alert texts read only the customer and the code of each failure.
        "UnwrapArrayMap": {"ignore": ["Foresi\\Invoicing\\Application\\RecurringAlerts::message"]},
        // Equivalent mutants: a seat that is not an array has no city, so it ends as no seat either way; without a
        // token the loop adds nothing and the rest of the text is all of it.
        "ReturnRemoval": {"ignore": [
            "Foresi\\Country\\CzechRepublic\\Registry\\AresCompanyRegistry::seat", "Foresi\\Invoicing\\Domain\\PeriodText::resolve",
            // Equivalent mutants: with nothing chosen the loop adds nothing, and a single chosen invoice gets the whole
            // (positive) amount; archiving an archived account keeps its first date, and making the primary account or
            // a restored one primary again when the firm has a primary changes nothing.
            "Foresi\\Banking\\Application\\PairingChoices::prefill::104",
            "Foresi\\Banking\\Application\\PairingChoices::prefill::107",
            "Foresi\\Party\\Application\\ManageFirmBankAccounts::archive::111",
            "Foresi\\Party\\Application\\ManageFirmBankAccounts::archive::116",
            "Foresi\\Party\\Application\\ManageFirmBankAccounts::restore::138"
        ]},
        // Equivalent mutant: the separator only keeps the keys apart, in either order.
        "Concat": {"ignore": [
            "Foresi\\Invoicing\\Domain\\InvoiceCalculator::summaries", "Foresi\\Invoicing\\Application\\RecurringAlerts::alertAll",
            // Equivalent mutants: a date with the time before it or without one parses to the same midnight.
            "Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::bookedOn::474"
        ]},
        // Unreachable guards: IssueRules refuses these cases before the throw, RecurringRules refuses an unknown
        // customer
        // before SaveRecurringInvoice reads it, a schedule that never ends always has a next date, and a row alert's
        // column that is not a string fails the check of its column below.
        "Throw_": {"ignore": [
            "Foresi\\Invoicing\\Application\\IssueInvoice::issue::65",
            "Foresi\\Invoicing\\Application\\IssueInvoice::issue::67",
            "Foresi\\Invoicing\\Application\\EditInvoice::edit::63",
            "Foresi\\Invoicing\\Application\\EditInvoice::edit::64",
            "Foresi\\Invoicing\\Application\\SaveRecurringInvoice::content::111",
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::firstOccurrenceFrom::212",
            "Foresi\\Ui\\Component\\DataTable::alert::242",
            // RecordPayment::check() refuses a payment without allocations, so a firm is always found.
            "Foresi\\Invoicing\\Application\\RecordPayment::firmOf::169"
        ]},
        // Equivalent mutants: preg_replace() and preg_replace_callback() without the u flag always return a string,
        // and NumberFormatter formats an integer without failing.
        "CastString": {"ignore": [
            // Equivalent mutants of Margin: the percent of a percent split is always set (checked when the allocation is made), and only a staff member decides, who is a stored user, so the actor has an id.
            "Foresi\\Margin\\Domain\\ShareSplitter::percent",
            "Foresi\\Margin\\Application\\AllocationWrites::setLine",
            "Foresi\\Margin\\Application\\AllocationWrites::assign",
            "Foresi\\Country\\CzechRepublic\\Party\\CzechBankAccount::toIban",
            "Foresi\\Country\\CzechRepublic\\Party\\CzechRegistrationNumberValidator::normalize",
            "Foresi\\Invoicing\\Application\\MailText::render::27",
            "Foresi\\Invoicing\\Application\\MailText::renderBody",
            "Foresi\\Invoicing\\Application\\MailMarkdown::escape",
            "Foresi\\Invoicing\\Application\\MailMarkdown::plain",
            "Foresi\\Invoicing\\Application\\DocumentFormat::money::31",
            // The first group of the pattern always takes part in a match.
            "Foresi\\Invoicing\\Domain\\PeriodText::resolve::43",
            // preg_replace() without the u flag always returns a string.
            "Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::amount::371"
        ]},
        // Equivalent mutants: of two sends sent at the same moment, either is the last one; a day equal to the one
        // compared with sets the same day again.
        "GreaterThan": {"ignore": ["Foresi\\Invoicing\\Application\\SendDraft::lastSentAt", "Foresi\\Invoicing\\Domain\\RecurringInvoice::nextOccurrenceUnder::227", "Foresi\\Invoicing\\Domain\\RecurringInvoice::resume::318"]},
        // Equivalent mutants in the party import: a new party starts from the standard defaults, so clearing them
        // changes
        // nothing; a part of an address that is missing has no earlier error to keep; role keys are plain ASCII. The
        // one
        // caller of RecurringSchedule::inMonth() without a last-day flag, PeriodText, reads only the month and year.
        "FalseValue": {"ignore": ["Foresi\\Party\\Application\\ImportPartyValues::input", "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::inMonth"]},
        "AssignCoalesce": {"ignore": ["Foresi\\Party\\Application\\ImportPartyValues::address"]},
        "MBString": {"ignore": [
            "Foresi\\Party\\Application\\ImportPartyValues::roles",
            // A configured inbound template passes FILTER_VALIDATE_EMAIL without the Unicode flag, so it is ASCII only.
            "Foresi\\Banking\\Application\\InboundAddresses::written::76"
        ]},
        // Equivalent mutants: both columns are always set together, and a repeated id is looked up and stored again
        // with the same outcome.
        "LogicalOr": {"ignore": [
            // Equivalent mutant: a fixed allocation is checked when it is made, so a share without an amount always takes the rest, and one that takes the rest has no amount.
            "Foresi\\Margin\\Domain\\ShareSplitter::fixed",
            "Foresi\\Party\\Domain\\Party::registrationNumber", "Foresi\\Party\\Domain\\Party::check", "Foresi\\Country\\CzechRepublic\\Registry\\AdisVatPayerReliability::checkMany", "Foresi\\Invoicing\\Domain\\FirmReminders::minimum",
            // Equivalent mutants: a key and its value come from the same branch of the pattern; an empty side fails the
            // count check of the newest ARC set below.
            "Foresi\\Banking\\Application\\AuthenticationResultsParser::result::150",
            "Foresi\\Banking\\Application\\MailAuthentication::arcVouches::211",
            // Equivalent mutants: a tax document on payment out of the trash always names its payment and its advance,
            // and one with something owed after a refund always has the day of that refund.
            "Foresi\\Invoicing\\Application\\CorrectPaymentTaxDocument::due::62",
            "Foresi\\Invoicing\\Application\\CorrectPaymentTaxDocument::due::76",
            // Equivalent mutants: an hourly or invoiced rate is stored from one Money, so its amount and its currency
            // are always both set or both empty.
            "Foresi\\Identity\\Domain\\Membership::hourlyRate",
            "Foresi\\Party\\Domain\\InvoicingDefaults::hourlyRate",
            "Foresi\\Work\\Domain\\Project::hourlyRate",
            "Foresi\\Work\\Domain\\TimeEntry::invoicedRate"
        ]},
        // Equivalent mutants: a paused template always has a next date, and a row alert's column that is not a
        // string fails the check of its column below.
        "LogicalAnd": {"ignore": [
            // Equivalent mutant: a scope that reads, asked for the same resource and not for a write, is the scope
            // asked for, granted above.
            "Foresi\\Identity\\Domain\\ApiScope::grants::84",
            "Foresi\\Invoicing\\Domain\\RecurringInvoice::resume::308", "Foresi\\Ui\\Component\\DataTable::alert::242",
            // Equivalent mutants: two equal invoices are both close to the amount, so nothing pairs either way; when
            // only one statement has an IBAN, the IBAN comparison below refuses with the same reason.
            "Foresi\\Banking\\Application\\Matcher::decide::109",
            "Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::assertAgree::316"
        ]},
        // Equivalent mutants: an end on a date always has that date (Recurrence checks it), and a staff member is a
        // stored user.
        "NullSafeMethodCall": {"ignore": ["Foresi\\Purchasing\\Integration\\Margin\\ReceivedDocumentCosts::document", "Foresi\\Shared\\Domain\\Schedule\\RecurringSchedule::isOver", "Foresi\\Invoicing\\Application\\RecurringAlerts::recipient"]},
        // Equivalent mutants: ids hold letters and digits only, so the XML escape flags change nothing, and the
        // parser flags only back up the checks above them (no DTD is let through, errors are collected internally).
        "BitwiseOr": {"ignore": [
            "Foresi\\Country\\CzechRepublic\\Registry\\AdisVatPayerReliability::envelope", "Foresi\\Country\\CzechRepublic\\Registry\\AdisVatPayerReliability::parse",
            // Equivalent mutants: the HTML parser fetches nothing, and its errors are collected internally and cleared
            // either way.
            "Foresi\\Banking\\Contract\\NotificationLines::textOf::62"
        ]},
        // Equivalent mutants: a blank answer fails as invalid XML instead, a blank VAT id is rejected by VatId, with
        // the same result.
        "UnwrapTrim": {"ignore": [
            // Equivalent mutant: the label is trimmed against an empty supplier name, which a recorded document does not have.
            "Foresi\\Purchasing\\Integration\\Margin\\ReceivedDocumentCosts::document",
            "Foresi\\Country\\CzechRepublic\\Registry\\AdisVatPayerReliability::parse", "Foresi\\Country\\CzechRepublic\\Registry\\AresCompanyRegistry::vatId",
            // Equivalent mutants: HTML of white space only loads to no lines, and every KB value is trimmed already.
            "Foresi\\Banking\\Contract\\NotificationLines::textOf::52",
            "Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::iban::422"
        ]},
        // Equivalent mutants: the batch is only walked with foreach, and spreading a list renumbers its keys anyway.
        "UnwrapArrayValues": {"ignore": [
            "Foresi\\Country\\CzechRepublic\\Registry\\AdisVatPayerReliability::checkMany", "Foresi\\Invoicing\\Application\\MailVariables::names",
            // Of the bank: usort(), sort() and array_slice() renumber the keys anyway, and the other lists are only
            // counted, searched, filtered again or walked with foreach; the symbol matches come first, so their keys
            // already run from 0.
            "Foresi\\Banking\\Application\\Matcher::decide::80",
            "Foresi\\Banking\\Application\\PairMovement::lockInvoices::220",
            "Foresi\\Banking\\Application\\PairingChoices::of::70",
            "Foresi\\Banking\\Application\\PairingChoices::of::88",
            "Foresi\\Banking\\Application\\PairingChoices::prefill::100",
            "Foresi\\Banking\\Application\\PairingChoices::prefill::101",
            "Foresi\\Banking\\Application\\MailAuthentication::verdict::86",
            "Foresi\\Banking\\Application\\TrustSettings::names::77",
            "Foresi\\Invoicing\\Application\\InvoiceHistory::of::45",
            "Foresi\\Invoicing\\Application\\RecordPayment::record::57",
            // Spreading a list into an array literal renumbers its keys, so the groupings are a list either way.
            "Foresi\\Work\\Application\\View\\TaskLists::groupsOf::132"
        ]},
        // Equivalent mutant: when both parties carry a tenant they are equal (checked just above).
        // Czechia, at home in CZK, is the only invoicing country, and a template without one is refused for its
        // currency whatever its lines are priced in.
        "Coalesce": {"ignore": ["Foresi\\Party\\Domain\\ContactLink::__construct", "Foresi\\Idoklad\\Application\\Import\\RecurringStage::input::250"]},
        // Equivalent mutant: the libxml HTML parser lower-cases tag names already.
        "UnwrapStrToLower": {"ignore": ["Foresi\\Banking\\Contract\\NotificationLines::collect::80"]},
        // Unreachable: the whole part is digits and the fraction at most two of them, so Money only fails by overflow.
        "Catch_": {"ignore": ["Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::amount::375"]},
        // Equivalent mutant: Iban::fromString() upper-cases itself, and the domestic pattern does not depend on case.
        "UnwrapStrToUpper": {"ignore": ["Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::iban::414"]},
        // Equivalent mutants: a date without a time parses to the same midnight; a working file of a pack named
        // beside its directory instead of in it is as unique (the pack path is) and is deleted all the same; the
        // fallback problem of a refusal without problems loses its prefix in reasonOf() either way.
        "ConcatOperandRemoval": {"ignore": [
            "Foresi\\Country\\Integration\\Banking\\CzechRepublic\\KbNotificationParser::bookedOn::474",
            "Foresi\\Invoicing\\Application\\InvoiceBundle::add::174",
            "Foresi\\Invoicing\\Application\\Api\\InvoicingRefused::of::87"
        ]},
        // Equivalent mutants: the left side of ?? is read as isset() reads it, so a property of null is null there
        // without the nullsafe operator too.
        "NullSafePropertyCall": {"ignore": [
            "Foresi\\Invoicing\\Application\\Api\\InvoiceWrites::create::101",
            "Foresi\\Invoicing\\Application\\Api\\InvoiceWrites::update::138"
        ]},
        // Equivalent mutants: the subject is always exactly one character, and rawurlencode() output has no regex
        // metacharacters.
        // Of iDoklad numbers: a lazy group from the start matches wherever a match exists, as anchored; the number
        // is trimmed and its head is of one line (dot), so no line break stands before an end.
        "PregMatchRemoveCaret": {"ignore": [
            // Equivalent mutant: the pattern only keeps text that is no uuid from the guid column of PostgreSQL; on SQLite and in PostgreSQL alike such an id finds no document.
            "Foresi\\Purchasing\\Integration\\Margin\\ReceivedDocumentCosts::document",
            "Foresi\\Banking\\Application\\InboundAddresses::written::78",
            "Foresi\\Idoklad\\Application\\Import\\DocumentsStage::shapeOf"
        ]},
        "PregMatchRemoveDollar": {"ignore": [
            // The same.
            "Foresi\\Purchasing\\Integration\\Margin\\ReceivedDocumentCosts::document",
            // Without the end anchor, a longer name still needs an icon file of that exact name.
            "Foresi\\Ui\\Contract\\Guard::icon::22",
            "Foresi\\Banking\\Application\\InboundAddresses::written::78",
            "Foresi\\Idoklad\\Application\\Import\\DocumentsStage::shapeOf::583"
        ]},
        "PregMatchRemoveFlags": {"ignore": ["Foresi\\Purchasing\\Integration\\Margin\\ReceivedDocumentCosts::document", "Foresi\\Idoklad\\Application\\Import\\DocumentsStage::shapeOf"]},
        "PregQuote": {"ignore": ["Foresi\\Banking\\Application\\InboundAddresses::written::78"]}
    }
}
