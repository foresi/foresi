#!/usr/bin/env php
<?php
// SPDX-License-Identifier: AGPL-3.0-only

declare(strict_types=1);

/*
 * Splits one Infection run into shards and puts the scores of the shards back together.
 * Infection has no option for sharding, so a shard is a set of source files.
 *
 *   bin/infection-shard files INDEX COUNT [PATH...]
 *       Prints the source files of shard INDEX (1 to COUNT), one per line. The files are
 *       the ones Infection mutates (infection.json5, including its excludes), spread over
 *       the shards so that they take about as long. PATH limits the files, to try it.
 *       With INFECTION_SHARD_MANIFEST set, the split is also written to that file as JSON.
 *
 *       A file weighs the seconds its mutants took in an earlier full run, from the JSON
 *       file INFECTION_SHARD_TIMES names (see times and collect). What a mutant costs
 *       depends on the tests that kill it, not on the size of the file: in the run of
 *       2026-11-25 one file of 437 lines took a sixth of the whole run. The size of a file
 *       stands in for a file that was not measured, scaled to seconds by the files that were.
 *
 *   bin/infection-shard times LOG FILES [PREVIOUS]
 *       Prints the seconds the mutants of each source file took, as JSON, from the output of
 *       Infection with --teamcity in LOG. FILES lists the files of the shard, one per line;
 *       a file the log does not finish (a shard stopped before its end) keeps its time from
 *       PREVIOUS, the times the shard was split by, when that is longer than its part.
 *
 *   bin/infection-shard collect DIRECTORY...
 *       Puts the times-INDEX.json of the shards in the directories together, as JSON.
 *
 *   bin/infection-shard merge DIRECTORY...
 *       Reads shard-INDEX.json (the Infection summary of a shard, from --logger-summary-json)
 *       and shard-INDEX.files.json (the manifest) from the directories, checks that every
 *       shard of the run is there, and enforces the two minimum scores over the total.
 */

const MIN_MSI = 80.0;
const MIN_COVERED_MSI = 90.0;
const PRECISION = 2;

$root = dirname(__DIR__);
$arguments = $_SERVER['argv'];
array_shift($arguments);
$command = array_shift($arguments);

exit(match ($command) {
    'files' => files($root, $arguments),
    'merge' => merge($arguments),
    'times' => times($root, $arguments),
    'collect' => collect($arguments),
    default => fail("Usage: bin/infection-shard files INDEX COUNT [PATH...] | merge DIRECTORY... | times LOG FILES [PREVIOUS] | collect DIRECTORY...\n"),
});

function fail(string $message): int
{
    fwrite(\STDERR, $message);

    return 1;
}

/**
 * @param list<string> $arguments
 */
function files(string $root, array $arguments): int
{
    $index = (int) ($arguments[0] ?? 0);
    $count = (int) ($arguments[1] ?? 0);
    if ($count < 1 || $index < 1 || $index > $count) {
        return fail("INDEX must be from 1 to COUNT.\n");
    }

    $command = array_merge(
        [\PHP_BINARY, $root.'/vendor/bin/infection', 'config:list-sources', '--no-interaction'],
        array_slice($arguments, 2),
    );
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $root);
    if (!\is_resource($process)) {
        return fail("Infection cannot be started.\n");
    }
    $output = (string) stream_get_contents($pipes[1]);
    $errors = (string) stream_get_contents($pipes[2]);
    if (0 !== proc_close($process)) {
        return fail("Infection cannot list the source files.\n$output$errors");
    }

    $paths = array_values(array_filter(array_map('trim', explode("\n", $output)), static fn (string $line): bool => '' !== $line));
    if ([] === $paths) {
        return fail("Infection lists no source file.\n");
    }

    $costs = costs($root, $paths, readTimes((string) getenv('INFECTION_SHARD_TIMES')));

    // Longest processing time first: each file goes to the shard with the least so far. Ties
    // are broken by path, so every job that runs this on the same checkout and times gets the
    // same split.
    uksort($costs, static fn (string $a, string $b): int => [$costs[$b], $a] <=> [$costs[$a], $b]);

    $load = array_fill(1, $count, 0.0);
    $shards = array_fill(1, $count, []);
    foreach ($costs as $path => $cost) {
        $target = array_search(min($load), $load, true);
        $load[$target] += $cost;
        $shards[$target][] = $path;
    }

    $mine = $shards[$index];
    sort($mine);
    echo implode("\n", $mine), "\n";

    $manifest = getenv('INFECTION_SHARD_MANIFEST');
    if (false !== $manifest && '' !== $manifest) {
        file_put_contents($manifest, json_encode(['index' => $index, 'count' => $count, 'files' => $mine], \JSON_THROW_ON_ERROR | \JSON_PRETTY_PRINT)."\n");
    }

    return 0;
}

/**
 * @param list<string>         $paths
 * @param array<string, float> $times
 *
 * @return array<string, float>
 */
function costs(string $root, array $paths, array $times): array
{
    $sizes = [];
    foreach ($paths as $path) {
        $sizes[$path] = (float) filesize($root.'/'.$path);
    }

    // Seconds per byte of the files that were measured; one when none was.
    $measuredSeconds = 0.0;
    $measuredBytes = 0.0;
    foreach ($paths as $path) {
        if (isset($times[$path])) {
            $measuredSeconds += $times[$path];
            $measuredBytes += $sizes[$path];
        }
    }
    $scale = $measuredSeconds > 0 && $measuredBytes > 0 ? $measuredSeconds / $measuredBytes : 1.0;

    $costs = [];
    foreach ($paths as $path) {
        $costs[$path] = $times[$path] ?? $sizes[$path] * $scale;
    }

    return $costs;
}

/**
 * @return array<string, float> empty when the file is not given or not there
 */
function readTimes(string $file): array
{
    if ('' === $file || !is_file($file)) {
        return [];
    }
    $data = json_decode((string) file_get_contents($file), true);
    if (!\is_array($data)) {
        return [];
    }
    $times = [];
    foreach ($data as $path => $seconds) {
        if (\is_string($path) && (\is_int($seconds) || \is_float($seconds))) {
            $times[$path] = (float) $seconds;
        }
    }

    return $times;
}

/**
 * @param list<string> $arguments
 */
function times(string $root, array $arguments): int
{
    [$log, $list] = [$arguments[0] ?? '', $arguments[1] ?? ''];
    if (!is_file($log) || !is_file($list)) {
        return fail("Usage: bin/infection-shard times LOG FILES [PREVIOUS]\n");
    }
    $previous = readTimes($arguments[2] ?? '');

    // A mutant starts with testStarted, which names its file in locationHint, and ends with
    // testFinished (killed), testFailed (escaped) or testIgnored, which carry its duration in
    // milliseconds. An escaped mutant runs every test that covers it, so it is often the
    // dearest of its file.
    $fileOf = [];
    $times = [];
    $finished = [];
    $handle = fopen($log, 'r');
    if (false === $handle) {
        return fail("$log cannot be read.\n");
    }
    while (false !== ($line = fgets($handle))) {
        if (str_contains($line, '##teamcity[testStarted ')
            && preg_match("/nodeId='([^']+)'.*locationHint='infection:\\/\\/(.+?)::/", $line, $match)) {
            $path = str_starts_with($match[2], $root.'/') ? substr($match[2], \strlen($root) + 1) : $match[2];
            $fileOf[$match[1]] = $path;
        } elseif (str_contains($line, '##teamcity[testSuiteFinished ')
            && preg_match("/name='([^']+)'/", $line, $match)) {
            $finished[$match[1]] = true;
        } elseif (preg_match('/^##teamcity\\[test(?:Finished|Failed|Ignored) /', $line)
            && preg_match("/nodeId='([^']+)'.*duration='(\\d+)'/", $line, $match)
            && isset($fileOf[$match[1]])) {
            $path = $fileOf[$match[1]];
            $times[$path] = ($times[$path] ?? 0.0) + (int) $match[2] / 1000;
        }
    }
    fclose($handle);

    $result = [];
    foreach (array_filter(array_map('trim', file($list) ?: []), static fn (string $path): bool => '' !== $path) as $path) {
        $seconds = isset($finished[$path]) ? $times[$path] ?? 0.0 : max($times[$path] ?? 0.0, $previous[$path] ?? 0.0);
        $result[$path] = round($seconds, 1);
    }
    ksort($result);
    echo json_encode($result, \JSON_THROW_ON_ERROR | \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES), "\n";

    return 0;
}

/**
 * @param list<string> $directories
 */
function collect(array $directories): int
{
    $times = [];
    foreach ($directories as $directory) {
        foreach (glob(rtrim($directory, '/').'/{,*/}times-*.json', \GLOB_BRACE) ?: [] as $file) {
            $times += readTimes($file);
        }
    }
    if ([] === $times) {
        return fail("No times found.\n");
    }
    ksort($times);
    echo json_encode($times, \JSON_THROW_ON_ERROR | \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES), "\n";

    return 0;
}

/**
 * @param list<string> $directories
 */
function merge(array $directories): int
{
    $summaries = [];
    $manifests = [];
    foreach ($directories as $directory) {
        foreach (glob(rtrim($directory, '/').'/{,*/}shard-*.json', \GLOB_BRACE) ?: [] as $file) {
            $data = json_decode((string) file_get_contents($file), true, 512, \JSON_THROW_ON_ERROR);
            $index = (int) preg_replace('/\D/', '', basename($file));
            if (str_ends_with($file, '.files.json')) {
                $manifests[$index] = $data;
            } else {
                $summaries[$index] = $data['stats'];
            }
        }
    }

    if ([] === $manifests) {
        return fail("No shard found.\n");
    }
    $counts = array_values(array_unique(array_column($manifests, 'count')));
    if (1 !== \count($counts)) {
        return fail("The shards disagree on how many there are.\n");
    }
    $count = (int) $counts[0];

    // A shard that is missing would leave its files out of the score, so every shard from 1
    // to COUNT must be there. This also catches a job matrix that is smaller than the count.
    for ($index = 1; $index <= $count; ++$index) {
        if (!isset($manifests[$index], $summaries[$index])) {
            return fail("Shard $index of $count is missing.\n");
        }
    }

    $files = [];
    foreach ($manifests as $manifest) {
        foreach ($manifest['files'] as $file) {
            if (isset($files[$file])) {
                return fail("$file is in more than one shard.\n");
            }
            $files[$file] = true;
        }
    }

    $total = array_fill_keys(['totalMutantsCount', 'killedCount', 'notCoveredCount', 'escapedCount', 'errorCount', 'syntaxErrorCount', 'skippedCount', 'ignoredCount', 'timeOutCount'], 0);
    ksort($summaries);
    foreach ($summaries as $index => $stats) {
        printf("Shard %d: %d mutants, MSI %s%%, covered MSI %s%%\n", $index, $stats['totalMutantsCount'], $stats['msi'], $stats['coveredCodeMsi']);
        foreach ($total as $key => $value) {
            $total[$key] = $value + $stats[$key];
        }
    }

    // The same arithmetic as Infection's own: errors and timeouts count as killed, and skipped
    // and ignored mutants are left out.
    $tested = $total['totalMutantsCount'] - $total['skippedCount'] - $total['ignoredCount'];
    $covered = $tested - $total['notCoveredCount'];
    $detected = $total['killedCount'] + $total['errorCount'] + $total['syntaxErrorCount'] + $total['timeOutCount'];
    $msi = $tested > 0 ? round(100 * $detected / $tested, PRECISION) : 0.0;
    $coveredMsi = $covered > 0 ? round(100 * $detected / $covered, PRECISION) : 0.0;

    printf("Total of %d shards, %d files: %d mutants, %d skipped, %d escaped, %d not covered\n", $count, \count($files), $total['totalMutantsCount'], $total['skippedCount'], $total['escapedCount'], $total['notCoveredCount']);
    printf("Mutation Score Indicator (MSI): %s%% (minimum %s%%)\n", $msi, MIN_MSI);
    printf("Covered Code MSI: %s%% (minimum %s%%)\n", $coveredMsi, MIN_COVERED_MSI);

    if ($total['skippedCount'] > 0) {
        return fail("{$total['skippedCount']} mutants were skipped; none may be.\n");
    }
    if ($msi < MIN_MSI) {
        return fail("The MSI is below the minimum.\n");
    }
    if ($coveredMsi < MIN_COVERED_MSI) {
        return fail("The covered code MSI is below the minimum.\n");
    }

    return 0;
}
