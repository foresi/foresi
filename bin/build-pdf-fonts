#!/usr/bin/env php
<?php
// SPDX-License-Identifier: AGPL-3.0-only

declare(strict_types=1);

/*
 * Builds the font definitions tc-lib-pdf reads and writes them to
 * src/Shared/resources/pdf-fonts/. The output is committed, so a running installation
 * never needs this script, and running it on the same sources gives the same files.
 * Every source is checked by SHA-256 below.
 *
 * Inter 4.1, SIL Open Font License 1.1 (src/Shared/resources/pdf-fonts/OFL.txt).
 *   https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip
 * intertnum and intertnumb are the Regular and SemiBold faces with the digits pointed
 * at their tabular glyphs by bin/inter-tabular.py, which needs Python 3 with fontTools.
 * interdisplay is the Display SemiBold face unchanged.
 *
 * Gelasio 1.008, SIL Open Font License 1.1 (src/Shared/resources/pdf-fonts/OFL-Gelasio.txt).
 *   https://github.com/SorkinType/Gelasio/tree/7ab20e7e5c42791e603b9ee3201a0b49849cfdb2/fonts/ttf
 * gelasio and gelasiob are the Regular and Bold faces unchanged.
 *
 * Usage: bin/build-pdf-fonts inter <path to Inter-4.1.zip>
 *        bin/build-pdf-fonts gelasio <directory with Gelasio-Regular.ttf and Gelasio-Bold.ttf>
 */

use Com\Tecnick\File\File;
use Com\Tecnick\Pdf\Font\FontPaths;
use Com\Tecnick\Pdf\Font\Import;

require dirname(__DIR__).'/vendor/autoload.php';

const INTER_ARCHIVE_SHA256 = '9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e';
const INTER_FACES = [
    'intertnum' => ['extras/ttf/Inter-Regular.ttf', '40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82', true],
    'intertnumb' => ['extras/ttf/Inter-SemiBold.ttf', '78a843fade9d4612a5567302fb595b56976eb5fcebf4fea5a5912d638bafcde3', true],
    'interdisplay' => ['extras/ttf/InterDisplay-SemiBold.ttf', '0310d7a325896129730c6c8cf9a6e0f81ee258bedf77b1ff059b2a7b75f74e02', false],
];
const GELASIO_FACES = [
    'gelasio' => ['Gelasio-Regular.ttf', '48c797fbe0e07c48a18cb962e7bdfa23f19618327dddf54093265328dc9eb39d'],
    'gelasiob' => ['Gelasio-Bold.ttf', 'e0ef3addf1acf35f5c6aef2be00d0a2c01363bf70a5950e16650976051a0c462'],
];

$fail = static function (string $message): never {
    fwrite(\STDERR, $message."\n");
    exit(1);
};
$usage = static function (): never {
    fwrite(\STDERR, "Usage: bin/build-pdf-fonts inter <path to Inter-4.1.zip>\n       bin/build-pdf-fonts gelasio <directory with Gelasio-Regular.ttf and Gelasio-Bold.ttf>\n");
    exit(2);
};

$family = $argv[1] ?? '';
$source = $argv[2] ?? '';

/** @var array<string, array{string, bool}> $faces the bytes of each face and whether its digits become tabular */
$faces = [];
if ('inter' === $family) {
    if ('' === $source || !is_file($source)) {
        $usage();
    }
    if (INTER_ARCHIVE_SHA256 !== hash_file('sha256', $source)) {
        $fail('Refused: this is not the Inter 4.1 release.');
    }
    $zip = new ZipArchive();
    if (true !== $zip->open($source)) {
        $fail('The archive cannot be opened.');
    }
    foreach (INTER_FACES as $name => [$entry, $sha256, $tabular]) {
        $bytes = $zip->getFromName($entry);
        if (false === $bytes || $sha256 !== hash('sha256', $bytes)) {
            $fail("Refused: $entry is not the face this script knows.");
        }
        $faces[$name] = [$bytes, $tabular];
    }
} elseif ('gelasio' === $family) {
    if ('' === $source || !is_dir($source)) {
        $usage();
    }
    foreach (GELASIO_FACES as $name => [$file, $sha256]) {
        $bytes = @file_get_contents($source.'/'.$file);
        if (false === $bytes || $sha256 !== hash('sha256', $bytes)) {
            $fail("Refused: $file is not the face this script knows.");
        }
        $faces[$name] = [$bytes, false];
    }
} else {
    $usage();
}

$output = dirname(__DIR__).'/src/Shared/resources/pdf-fonts';
$work = sys_get_temp_dir().'/foresi-fonts-'.bin2hex(random_bytes(6));
if (!mkdir($work, 0o700)) {
    $fail("Cannot create $work");
}
$work = (string) realpath($work);

try {
    foreach ($faces as $name => [$bytes, $tabular]) {
        $original = $work.'/source-'.$name.'.ttf';
        file_put_contents($original, $bytes);
        $face = $work.'/'.$name.'.ttf';
        if ($tabular) {
            $command = array_map(escapeshellarg(...), ['python3', __DIR__.'/inter-tabular.py', $original, $face]);
            passthru(implode(' ', $command), $exit);
            if (0 !== $exit) {
                $fail("Making $name tabular failed. It needs Python 3 with fontTools.");
            }
        } else {
            copy($original, $face);
        }

        // The converter refuses a font that is already imported; start clean.
        foreach (["$name.json", "$name.z", "$name.ctg.z"] as $old) {
            if (is_file($output.'/'.$old)) {
                unlink($output.'/'.$old);
            }
        }

        // Full Unicode cmap (platform 3, encoding 10) so every glyph of the font is reachable.
        $helper = new File(allowedPaths: array_values(array_unique([...FontPaths::buildAllowedPaths(), $work, $output])));
        $import = new Import($face, $output.'/', 'TrueTypeUnicode', '', 32, 3, 10, false, $helper);
        fwrite(\STDOUT, sprintf("%s -> %s (sha256 %s)\n", $name, $import->getFontName(), hash_file('sha256', $face)));
    }
} finally {
    array_map(unlink(...), glob($work.'/*') ?: []);
    rmdir($work);
}
