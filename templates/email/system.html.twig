{# The HTML layout of system mail: plain, the product, the content the caller rendered, then who sent it. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ mail.subject }}</title>
</head>
<body style="margin:0;padding:24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;color:#1f2933;background:#ffffff;">
    <p style="margin:0 0 24px;font-weight:bold;">{{ product_name }}</p>
    {{ mail.html|raw }}
    <p style="margin:32px 0 0;padding-top:16px;border-top:1px solid #d9dee3;font-size:13px;color:#616e7c;">{{ mail.organisation is null ? 'system_mail.footer'|trans({product: product_name}, null, locale) : 'system_mail.footer_organisation'|trans({product: product_name, organisation: mail.organisation}, null, locale) }}</p>
</body>
</html>
