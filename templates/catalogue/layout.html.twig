{# Frame of the development catalogue: frame colour and one white panel; needs no tenant or sign-in. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'catalogue.title'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-frame p-2.5 text-text">
        <main id="main" class="mx-auto max-w-[1100px] rounded-panel border border-container bg-white shadow-raised">
            {% block panel %}{% endblock %}
        </main>
    </div>
{% endblock %}
