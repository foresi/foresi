{% extends frame ? 'catalogue/frame.html.twig' : 'catalogue/layout.html.twig' %}

{% block panel %}
    {% if not frame %}
        <header class="flex flex-wrap items-center gap-3 border-b border-divider px-6 py-4 max-[899px]:px-3.5">
            <div class="min-w-0">
                <h1 class="m-0 text-title font-semibold text-ink">{{ 'catalogue.title'|trans }}</h1>
                <p class="m-0 text-muted">{{ 'catalogue.intro'|trans }}</p>
            </div>
            <nav class="ml-auto flex items-center gap-2" aria-label="{{ 'catalogue.language'|trans }}">
                {% for code in locales %}
                    <twig:Ui:Button :href="path('catalogue', {locale: code})" :variant="code == locale ? 'primary' : 'secondary'" size="sm" hreflang="{{ code }}" lang="{{ code }}" :aria-current="code == locale ? 'true' : null">{{ ('locale.' ~ code)|trans({}, 'messages', code) }}</twig:Ui:Button>
                {% endfor %}
            </nav>
        </header>
        <nav class="border-b border-divider px-6 py-3 max-[899px]:px-3.5" aria-label="{{ 'catalogue.jump'|trans }}">
            <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-small">
                {% for name in sections %}
                    <li><a href="#component-{{ name }}" class="inline-flex min-h-6 items-center text-muted hover:text-ink">{{ name }}</a></li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
    <div class="grid gap-8 p-6 max-[899px]:p-3.5">
        {% for name in sections %}
            <section id="component-{{ name }}" aria-labelledby="component-{{ name }}-title" class="scroll-mt-4 grid min-w-0 gap-4">
                <h2 id="component-{{ name }}-title" class="m-0 border-b border-divider pb-2 text-heading font-semibold text-ink">{{ name }}</h2>
                {% if name != 'tokens' %}<p class="m-0 text-caption text-muted">{{ 'catalogue.interaction_note'|trans }}</p>{% endif %}
                {% include 'catalogue/sections/' ~ name ~ '.html.twig' %}
                {% if not frame and name != 'tokens' %}
                    <details class="rounded-panel border border-container">
                        <summary class="cursor-pointer px-3.5 py-2 text-small font-medium text-ink">{{ 'catalogue.mobile_preview'|trans }}</summary>
                        <iframe data-mobile-preview width="390" height="480" loading="lazy" title="{{ 'catalogue.mobile_preview'|trans }}: {{ name }}" src="{{ path('catalogue', {frame: 'mobile', section: name, locale: locale}) }}" class="mx-auto my-3 block max-w-full border border-container bg-white"></iframe>
                    </details>
                {% endif %}
            </section>
        {% endfor %}
    </div>
{% endblock %}
