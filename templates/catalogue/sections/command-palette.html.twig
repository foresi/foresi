<div class="w-full max-w-sm"><twig:Ui:CommandPalette id="cat-palette" :commands="[{label: 'New contact', href: '#', group: 'Create', icon: 'plus', shortcut: 'N'}, {label: 'Contacts', href: '#', group: 'Go to', icon: 'users', keywords: 'customers suppliers'}, {label: 'Settings', href: '#', group: 'Go to', icon: 'settings'}]" /></div>
