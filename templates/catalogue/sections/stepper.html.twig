<div class="grid gap-5">
{% embed 'catalogue/_state.html.twig' with {state: 'default'} %}{% block sample %}
<twig:Ui:Stepper class="w-full" label="Import steps" :steps="['Upload', 'Columns', 'Check', 'Import', 'Summary']" :current="0" />
{% endblock %}{% endembed %}
{% embed 'catalogue/_state.html.twig' with {state: 'progress'} %}{% block sample %}
<twig:Ui:Stepper class="w-full" label="Kroky importu" :steps="['Nahrání', 'Sloupce', 'Kontrola', 'Import', 'Souhrn']" :current="2" />
{% endblock %}{% endembed %}
{% embed 'catalogue/_state.html.twig' with {state: 'done'} %}{% block sample %}
<twig:Ui:Stepper class="w-full" label="Kroky importu" :steps="['Nahrání', 'Sloupce', 'Kontrola', 'Import', 'Souhrn']" :current="4" />
{% endblock %}{% endembed %}
</div>
