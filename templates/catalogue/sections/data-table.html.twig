<div class="grid gap-5">
{% embed 'catalogue/_state.html.twig' with {state: 'default'} %}{% block sample %}
<div class="w-full"><twig:Ui:DataTable caption="Contacts" :columns="[{key: 'name', label: 'Name', sortable: true, sort: 'asc', href: '#'}, {key: 'email', label: 'E-mail', sortable: true, href: '#'}, {key: 'status', label: 'Status'}, {key: 'balance', label: 'Balance', align: 'right'}]" :rows="[{id: 'a1', label: 'Example Company', href: '#', cells: {name: {text: 'Example Company s.r.o.', link: '#'}, email: 'info@example.com', status: {text: 'Active', tone: 'green'}, balance: {text: '12 400,00 Kč', numeric: true}}}, {id: 'b2', label: 'Second Ltd', href: '#', cells: {name: {text: 'Druhá společnost a.s.', link: '#'}, email: null, status: {text: 'Overdue', tone: 'red'}, balance: {text: '1 200,50 Kč', numeric: true}}}]"><twig:block name="footer"><span>2</span></twig:block></twig:Ui:DataTable></div>
{% endblock %}{% endembed %}
{% embed 'catalogue/_state.html.twig' with {state: 'sorted'} %}{% block sample %}
<div class="w-full"><twig:Ui:DataTable caption="Contacts" :columns="[{key: 'name', label: 'Name', sortable: true, sort: 'asc', href: '#'}, {key: 'email', label: 'E-mail', sortable: true, href: '#'}, {key: 'status', label: 'Status'}, {key: 'balance', label: 'Balance', align: 'right'}]" :rows="[{id: 'a1', label: 'Example Company', href: '#', cells: {name: {text: 'Example Company s.r.o.', link: '#'}, email: 'info@example.com', status: {text: 'Active', tone: 'green'}, balance: {text: '12 400,00 Kč', numeric: true}}}, {id: 'b2', label: 'Second Ltd', href: '#', cells: {name: {text: 'Druhá společnost a.s.', link: '#'}, email: null, status: {text: 'Overdue', tone: 'red'}, balance: {text: '1 200,50 Kč', numeric: true}}}]" :totals="{balance: '13 600,50 Kč'}" /></div>
{% endblock %}{% endembed %}
{% embed 'catalogue/_state.html.twig' with {state: 'selectable'} %}{% block sample %}
<div class="w-full"><twig:Ui:DataTable caption="Contacts" :columns="[{key: 'name', label: 'Name', sortable: true, sort: 'asc', href: '#'}, {key: 'email', label: 'E-mail', sortable: true, href: '#'}, {key: 'status', label: 'Status'}, {key: 'balance', label: 'Balance', align: 'right'}]" :rows="[{id: 'a1', label: 'Example Company', href: '#', cells: {name: {text: 'Example Company s.r.o.', link: '#'}, email: 'info@example.com', status: {text: 'Active', tone: 'green'}, balance: {text: '12 400,00 Kč', numeric: true}}}, {id: 'b2', label: 'Second Ltd', href: '#', cells: {name: {text: 'Druhá společnost a.s.', link: '#'}, email: null, status: {text: 'Overdue', tone: 'red'}, balance: {text: '1 200,50 Kč', numeric: true}}}]" :selectable="true"><twig:block name="bulk"><twig:Ui:Button variant="secondary" size="sm">Export</twig:Ui:Button></twig:block></twig:Ui:DataTable></div>
{% endblock %}{% endembed %}
{% embed 'catalogue/_state.html.twig' with {state: 'empty'} %}{% block sample %}
<div class="w-full"><twig:Ui:DataTable caption="Contacts" :columns="[{key: 'name', label: 'Name'}]" :rows="[]"><twig:block name="empty"><twig:Ui:EmptyState icon="users" title="No contacts yet" text="Add your first contact."><twig:Ui:Button variant="primary" icon="plus">New contact</twig:Ui:Button></twig:Ui:EmptyState></twig:block></twig:Ui:DataTable></div>
{% endblock %}{% endembed %}
{% embed 'catalogue/_state.html.twig' with {state: 'long'} %}{% block sample %}
<div class="w-full"><twig:Ui:DataTable caption="Contacts" :columns="[{key: 'name', label: 'Name', sortable: true, sort: 'asc', href: '#'}, {key: 'email', label: 'E-mail', sortable: true, href: '#'}, {key: 'status', label: 'Status'}, {key: 'balance', label: 'Balance', align: 'right'}]" :rows="[{id: 'c3', label: 'Long', href: '#', cells: {name: {text: 'Example Company Holding of Central European Trading s.r.o.', link: '#', title: 'Example Company Holding of Central European Trading s.r.o.'}, email: {text: 'accounting.department.of.the.example.company@subdomain.example.com', title: 'accounting.department.of.the.example.company@subdomain.example.com'}, status: {text: 'Archived', tone: 'gray'}, balance: {text: '999 999 999,00 Kč', numeric: true}}}]" /></div>
{% endblock %}{% endembed %}
</div>
