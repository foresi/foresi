<div class="grid gap-5">
{% embed 'catalogue/_state.html.twig' with {state: 'default'} %}{% block sample %}
<twig:Ui:Card>
    <twig:Ui:TextInput name="cat-band-customer" label="Odběratel" :row="true" width="long" :required="true" value="Example Company s.r.o." />
    <twig:Ui:FormBand class="mt-5">
        <twig:Ui:FieldGroup title="Datumy">
            <twig:Ui:TextInput name="cat-band-issue" type="date" label="Datum vystavení" :row="true" width="short" value="2026-11-05" />
        </twig:Ui:FieldGroup>
        <twig:Ui:FieldGroup title="Moje platební údaje">
            <twig:Ui:Select name="cat-band-method" label="Platba" :row="true" width="medium" :options="{a: 'Převodem'}" />
            {# Each fact once, as invoicing/_bank_account.html.twig: the account (a select with more), then its numbers as text rows. #}
            <twig:Ui:Field id="cat-band-account" label="Bankovní účet" :row="true" :plain="true"><p class="m-0 flex items-center text-ink md:min-h-control">Hlavní účet</p></twig:Ui:Field>
            <dl class="m-0 grid gap-1.5">
                <div class="grid content-start gap-1.5 md:grid-cols-[var(--spacing-label)_minmax(0,1fr)] md:gap-x-4"><dt class="text-small font-medium text-ink md:text-right">Číslo účtu</dt><dd class="num m-0 break-all text-ink">19-2000145399/0800</dd></div>
                <div class="grid content-start gap-1.5 md:grid-cols-[var(--spacing-label)_minmax(0,1fr)] md:gap-x-4"><dt class="text-small font-medium text-ink md:text-right">IBAN</dt><dd class="num m-0 break-all text-ink">CZ65 0800 0000 1920 0014 5399</dd></div>
            </dl>
            <twig:Ui:Field id="cat-band-currency" label="Měna" :row="true" :plain="true"><p class="m-0 flex items-center text-ink md:min-h-control">CZK</p></twig:Ui:Field>
        </twig:Ui:FieldGroup>
    </twig:Ui:FormBand>
</twig:Ui:Card>
{% endblock %}{% endembed %}
</div>
