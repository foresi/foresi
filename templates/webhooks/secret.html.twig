{#
    The signing secret of an endpoint, with a button to copy it: once in the answer that created or
    rotated the endpoint, or on purpose through Reveal, which asks first and shows it only in the
    answer to that form. Never a redirect, and the answer is not cached. A dialog that created or
    rotated loads the page under it again when it closes.
    Variables: endpoint, title, secret (null while Reveal asks), mode (created, rotated, revealed,
    reveal), previousUntil (rotated only), error.
#}
{% extends in_dialog() ? 'layout/dialog.html.twig' : 'layout/app.html.twig' %}

{% set back = mode == 'created' ? path('app_webhooks') : path('app_webhook', {id: endpoint.id}) %}
{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'webhooks.title'|trans, href: path('app_webhooks')}, {label: title, href: path('app_webhook', {id: endpoint.id})}, {label: ('webhooks.secret.title.' ~ mode)|trans}] %}
{% set dialog_size = 'md' %}
{% set dialog_fields = secret is null %}
{% set dialog_reload = mode in ['created', 'rotated'] %}

{% block head %}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block title %}{{ ('webhooks.secret.title.' ~ mode)|trans }}{% endblock %}

{% block dialog_body %}
    <div class="grid gap-4">
        {% if error %}<twig:Ui:Alert tone="error">{{ error }}</twig:Ui:Alert>{% endif %}
        {% if secret is null %}
            <p class="m-0 text-text">{{ 'webhooks.secret.reveal_text'|trans({host: endpoint.url.host}) }}</p>
            <form method="post" id="webhook-secret-form" action="{{ path('app_webhook_secret', {id: endpoint.id}) }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Webhooks\\Infrastructure\\Controller\\WebhookEndpointController::TOKEN')) }}">
            </form>
        {% else %}
            {% if mode != 'revealed' %}<twig:Ui:Alert tone="warning" data-webhook-secret-once>{{ 'webhooks.secret.once'|trans }}</twig:Ui:Alert>{% endif %}
            <p class="m-0 text-text">{{ ('webhooks.secret.text.' ~ mode)|trans({host: endpoint.url.host}) }}</p>
            {% if previousUntil %}<p class="m-0 text-text" data-webhook-previous>{{ 'webhooks.secret.previous'|trans({date: previousUntil}) }}</p>{% endif %}
            <div class="flex flex-wrap items-end gap-2" data-controller="copy" data-copy-done-value="{{ 'webhooks.secret.copied'|trans }}" data-copy-failed-value="{{ 'webhooks.secret.copy_failed'|trans }}">
                <div class="min-w-0 flex-1 basis-64"><twig:Ui:TextInput id="webhook-secret" :label="'webhooks.secret.field'|trans" :value="secret" readonly spellcheck="false" autocomplete="off" data-copy-target="source" /></div>
                <twig:Ui:Button icon="copy" data-action="copy#copy"><span data-copy-target="label">{{ 'webhooks.secret.copy'|trans }}</span></twig:Ui:Button>
                <span class="sr-only" aria-live="polite" data-copy-target="status"></span>
            </div>
            <p class="m-0 text-caption text-muted">{{ 'webhooks.secret.use'|trans }}</p>
        {% endif %}
    </div>
{% endblock %}

{% block dialog_footer %}
    {% if secret is null %}
        <twig:Ui:Button data-action="dialog#dismiss">{{ 'webhooks.cancel'|trans }}</twig:Ui:Button>
        <twig:Ui:Button type="submit" form="webhook-secret-form" variant="primary" icon="key-round">{{ 'webhooks.action.reveal'|trans }}</twig:Ui:Button>
    {% else %}
        <twig:Ui:Button variant="primary" data-action="dialog#dismiss">{{ 'webhooks.done'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% set body %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="('webhooks.secret.title.' ~ mode)|trans" icon="key-round" class="max-w-2xl">
        {{ body }}
        <div class="mt-4 flex flex-wrap justify-end gap-2">
            {% if secret is null %}
                <twig:Ui:Button :href="back">{{ 'webhooks.cancel'|trans }}</twig:Ui:Button>
                <twig:Ui:Button type="submit" form="webhook-secret-form" variant="primary" icon="key-round">{{ 'webhooks.action.reveal'|trans }}</twig:Ui:Button>
            {% else %}
                <twig:Ui:Button variant="primary" :href="back">{{ 'webhooks.done'|trans }}</twig:Ui:Button>
            {% endif %}
        </div>
    </twig:Ui:Card>
{% endblock %}
