{#
    The webhook endpoints of the organisation that the person may manage. A new endpoint opens in a
    dialog over the list; the row menu edits, pings, disables or enables and deletes, and deleting asks
    first. Variables: columns, rows.
#}
{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'webhooks.title'|trans}] %}

{% block title %}{{ 'webhooks.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_webhook_new')" id="webhook-new" data-dialog aria-haspopup="dialog">{{ 'webhooks.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <section class="grid gap-2" data-webhook-endpoints>
        <twig:Ui:DataTable :caption="'webhooks.title'|trans" :columns="columns" :rows="rows" :actionToken="csrf_token(constant('App\\Webhooks\\Infrastructure\\Controller\\WebhookEndpointController::TOKEN'))">
            <twig:block name="empty">
                <twig:Ui:EmptyState icon="send" :title="'webhooks.empty.title'|trans" :text="'webhooks.empty.text'|trans">
                    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_webhook_new')" data-dialog aria-haspopup="dialog">{{ 'webhooks.new'|trans }}</twig:Ui:Button>
                </twig:Ui:EmptyState>
            </twig:block>
        </twig:Ui:DataTable>
    </section>
{% endblock %}
