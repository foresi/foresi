{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.contacts'|trans}, {label: 'party.title'|trans}] %}

{% block title %}{{ 'party.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button icon="upload" :href="path('app_import_new', {target: 'party'})">{{ 'party.header.import'|trans }}</twig:Ui:Button>
    {% if not firstRun %}
        {% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
        {% set itemClass = 'flex h-control w-full cursor-pointer items-center gap-2.5 rounded-control border-0 bg-transparent px-2.5 text-left text-text no-underline hover:bg-head focus-visible:bg-head' %}
        <form method="post" action="{{ path('app_contacts_export') }}" data-turbo="false" class="relative" data-controller="dropdown">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Party\\Infrastructure\\Controller\\PartyController::ACTION_TOKEN')) }}">
            <input type="hidden" name="scope" value="view">
            <input type="hidden" name="view" value="{{ exportQuery.view }}">
            <input type="hidden" name="q" value="{{ exportQuery.q }}">
            {% if exportQuery.import is defined %}
                <input type="hidden" name="import" value="{{ exportQuery.import }}">
                <input type="hidden" name="outcome" value="{{ exportQuery.outcome }}">
            {% endif %}
            <twig:Ui:Button icon="download" id="export-button" aria-haspopup="menu" aria-expanded="false" aria-controls="export-menu" data-dropdown-target="button" data-action="dropdown#toggle keydown->dropdown#openFromButton">{{ 'party.header.export'|trans }}{{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-muted', 'aria-hidden': 'true'}) }}</twig:Ui:Button>
            <div id="export-menu" role="menu" hidden data-dropdown-target="menu" data-action="keydown->dropdown#navigate" aria-labelledby="export-button" class="absolute right-0 top-full z-50 mt-1.5 w-max min-w-full rounded-panel border border-container bg-white p-1.5 shadow-floating">
                <button type="submit" name="format" value="csv" role="menuitem" tabindex="-1" class="{{ itemClass }} {{ focus }}">
                    <span>{{ 'party.header.export_csv'|trans }}</span>
                </button>
                <button type="submit" name="format" value="xlsx" role="menuitem" tabindex="-1" class="{{ itemClass }} {{ focus }}">
                    <span>{{ 'party.header.export_xlsx'|trans }}</span>
                </button>
            </div>
        </form>
        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_contact_new')">{{ 'party.new'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% for message in app.flashes('success') %}
        <twig:Ui:Alert tone="success" class="mb-4">{{ message }}</twig:Ui:Alert>
    {% endfor %}

    {% if firstRun %}
        <twig:Ui:EmptyState icon="users" :title="'party.empty.title'|trans" :text="'party.empty.text'|trans">
            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_contact_new')">{{ 'party.new'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            <twig:Ui:KpiStrip :items="[
                {label: 'party.kpi.all'|trans, value: counts.all ~ ''},
                {label: 'party.kpi.customers'|trans, value: counts.customers ~ ''},
                {label: 'party.kpi.suppliers'|trans, value: counts.suppliers ~ ''},
                (counts.unreliablePayers > 0
                    ? {label: 'party.kpi.unreliable'|trans, value: counts.unreliablePayers ~ '', badge: {label: 'party.kpi.check'|trans, tone: 'red'}}
                    : {label: 'party.kpi.unreliable'|trans, value: counts.unreliablePayers ~ ''}),
            ]" />

            <div class="flex flex-wrap items-end justify-between gap-3">
                <twig:Ui:Tabs :items="tabs" :label="'party.views'|trans" class="min-w-0 flex-1" />
                <form method="get" action="{{ path('app_contacts') }}" role="search" class="flex w-full items-center gap-2 sm:w-auto max-sm:[&_button]:h-control-lg max-sm:[&_input]:h-control-lg">
                    {% if view != 'all' %}<input type="hidden" name="view" value="{{ view }}">{% endif %}
                    {% if sort != 'name' %}<input type="hidden" name="sort" value="{{ sort }}">{% endif %}
                    <twig:Ui:SearchField name="q" :value="text" :label="'party.search.label'|trans" :placeholder="'party.search.placeholder'|trans" maxlength="100" class="min-w-0 flex-1 sm:w-72 sm:flex-none" />
                    <twig:Ui:Button type="submit" icon="search">{{ 'party.search.submit'|trans }}</twig:Ui:Button>
                </form>
            </div>

            {% if importedBy %}
                <twig:Ui:Alert tone="info" data-imported-by>
                    <span>{{ importedBy.text }}</span>
                    <a href="{{ importedBy.href }}" class="ml-1 font-semibold text-current underline underline-offset-2 {{ constant('App\\Ui\\Component\\Style::FOCUS') }}">{{ 'party.imported_by.summary'|trans }}</a>
                    <a href="{{ path('app_contacts') }}" class="ml-1 font-semibold text-current underline underline-offset-2 {{ constant('App\\Ui\\Component\\Style::FOCUS') }}">{{ 'party.empty_filtered.reset'|trans }}</a>
                </twig:Ui:Alert>
            {% endif %}

            <form method="post" action="{{ path('app_contacts_export') }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Party\\Infrastructure\\Controller\\PartyController::ACTION_TOKEN')) }}">
                <twig:Ui:DataTable :caption="'party.title'|trans" :columns="columns" :rows="rows" :selectable="true" selectionName="ids[]">
                    <twig:block name="empty">
                        <twig:Ui:EmptyState icon="search" :title="'party.empty_filtered.title'|trans" :text="'party.empty_filtered.text'|trans">
                            <twig:Ui:Button :href="path('app_contacts')">{{ 'party.empty_filtered.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    </twig:block>
                    <twig:block name="footer">
                        <span class="num">{{ 'party.pagination.summary'|trans({total: page.total}) }}</span>
                        <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                    </twig:block>
                    <twig:block name="bulk">
                        {% if view != 'archived' %}
                            <twig:Ui:Button type="submit" size="sm" icon="archive" formaction="{{ path('app_contacts_archive') }}">{{ 'party.bulk.archive'|trans }}</twig:Ui:Button>
                        {% endif %}
                        <twig:Ui:Button type="submit" size="sm" icon="download">{{ 'party.bulk.export'|trans }}</twig:Ui:Button>
                    </twig:block>
                </twig:Ui:DataTable>
            </form>
        </div>
    {% endif %}
{% endblock %}
