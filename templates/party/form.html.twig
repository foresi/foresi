{% extends 'layout/app.html.twig' %}

{% set editing = party is not null %}
{% set crumbs = editing
    ? [{label: 'party.title'|trans, href: path('app_contacts')}, {label: party.displayName, href: cancel}, {label: 'party.edit'|trans}]
    : [{label: 'party.title'|trans, href: path('app_contacts')}, {label: 'party.new'|trans}] %}
{% set roleValues = values.roles %}
{% set form_invalid = errors is not empty %}

{% block title %}{{ editing ? 'party.edit'|trans : 'party.new'|trans }}{% endblock %}

{% block content %}
    <form method="post" action="{{ action }}" class="grid max-w-4xl gap-4" novalidate data-controller="party-lookup" data-party-lookup-url-value="{{ path('app_contact_lookup') }}" data-party-lookup-existing-value="{{ 'party.lookup.existing'|trans }}" data-party-lookup-empty-value="{{ 'party.lookup.empty'|trans }}" data-party-lookup-limited-value="{{ 'party.lookup.limited'|trans }}">
        <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Party\\Infrastructure\\Controller\\PartyFormController::FORM_TOKEN')) }}">
        {% if not editing %}<input type="hidden" name="_submission" value="{{ token }}">{% endif %}

        {% if errors.form is defined %}
            <twig:Ui:Alert tone="error">{{ errors.form }}</twig:Ui:Alert>
        {% endif %}

        {% if duplicates is not empty %}
            <twig:Ui:Alert tone="warning" role="alert" icon="triangle-alert" :title="'party.duplicate.title'|trans" data-duplicate-warning>
                <p class="mb-2">{{ 'party.duplicate.text'|trans }}</p>
                <ul class="m-0 mb-3 list-none p-0">
                    {% for match in duplicates %}
                        <li><a href="{{ match.url }}" class="font-medium text-badge-amber-text underline" target="_blank" rel="noopener">{{ match.name }}</a>{% if match.archived %} ({{ 'party.archived'|trans }}){% endif %}</li>
                    {% endfor %}
                </ul>
                <twig:Ui:Button type="submit" variant="primary" name="confirm_duplicate" value="1">{{ 'party.duplicate.confirm'|trans }}</twig:Ui:Button>
            </twig:Ui:Alert>
        {% endif %}

        <twig:Ui:Card :title="'party.card.identification'|trans" icon="building-2">
            <div class="grid gap-3 sm:grid-cols-2">
                {% if not editing %}
                    <div class="sm:col-span-2">
                        <twig:Ui:TextInput id="lookup" type="search" :label="'party.lookup.label'|trans" :help="'party.lookup.help'|trans" autocomplete="off" data-party-lookup-target="query" data-action="input->party-lookup#search" />
                        <div class="mt-2" data-party-lookup-target="results" aria-live="polite"></div>
                    </div>
                {% endif %}
                {% if editing %}
                    <input type="hidden" name="kind" value="{{ values.kind }}">
                    <twig:Ui:TextInput name="kind_label" id="kind-label" :label="'party.field.kind'|trans" :value="kinds[values.kind]|default('')" disabled />
                {% else %}
                    <twig:Ui:Select name="kind" id="kind" :label="'party.field.kind'|trans" :options="kinds" :value="values.kind" :error="errors.kind|default(null)" required />
                {% endif %}
                <twig:Ui:TextInput name="displayName" id="displayName" :label="'party.field.displayName'|trans" :value="values.displayName" :error="errors.displayName|default(null)" maxlength="255" required data-party-lookup-target="name" />
                <twig:Ui:Select name="registrationCountry" id="registrationCountry" :label="'party.field.registrationCountry'|trans" :options="countries" :value="values.registrationCountry" data-party-lookup-target="registrationCountry" />
                <twig:Ui:TextInput name="registrationNumber" id="registrationNumber" :label="'party.field.registrationNumber'|trans" :value="values.registrationNumber" :error="errors.registrationNumber|default(null)" maxlength="64" data-party-lookup-target="registrationNumber" />
                <twig:Ui:TextInput name="vatId" id="vatId" :label="'party.field.vatId'|trans" :help="'party.field.vatId_help'|trans" :value="values.vatId" :error="errors.vatId|default(null)" maxlength="16" data-party-lookup-target="vatId" />
            </div>
        </twig:Ui:Card>

        <twig:Ui:Card :title="'party.card.contact'|trans" icon="send">
            <div class="grid gap-3 sm:grid-cols-2">
                <twig:Ui:TextInput name="email" id="email" type="email" :label="'party.field.email'|trans" :value="values.email" :error="errors.email|default(null)" maxlength="254" />
                <twig:Ui:TextInput name="phone" id="phone" type="tel" :label="'party.field.phone'|trans" :value="values.phone" :error="errors.phone|default(null)" maxlength="64" />
                <twig:Ui:TextInput name="mobile" id="mobile" type="tel" :label="'party.field.mobile'|trans" :value="values.mobile" :error="errors.mobile|default(null)" maxlength="64" />
                <twig:Ui:TextInput name="website" id="website" inputmode="url" :label="'party.field.website'|trans" :value="values.website" :error="errors.website|default(null)" maxlength="255" />
            </div>
        </twig:Ui:Card>

        <twig:Ui:Card :title="'party.card.billing'|trans" icon="landmark">
            <div class="grid gap-3 sm:grid-cols-2">
                <div class="sm:col-span-2"><twig:Ui:TextInput name="street" id="street" :label="'party.field.street'|trans" :value="values.street" :error="errors.street|default(null)" maxlength="255" required data-party-lookup-target="street" /></div>
                <twig:Ui:TextInput name="city" id="city" :label="'party.field.city'|trans" :value="values.city" :error="errors.city|default(null)" maxlength="128" required data-party-lookup-target="city" />
                <twig:Ui:TextInput name="postalCode" id="postalCode" :label="'party.field.postalCode'|trans" :value="values.postalCode" :error="errors.postalCode|default(null)" maxlength="32" required data-party-lookup-target="postalCode" />
                <twig:Ui:Select name="countryCode" id="countryCode" :label="'party.field.countryCode'|trans" :options="countries" :value="values.countryCode" :error="errors.countryCode|default(null)" data-party-lookup-target="countryCode" />
            </div>
        </twig:Ui:Card>

        <twig:Ui:Card :title="'party.card.roles'|trans" icon="tag">
            <div class="grid gap-3">
                <twig:Ui:ChoiceChips name="roles[]" id="roles" :legend="'party.field.roles'|trans" :options="roleOptions" :values="roleValues" :error="errors.roles|default(null)" />
                <twig:Ui:Textarea name="privateNote" id="privateNote" :label="'party.field.privateNote'|trans" :help="'party.field.privateNote_help'|trans" :value="values.privateNote" :rows="3" />
            </div>
        </twig:Ui:Card>

        {% for section in firmSections %}
            <twig:Ui:Card :title="'party.card.firm'|trans({name: section.name})" icon="landmark" data-firm-settings="{{ section.id }}">
                <div class="grid gap-3 sm:grid-cols-2">
                    <twig:Ui:TextInput :name="'firms[' ~ section.id ~ '][dueDays]'" :id="'firm-' ~ section.id ~ '-dueDays'" inputmode="numeric" :label="'party.firm_settings.due_days'|trans" :help="'party.firm_settings.due_days_help'|trans" :value="section.values.dueDays" :error="section.errors.dueDays|default(null)" maxlength="3" required />
                    <twig:Ui:Select :name="'firms[' ~ section.id ~ '][currency]'" :id="'firm-' ~ section.id ~ '-currency'" :label="'party.firm_settings.currency'|trans" :options="currencies" :value="section.values.currency" :error="section.errors.currency|default(null)" />
                    <twig:Ui:Select :name="'firms[' ~ section.id ~ '][language]'" :id="'firm-' ~ section.id ~ '-language'" :label="'party.firm_settings.language'|trans" :options="languages" :value="section.values.language" :error="section.errors.language|default(null)" />
                    <twig:Ui:Select :name="'firms[' ~ section.id ~ '][paymentMethod]'" :id="'firm-' ~ section.id ~ '-paymentMethod'" :label="'party.firm_settings.payment_method'|trans" :options="paymentMethods" :value="section.values.paymentMethod" :error="section.errors.paymentMethod|default(null)" />
                    <div class="sm:col-span-2"><twig:Ui:Checkbox :name="'firms[' ~ section.id ~ '][reverseCharge]'" :id="'firm-' ~ section.id ~ '-reverseCharge'" :label="'party.firm_settings.reverse_charge'|trans" :checked="section.values.reverseCharge == '1'" /></div>
                </div>
            </twig:Ui:Card>
        {% endfor %}

        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="cancel">{{ 'party.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" variant="primary">{{ 'party.save'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </form>
{% endblock %}
