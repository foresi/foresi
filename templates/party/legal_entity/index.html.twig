{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'firm.title'|trans}] %}

{% block title %}{{ 'firm.title'|trans }}{% endblock %}

{% block actions %}
    {% if not firstRun %}
        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_firm_new')">{{ 'firm.new'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% for message in app.flashes('success') %}
        <twig:Ui:Alert tone="success" class="mb-4">{{ message }}</twig:Ui:Alert>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <twig:Ui:Alert tone="error" class="mb-4">{{ message }}</twig:Ui:Alert>
    {% endfor %}

    {% if firstRun %}
        <twig:Ui:EmptyState icon="building-2" :title="'firm.empty.title'|trans" :text="'firm.empty.text'|trans">
            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_firm_new')">{{ 'firm.new'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            <twig:Ui:Tabs :items="tabs" :label="'firm.views'|trans" />
            <twig:Ui:DataTable :caption="'firm.title'|trans" :columns="columns" :rows="rows">
                <twig:block name="empty">
                    <twig:Ui:EmptyState icon="building-2" :title="'firm.empty_view.title'|trans" :text="'firm.empty_view.text'|trans" />
                </twig:block>
                <twig:block name="footer">
                    <span class="num">{{ 'firm.summary'|trans({total: total}) }}</span>
                </twig:block>
            </twig:Ui:DataTable>
        </div>
    {% endif %}
{% endblock %}
