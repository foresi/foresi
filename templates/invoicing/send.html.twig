{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'invoice.list.title'|trans, href: cancel}, {label: invoice.number}] %}
{% set form_invalid = problems is not empty %}
{% set fieldProblems = problems|filter(problem => problem.id != 'form') %}
{% set link_class = 'text-current underline underline-offset-2 ' ~ constant('App\\Ui\\Component\\Style::FOCUS') %}

{% block title %}{{ 'invoice.send.title'|trans({number: invoice.number}) }}{% endblock %}

{% block content %}
    <div class="grid max-w-3xl grid-cols-1 gap-4">
        {% for type, tone in {success: 'success', warning: 'warning', error: 'error'} %}
            {% for message in app.flashes(type) %}<twig:Ui:Alert :tone="tone">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% endfor %}

        {% if not draft.hasServer %}
            <twig:Ui:Card>
                <twig:Ui:EmptyState icon="plug" :title="'invoice.send.no_server_title'|trans" :text="'invoice.send.no_server_text'|trans({firm: invoice.issuer.name}) ~ (settingsUrl ? '' : ' ' ~ 'invoice.send.no_server_owner'|trans)" class="py-12">
                    <twig:Ui:Button :href="cancel">{{ 'invoice.send.back'|trans }}</twig:Ui:Button>
                    {% if settingsUrl %}
                        <twig:Ui:Button :href="settingsUrl" variant="primary" icon="settings">{{ 'invoice.send.no_server_open'|trans }}</twig:Ui:Button>
                    {% endif %}
                </twig:Ui:EmptyState>
            </twig:Ui:Card>
        {% else %}
            <form method="post" action="{{ path('app_invoice_send', {id: invoice.id}) }}" class="grid grid-cols-1 gap-4" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Invoicing\\Infrastructure\\Controller\\InvoiceSendController::FORM_TOKEN')) }}">
                <input type="hidden" name="_submission" value="{{ token }}">
                <input type="hidden" name="return" value="{{ return }}">

                {% if problems is not empty %}
                    {# A refusal that names no field takes the focus itself; otherwise the first field to fix does. #}
                    <twig:Ui:Alert tone="error" tabindex="-1" data-error-summary :autofocus="fieldProblems is empty">
                        <p class="m-0 mb-1 font-semibold">{{ 'invoice.send.errors_title'|trans }}</p>
                        <ul class="m-0 grid list-none gap-0.5 p-0">
                            {% for problem in problems %}
                                <li>
                                    {%- if problem.id == 'form' %}{{ problem.message }}
                                    {%- else %}<a href="#{{ problem.id == 'recipients' ? (draft.recipients is empty ? 'others' : 'recipient-1') : problem.id }}" class="{{ link_class }}">{{ problem.field }}</a>: {{ problem.message }}
                                    {%- endif -%}
                                </li>
                            {% endfor %}
                        </ul>
                    </twig:Ui:Alert>
                {% endif %}

                {% if lastSent %}
                    <twig:Ui:Alert tone="info" icon="circle-check" data-sent-before>{{ 'invoice.send.sent_before'|trans({date: lastSent}) }}</twig:Ui:Alert>
                {% endif %}

                <twig:Ui:Card :title="'invoice.send.card'|trans" icon="send">
                    <div class="grid gap-4">
                        <dl class="m-0 grid gap-1.5">
                            <dt class="text-small font-medium text-ink">{{ 'invoice.send.field.from'|trans }}</dt>
                            <dd class="m-0 min-w-0 break-words text-text">{{ draft.fromName }} <span class="text-muted">&lt;{{ draft.fromAddress }}&gt;</span></dd>
                        </dl>

                        <fieldset class="m-0 grid min-w-0 gap-2.5 border-0 p-0"{% if errors.recipients is defined %} aria-describedby="recipients-error"{% endif %}>
                            <legend class="mb-1.5 p-0 text-small font-medium text-ink">{{ 'invoice.send.field.recipients'|trans }}</legend>
                            {% for recipient in draft.recipients %}
                                {% set purpose = recipient.purpose ? recipient.purpose.value : 'document' %}
                                <twig:Ui:Checkbox
                                    :name="recipient.field ~ '[]'"
                                    :id="'recipient-' ~ loop.index"
                                    :value="recipient.address"
                                    :label="('invoice.send.recipient.' ~ purpose)|trans({address: recipient.address})"
                                    :checked="recipient.address in values[recipient.field]"
                                    :errorRef="errors.recipients is defined ? 'recipients-error' : null"
                                />
                            {% endfor %}
                            {% if draft.fromDocument %}
                                <p class="m-0 text-caption text-muted" data-recipient-note>{{ 'invoice.send.from_document'|trans }}</p>
                            {% elseif draft.recipients is empty %}
                                <p class="m-0 text-caption text-muted" data-recipient-note>{{ 'invoice.send.no_address'|trans }}</p>
                            {% endif %}
                            {% if errors.recipients is defined %}
                                <p id="recipients-error" class="m-0 text-caption font-medium text-badge-red-text">{{ errors.recipients }}</p>
                            {% endif %}
                            <twig:Ui:TextInput name="others" id="others" type="text" inputmode="email" :label="'invoice.send.field.others'|trans" :help="'invoice.send.others_help'|trans({max: maxOthers})" :value="values.others" :error="errors.others|default(null)" :errorRef="errors.recipients is defined and draft.recipients is empty ? 'recipients-error' : null" autocomplete="off" autocapitalize="none" spellcheck="false" />
                        </fieldset>

                        {% if draft.copyAddress %}
                            <twig:Ui:Checkbox name="copyToMe" id="copyToMe" :label="'invoice.send.copy_to_me'|trans({address: draft.copyAddress})" :checked="values.copyToMe" />
                        {% endif %}

                        <twig:Ui:TextInput name="subject" id="subject" :label="'invoice.send.field.subject'|trans" :value="values.subject" :error="errors.subject|default(null)" :lang="draft.language.value" maxlength="255" required />
                        <twig:Ui:Textarea name="body" id="body" :label="'invoice.send.field.body'|trans" :help="'invoice.send.body_help'|trans({token: linkToken})" :value="values.body" :error="errors.body|default(null)" :rows="10" :lang="draft.language.value" />
                    </div>
                </twig:Ui:Card>

                <twig:Ui:ActionBar>
                    <twig:Ui:Button :href="cancel">{{ 'invoice.send.back'|trans }}</twig:Ui:Button>
                    <twig:Ui:Button type="submit" id="send-submit" variant="primary" icon="send">{{ 'invoice.send.submit'|trans }}</twig:Ui:Button>
                </twig:Ui:ActionBar>
            </form>
        {% endif %}
    </div>
{% endblock %}
