{# One send on the history of an invoice: who sent it to whom and how it went, then what went out. #}
{% set link_class = 'font-medium text-ink underline underline-offset-2 ' ~ constant('App\\Ui\\Component\\Style::FOCUS') %}
<li class="grid grid-cols-[20px_1fr] items-center gap-x-2 py-1.5 sm:grid-cols-[20px_9.5rem_1fr]" data-send-entry>
    {{ ux_icon('lucide:send', {class: 'size-4 text-green', 'aria-hidden': 'true'}) }}
    <time datetime="{{ item.datetime }}" class="num text-muted">{{ item.time }}</time>
    <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-text [overflow-wrap:anywhere] max-sm:col-start-2">
        <span>{{ item.text }}</span>
        <twig:Ui:Badge :tone="item.tone">{{ item.status }}</twig:Ui:Badge>
        {% if item.read %}<span class="text-small text-muted">{{ item.read }}</span>{% endif %}
    </span>
    <div class="col-start-2 grid min-w-0 gap-1.5 pb-1 pt-0.5 sm:col-start-3">
        {% if item.error %}<p class="m-0 text-small font-medium text-badge-red-text [overflow-wrap:anywhere]">{{ item.error }}</p>{% endif %}
        {% if item.copyError %}<p class="m-0 text-small text-badge-red-text [overflow-wrap:anywhere]">{{ item.copyError }}</p>{% endif %}
        <details class="min-w-0">
            <summary class="w-fit cursor-pointer text-small text-muted hover:text-ink {{ constant('App\\Ui\\Component\\Style::FOCUS') }}">{{ 'invoice.history.send_show'|trans }}</summary>
            <div class="mt-1.5 grid gap-1 rounded-panel border border-container bg-head px-3 py-2.5 text-small" lang="{{ item.language }}">
                <p class="m-0 font-medium text-ink [overflow-wrap:anywhere]"><span class="sr-only">{{ 'invoice.history.send_subject'|trans }}: </span>{{ item.subject }}</p>
                <p class="m-0 whitespace-pre-line text-text [overflow-wrap:anywhere]">{{ item.body }}</p>
            </div>
        </details>
        <p class="m-0 flex flex-wrap gap-x-4 gap-y-1 text-small">
            <a href="{{ item.pdf }}" data-turbo="false" class="{{ link_class }}">{{ 'invoice.history.send_pdf'|trans }}</a>
            {% if item.again %}<a href="{{ item.again }}" class="{{ link_class }}">{{ 'invoice.history.send_again'|trans }}</a>{% endif %}
        </p>
    </div>
</li>
