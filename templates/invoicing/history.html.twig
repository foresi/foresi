{% extends 'layout/app.html.twig' %}

{% set badge = badge %}
{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'invoice.list.title'|trans, href: path('app_invoices')}, {label: invoice.number}] %}

{% block title %}{{ 'invoice.history.title'|trans({number: invoice.number}) }}{% endblock %}

{% block content %}
    {# A send from the dialog over this page comes back here with its message. #}
    {% set flashes %}
        {% for type, tone in {success: 'success', warning: 'warning', error: 'error'} %}
            {% for message in app.flashes(type) %}<twig:Ui:Alert :tone="tone">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% endfor %}
    {% endset %}
    {% if flashes|trim %}<div class="mb-4 grid gap-2">{{ flashes }}</div>{% endif %}
    <twig:Ui:Card :title="'invoice.history.card'|trans" icon="history">
        {# The Timeline's own rows, with the sends among them in time; a send shows what went out. #}
        <ol class="m-0 list-none p-0" data-invoice-history>
            {% for item in timeline %}
                {% if item.send is defined %}
                    {{ include('invoicing/_send_entry.html.twig', {item: item}) }}
                {% else %}
                    <li class="grid grid-cols-[20px_1fr] items-center gap-x-2 py-1.5 sm:grid-cols-[20px_9.5rem_1fr]" data-history-icon="{{ item.icon }}">
                        {# A removed payment reads quieter than one recorded. #}
                        {{ ux_icon('lucide:' ~ item.icon, {class: 'size-4 ' ~ (item.icon == 'banknote-x' ? 'text-muted' : 'text-green'), 'aria-hidden': 'true'}) }}
                        <time datetime="{{ item.datetime }}" class="num text-muted">{{ item.time }}</time>
                        <span class="min-w-0 text-text [overflow-wrap:anywhere] max-sm:col-start-2">{{ item.text }}</span>
                    </li>
                {% endif %}
            {% endfor %}
        </ol>
    </twig:Ui:Card>
{% endblock %}
