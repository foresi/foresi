{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'invoice.list.title_advance'|trans, href: path('app_advances')}, {label: 'advance.missing.tab'|trans}] %}

{% block title %}{{ 'advance.missing.title'|trans }}{% endblock %}

{% block content %}
    {% set messages %}
        {% for message in app.flashes('success') %}<twig:Ui:Alert tone="success" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('error') %}<twig:Ui:Alert tone="error" role="alert">{{ message }}</twig:Ui:Alert>{% endfor %}
    {% endset %}
    {% if messages|trim %}<div class="mb-4 grid gap-2">{{ messages }}</div>{% endif %}

    <div class="grid grid-cols-1 gap-4">
        <twig:Ui:Tabs :items="tabs" :label="'invoice.list.views'|trans" class="min-w-0" />
        <p class="m-0 text-small text-muted">{{ 'advance.missing.intro'|trans }}</p>
        <twig:Ui:DataTable :caption="'advance.missing.title'|trans" :columns="columns" :rows="rows" :actionToken="csrf_token(constant('App\\Invoicing\\Infrastructure\\Controller\\InvoiceListController::ACTION_TOKEN'))">
            <twig:block name="empty">
                <twig:Ui:EmptyState icon="circle-check" :title="'advance.missing.empty'|trans" />
            </twig:block>
        </twig:Ui:DataTable>
    </div>
{% endblock %}
