{#
    The payments of a stored invoice, outside the invoice form so their own forms never post it.
    "Pay" opens the pay dialog over the form; Remove asks first, in the shared confirmation, and
    for a bank payment says the movement goes back among the unmatched ones.
#}
{% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
<twig:Ui:Card :title="'invoice.payment.panel.title'|trans" icon="banknote" class="mt-4" data-payments="">
    <div class="grid gap-3">
        {% if payments.lines is empty %}
            <p class="m-0 text-muted" data-payments-empty>{{ 'invoice.payment.panel.empty'|trans }}</p>
        {% else %}
            <ul class="m-0 grid list-none divide-y divide-divider p-0">
                {% for line in payments.lines %}
                    <li class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-0.5 py-2 first:pt-0" data-payment="{{ line.id }}">
                        <time datetime="{{ line.datetime }}" class="num text-muted">{{ line.date }}</time>
                        <span class="min-w-0 text-text">
                            <span class="num font-medium text-ink">{{ line.amount }}</span>
                            <span class="text-muted"> · {% if line.movement %}<a href="{{ line.movement }}" data-payment-movement title="{{ 'invoice.payment.panel.movement'|trans }}" class="text-muted underline hover:text-ink {{ focus }}">{{ line.method }}</a>{% else %}{{ line.method }}{% endif %}</span>
                            {% if line.settlement %}<span class="block text-caption text-muted">{{ line.settlement }}</span>{% endif %}
                        </span>
                        <form method="post" action="{{ path('app_invoice_payment_cancel', {id: invoice.id, paymentId: line.id}) }}"
                            data-controller="confirm-submit" data-action="submit->confirm-submit#ask"
                            data-confirm-title="{{ line.confirm.title }}" data-confirm-text="{{ line.confirm.text }}" data-confirm-accept="{{ line.confirm.accept }}" data-confirm-cancel="{{ line.confirm.cancel }}" data-confirm-tone="{{ line.confirm.tone }}">
                            <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Invoicing\\Infrastructure\\Controller\\InvoicePaymentController::FORM_TOKEN')) }}">
                            <twig:Ui:Button type="submit" variant="ghost" size="sm" :aria-label="line.label">{{ 'invoice.payment.panel.remove'|trans }}</twig:Ui:Button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-divider pt-3">
            <dl class="m-0 flex flex-wrap gap-x-6 gap-y-1">
                <div class="flex gap-1.5"><dt class="text-muted">{{ 'invoice.payment.panel.paid'|trans }}</dt><dd class="num m-0 font-medium text-ink">{{ payments.paid }}</dd></div>
                {% if payments.remaining %}<div class="flex gap-1.5"><dt class="text-muted">{{ 'invoice.payment.panel.remaining'|trans }}</dt><dd class="num m-0 font-medium text-ink" data-payments-remaining>{{ payments.remaining }}</dd></div>{% endif %}
                {% if payments.overpaid %}<div class="flex gap-1.5"><dt class="text-badge-amber-text">{{ 'invoice.payment.panel.overpaid'|trans }}</dt><dd class="num m-0 font-medium text-badge-amber-text">{{ payments.overpaid }}</dd></div>{% endif %}
                {% if payments.toRefund %}<div class="flex gap-1.5"><dt class="text-badge-amber-text">{{ 'invoice.payment.panel.to_refund'|trans }}</dt><dd class="num m-0 font-medium text-badge-amber-text">{{ payments.toRefund }}</dd></div>{% endif %}
            </dl>
            {% if payments.payable and not payments.settled %}
                <twig:Ui:Button :href="path('app_invoice_pay', {id: invoice.id})" icon="banknote" data-dialog aria-haspopup="dialog" id="invoice-pay">{{ 'invoice.payment.panel.pay'|trans }}</twig:Ui:Button>
            {% endif %}
        </div>
    </div>
</twig:Ui:Card>
