{# Panel: one green block holds all a client needs to pay, beside who the document is between. #}
{% block head %}{% endblock %}

{% block body %}
    {% import 'invoicing/pdf/theme/_tables.html.twig' as t %}
    {% set s = {
        label: 'font-family:intertnum;font-size:7.5pt;color:#5e625c;margin:0;',
        name: 'font-family:intertnum;font-weight:bold;font-size:10pt;color:#1e2320;margin:0;',
        text: 'font-family:intertnum;font-size:8.5pt;color:#1e2320;margin:0;line-height:1.35;',
        small: 'font-family:intertnum;font-size:7.5pt;color:#5e625c;margin:0;',
        strong: 'font-family:intertnum;font-weight:bold;font-size:9.5pt;color:#1e2320;margin:0;',
        note: 'font-family:intertnum;font-weight:bold;font-size:8.5pt;color:#1e2320;margin:0;',
    } %}
    {% set on = 'font-family:intertnum;font-size:7.5pt;color:#dfe5df;margin:0;' %}
    {% set onValue = 'font-family:intertnum;font-weight:bold;font-size:10pt;color:#ffffff;margin:0;white-space:nowrap;' %}
    {% set big = doc.payable|length > 17 ? '15pt' : (doc.payable|length > 13 ? '19pt' : '24pt') %}
    <table cellpadding="0">
        <tr>
            <td width="54%">
                {% if doc.logo %}<img src="{{ doc.logo.path }}" alt="{{ doc.logo.alt }}" width="{{ doc.logo.width }}" height="{{ doc.logo.height }}">
                {% else %}<p style="font-family:interdisplay;font-size:16pt;color:#2f4a3a;margin:0;">{{ doc.issuer.name }}</p>{% endif %}
                <table cellpadding="0"><tr><td height="9mm"></td></tr></table>
                <h1 style="font-family:intertnum;font-weight:normal;font-size:9pt;color:#5e625c;margin:0;">{{ doc.title }}</h1>
                <p style="font-family:interdisplay;font-size:20pt;color:#1e2320;margin:0;">{{ doc.number }}</p>
                <table cellpadding="0"><tr><td height="9mm"></td></tr></table>
                {{ t.party(doc.customer, 'invoice.pdf.customer'|trans, doc, s, false) }}
                <table cellpadding="0"><tr><td height="6mm"></td></tr></table>
                {{ t.party(doc.issuer, 'invoice.pdf.supplier'|trans, doc, s, true) }}
            </td>
            <td width="3%"></td>
            <td width="43%" style="background-color:#2f4a3a;">
                <table cellpadding="16">
                    <tr>
                        <td width="100%">
                            <table cellpadding="0">
                                <tr>
                                    <td width="100%" height="{{ doc.hasQr ? '56mm' : '40mm' }}">
                                        <p style="{{ on }}">{{ 'invoice.pdf.payable'|trans }}</p>
                                        <p style="font-family:interdisplay;font-size:{{ big }};color:#ffffff;margin:0 0 6pt 0;white-space:nowrap;">{{ doc.payable }}</p>
                                        <p style="{{ on }}">{{ 'invoice.pdf.due_date'|trans }}</p>
                                        <p style="font-family:intertnum;font-weight:bold;font-size:13pt;color:#ffffff;margin:0 0 7pt 0;white-space:nowrap;">{{ doc.dueDate }}</p>
                                        {% if doc.account %}<p style="{{ on }}">{{ 'invoice.pdf.bank_account'|trans }}</p><p style="{{ onValue }}">{{ doc.account }}</p>{% endif %}
                                        {% if doc.iban %}<p style="{{ on }}white-space:nowrap;">IBAN: {{ doc.iban }}</p>{% endif %}
                                        {% if doc.variableSymbol %}<p style="{{ on }}margin-top:5pt;">{{ 'invoice.pdf.variable_symbol'|trans }}</p><p style="{{ onValue }}">{{ doc.variableSymbol }}</p>{% endif %}
                                        {% if doc.constantSymbol %}<p style="{{ on }}">{{ 'invoice.pdf.constant_symbol'|trans }}: {{ doc.constantSymbol }}</p>{% endif %}
                                    </td>
                                </tr>
                            </table>
                            <table cellpadding="0">
                                <tr>
                                    {% if doc.hasQr %}<td width="58%" height="38mm" style="background-color:#ffffff;"></td><td width="5%"></td>{% endif %}
                                    <td width="37%">
                                        {% if doc.hasQr %}<p style="{{ on }}">{{ 'invoice.pdf.qr_label'|trans }}</p>{% endif %}
                                        <p style="{{ on }}">{{ 'invoice.pdf.payment_method'|trans }}: {{ doc.paymentMethod }}</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    <table cellpadding="0"><tr><td height="6mm"></td></tr></table>
    <table cellpadding="0">
        <tr>
            <td width="33%"><span style="{{ s.label }}">{{ 'invoice.pdf.issue_date'|trans }}</span><br><span style="{{ s.text }}">{{ doc.issueDate }}</span></td>
            <td width="34%"><span style="{{ s.label }}">{{ doc.taxPointLabel }}</span><br><span style="{{ s.text }}">{{ doc.taxPointDate }}</span></td>
            <td width="33%">{% if doc.orderNumber %}<span style="{{ s.label }}">{{ 'invoice.pdf.order_number'|trans }}</span><br><span style="{{ s.text }}">{{ doc.orderNumber }}</span>{% endif %}</td>
        </tr>
    </table>
    <table cellpadding="0"><tr><td height="5mm"></td></tr></table>
    {% if doc.description or doc.textBefore %}
        {{ t.description(doc, s) }}
        <table cellpadding="0"><tr><td height="3mm"></td></tr></table>
    {% endif %}
    {{ t.items(doc, {
        padding: '4',
        table: 'font-family:intertnum;font-size:' ~ doc.tableFont ~ ';color:#1e2320;',
        th: 'font-weight:bold;color:#2f4a3a;background-color:#f4f2ec;',
        td: 'border-bottom:0.25pt solid #d9d6cc;',
        last: 'border-bottom:0.25pt solid #d9d6cc;',
    }) }}
    <table cellpadding="0"><tr><td height="5mm"></td></tr></table>
    {% if doc.textAfter or doc.notes %}
        {{ t.notes(doc, s) }}
        <table cellpadding="0"><tr><td height="4mm"></td></tr></table>
    {% endif %}
    <table cellpadding="0" nobr="true">
        <tr>
            <td width="36%">
                <p style="{{ s.label }}">{{ 'invoice.pdf.stamp'|trans }}</p>
                {% if doc.stamp %}<img src="{{ doc.stamp.path }}" alt="{{ doc.stamp.alt }}" width="{{ doc.stamp.width }}" height="{{ doc.stamp.height }}">{% endif %}
            </td>
            <td width="64%">
                {{ t.recap(doc, {
                    padding: '3',
                    table: 'font-family:intertnum;font-size:' ~ doc.tableFont ~ ';color:#1e2320;',
                    th: 'font-weight:normal;color:#5e625c;',
                    td: '',
                    sum: 'font-weight:bold;background-color:#f4f2ec;',
                }) }}
                <p style="font-family:intertnum;font-weight:bold;font-size:11pt;text-align:right;color:#2f4a3a;margin:6pt 0 0 0;">{{ 'invoice.pdf.payable'|trans }}: {{ doc.payable }}</p>
            </td>
        </tr>
    </table>
{% endblock %}
