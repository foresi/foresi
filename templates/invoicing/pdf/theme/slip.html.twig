{# Slip: a working document above, a payment slip to cut off along the foot of the last page. #}
{% block head %}
    {% import 'invoicing/pdf/theme/_tables.html.twig' as t %}
    {% set s = {
        label: 'font-family:intertnum;font-size:7pt;color:#5e625c;margin:0;',
        name: 'font-family:intertnum;font-weight:bold;font-size:10pt;color:#1e2320;margin:0;',
        text: 'font-family:intertnum;font-size:8pt;color:#1e2320;margin:0;line-height:1.3;',
        small: 'font-family:intertnum;font-size:7pt;color:#5e625c;margin:0;',
    } %}
    <table cellpadding="0">
        <tr>
            <td width="52%">
                {% if doc.logo %}<img src="{{ doc.logo.path }}" alt="{{ doc.logo.alt }}" width="{{ doc.logo.width }}" height="{{ doc.logo.height }}">
                {% else %}<p style="font-family:interdisplay;font-size:15pt;color:#2f4a3a;margin:0;">{{ doc.issuer.name }}</p>{% endif %}
            </td>
            <td width="48%" align="right">
                <h1 style="font-family:interdisplay;font-weight:normal;font-size:15pt;color:#2f4a3a;margin:0;">{{ doc.title }}</h1>
                <p style="font-family:intertnum;font-weight:bold;font-size:10pt;color:#1e2320;margin:0;">{{ doc.number }}</p>
            </td>
        </tr>
    </table>
    <table cellpadding="0"><tr><td height="8mm"></td></tr></table>
    <table cellpadding="0">
        <tr>
            <td width="52%">{{ t.party(doc.customer, 'invoice.pdf.customer'|trans, doc, s|merge({name: 'font-family:intertnum;font-weight:bold;font-size:12pt;color:#1e2320;margin:0;', text: 'font-family:intertnum;font-size:9.5pt;color:#1e2320;margin:0;line-height:1.3;'}), false) }}</td>
            <td width="48%">{{ t.party(doc.issuer, 'invoice.pdf.supplier'|trans, doc, s, true) }}</td>
        </tr>
    </table>
    <table cellpadding="0"><tr><td height="6mm"></td></tr></table>
    <table cellpadding="6" style="background-color:#f4f2ec;">
        <tr>
            <td width="21%"><span style="{{ s.label }}">{{ 'invoice.pdf.issue_date'|trans }}</span><br><span style="{{ s.text }}">{{ doc.issueDate }}</span></td>
            <td width="27%"><span style="{{ s.label }}">{{ doc.taxPointLabel }}</span><br><span style="{{ s.text }}">{{ doc.taxPointDate }}</span></td>
            <td width="21%"><span style="{{ s.label }}">{{ 'invoice.pdf.due_date'|trans }}</span><br><span style="font-family:intertnum;font-weight:bold;font-size:11pt;color:#1e2320;">{{ doc.dueDate }}</span></td>
            <td width="31%" align="right"><span style="{{ s.label }}">{{ 'invoice.pdf.payable'|trans }}</span><br><span style="font-family:intertnum;font-weight:bold;font-size:{{ doc.payable|length > 17 ? '9pt' : '11pt' }};color:#2f4a3a;white-space:nowrap;">{{ doc.payable }}</span></td>
        </tr>
    </table>
    <table cellpadding="0"><tr><td height="5mm"></td></tr></table>
{% endblock %}

{% block body %}
    {% import 'invoicing/pdf/theme/_tables.html.twig' as t %}
    {% set s = {
        label: 'font-family:intertnum;font-size:7pt;color:#5e625c;margin:0;',
        text: 'font-family:intertnum;font-size:8pt;color:#1e2320;margin:0;line-height:1.3;',
        strong: 'font-family:intertnum;font-weight:bold;font-size:9pt;color:#1e2320;margin:0;',
        note: 'font-family:intertnum;font-weight:bold;font-size:8pt;color:#1e2320;margin:0;',
    } %}
    {% if doc.description or doc.textBefore or doc.orderNumber %}
        {{ t.description(doc, s) }}
        {% if doc.orderNumber %}<p style="{{ s.label }}">{{ 'invoice.pdf.order_number'|trans }}: {{ doc.orderNumber }}</p>{% endif %}
        <table cellpadding="0"><tr><td height="3mm"></td></tr></table>
    {% endif %}
    {{ t.items(doc, {
        padding: '4',
        table: 'font-family:intertnum;font-size:' ~ doc.tableFont ~ ';color:#1e2320;',
        th: 'font-weight:bold;color:#ffffff;background-color:#2f4a3a;',
        td: 'border-bottom:0.25pt solid #d9d6cc;',
        last: 'border-bottom:0.75pt solid #2f4a3a;',
    }) }}
    <table cellpadding="0"><tr><td height="4mm"></td></tr></table>
    {% if doc.textAfter or doc.notes %}
        {{ t.notes(doc, s) }}
        <table cellpadding="0"><tr><td height="3mm"></td></tr></table>
    {% endif %}
    <table cellpadding="0" nobr="true">
        <tr>
            <td width="36%">
                <p style="{{ s.label }}">{{ 'invoice.pdf.stamp'|trans }}</p>
                {% if doc.stamp %}<img src="{{ doc.stamp.path }}" alt="{{ doc.stamp.alt }}" width="{{ doc.stamp.width }}" height="{{ doc.stamp.height }}">{% endif %}
            </td>
            <td width="64%">
                {{ t.recap(doc, {
                    padding: '3',
                    table: 'font-family:intertnum;font-size:' ~ doc.tableFont ~ ';color:#1e2320;',
                    th: 'font-weight:normal;color:#5e625c;border-bottom:0.25pt solid #d9d6cc;',
                    td: '',
                    sum: 'font-weight:bold;border-top:0.5pt solid #1e2320;',
                }) }}
            </td>
        </tr>
    </table>
{% endblock %}

{% block foot %}
    {% set label = 'font-family:intertnum;font-size:7pt;color:#5e625c;margin:0;' %}
    {% set value = 'font-family:intertnum;font-size:9pt;color:#1e2320;margin:0;' %}
    {% set strong = 'font-family:intertnum;font-weight:bold;font-size:11pt;color:#1e2320;margin:0;white-space:nowrap;' %}
    <table cellpadding="0"><tr><td height="5mm" style="border-top:0.75pt dashed #5e625c;"></td></tr></table>
    <table cellpadding="0">
        <tr>
            {% if doc.hasQr %}
                <td width="22%" height="38mm"><p style="{{ label }}">{{ 'invoice.pdf.qr_label'|trans }}</p></td>
            {% endif %}
            <td width="{{ doc.hasQr ? '44%' : '60%' }}">
                <p style="{{ label }}">{{ 'invoice.pdf.supplier'|trans }}</p>
                <p style="{{ value }}">{{ doc.issuer.name }}</p>
                {% if doc.account %}<p style="{{ label }}margin-top:3pt;">{{ 'invoice.pdf.bank_account'|trans }}</p><p style="{{ strong }}">{{ doc.account }}</p>{% endif %}
                {% if doc.iban %}<p style="{{ value }}font-size:8pt;white-space:nowrap;">IBAN: {{ doc.iban }}</p>{% endif %}
                {% if doc.variableSymbol %}<p style="{{ label }}margin-top:3pt;">{{ 'invoice.pdf.variable_symbol'|trans }}</p><p style="{{ strong }}">{{ doc.variableSymbol }}</p>{% endif %}
                {% if doc.constantSymbol %}<p style="{{ label }}">{{ 'invoice.pdf.constant_symbol'|trans }}: {{ doc.constantSymbol }}</p>{% endif %}
                <p style="{{ label }}">{{ 'invoice.pdf.payment_method'|trans }}: {{ doc.paymentMethod }}</p>
            </td>
            <td width="{{ doc.hasQr ? '34%' : '40%' }}" align="right">
                <p style="{{ label }}">{{ 'invoice.pdf.payable'|trans }}</p>
                <p style="font-family:interdisplay;font-size:{{ doc.payable|length > 17 ? '13pt' : (doc.payable|length > 13 ? '17pt' : '22pt') }};color:#2f4a3a;margin:0 0 6pt 0;white-space:nowrap;">{{ doc.payable }}</p>
                <p style="{{ label }}">{{ 'invoice.pdf.due_date'|trans }}</p>
                <p style="{{ strong }}">{{ doc.dueDate }}</p>
            </td>
        </tr>
    </table>
{% endblock %}
