{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.sales'|trans}, {label: 'recurring.list.title'|trans}] %}

{% block title %}{{ 'recurring.list.title'|trans }}{% endblock %}

{% block actions %}
    {% if not firstRun %}
        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_recurring_new')" data-turbo="false">{{ 'recurring.form.new_title'|trans }}</twig:Ui:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {% set messages %}
        {% for message in app.flashes('success') %}<twig:Ui:Alert tone="success" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('warning') %}<twig:Ui:Alert tone="warning" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('error') %}<twig:Ui:Alert tone="error" role="alert">{{ message }}</twig:Ui:Alert>{% endfor %}
    {% endset %}
    {% if messages|trim %}<div class="mb-4 grid gap-2">{{ messages }}</div>{% endif %}

    {% if firstRun %}
        <twig:Ui:EmptyState icon="refresh-cw" :title="'recurring.list.empty.title'|trans" :text="'recurring.list.empty.text'|trans">
            <twig:Ui:Button variant="primary" icon="plus" :href="path('app_recurring_new')" data-turbo="false">{{ 'recurring.form.new_title'|trans }}</twig:Ui:Button>
            <twig:Ui:Button :href="path('app_invoices')">{{ 'recurring.list.empty.from_invoice'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            <div class="flex flex-wrap items-end justify-between gap-3">
                <twig:Ui:Tabs :items="tabs" :label="'recurring.list.views'|trans" class="min-w-0 flex-1" />
                {% if firms is not empty %}
                    <form method="get" action="{{ path('app_recurring') }}" class="flex w-full flex-wrap items-end gap-2 sm:w-auto max-sm:[&_button]:h-control-lg max-sm:[&_select]:h-control-lg">
                        {% if tab != 'active' %}<input type="hidden" name="tab" value="{{ tab }}">{% endif %}
                        <div class="min-w-0 flex-1 sm:w-52 sm:flex-none"><twig:Ui:Select name="firm" id="recurring-firm" :label="'invoice.field.firm'|trans" :options="firms" :value="firm" /></div>
                        <twig:Ui:Button type="submit" icon="list-filter">{{ 'recurring.list.filter'|trans }}</twig:Ui:Button>
                    </form>
                {% endif %}
            </div>

            <twig:Ui:DataTable :caption="'recurring.list.title'|trans" :columns="columns" :rows="rows">
                <twig:block name="empty">
                    {% if filtered %}
                        <twig:Ui:EmptyState icon="search" :title="'recurring.list.empty.filtered_title'|trans">
                            <twig:Ui:Button :href="path('app_recurring', tab == 'active' ? {} : {tab: tab})">{{ 'recurring.list.empty.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% else %}
                        <twig:Ui:EmptyState :icon="tab == 'failing' ? 'circle-check' : 'refresh-cw'" :title="('recurring.list.empty.' ~ tab)|trans" />
                    {% endif %}
                </twig:block>
                <twig:block name="footer">
                    <span class="num">{{ 'recurring.list.summary'|trans({total: page.total}) }}</span>
                    <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                </twig:block>
            </twig:Ui:DataTable>
        </div>
    {% endif %}
{% endblock %}
