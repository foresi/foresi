{#
    "Opakování vystavení", in iDoklad's order: repeat, first issue, last day of the month, every N, the
    next issue in one line with the dates after it in a dialog, then the end. The line moves with every
    change of the form. One group of the form's band: labels in the label column, fields in the field column.
#}
{% set monthly = values.unit in ['month', 'year'] %}
{% set column = 'md:pl-[calc(var(--spacing-label)+1rem)]' %}
<twig:Ui:FieldGroup :title="'recurring.card.schedule'|trans">
    <twig:Ui:Select name="unit" id="unit" :row="true" width="medium" :label="'recurring.field.unit'|trans" :options="units" :value="values.unit" :error="errorFields.unit|default(null)" data-recurring-schedule-target="unit" data-action="change->recurring-schedule#unitChanged" />
    <twig:Ui:TextInput name="firstIssueOn" id="firstIssueOn" type="date" :row="true" width="short" :label="'recurring.field.firstIssueOn'|trans" :value="values.firstIssueOn" :error="errorFields.firstIssueOn|default(null)" :required="true" />
    <div class="{{ column }}"{% if not monthly %} hidden{% endif %} data-recurring-schedule-target="lastDay">
        <twig:Ui:Checkbox name="onLastDayOfMonth" id="onLastDayOfMonth" :label="'recurring.field.onLastDayOfMonth'|trans" value="1" :checked="values.onLastDayOfMonth == '1'" :error="errorFields.onLastDayOfMonth|default(null)" />
    </div>
    {{ include('invoicing/recurring/_stepper.html.twig', {id: 'every', label: 'recurring.field.every'|trans, help: 'recurring.field.every_help'|trans, error: errorFields.every|default(null), value: values.every, min: 1, max: 99, maxlength: 2}, with_context = false) }}
    <div class="{{ column }}">
        {{ include('invoicing/recurring/_preview.html.twig') }}
    </div>
    <twig:Ui:Select name="end" id="end" :row="true" width="medium" :label="'recurring.field.end'|trans" :options="ends" :value="values.end" :error="errorFields.end|default(null)" data-recurring-schedule-target="end" data-action="change->recurring-schedule#endChanged" />
    <div{% if values.end != 'on_date' %} hidden{% endif %} data-recurring-schedule-target="endOn">
        <twig:Ui:TextInput name="endOn" id="endOn" type="date" :row="true" width="short" :label="'recurring.field.endOn'|trans" :value="values.endOn" :error="errorFields.endOn|default(null)" />
    </div>
    <div{% if values.end != 'after_count' %} hidden{% endif %} data-recurring-schedule-target="endAfter">
        <twig:Ui:TextInput name="endAfter" id="endAfter" :row="true" width="short" :label="'recurring.field.endAfter'|trans" :value="values.endAfter" :error="errorFields.endAfter|default(null)" inputmode="numeric" autocomplete="off" maxlength="3" />
    </div>
    <div class="{{ column }}" data-invoice-form-target="noScript">
        <twig:Ui:Button type="submit" name="_action" value="refresh" size="sm">{{ 'recurring.form.apply'|trans }}</twig:Ui:Button>
    </div>
    {# Outside the frame, so a refresh of the preview never closes it; the controller copies the dates in. #}
    <twig:Ui:Dialog id="recurring-all" :title="'recurring.preview.all'|trans" size="sm">
        <div data-recurring-schedule-target="dialogList"></div>
        <twig:block name="footer">
            <twig:Ui:Button data-action="dialog#close">{{ 'ui.dialog.close'|trans }}</twig:Ui:Button>
        </twig:block>
    </twig:Ui:Dialog>
</twig:Ui:FieldGroup>
