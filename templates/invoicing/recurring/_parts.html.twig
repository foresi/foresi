{#
    The parts of the recurring form that follow what was typed. Each has an id and data-recurring-live:
    the form draws them in place, and the preview answers with them, which the schedule controller puts
    over the ones on the page. Only text is replaced, never a field, so the focus stays where it is.
#}

{# The addresses a box of "Odesílání faktury" sends to, under its label; with none, the box is disabled (data-recurring-empty). #}
{% macro addresses(id, addresses) %}
    <p id="{{ id }}" class="m-0 break-all pl-6 text-caption text-muted" data-recurring-live{% if addresses is empty %} data-recurring-empty{% endif %}>
        {{- addresses is empty ? 'recurring.sending.no_email'|trans : addresses|join(', ') -}}
    </p>
{% endmacro %}

{# The chosen account as the invoice prints it, read-only: rows of the form, terms in the label column. #}
{% macro account(account) %}
    {% set rowClass = 'grid content-start gap-1.5 md:grid-cols-[var(--spacing-label)_minmax(0,1fr)] md:gap-x-4' %}
    {% set termClass = 'text-small font-medium text-ink md:text-right' %}
    <dl id="recurring-account" class="m-0 grid gap-1.5" data-recurring-live>
        {% if account %}
            {% if account.number %}
                <div class="{{ rowClass }}">
                    <dt class="{{ termClass }}">{{ 'recurring.payment.account_number'|trans }}</dt>
                    <dd class="num m-0 break-all text-ink" data-account-number>{{ account.number }}</dd>
                </div>
            {% endif %}
            <div class="{{ rowClass }}">
                <dt class="{{ termClass }}">{{ 'recurring.payment.iban'|trans }}</dt>
                <dd class="num m-0 break-all text-ink" data-account-iban>{{ account.iban }}</dd>
            </div>
        {% endif %}
    </dl>
{% endmacro %}

{# The variables of a period as chips; one goes into the field that had the focus last: the description, a text or an item. #}
{% macro variables(id, variables, focus) %}
    <div class="flex flex-wrap items-center gap-1">
        <span id="{{ id }}" class="inline-flex items-center gap-1 text-caption font-medium text-muted" title="{{ 'recurring.variables.help'|trans }}">{{ 'recurring.variables.title'|trans }}{{ ux_icon('lucide:circle-help', {class: 'size-3.5', 'aria-hidden': 'true'}) }}</span>
        <span id="{{ id }}-help" class="sr-only">{{ 'recurring.variables.help'|trans }}</span>
        {# A toolbar: one Tab stop, the arrow keys move between the chips. #}
        <div role="toolbar" aria-labelledby="{{ id }}" aria-describedby="{{ id }}-help" class="flex flex-wrap gap-1" data-action="keydown->mail-chips#move">
            {% for variable in variables %}
                <button type="button" draggable="true" tabindex="{{ loop.first ? 0 : -1 }}" data-token="{{ variable.token }}" data-mail-chips-target="chip" data-action="mail-chips#insert dragstart->mail-chips#drag" title="{{ variable.token }}" class="inline-flex h-badge cursor-grab select-none items-center rounded-sm border border-control-line bg-white px-1.5 text-caption font-medium text-text hover:border-muted active:cursor-grabbing {{ focus }}">{{ variable.label }}</button>
            {% endfor %}
        </div>
    </div>
{% endmacro %}
