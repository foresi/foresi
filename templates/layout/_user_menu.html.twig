{#
    The account menu behind the avatar at the bottom of the rail: the person, the firm being worked
    in and the switch to another firm, language and sign-out. In the phone app bar the avatar is the
    last action, a 44 x 44 px target around the 36 px tile (Apple HIG, Buttons), and the menu opens
    below it, kept inside the viewport by the dropdown controller (Android Developers, "Menus").
    Variables: shell (ShellView).
#}
{% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
{% set orgName = shell.organisation ? shell.organisation.name : 'shell.organisation.none'|trans %}
<twig:Ui:Menu id="user-menu" buttonId="user-menu-button" :label="'shell.user_menu.label'|trans" :menuLabel="'shell.user_menu.label'|trans" placement="above" align="start" :float="true" menuClass="min-w-60 max-w-[min(340px,calc(100vw-24px))]" class="shell:mt-1.5">
    <twig:block name="trigger">
        <button type="button" id="user-menu-button" data-dropdown-target="button" data-action="dropdown#toggle keydown->dropdown#openFromButton" aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" title="{{ shell.userName }} · {{ orgName }}" class="group grid size-9 cursor-pointer place-items-center rounded-control border-0 bg-transparent text-caption font-semibold text-green shell:bg-green-tint shell:hover:bg-badge-green max-shell:size-touch {{ focus }}">
            <span aria-hidden="true" class="max-shell:grid max-shell:size-9 max-shell:place-items-center max-shell:rounded-control max-shell:bg-green-tint max-shell:group-hover:bg-badge-green">{{ shell.initials }}</span>
            <span class="sr-only">{{ 'shell.user_menu.label'|trans }}: {{ shell.userName }}, {{ orgName }}</span>
        </button>
    </twig:block>
    <div class="px-3 pb-2 pt-1.5">
        {% if shell.userName != shell.userEmail %}<b class="block text-small leading-tight text-ink [overflow-wrap:anywhere]">{{ shell.userName }}</b>{% endif %}
        <small class="mt-0.5 block text-caption text-muted [overflow-wrap:anywhere]">{{ shell.userEmail }}</small>
        <div data-organisation class="mt-2 flex items-center gap-2">
            <span class="grid size-6 shrink-0 place-items-center rounded-sm bg-green text-caption font-semibold text-white" aria-hidden="true">{{ orgName|first|upper }}</span>
            <span class="min-w-0">
                <b class="block text-small leading-tight text-ink [overflow-wrap:anywhere]">{{ orgName }}</b>
                {% if shell.organisation %}<small class="block text-caption text-muted">{{ ('role.' ~ shell.organisation.role.value)|trans }}</small>{% endif %}
            </span>
        </div>
    </div>
    <twig:Ui:MenuSection>
        <twig:Ui:MenuItem icon="user" :disabled="true">{{ 'shell.user_menu.profile'|trans }}<span class="ml-auto text-caption font-normal text-muted">{{ 'shell.user_menu.soon'|trans }}</span></twig:Ui:MenuItem>
        <twig:Ui:MenuItem :href="path('app_notification_settings')" icon="bell-ring" data-user-menu-notifications>{{ 'shell.user_menu.notifications'|trans }}</twig:Ui:MenuItem>
        {% if shell.organisation and shell.organisation.role.isStaff %}
            <twig:Ui:MenuItem :href="path('app_api_tokens')" icon="key-round">{{ 'shell.user_menu.api_access'|trans }}</twig:Ui:MenuItem>
        {% endif %}
        <form method="post" action="{{ path('app_account_language') }}" data-turbo="false" role="none">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Identity\\Infrastructure\\Controller\\LanguageController::TOKEN_ID')) }}">
            <input type="hidden" name="locale" value="{{ shell.otherLocale }}">
            <input type="hidden" name="redirect" value="{{ app.request.requestUri }}" data-nav-sync>
            <twig:Ui:MenuItem type="submit" icon="languages">{{ 'shell.user_menu.language'|trans({language: ('locale.' ~ shell.otherLocale)|trans}) }}</twig:Ui:MenuItem>
        </form>
        {% if shell.organisations|length > 1 %}
            <twig:Ui:MenuItem :href="path('app_organisation_choose')" icon="building-2">{{ 'shell.user_menu.switch_organisation'|trans }}</twig:Ui:MenuItem>
        {% endif %}
    </twig:Ui:MenuSection>
    <twig:Ui:MenuSection>
        <form method="post" action="{{ path('app_logout') }}" data-turbo="false" role="none">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <twig:Ui:MenuItem type="submit" icon="log-out">{{ 'auth.logout'|trans }}</twig:Ui:MenuItem>
        </form>
    </twig:Ui:MenuSection>
</twig:Ui:Menu>
