{#
    The page frame of every signed-in page: the rail of areas, the sidebar of the current area, and one
    white panel with the page header. On a phone the rail and the sidebar are one drawer.
    Pages extend it and fill the blocks "title" (plain text), "actions" (header buttons) and "content".
    The timer the person runs shows in a bar over the page header, on every page.
    Breadcrumbs are given as a "crumbs" variable: {% set crumbs = [{label: 'Contacts', href: path('...')}, {label: 'Detail'}] %}.
    A status badge next to the title is given as a "badge" variable: {% set badge = {label: 'Archived', tone: 'gray'} %};
    more after it as "badges", each with an optional icon: {% set badges = [{label: 'Private', tone: 'gray', icon: 'lock'}] %}.
#}
{% extends 'base.html.twig' %}

{% block body %}
    {% set shell = shell() %}
    {% set pageTitle = block('title')|striptags|html_decode|trim %}
    {% set headerActions %}{% block actions %}{% endblock %}{% endset %}
    {% set areas = nav_areas(app.current_route, shell.tenantActive) %}
    {# The rail and the sidebar are kept across Turbo visits; the nav controller copies the state the server renders for the next page onto them. #}
    {% set navKey = [app.request.locale, shell.userEmail, shell.organisation ? shell.organisation.id.toString : '', shell.organisation ? shell.organisation.role.value : '']|join('|') %}
    <div class="grid min-h-screen shell:grid-cols-[var(--spacing-rail)_var(--spacing-sidebar)_minmax(0,1fr)] max-shell:p-2" data-controller="sidebar nav">
        <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-control focus:bg-white focus:px-3 focus:py-2 focus:text-ink focus:outline-2 focus:outline-green">{{ 'shell.skip_to_content'|trans }}</a>
        <div hidden data-sidebar-target="scrim" data-action="click->sidebar#close" class="fixed inset-0 z-30 bg-ink/25 shell:hidden"></div>
        {# Wide screen: the rail and the sidebar are grid columns. Phone: one drawer, the rail its top row. #}
        <div id="navigation" data-sidebar-target="panel" class="shell:contents max-shell:invisible max-shell:fixed max-shell:inset-y-0 max-shell:left-0 max-shell:z-40 max-shell:flex max-shell:w-[82%] max-shell:max-w-80 max-shell:flex-col max-shell:bg-frame max-shell:data-[open]:visible">
            <nav id="rail" data-turbo-permanent data-nav-key="{{ navKey }}" aria-label="{{ 'shell.rail_label'|trans }}" class="flex items-center gap-2 px-3 pb-1 pt-3 shell:sticky shell:top-0 shell:z-10 shell:h-screen shell:flex-col shell:gap-1 shell:overflow-y-auto shell:px-2 shell:py-3.5">
                {% include 'layout/_rail.html.twig' with {shell: shell, areas: areas} only %}
            </nav>
            <aside id="sidebar" data-turbo-permanent data-nav-key="{{ navKey }}" class="min-h-0 flex-1 overflow-y-auto px-3 pb-3 pt-2 shell:sticky shell:top-0 shell:h-screen shell:pb-4 shell:pl-1.5 shell:pr-2.5 shell:pt-4">
                {% include 'layout/_sidebar.html.twig' with {areas: areas} only %}
            </aside>
        </div>
        <main id="main" tabindex="-1" data-sidebar-target="page" class="min-w-0 rounded-xl border border-container bg-white shadow-raised outline-none [view-transition-name:content] shell:my-2.5 shell:mr-2.5">
            <div class="flex items-center gap-2 border-b border-divider px-3.5 py-2 shell:hidden">
                <twig:Ui:IconButton icon="menu" :label="'shell.menu.open'|trans" variant="ghost" data-sidebar-target="toggle" data-action="sidebar#toggle" aria-controls="navigation" aria-expanded="false" />
                <span class="font-semibold text-ink">{{ product_name }}</span>
            </div>
            {% if shell and shell.tenantActive %}{% include 'work/_running_timer.html.twig' %}{% endif %}
            <twig:Ui:PageHeader :title="pageTitle" :crumbs="crumbs|default([])" :badge="badge|default(null)" :badges="badges|default([])">{{ headerActions }}</twig:Ui:PageHeader>
            <div class="p-6 max-shell:p-3.5">
                {% set notices = shell_notices(shell ? shell.tenantActive : false) %}
                {% if notices is not empty %}
                    <div data-shell-notices class="mb-4 grid gap-2">
                        {% for notice in notices %}
                            <twig:Ui:Alert :tone="notice.tone">
                                <span>{{ notice.text }}</span>
                                <a href="{{ notice.href }}" class="ml-1 font-semibold text-current underline underline-offset-2 {{ constant('App\\Ui\\Component\\Style::FOCUS') }}">{{ notice.linkLabel }}</a>
                            </twig:Ui:Alert>
                        {% endfor %}
                    </div>
                {% endif %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
    {% include 'layout/_dialogs.html.twig' %}
{% endblock %}
