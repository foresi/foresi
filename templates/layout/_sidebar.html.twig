{# Variables: shell (ShellView). #}
{% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
{% set groups = nav_groups(app.current_route, shell.tenantActive) %}
{% set commands = [] %}
{% for group in groups %}
    {% for item in group.items %}
        {% set commands = commands|merge([{label: item.labelKey|trans, href: path(item.route), icon: item.icon, group: 'shell.palette.go_to'|trans}]) %}
        {% if item.commandRoute %}
            {% set commands = commands|merge([{label: item.commandLabelKey|trans, href: path(item.commandRoute), icon: 'plus', group: 'shell.palette.go_to'|trans}]) %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% set orgName = shell.organisation ? shell.organisation.name : 'shell.organisation.none'|trans %}
{% set orgClass = 'flex items-center gap-2.5 rounded-panel border border-container bg-white p-2.5 text-left no-underline' %}
{% set orgContent %}
    <span class="grid size-8 shrink-0 place-items-center rounded-control bg-green font-bold text-white" aria-hidden="true">{{ orgName|first|upper }}</span>
    <span class="min-w-0">
        <b class="line-clamp-2 block text-body leading-tight text-ink [overflow-wrap:anywhere]" title="{{ orgName }}">{{ orgName }}</b>
        {% if shell.organisation %}<small class="block truncate text-caption text-muted">{{ ('role.' ~ shell.organisation.role.value)|trans }}</small>{% endif %}
    </span>
{% endset %}
{% if shell.organisations|length > 1 %}
    <a href="{{ path('app_organisation_choose') }}" data-organisation class="{{ orgClass }} hover:bg-head {{ focus }}" aria-label="{{ 'shell.organisation.switch'|trans }}: {{ orgName }}">
        {{ orgContent }}
        {{ ux_icon('lucide:chevrons-up-down', {class: 'ml-auto size-4 shrink-0 text-muted', 'aria-hidden': 'true'}) }}
    </a>
{% else %}
    <div data-organisation class="{{ orgClass }}">{{ orgContent }}</div>
{% endif %}

<div class="mb-1 mt-3">
    <twig:Ui:CommandPalette :commands="commands" />
</div>

{% macro item(entry, focus) %}
    <a href="{{ path(entry.route) }}"{% if entry.current %} aria-current="page"{% endif %} class="flex h-control items-center gap-2.5 rounded-control border px-2.5 no-underline {{ entry.current ? 'border-container bg-white font-medium text-ink shadow-raised' : 'border-transparent text-text hover:bg-frame-hover' }} {{ focus }}">
        {{ ux_icon('lucide:' ~ entry.icon, {class: 'size-4 shrink-0 ' ~ (entry.current ? 'text-green' : ''), 'aria-hidden': 'true'}) }}
        <span class="truncate">{{ entry.labelKey|trans }}</span>
        {% if entry.count is not null %}<span data-nav-count class="num ml-auto inline-flex h-badge items-center rounded-sm px-1.5 text-caption font-medium {{ entry.current ? 'bg-green-tint text-green' : 'bg-frame-hover text-muted' }}">{{ entry.count }}</span>{% endif %}
    </a>
{% endmacro %}

<nav aria-label="{{ 'shell.sidebar_label'|trans }}" class="flex-1">
    {% for group in groups|filter(g => g.key != 'settings') %}
        <section data-nav-group="{{ group.key }}" aria-labelledby="nav-group-{{ group.key }}">
            <h2 id="nav-group-{{ group.key }}" class="{{ 'main' == group.key ? 'sr-only' : 'mx-2.5 mb-1.5 mt-4 text-caption font-semibold uppercase tracking-wide text-muted' }}">{{ group.labelKey|trans }}</h2>
            <ul class="m-0 grid list-none gap-0.5 p-0">
                {% for entry in group.items %}<li>{{ _self.item(entry, focus) }}</li>{% endfor %}
            </ul>
        </section>
    {% endfor %}
</nav>

<div class="mt-4">
    {% for group in groups|filter(g => g.key == 'settings') %}
        <ul data-nav-group="settings" class="m-0 grid list-none gap-0.5 p-0">
            {% for entry in group.items %}<li>{{ _self.item(entry, focus) }}</li>{% endfor %}
        </ul>
    {% endfor %}
    {% include 'layout/_user_menu.html.twig' with {shell: shell} only %}
</div>
