{# The owner invites a person by e-mail: a member, or an external person who represents a contact. #}
{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'people.title'|trans, href: path('app_people')}, {label: 'people.invite_title'|trans}] %}
{% set form_invalid = errors is not empty %}

{% block title %}{{ 'people.invite_title'|trans }}{% endblock %}

{% block content %}
    <form method="post" action="{{ path('app_people_invite') }}" class="grid max-w-4xl gap-4" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Identity\\Infrastructure\\Controller\\PeopleController::TOKEN')) }}">

        {% if errors.form is defined %}
            <twig:Ui:Alert tone="error">{{ errors.form }}</twig:Ui:Alert>
        {% endif %}

        <twig:Ui:Card :title="'people.invite_card'|trans" icon="user-plus">
            <div class="grid gap-3 sm:grid-cols-2">
                <twig:Ui:TextInput name="email" id="email" type="email" :label="'people.field.email'|trans" :value="values.email" :error="errors.email|default(null)" maxlength="255" required autocomplete="off" spellcheck="false" />
                <twig:Ui:TextInput name="name" id="name" :label="'people.field.name'|trans" :help="'people.field.name_help'|trans" :value="values.name" :error="errors.name|default(null)" maxlength="255" required autocomplete="off" />
                <twig:Ui:Select name="role" id="role" :label="'people.field.role'|trans" :help="'people.field.role_help'|trans" :options="roles" :value="values.role" :error="errors.role|default(null)" />
                <twig:Ui:Select name="locale" id="locale" :label="'people.field.locale'|trans" :help="'people.field.locale_help'|trans" :options="locales" :value="values.locale" />
                <div class="sm:col-span-2"><twig:Ui:Combobox name="contactId" id="contact" textName="contactQuery" width="long" :label="'people.field.contact'|trans" :help="'people.field.contact_help'|trans" :placeholder="'people.field.contact_placeholder'|trans" :value="values.contactId" :text="values.contactQuery" :url="path('app_people_contacts')" :emptyText="'people.field.contact_empty'|trans" :error="errors.contact|default(null)" /></div>
            </div>
        </twig:Ui:Card>

        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_people')">{{ 'people.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" variant="primary" icon="send">{{ 'people.invite_submit'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </form>
{% endblock %}
