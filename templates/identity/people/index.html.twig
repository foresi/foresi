{#
    The people of the organisation: who belongs to it, and for the owner the pending invitations.
    The staff see the list; only the owner gets the tabs, the invitation and the row actions.
#}
{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'people.title'|trans}] %}

{% block title %}{{ 'people.title'|trans }}{% endblock %}

{% block actions %}
    {% if owner %}<twig:Ui:Button variant="primary" icon="user-plus" :href="path('app_people_invite')">{{ 'people.invite'|trans }}</twig:Ui:Button>{% endif %}
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    {% if owner %}<div class="mb-4">{% include 'identity/people/_tabs.html.twig' with {active: tab, pendingCount: pendingCount} only %}</div>{% endif %}
    <twig:Ui:DataTable :caption="(tab == 'people' ? 'people.tab.people' : 'people.tab.invitations')|trans" :columns="columns" :rows="rows" :actionToken="owner ? csrf_token(constant('App\\Identity\\Infrastructure\\Controller\\PeopleController::TOKEN')) : null">
        <twig:block name="empty">
            {% if tab == 'invitations' %}
                <twig:Ui:EmptyState icon="send" :title="'people.invitations.empty.title'|trans" :text="'people.invitations.empty.text'|trans">
                    <twig:Ui:Button variant="primary" icon="user-plus" :href="path('app_people_invite')">{{ 'people.invite'|trans }}</twig:Ui:Button>
                </twig:Ui:EmptyState>
            {% endif %}
        </twig:block>
    </twig:Ui:DataTable>
{% endblock %}
