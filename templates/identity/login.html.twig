{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'login.title'|trans }}</h1>

    {% if error %}
        <p role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <p>
            <label for="username">{{ 'login.email'|trans }}</label>
            <input type="email" id="username" name="_username" value="{{ lastUsername }}" autocomplete="username" required autofocus>
        </p>
        <p>
            <label for="password">{{ 'login.password'|trans }}</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>
        </p>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">{{ 'login.submit'|trans }}</button>
    </form>
{% endblock %}
