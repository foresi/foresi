{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'dashboard.title'|trans }}</h1>
    <p>{{ 'dashboard.signed_in_as'|trans({email: app.user.userIdentifier}) }}</p>
    <p><a href="{{ path('app_logout') }}">{{ 'auth.logout'|trans }}</a></p>
{% endblock %}
