{#
    The inbox: one row per task, newest first, the latest event and who did it. "Nové" holds what is
    not done, "Hotové" what is, kept three months; the filter narrows both to mentions or assignments.
    Opening a task reads its row; the links are not prefetched on hover, which would read it too.
#}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'work.notifications.title'|trans }}{% endblock %}

{% block actions %}
    {% if unread > 0 %}
        <form method="post" action="{{ readAllUrl }}" data-notifications-read-all>
            <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Work\\Infrastructure\\Controller\\NotificationController::TOKEN')) }}">
            <twig:Ui:Button type="submit" icon="check">{{ 'work.notifications.read_all'|trans }}</twig:Ui:Button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 gap-4">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <twig:Ui:Tabs :items="tabs" :label="'work.notifications.views'|trans" class="min-w-0 flex-1" />
            <form method="get" action="{{ path('app_notifications') }}" role="search" class="flex w-full flex-wrap items-end gap-2 sm:w-auto max-sm:[&_button]:h-control-lg max-sm:[&_a]:h-control-lg" data-notifications-filter>
                {% if done %}<input type="hidden" name="tab" value="done">{% endif %}
                <div class="w-full min-w-0 sm:w-44"><twig:Ui:Select name="filter" id="filter-kind" :label="'work.notifications.filter.label'|trans" :options="filters" :value="filter" /></div>
                <twig:Ui:Button type="submit" icon="list-filter">{{ 'work.filter.apply'|trans }}</twig:Ui:Button>
                {% if filter != 'all' %}<twig:Ui:Button variant="ghost" :href="path('app_notifications', done ? {tab: 'done'} : {})">{{ 'work.filter.reset'|trans }}</twig:Ui:Button>{% endif %}
            </form>
        </div>

        {% if done %}<p class="m-0 text-small text-muted" data-notifications-kept>{{ 'work.notifications.kept'|trans }}</p>{% endif %}

        <twig:Ui:DataTable :caption="'work.notifications.title'|trans" :columns="columns" :rows="rows" :actionToken="csrf_token(constant('App\\Work\\Infrastructure\\Controller\\NotificationController::TOKEN'))" data-notifications data-turbo-prefetch="false">
            <twig:block name="empty">
                {% set empty = done ? 'done' : 'new' %}
                <twig:Ui:EmptyState icon="inbox" :title="('work.notifications.empty.' ~ empty ~ '_title')|trans" :text="(filter != 'all' ? 'work.notifications.empty.filtered' : 'work.notifications.empty.' ~ empty ~ '_text')|trans" data-notifications-empty />
            </twig:block>
            <twig:block name="footer">
                {%- if pages > 1 -%}
                    <span></span>
                    <twig:Ui:Pagination :page="page" :pages="pages" :baseUrl="baseUrl" />
                {%- endif -%}
            </twig:block>
        </twig:Ui:DataTable>
    </div>
{% endblock %}
