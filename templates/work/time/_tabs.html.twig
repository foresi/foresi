    {label: 'work.time.tab.week'|trans, href: path('app_time'), active: active == 'week'},
    {label: 'work.time.tab.report'|trans, href: path('app_time_report'), active: active == 'report'},
]" :label="'work.time.views'|trans" class="min-w-0 flex-1" />
