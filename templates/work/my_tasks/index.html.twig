{#
    My unfinished tasks: those I am responsible for, or those I watch, in groups by when they are
    due. A group with nothing in it is left out; the client filter narrows both tabs.
#}
{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.my_tasks.title'|trans}] %}

{% block title %}{{ 'work.my_tasks.title'|trans }}{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 gap-4">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <twig:Ui:Tabs :items="tabs" :label="'work.my_tasks.views'|trans" class="min-w-0 flex-1" />
            <form method="get" action="{{ path('app_my_tasks') }}" role="search" class="flex w-full flex-wrap items-end gap-2 sm:w-auto max-sm:[&_button]:h-control-lg" data-my-tasks-filter>
                {% if watching %}<input type="hidden" name="tab" value="watching">{% endif %}
                <div class="w-full min-w-0 sm:w-56"><twig:Ui:Select name="client" id="filter-client" :label="'work.my_tasks.client'|trans" :options="clients" :value="client" /></div>
                <twig:Ui:Button type="submit" icon="list-filter">{{ 'work.filter.apply'|trans }}</twig:Ui:Button>
                {% if client %}<twig:Ui:Button variant="ghost" :href="path('app_my_tasks', watching ? {tab: 'watching'} : {})">{{ 'work.filter.reset'|trans }}</twig:Ui:Button>{% endif %}
            </form>
        </div>

        {% for group in groups %}
            <section class="grid gap-2" aria-labelledby="group-{{ group.key }}-title" data-task-group="{{ group.key }}">
                <h2 id="group-{{ group.key }}-title" class="m-0 text-heading font-semibold text-ink">{{ group.name }} <span class="num font-normal text-muted">({{ group.count }})</span></h2>
                <twig:Ui:DataTable :caption="group.name" :columns="columns" :rows="group.rows" />
            </section>
        {% else %}
            {% set empty = watching ? 'watching' : 'assigned' %}
            <twig:Ui:EmptyState icon="square-check-big" :title="('work.my_tasks.empty.' ~ empty ~ '_title')|trans" :text="(client ? 'work.my_tasks.empty.filtered' : 'work.my_tasks.empty.' ~ empty ~ '_text')|trans" />
        {% endfor %}
    </div>
{% endblock %}
