{#
    A new subtask of a task, by its title, in the section of its task. A dialog over the task it goes
    back to; the same URL is a page of its own.
#}
{% extends in_dialog() ? 'layout/dialog.html.twig' : 'layout/app.html.twig' %}

{% set row = task.task %}
{% set taskUrl = path('app_task', {id: row.id}) %}
{% set crumbs = (task.manageable ? [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans, href: path('app_projects')}] : [{label: 'shared_with_me.title'|trans, href: path('app_shared_with_me')}])|merge([row.projectSeen ? {label: row.projectName, href: path('app_project', {id: row.projectId})} : {label: row.projectName}, {label: row.title, href: taskUrl}, {label: 'work.task.new_subtask'|trans}]) %}
{% set form_invalid = errors is not empty %}
{% set dialog_size = 'sm' %}

{% block title %}{{ 'work.task.new_subtask'|trans }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="subtask-new-form" action="{{ path('app_task_subtask_new', {id: row.id}) }}" class="grid gap-4" novalidate data-subtask-new>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Work\\Infrastructure\\Controller\\TaskController::TOKEN')) }}">
        {{ include('work/_form_errors.html.twig', {prefix: 'subtask-new-'}) }}
        <twig:Ui:TextInput name="title" id="subtask-new-title" :label="'work.task.field.title'|trans" :value="values.title" :error="errors.title|default(null)" maxlength="500" required autocomplete="off" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'work.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="subtask-new-form" variant="primary">{{ 'work.task.create_subtask'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set form %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="'work.task.new_subtask'|trans" icon="square-check-big" class="max-w-2xl">
        {{ form }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="taskUrl ~ '#task-subtasks-title'">{{ 'work.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="subtask-new-form" variant="primary">{{ 'work.task.create_subtask'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
