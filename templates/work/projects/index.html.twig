{#
    The projects of the organisation, active or archived, with what is left of each. A new project
    starts in a dialog over the list; without JavaScript the same link is a page.
#}
{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans}] %}

{% block title %}{{ 'work.projects.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_project_new')" id="project-new" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'work.projects.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <div class="grid grid-cols-1 gap-4">
        <twig:Ui:Tabs :items="tabs" :label="'work.projects.views'|trans" />
        <twig:Ui:DataTable :caption="'work.projects.title'|trans" :columns="columns" :rows="rows">
            <twig:block name="empty">
                {% if archived %}
                    <twig:Ui:EmptyState icon="archive" :title="'work.projects.empty.archived_title'|trans" />
                {% else %}
                    <twig:Ui:EmptyState icon="columns-3" :title="'work.projects.empty.title'|trans" :text="'work.projects.empty.text'|trans">
                        <twig:Ui:Button variant="primary" icon="plus" :href="path('app_project_new')" data-dialog data-dialog-then="follow" aria-haspopup="dialog">{{ 'work.projects.new'|trans }}</twig:Ui:Button>
                    </twig:Ui:EmptyState>
                {% endif %}
            </twig:block>
        </twig:Ui:DataTable>
    </div>
{% endblock %}
