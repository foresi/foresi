{#
    A new status of a project: its name and its type. It goes to the end of the statuses. A dialog
    over the settings; the same URL is a page of its own. A missing name or a refusal is told here.
#}
{% extends in_dialog() ? 'layout/dialog.html.twig' : 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans, href: path('app_projects')}, {label: project.name, href: path('app_project', {id: project.id})}, {label: 'work.settings.title'|trans, href: path('app_project_settings', {id: project.id})}, {label: 'work.settings.add_status'|trans}] %}
{% set form_invalid = error is not null %}
{% set dialog_size = 'sm' %}

{% block title %}{{ 'work.settings.add_status'|trans }}{% endblock %}

{% block dialog_body %}
    <form method="post" id="status-new-form" action="{{ path('app_project_status_add', {id: project.id}) }}" class="grid gap-4" novalidate data-settings-status-new>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('Foresi\\Work\\Infrastructure\\Controller\\ProjectSettingsController::TOKEN')) }}">
        <twig:Ui:TextInput name="name" id="status-name" :label="'work.settings.status_name'|trans" :value="name" :error="error" maxlength="80" required autocomplete="off" />
        <twig:Ui:Select name="type" id="status-type" :label="'work.settings.status_type'|trans" :options="types" :value="type" />
    </form>
{% endblock %}

{% block dialog_footer %}
    <twig:Ui:Button data-action="dialog#dismiss">{{ 'work.cancel'|trans }}</twig:Ui:Button>
    <twig:Ui:Button type="submit" form="status-new-form" variant="primary">{{ 'work.settings.add_status'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% set form %}{{ block('dialog_body') }}{% endset %}
    <twig:Ui:Card :title="'work.settings.add_status'|trans" icon="circle-check" class="max-w-2xl">
        {{ form }}
    </twig:Ui:Card>
    <div class="max-w-2xl">
        <twig:Ui:ActionBar>
            <twig:Ui:Button :href="path('app_project_settings', {id: project.id})">{{ 'work.cancel'|trans }}</twig:Ui:Button>
            <twig:Ui:Button type="submit" form="status-new-form" variant="primary">{{ 'work.settings.add_status'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </div>
{% endblock %}
