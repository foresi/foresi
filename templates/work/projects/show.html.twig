{#
    A project as a list: the filters, then one block per section in order, each with its top-level
    tasks and their subtasks under them. The tasks in no section come first, when there are some.
    A new task opens in a dialog from the header, and from the empty state of a project with nothing
    to show; so does the sharing dialog. A private section or task has its badge. A row's menu deletes its task; the trash of the project is linked at the end while it
    holds something.
#}
{% extends 'layout/app.html.twig' %}

{% set crumbs = (project.manageable ? [{label: 'nav.group.work'|trans}, {label: 'work.projects.title'|trans, href: path('app_projects')}] : [{label: 'shared_with_me.title'|trans, href: path('app_shared_with_me')}])|merge([{label: project.name}]) %}
{% if project.archivedAt %}{% set badge = {label: 'work.project.archived'|trans, tone: 'gray'} %}{% endif %}
{% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
{% set share %}{% if project.shareable %}<twig:Ui:Button icon="share-2" :href="path('app_sharing', {kind: 'projects', id: project.id, return: app.request.requestUri})" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-project-share>{{ 'work.sharing.open'|trans }}</twig:Ui:Button>{% endif %}{% endset %}
{% if project.visibility.value == 'chosen' %}{% set badges = [{label: 'work.sharing.chosen_badge'|trans, tone: 'gray', icon: 'lock'}] %}{% endif %}
{% set newTask %}<twig:Ui:Button variant="primary" icon="plus" :href="path('app_project_task_new', {id: project.id, return: app.request.requestUri})" data-dialog data-dialog-then="follow" aria-haspopup="dialog" data-task-new-open>{{ 'work.task.new'|trans }}</twig:Ui:Button>{% endset %}
{% set trashToken = csrf_token(constant('App\\Work\\Infrastructure\\Controller\\TaskController::TRASH_TOKEN')) %}

{% block title %}{{ project.name }}{% endblock %}

{% block actions %}
    {% if project.manageable %}<twig:Ui:Button icon="settings" :href="path('app_project_settings', {id: project.id})" data-project-settings>{{ 'work.settings.title'|trans }}</twig:Ui:Button>{% endif %}
    {{ share }}
    {% if timeLoggable %}<twig:Ui:Button icon="clock-3" :href="path('app_project_time_new', {id: project.id})" data-dialog aria-haspopup="dialog" data-project-time-new>{{ 'work.time.log'|trans }}</twig:Ui:Button>{% endif %}
    {% if not project.archivedAt and project.taskable %}{{ newTask }}{% endif %}
{% endblock %}

{% block content %}
    {{ include('work/_flashes.html.twig') }}
    <div class="grid grid-cols-1 gap-4">
        {% if project.clientId %}
            <p class="m-0 text-small text-muted" data-project-client>{{ 'work.project.field.client'|trans }}: {% if project.manageable %}<a href="{{ path('app_contact_show', {id: project.clientId}) }}" class="font-medium text-ink no-underline hover:underline {{ focus }}">{{ project.clientName }}</a>{% else %}<span class="font-medium text-ink">{{ project.clientName }}</span>{% endif %}</p>
        {% endif %}

        <div class="flex flex-wrap items-end justify-between gap-3">
            <twig:Ui:Tabs :items="[{label: 'work.project.tab.list'|trans, href: path('app_project', {id: project.id}), active: true}, {label: 'work.project.tab.board'|trans, href: path('app_project_board', {id: project.id})}]" :label="'work.project.views'|trans" class="shrink-0" />
            <form method="get" action="{{ path('app_project', {id: project.id}) }}" role="search" class="flex w-full flex-wrap items-end gap-2 sm:w-auto max-sm:[&_button]:h-control-lg" data-task-filters>
                <div class="w-full min-w-0 sm:w-44"><twig:Ui:Select name="responsible" id="filter-responsible" :label="'work.filter.responsible'|trans" :options="responsibles" :value="query.responsible" /></div>
                <div class="w-full min-w-0 sm:w-40"><twig:Ui:Select name="status" id="filter-status" :label="'work.filter.status'|trans" :options="statuses" :value="query.status" /></div>
                <div class="w-full min-w-0 sm:w-40"><twig:Ui:Select name="due" id="filter-due" :label="'work.filter.due'|trans" :options="dues" :value="query.due" /></div>
                <twig:Ui:Button type="submit" icon="list-filter">{{ 'work.filter.apply'|trans }}</twig:Ui:Button>
                {% if filtered %}<twig:Ui:Button variant="ghost" :href="path('app_project', {id: project.id})">{{ 'work.filter.reset'|trans }}</twig:Ui:Button>{% endif %}
            </form>
        </div>

        {% for section in sections %}
            <section class="grid gap-2" aria-labelledby="section-{{ section.key }}-title" data-section="{{ section.key }}">
                <h2 id="section-{{ section.key }}-title" class="m-0 text-heading font-semibold text-ink">{{ section.name }} <span class="num font-normal text-muted">({{ section.count }})</span>{% if section.private %} {{ include('work/_private_badge.html.twig') }}{% endif %}</h2>
                <twig:Ui:DataTable :caption="section.name" :columns="columns" :rows="section.rows" :actionToken="trashToken">
                    <twig:block name="empty">
                        <p class="m-0 rounded-panel border border-container bg-white px-4 py-3 text-small text-muted">{{ (filtered ? 'work.list.empty_filtered' : 'work.list.empty')|trans }}</p>
                    </twig:block>
                </twig:Ui:DataTable>
            </section>
        {% else %}
            {% if filtered %}
                <p class="m-0 rounded-panel border border-container bg-white px-4 py-3 text-small text-muted" data-project-empty>{{ 'work.list.empty_filtered'|trans }}</p>
            {% else %}
                <twig:Ui:EmptyState icon="square-check-big" :title="'work.list.empty_title'|trans" :text="(project.archivedAt ? null : 'work.list.empty_text'|trans)" data-project-empty>
                    {% if not project.archivedAt and project.taskable %}{{ newTask }}{% endif %}
                </twig:Ui:EmptyState>
            {% endif %}
        {% endfor %}

        {% if trashCount > 0 %}
            <div><twig:Ui:Button variant="ghost" size="sm" icon="trash-2" :href="path('app_project_trash', {id: project.id})" data-project-trash>{{ 'work.trash.link'|trans({count: trashCount}) }}</twig:Ui:Button></div>
        {% endif %}
    </div>
{% endblock %}
