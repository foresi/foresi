{#
    The labels of the organisation: each with how it looks and how many tasks carry it. A new label
    and a change of one open in a dialog over the list; delete asks first.
#}
{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.settings'|trans}, {label: 'work.labels.title'|trans}] %}

{% block title %}{{ 'work.labels.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button variant="primary" icon="plus" :href="path('app_label_new')" id="label-new" data-dialog aria-haspopup="dialog">{{ 'work.labels.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block content %}
    {% for tone in ['success', 'error'] %}
        {% for message in app.flashes(tone) %}
            <twig:Ui:Alert :tone="tone" class="mb-4">{{ message }}</twig:Ui:Alert>
        {% endfor %}
    {% endfor %}
    <twig:Ui:DataTable :caption="'work.labels.title'|trans" :columns="columns" :rows="rows" :actionToken="csrf_token(constant('App\\Work\\Infrastructure\\Controller\\LabelController::TOKEN'))">
        <twig:block name="empty">
            <twig:Ui:EmptyState icon="tag" :title="'work.labels.empty.title'|trans" :text="'work.labels.empty.text'|trans">
                <twig:Ui:Button variant="primary" icon="plus" :href="path('app_label_new')" data-dialog aria-haspopup="dialog">{{ 'work.labels.new'|trans }}</twig:Ui:Button>
            </twig:Ui:EmptyState>
        </twig:block>
    </twig:Ui:DataTable>
{% endblock %}
