{# The header action that cancels an import which has written nothing yet. Variables: import. #}
<form method="post" action="{{ path('app_import_cancel', {id: import.id}) }}" data-turbo-confirm="{{ 'import.cancel.confirm'|trans }}" data-confirm-text="{{ 'import.cancel.confirm_text'|trans }}" data-confirm-accept="{{ 'import.cancel.confirm_accept'|trans }}" data-confirm-cancel="{{ 'import.cancel.confirm_cancel'|trans }}" data-confirm-tone="danger">
    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Import\\Infrastructure\\Controller\\ImportController::TOKEN')) }}">
    <twig:Ui:Button type="submit" icon="x">{{ 'import.cancel.button'|trans }}</twig:Ui:Button>
</form>
