{% extends 'import/_flow.html.twig' %}

{% set form_invalid = errors is not empty %}

{% block title %}{{ 'import.upload.title'|trans }}{% endblock %}

{% block actions %}
    <twig:Ui:Button icon="history" :href="path('app_imports')">{{ 'import.history.title'|trans }}</twig:Ui:Button>
{% endblock %}

{% block screen %}
    <form method="post" action="{{ path('app_import_upload', target ? {target: target} : {}) }}" enctype="multipart/form-data" class="grid gap-4" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Import\\Infrastructure\\Controller\\ImportController::TOKEN')) }}">
        {% if target %}<input type="hidden" name="target" value="{{ target }}">{% endif %}

        <twig:Ui:Card :title="'import.upload.card'|trans" icon="upload">
            <div class="grid gap-3 sm:max-w-xl">
                {% if not target %}
                    <twig:Ui:Select name="target" id="target" :label="'import.upload.target'|trans" :options="targets" :error="errors.target|default(null)" required />
                {% endif %}
                <twig:Ui:TextInput type="file" name="file" id="file" :label="'import.upload.file'|trans" :help="'import.upload.file_help'|trans" :error="errors.file|default(null)" accept=".csv,.txt,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required class="py-0.5 pl-0.5 file:mr-3 file:h-control-sm file:cursor-pointer file:rounded-sm file:border-0 file:bg-badge-gray file:px-2.5 file:text-small file:font-medium file:text-ink" />
                {% if profiles is not empty %}
                    <twig:Ui:Select name="profile" id="profile" :label="'import.upload.profile'|trans" :help="'import.upload.profile_help'|trans" :options="profiles" :value="profileId" :error="errors.profile|default(null)" />
                {% elseif errors.profile is defined %}
                    <twig:Ui:Alert tone="error">{{ errors.profile }}</twig:Ui:Alert>
                {% endif %}
            </div>
        </twig:Ui:Card>

        <twig:Ui:ActionBar>
            <twig:Ui:Button type="submit" variant="primary" icon="upload">{{ 'import.upload.submit'|trans }}</twig:Ui:Button>
        </twig:Ui:ActionBar>
    </form>
{% endblock %}
