{% set emptySlot %}{% block empty %}{% endblock %}{% endset %}
{% set footerSlot %}{% block footer %}{% endblock %}{% endset %}
{% set bulkSlot %}{% block bulk %}{% endblock %}{% endset %}
{% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
<div {{ attributes.defaults({class: 'relative' ~ (selectable ? ' pb-24' : '')}) }}{% if selectable %} data-controller="table-selection" data-action="keydown->table-selection#keydown click->table-selection#rowClick"{% endif %}>
    {% if this.rowViews is empty %}
        {% if emptySlot %}{{ emptySlot|raw }}{% else %}<twig:Ui:EmptyState />{% endif %}
    {% else %}
        <div class="overflow-hidden rounded-panel border border-container bg-white">
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <caption class="sr-only">{{ caption ?: 'ui.table.caption'|trans }}</caption>
                    <thead>
                        <tr>
                            {% if selectable %}
                                <th scope="col" class="h-row w-12 border-b border-divider bg-white px-4 text-left">
                                    <label class="inline-grid size-6 place-items-center">
                                        <input type="checkbox" aria-label="{{ 'ui.table.select_all'|trans }}" data-table-selection-target="all" data-action="change->table-selection#toggleAll" class="size-4 accent-green {{ focus }}">
                                    </label>
                                </th>
                            {% endif %}
                            {% for column in this.columnViews %}
                                <th scope="col"{% if column.sortable %} aria-sort="{{ this.ariaSort(column.sort) }}"{% endif %} class="h-row whitespace-nowrap border-b border-divider bg-white px-4 text-caption font-medium text-muted {{ this.alignClass(column.align) }}">
                                    {%- if column.sortable -%}
                                        <a href="{{ column.href }}" class="inline-flex min-h-6 items-center gap-1 text-muted no-underline hover:text-ink {{ focus }}">
                                            {{- column.label -}}
                                            {{- ux_icon('lucide:' ~ (column.sort ? 'chevron-down' : 'chevrons-up-down'), {class: 'size-3.5 shrink-0' ~ (column.sort == 'asc' ? ' rotate-180' : ''), 'aria-hidden': 'true'}) -}}
                                        </a>
                                    {%- else -%}
                                        {{- column.label -}}
                                    {%- endif -%}
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in this.rowViews %}
                            <tr data-table-selection-target="row" data-id="{{ row.id }}"{% if row.selected %} data-selected="true"{% endif %} class="group scroll-mb-24{{ selectable and row.href ? ' cursor-pointer' : '' }}">
                                {% if selectable %}
                                    <td class="h-row w-12 border-b border-divider px-4 group-last:border-b-0 group-hover:bg-head group-data-[selected=true]:bg-green-tint group-data-[selected=true]:inset-shadow-selected">
                                        <label class="inline-grid size-6 place-items-center">
                                            <input type="checkbox"{% if selectionName %} name="{{ selectionName }}"{% endif %} value="{{ row.id }}" aria-label="{{ 'ui.table.select_row'|trans({label: row.label}) }}"{% if row.selected %} checked{% endif %} data-table-selection-target="check" data-action="click->table-selection#rowCheck change->table-selection#sync" class="size-4 accent-green {{ focus }}">
                                        </label>
                                    </td>
                                {% endif %}
                                {% for cell in row.cells %}
                                    <td class="h-row whitespace-nowrap border-b border-divider px-4 text-text group-last:border-b-0 group-hover:bg-head group-data-[selected=true]:bg-green-tint {{ this.alignClass(cell.align) }}">
                                        {%- if cell.tone -%}
                                            <twig:Ui:Badge :tone="cell.tone">{{ cell.text }}</twig:Ui:Badge>
                                        {%- elseif cell.link -%}
                                            <a href="{{ cell.link }}" data-row-link{% if cell.title %} title="{{ cell.title }}"{% endif %} class="block max-w-[32ch] truncate font-medium text-ink no-underline hover:underline {{ focus }}">{{ cell.text }}</a>
                                        {%- elseif cell.numeric -%}
                                            <span class="num"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                        {%- elseif cell.text is same as('') -%}
                                            <span class="text-control-line" aria-hidden="true">—</span>
                                        {%- else -%}
                                            <span class="block max-w-[32ch] truncate"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                        {%- endif -%}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                    {% if totals is not null %}
                        <tfoot>
                            <tr>
                                {% if selectable %}<td class="h-row border-t border-divider bg-head px-4"></td>{% endif %}
                                {% for cell in this.totalCells %}
                                    <td class="num h-row whitespace-nowrap border-t border-divider bg-head px-4 font-semibold text-ink {{ this.alignClass(cell.align) }}">
                                        {{- cell.text is not same as('') ? cell.text : (loop.first ? 'ui.table.total'|trans : '') -}}
                                    </td>
                                {% endfor %}
                            </tr>
                        </tfoot>
                    {% endif %}
                </table>
            </div>
            {% if footerSlot %}
                <div data-table-footer class="flex items-center justify-between gap-2.5 border-t border-divider px-4 py-2.5 text-small text-muted">{{ footerSlot|raw }}</div>
            {% endif %}
        </div>
    {% endif %}
    {% if selectable %}<twig:Ui:BulkBar>{{ bulkSlot|raw }}</twig:Ui:BulkBar>{% endif %}
</div>
