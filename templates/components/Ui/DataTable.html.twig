{% set emptySlot %}{% block empty %}{% endblock %}{% endset %}
{% set footerSlot %}{% block footer %}{% endblock %}{% endset %}
{% set bulkSlot %}{% block bulk %}{% endblock %}{% endset %}
{% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
{# Columns of long text share the room the others leave and cut their text short; numbers, badges and actions keep their width. #}
{% set share = this.shareClass %}
{% macro alert(alert, focus) %}{{ ux_icon('lucide:triangle-alert', {class: 'mt-0.5 size-3.5 shrink-0', 'aria-hidden': 'true'}) }}<span>{{ alert.text }}{% if alert.href %} <a href="{{ alert.href }}" data-turbo="false" class="font-medium text-badge-red-text underline {{ focus }}">{{ alert.action }}</a>{% endif %}</span>{% endmacro %}
{% macro confirm(confirm) %}{% if confirm %} data-turbo-confirm="{{ confirm.title }}"{% if confirm.text %} data-confirm-text="{{ confirm.text }}"{% endif %}{% if confirm.accept %} data-confirm-accept="{{ confirm.accept }}"{% endif %}{% if confirm.cancel %} data-confirm-cancel="{{ confirm.cancel }}"{% endif %}{% if confirm.tone %} data-confirm-tone="{{ confirm.tone }}"{% endif %}{% endif %}{% endmacro %}
<div {{ attributes.defaults({class: 'relative' ~ (selectable ? ' pb-24' : '')}) }}{% if selectable %} data-controller="table-selection" data-action="keydown->table-selection#keydown click->table-selection#rowClick"{% endif %}>
    {% if this.rowViews is empty %}
        {% if emptySlot %}{{ emptySlot|raw }}{% else %}<twig:Ui:EmptyState />{% endif %}
    {% else %}
        <div class="overflow-hidden rounded-panel border border-container bg-white">
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <caption class="sr-only">{{ caption ?: 'ui.table.caption'|trans }}</caption>
                    <thead>
                        <tr>
                            {% if selectable %}
                                <th scope="col" class="h-row w-12 border-b border-divider bg-white px-4 text-left">
                                    <label class="inline-grid size-6 place-items-center">
                                        <input type="checkbox" aria-label="{{ 'ui.table.select_all'|trans }}" data-table-selection-target="all" data-action="change->table-selection#toggleAll" class="size-4 accent-green {{ focus }}">
                                    </label>
                                </th>
                            {% endif %}
                            {% for column in this.columnViews %}
                                <th scope="col"{% if column.sortable %} aria-sort="{{ this.ariaSort(column.sort) }}"{% endif %} class="h-row whitespace-nowrap border-b border-divider bg-white px-4 text-caption font-medium text-muted {{ this.alignClass(column.align) }}{{ column.phone ? '' : ' max-sm:hidden' }}{{ column.wide ? ' max-xl:hidden' : '' }}{{ column.truncate ? ' sm:max-w-0 ' ~ share : '' }}">
                                    {%- if column.sortable -%}
                                        <a href="{{ column.href }}" class="inline-flex min-h-6 items-center gap-1 text-muted no-underline hover:text-ink {{ focus }}">
                                            {{- column.label -}}
                                            {{- ux_icon('lucide:' ~ (column.sort ? 'chevron-down' : 'chevrons-up-down'), {class: 'size-3.5 shrink-0' ~ (column.sort == 'asc' ? ' rotate-180' : ''), 'aria-hidden': 'true'}) -}}
                                        </a>
                                    {%- else -%}
                                        {{- column.label -}}
                                    {%- endif -%}
                                </th>
                            {% endfor %}
                            {% if this.hasActions %}
                                <th scope="col" class="h-row border-b border-divider bg-white px-2"><span class="sr-only">{{ 'ui.table.actions'|trans }}</span></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in this.rowViews %}
                            <tr data-table-selection-target="row" data-id="{{ row.id }}"{% if row.selected %} data-selected="true"{% endif %} class="group scroll-mb-24{{ selectable and row.href ? ' cursor-pointer' : '' }}{{ row.child ? ' text-small' : '' }}"{% if row.child %} data-row-child{% endif %}>
                                {% if selectable %}
                                    <td class="h-row w-12 border-b border-divider px-4 group-last:border-b-0 group-hover:bg-head group-data-[selected=true]:bg-green-tint group-data-[selected=true]:inset-shadow-selected">
                                        <label class="inline-grid size-6 place-items-center">
                                            <input type="checkbox"{% if selectionName %} name="{{ selectionName }}"{% endif %} value="{{ row.id }}" aria-label="{{ 'ui.table.select_row'|trans({label: row.label}) }}"{% if row.selected %} checked{% endif %} data-table-selection-target="check" data-action="click->table-selection#rowCheck change->table-selection#sync" class="size-4 accent-green {{ focus }}">
                                        </label>
                                    </td>
                                {% endif %}
                                {% for cell in row.cells %}
                                    <td class="h-row whitespace-nowrap border-b border-divider px-4 text-text group-last:border-b-0 group-hover:bg-head group-data-[selected=true]:bg-green-tint {{ this.alignClass(cell.align) }}{{ cell.phone ? '' : ' max-sm:hidden' }}{{ cell.wide ? ' max-xl:hidden' : '' }}{{ cell.truncate ? ' sm:max-w-0 ' ~ share : '' }}{{ (row.secondary or row.alert) and loop.first ? ' max-sm:w-full max-sm:max-w-0 max-sm:py-2' : '' }}{{ row.alert and cell.key == row.alert.column ? ' py-2' : '' }}{{ row.child and loop.first ? ' pl-10' : '' }}">
                                        {%- set unreadMark = loop.first and row.unread is not null -%}
                                        {%- if unreadMark %}<span class="flex min-w-0 items-center gap-2 [&>*]:min-w-0 {{ row.unread ? '[&_a]:font-semibold' : '[&_a]:font-normal' }}" data-unread="{{ row.unread ? 'true' : 'false' }}"><span class="size-2 shrink-0 rounded-sm{{ row.unread ? ' bg-green' : '' }}" aria-hidden="true"></span>{% if row.unread %}<span class="sr-only">{{ 'ui.table.unread'|trans }}: </span>{% endif %}{% endif -%}
                                        {%- if cell.links -%}
                                            <span class="block {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate"{% if cell.title %} title="{{ cell.title }}"{% endif %} data-links>
                                                {%- for link in cell.links -%}
                                                    {%- if not loop.first %}, {% endif -%}
                                                    <a href="{{ link.href }}"{% if cell.plain %} data-turbo="false"{% endif %} class="font-medium text-ink no-underline hover:underline {{ focus }}">{{ link.text }}</a>
                                                {%- endfor -%}
                                            </span>
                                        {%- elseif cell.flag -%}
                                            <span class="flex min-w-0 items-center gap-2" data-flag-cell>
                                                {%- if cell.link -%}
                                                    <a href="{{ cell.link }}" data-row-link{% if cell.plain %} data-turbo="false"{% endif %}{% if cell.title %} title="{{ cell.title }}"{% endif %} class="block min-w-0 {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate font-medium text-ink no-underline hover:underline {{ focus }}">{{ cell.text }}</a>
                                                {%- else -%}
                                                    <span class="block min-w-0 {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                                {%- endif -%}
                                                <twig:Ui:Badge :tone="cell.flag.tone" class="shrink-0 gap-1">{% if cell.flag.icon %}{{ ux_icon('lucide:' ~ cell.flag.icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}{% endif %}{{ cell.flag.label }}</twig:Ui:Badge>
                                            </span>
                                        {%- elseif cell.badges -%}
                                            <span class="flex flex-wrap items-center gap-1" data-badges>
                                                {%- for badge in cell.badges %}<twig:Ui:Badge :tone="badge.tone">{{ badge.label }}</twig:Ui:Badge>{% endfor -%}
                                            </span>
                                        {%- elseif cell.avatar -%}
                                            <span class="flex min-w-0 items-center gap-2" data-avatar-cell>
                                                <span class="grid size-6 shrink-0 place-items-center rounded-control text-caption font-semibold {{ cell.avatar.tone }}" aria-hidden="true">{{ cell.avatar.initials }}</span>
                                                {%- if cell.link -%}
                                                    <a href="{{ cell.link }}" data-row-link{% if cell.plain %} data-turbo="false"{% endif %}{% if cell.title %} title="{{ cell.title }}"{% endif %} class="block min-w-0 max-w-[32ch] truncate font-medium text-ink no-underline hover:underline {{ focus }}">{{ cell.text }}</a>
                                                {%- else -%}
                                                    <span class="block min-w-0 max-w-[32ch] truncate font-medium text-ink"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                                {%- endif -%}
                                            </span>
                                        {%- elseif cell.icon -%}
                                            <span class="inline-flex items-center gap-1.5"{% if cell.hint %} title="{{ cell.hint }}"{% endif %} data-icon-cell="{{ cell.icon }}">{{ ux_icon('lucide:' ~ cell.icon, {class: 'size-4 shrink-0 ' ~ cell.iconClass, 'aria-hidden': 'true'}) }}<span>{{ cell.text }}</span></span>
                                        {%- elseif cell.tone -%}
                                            <twig:Ui:Badge :tone="cell.tone" :title="cell.hint ?: false">{{ cell.text }}{% if cell.hint %}<span class="sr-only"> · {{ cell.hint }}</span>{% endif %}</twig:Ui:Badge>
                                        {%- elseif cell.link -%}
                                            <a href="{{ cell.link }}" data-row-link{% if cell.plain %} data-turbo="false"{% endif %}{% if cell.title %} title="{{ cell.title }}"{% endif %} class="block {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate font-medium text-ink no-underline hover:underline {{ focus }}">{{ cell.text }}</a>
                                        {%- elseif cell.numeric -%}
                                            <span class="num"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                        {%- elseif cell.text is same as('') -%}
                                            <span class="text-control-line" aria-hidden="true">—</span>
                                        {%- else -%}
                                            <span class="block {{ cell.truncate ? '' : 'max-w-[32ch] ' }}truncate"{% if cell.title %} title="{{ cell.title }}"{% endif %}>{{ cell.text }}</span>
                                        {%- endif -%}
                                        {%- if unreadMark %}</span>{% endif -%}
                                        {%- if row.alert and cell.key == row.alert.column %}<span class="mt-0.5 flex items-start gap-1 whitespace-normal break-words text-caption text-badge-red-text max-sm:hidden" data-row-alert>{{ _self.alert(row.alert, focus) }}</span>{% endif -%}
                                        {%- if row.secondary and loop.first %}<span class="mt-0.5 block whitespace-normal break-words text-caption text-muted sm:hidden" data-row-secondary>{{ row.secondary }}</span>{% endif -%}
                                        {%- if row.alert and loop.first %}<span class="mt-1 flex items-start gap-1 whitespace-normal break-words text-caption text-badge-red-text sm:hidden" data-row-alert-phone>{{ _self.alert(row.alert, focus) }}</span>{% endif -%}
                                    </td>
                                {% endfor %}
                                {% if this.hasActions %}
                                    <td class="h-row whitespace-nowrap border-b border-divider px-2 text-right group-last:border-b-0 group-hover:bg-head group-data-[selected=true]:bg-green-tint" data-row-actions>
                                        <div class="flex items-center justify-end gap-0.5">
                                            {% set menuId = 'row-menu-' ~ row.id %}
                                            {% set inMenu = row.actions|filter(action => action.icon is null) %}
                                            {% for action in row.actions|filter(action => action.icon is not null) %}
                                                {% if action.method == 'POST' %}
                                                    <form method="post" action="{{ action.href }}" class="max-sm:hidden"{{ _self.confirm(action.confirm) }}>
                                                        <input type="hidden" name="_token" value="{{ actionToken }}">
                                                        {% for name, value in action.fields %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                                                        <twig:Ui:IconButton type="submit" :icon="action.icon" :label="action.label" variant="ghost" size="sm" />
                                                    </form>
                                                {% else %}
                                                    <twig:Ui:IconButton :href="action.href" :icon="action.icon" :label="action.label" variant="ghost" size="sm" class="max-sm:hidden" data-turbo="{{ action.plain ? 'false' : 'true' }}" :data-dialog="action.dialog ? true : false" :aria-haspopup="action.dialog ? 'dialog' : false" />
                                                {% endif %}
                                            {% endfor %}
                                            <div class="relative{{ inMenu is empty ? ' sm:hidden' : '' }}" data-controller="dropdown" data-dropdown-float-value="true">
                                                <twig:Ui:IconButton icon="ellipsis" :label="'ui.table.more_actions'|trans({label: row.label})" variant="ghost" size="sm" :id="menuId ~ '-button'" aria-haspopup="menu" aria-expanded="false" :aria-controls="menuId" data-dropdown-target="button" data-action="dropdown#toggle keydown->dropdown#openFromButton" />
                                                <div id="{{ menuId }}" role="menu" hidden data-dropdown-target="menu" data-action="keydown->dropdown#navigate" aria-labelledby="{{ menuId }}-button" class="absolute right-0 z-50 w-max min-w-40 rounded-panel border border-container bg-white p-1.5 text-left shadow-floating">
                                                    {% for action in row.actions %}
                                                        {% set itemClass = 'flex h-control w-full cursor-pointer items-center rounded-control border-0 bg-transparent px-2.5 text-left text-text no-underline hover:bg-head focus-visible:bg-head ' ~ focus ~ (action.icon ? ' sm:hidden' : '') %}
                                                        {% if action.method == 'POST' %}
                                                            <form method="post" action="{{ action.href }}"{{ _self.confirm(action.confirm) }}{% if action.icon %} class="sm:hidden" {% endif %}>
                                                                <input type="hidden" name="_token" value="{{ actionToken }}">
                                                                {% for name, value in action.fields %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                                                                <button type="submit" role="menuitem" tabindex="-1"{% if action.icon %} data-phone-only{% endif %} class="{{ itemClass }}">{{ action.label }}</button>
                                                            </form>
                                                        {% else %}
                                                            <a href="{{ action.href }}" role="menuitem" tabindex="-1"{% if action.icon %} data-phone-only{% endif %}{% if action.plain %} data-turbo="false"{% endif %}{% if action.dialog %} data-dialog aria-haspopup="dialog"{% endif %} class="{{ itemClass }}">{{ action.label }}</a>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                    {% if totals is not null %}
                        <tfoot>
                            <tr>
                                {% if selectable %}<td class="h-row border-t border-divider bg-head px-4"></td>{% endif %}
                                {% for cell in this.totalCells %}
                                    <td class="num h-row whitespace-nowrap border-t border-divider bg-head px-4 font-semibold text-ink {{ this.alignClass(cell.align) }}{{ cell.phone ? '' : ' max-sm:hidden' }}{{ cell.wide ? ' max-xl:hidden' : '' }}">
                                        {{- cell.text is not same as('') ? cell.text : (loop.first ? 'ui.table.total'|trans : '') -}}
                                    </td>
                                {% endfor %}
                                {% if this.hasActions %}<td class="h-row border-t border-divider bg-head px-2"></td>{% endif %}
                            </tr>
                        </tfoot>
                    {% endif %}
                </table>
            </div>
            {% if footerSlot %}
                <div data-table-footer class="flex items-center justify-between gap-2.5 border-t border-divider px-4 py-2.5 text-small text-muted">{{ footerSlot|raw }}</div>
            {% endif %}
        </div>
    {% endif %}
    {% if selectable %}<twig:Ui:BulkBar>{{ bulkSlot|raw }}</twig:Ui:BulkBar>{% endif %}
</div>
