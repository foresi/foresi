<span {{ attributes.defaults({class: 'inline-flex h-[22px] max-w-full items-center gap-1.5 rounded-md border border-line-strong px-2 text-xs text-text', title: label}) }}>
    <i class="size-[7px] shrink-0 rounded-[2px]" style="background-color: {{ color }}" aria-hidden="true"></i>
    <span class="truncate">{{ label }}</span>
</span>
