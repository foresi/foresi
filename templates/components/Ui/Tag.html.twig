<span {{ attributes.defaults({class: 'inline-flex h-badge max-w-full items-center gap-1.5 rounded-sm border border-container px-2 text-caption text-text', title: label}) }}>
    <i class="size-2 shrink-0 rounded-sm" style="background-color: {{ color }}" aria-hidden="true"></i>
    <span class="truncate">{{ label }}</span>
</span>
