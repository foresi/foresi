{% set focus = constant('App\\Ui\\Component\\Style::FOCUS') %}
<div {{ attributes }} data-controller="command-palette">
    <button type="button" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" data-action="command-palette#open" data-command-palette-target="opener" class="inline-flex h-control w-full min-w-[220px] cursor-pointer items-center gap-2 rounded-control border border-control-line bg-white px-2.5 text-left text-muted hover:bg-head {{ focus }}">
        {{ ux_icon('lucide:search', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
        <span class="flex-1 truncate">{{ 'ui.palette.open'|trans }}</span>
        <twig:Ui:Kbd data-command-palette-target="shortcut">Ctrl K</twig:Ui:Kbd>
    </button>
    <div hidden data-command-palette-target="overlay" data-action="click->command-palette#backdrop" class="fixed inset-0 z-50 flex items-start justify-center bg-ink/25 pt-[12vh]">
        <div role="dialog" aria-modal="true" tabindex="-1" data-command-palette-target="dialog" data-action="mousedown->command-palette#keepFocus" aria-label="{{ 'ui.palette.label'|trans }}" class="w-[min(560px,92vw)] outline-none overflow-hidden rounded-panel border border-container bg-white shadow-overlay">
            <div class="flex items-center border-b border-divider pr-2">
                <input type="text" role="combobox" aria-expanded="false" aria-controls="{{ id }}-list" aria-autocomplete="list" aria-label="{{ 'ui.palette.label'|trans }}" placeholder="{{ 'ui.palette.placeholder'|trans }}" autocomplete="off" spellcheck="false" data-command-palette-target="input" data-action="input->command-palette#filter keydown->command-palette#navigate" class="h-control-lg min-w-0 flex-1 border-0 bg-transparent px-4 text-ink outline-none">
                <twig:Ui:IconButton icon="x" :label="'ui.palette.close'|trans" variant="ghost" size="sm" data-action="command-palette#close" data-command-palette-target="close" />
            </div>
            <ul id="{{ id }}-list" role="listbox" aria-label="{{ 'ui.palette.label'|trans }}" data-command-palette-target="list" class="m-0 max-h-[50vh] list-none overflow-y-auto p-1.5">
                {% for group in this.groups %}
                    <li role="presentation" data-group>
                        <ul role="group"{% if group.label %} aria-labelledby="{{ id }}-group-{{ group.index }}"{% endif %} class="m-0 list-none p-0">
                            {% if group.label %}<li role="presentation" id="{{ id }}-group-{{ group.index }}" class="px-2.5 pb-1 pt-2.5 text-caption font-semibold uppercase tracking-wide text-muted">{{ group.label }}</li>{% endif %}
                            {% for command in group.items %}
                                <li id="{{ id }}-option-{{ command.index }}" role="option" aria-selected="false" data-href="{{ command.href }}" data-keywords="{{ command.keywords }}" data-action="click->command-palette#choose" data-command-palette-target="option" class="flex h-control cursor-pointer items-center gap-2.5 rounded-control px-2.5 text-ink aria-selected:bg-green-tint">
                                    {% if command.icon %}{{ ux_icon('lucide:' ~ command.icon, {class: 'size-4 shrink-0 text-green', 'aria-hidden': 'true'}) }}{% endif %}
                                    <span class="truncate">{{ command.label }}</span>
                                    {% if command.shortcut %}<twig:Ui:Kbd class="ml-auto">{{ command.shortcut }}</twig:Ui:Kbd>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
            <p role="status" hidden data-command-palette-target="empty" class="m-0 px-4 py-6 text-center text-muted">{{ 'ui.palette.empty'|trans }}</p>
        </div>
    </div>
</div>
