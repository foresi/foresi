{#
    One view in Manage views: the handle and Move up / Move down for an owner (D7, WCAG 2.2 SC
    2.5.7), its name with a lock when private, and its "⋯" menu: Open and edit, Rename, share or
    keep to yourself, a tab or More views for a member's own view, Hide (shipped) or Delete (yours).
    Takes `row`, `reorder`, `token` and `manageViews`.
#}
{% set viewLabel = row.translated ? row.name|trans : row.name %}
<li class="flex min-h-touch items-center gap-1 rounded-control bg-white pr-1 data-[dragging]:bg-green-tint data-[dragging]:shadow-overlay" data-view-manage-row="{{ row.key }}" data-label="{{ viewLabel }}"{% if reorder %} data-view-order-target="row"{% endif %}>
    {% if reorder %}
        <input type="hidden" name="views[]" value="{{ row.ref }}" form="view-order-form">
        {# The handle is for a pointer; the buttons do the same with one tap or a key (WCAG 2.5.7). #}
        <span class="grid size-8 shrink-0 cursor-grab touch-none place-items-center rounded-control text-muted hover:bg-head active:cursor-grabbing" data-action="pointerdown->view-order#grab" aria-hidden="true">{{ ux_icon('lucide:grip-vertical', {class: 'size-4'}) }}</span>
    {% endif %}
    <span class="flex min-w-0 flex-1 items-center gap-1.5 py-2 pl-1.5">
        {%- if row.private %}{{ ux_icon('lucide:lock', {class: 'size-3.5 shrink-0', 'aria-label': 'saved_view.visibility.private'|trans, role: 'img'}) }}{% endif -%}
        <span class="truncate">{{ viewLabel }}</span>
        {%- if not row.editable %} <span class="shrink-0 text-small text-muted" data-view-read-only>{{ 'saved_view.read_only'|trans }}</span>{% endif -%}
    </span>
    {% if reorder %}
        <twig:Ui:IconButton icon="arrow-up" variant="ghost" size="sm" :label="'saved_view.move_up'|trans({name: viewLabel})" data-action="view-order#up" data-view-order-up="" />
        <twig:Ui:IconButton icon="arrow-down" variant="ghost" size="sm" :label="'saved_view.move_down'|trans({name: viewLabel})" data-action="view-order#down" data-view-order-down="" />
    {% endif %}
    <twig:Ui:Menu id="view-row-{{ row.key }}" :label="'saved_view.row_actions'|trans({name: viewLabel})" icon="ellipsis" :iconOnly="true" variant="ghost" size="sm" :float="true" data-view-row-menu>
        <twig:Ui:MenuItem :href="row.href" icon="square-pen" data-view-open>{{ (row.editable ? 'saved_view.open_edit' : 'saved_view.open')|trans }}</twig:Ui:MenuItem>
        {% if row.editable %}
            <twig:Ui:MenuItem type="button" icon="pencil" data-controller="dialog-open" data-action="dialog-open#open" data-dialog-open-id-param="view-rename-{{ row.key }}" aria-haspopup="dialog" data-view-rename>{{ 'saved_view.rename'|trans }}</twig:Ui:MenuItem>
            {% if not row.shipped %}
                <form method="post" action="{{ path('app_view_edit') }}" role="none">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="ref" value="{{ row.ref }}">
                    <input type="hidden" name="visibility" value="{{ row.private ? 'shared' : 'private' }}">
                    <input type="hidden" name="return" value="{{ manageViews.return }}">
                    <twig:Ui:MenuItem type="submit" :icon="row.private ? 'users' : 'lock'" data-view-visibility>{{ (row.private ? 'saved_view.share' : 'saved_view.make_private')|trans }}</twig:Ui:MenuItem>
                </form>
            {% endif %}
            {% if not reorder and (row.primary or not manageViews.primaryFull) %}
                <form method="post" action="{{ path('app_view_edit') }}" role="none">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="ref" value="{{ row.ref }}">
                    <input type="hidden" name="placement" value="{{ row.primary ? 'overflow' : 'primary' }}">
                    <input type="hidden" name="return" value="{{ manageViews.return }}">
                    <twig:Ui:MenuItem type="submit" :icon="row.primary ? 'list' : 'panel-top'" data-view-placement>{{ (row.primary ? 'saved_view.to_more' : 'saved_view.to_tabs')|trans }}</twig:Ui:MenuItem>
                </form>
            {% endif %}
            {% if row.shipped %}
                <form method="post" action="{{ path('app_view_edit') }}" role="none">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="ref" value="{{ row.ref }}">
                    <input type="hidden" name="hidden" value="1">
                    <input type="hidden" name="return" value="{{ manageViews.return }}">
                    <twig:Ui:MenuItem type="submit" icon="eye-off" data-view-hide>{{ 'saved_view.hide'|trans }}</twig:Ui:MenuItem>
                </form>
            {% else %}
                <form method="post" action="{{ path('app_view_delete') }}" role="none" data-turbo-confirm="{{ 'saved_view.delete_confirm'|trans({name: viewLabel}) }}" data-confirm-text="{{ 'saved_view.delete_confirm_text'|trans }}" data-confirm-accept="{{ 'saved_view.delete'|trans }}" data-confirm-cancel="{{ 'saved_view.cancel'|trans }}" data-confirm-tone="danger">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="ref" value="{{ row.ref }}">
                    <input type="hidden" name="return" value="{{ manageViews.return }}">
                    <twig:Ui:MenuItem type="submit" icon="trash-2" tone="danger" data-view-delete>{{ 'saved_view.delete'|trans }}</twig:Ui:MenuItem>
                </form>
            {% endif %}
        {% endif %}
    </twig:Ui:Menu>
</li>
