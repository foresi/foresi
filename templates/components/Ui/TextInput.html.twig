{% set ctl = this %}
{# Captured here: inside the Field block "attributes" would be the Field's own. #}
{% set controlAttributes = attributes %}
<twig:Ui:Field :id="id" :label="label" :help="help" :error="error" :required="required">
    <input type="{{ type }}" id="{{ id }}" name="{{ name }}"{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{% if ctl.invalid %} aria-invalid="true"{% endif %}{% if ctl.describedBy %} aria-describedby="{{ ctl.describedBy }}"{% endif %}{% if ctl.focused and not controlAttributes.has('autofocus') %} autofocus{% endif %} value="{{ value }}" {{ controlAttributes.defaults({class: 'h-control ' ~ ctl.classes}) }}>
</twig:Ui:Field>
