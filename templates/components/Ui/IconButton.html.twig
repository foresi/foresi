{% set tag = href ? 'a' : 'button' %}
<{{ tag }} {{ attributes.defaults({class: this.classes}) }} aria-label="{{ label }}" title="{{ label }}"{% if href %} href="{{ href }}"{% else %} type="{{ type }}"{% endif %}>
    {{- ux_icon('lucide:' ~ icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) -}}
</{{ tag }}>
