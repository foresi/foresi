{% set ctl = this %}
{# Captured here: inside the Field block "attributes" would be the Field's own. #}
{% set controlAttributes = attributes %}
<twig:Ui:Field :id="id" :label="label" :help="help" :error="error" :required="required">
    <textarea id="{{ id }}" name="{{ name }}"{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{% if ctl.invalid %} aria-invalid="true"{% endif %}{% if ctl.describedBy %} aria-describedby="{{ ctl.describedBy }}"{% endif %} rows="{{ rows }}" {{ controlAttributes.defaults({class: 'py-2 ' ~ ctl.classes}) }}>{{ value }}</textarea>
</twig:Ui:Field>
