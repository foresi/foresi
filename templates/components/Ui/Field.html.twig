{% set control = block('content') %}
{% set labelHtml %}
    <label for="{{ id }}" class="text-[13px] font-medium text-ink">{{ label }}{% if required %}<span class="ml-0.5 text-badge-red-text" aria-hidden="true">*</span>{% endif %}</label>
{% endset %}
<div {{ attributes.defaults({class: 'grid gap-1.5'}) }}>
    {% if inline %}
        <div class="flex items-start gap-2">{{ control|raw }}{{ labelHtml }}</div>
    {% else %}
        {{ labelHtml }}{{ control|raw }}
    {% endif %}
    {% if help %}<p id="{{ id }}-help" class="text-xs text-muted">{{ help }}</p>{% endif %}
    {% if error %}<p id="{{ id }}-error" class="text-xs font-medium text-badge-red-text">{{ error }}</p>{% endif %}
</div>
