<div {{ attributes.defaults({class: 'grid gap-1.5'}) }}>
    <div class="flex items-baseline justify-between gap-3 text-[13px]">
        <span class="min-w-0 truncate font-medium text-ink">{{ label }}</span>
        {% if valueText %}<span class="num shrink-0 text-muted">{{ valueText }}</span>{% endif %}
    </div>
    <div role="progressbar" aria-label="{{ label }}"{% if this.determinate %} aria-valuemin="0" aria-valuemax="{{ max }}" aria-valuenow="{{ value }}"{% endif %}{% if valueText %} aria-valuetext="{{ valueText }}"{% endif %} class="h-2 overflow-hidden rounded-full bg-badge-gray">
        {% if this.determinate %}
            <div class="h-full rounded-full bg-green" style="width:{{ this.percent }}%"></div>
        {% else %}
            <div class="h-full w-1/3 rounded-full bg-green/60 motion-safe:animate-pulse"></div>
        {% endif %}
    </div>
</div>
