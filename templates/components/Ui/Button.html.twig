{% set tag = href ? 'a' : 'button' %}
<{{ tag }} {{ attributes.defaults({class: this.classes}) }}{% if href %} href="{{ href }}"{% else %} type="{{ type }}"{% endif %}>
    {%- if icon %}{{ ux_icon('lucide:' ~ icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}{% endif -%}
    {%- block content %}{% endblock -%}
</{{ tag }}>
