<!DOCTYPE html>
{#
    A page whose form came back with errors sets "form_invalid" to true (a top-level set in the page
    template): the title then starts with "Error:" (WCAG 3.3.1), and the form-errors controller on the
    body moves the focus to the first invalid field.
#}
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% if form_invalid|default(false) %}{{ 'form.title_error'|trans }} {% endif %}{% block title %}{% endblock %}</title>
        {% block head %}{% endblock %}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
    </head>
    <body data-controller="form-errors"{% block body_attributes %}{% endblock %}>
        {% block body %}{% endblock %}
    </body>
</html>
