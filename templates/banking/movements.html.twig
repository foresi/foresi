{#
    The bank screen, as iDoklad's Finance, Bank: the incoming and outgoing movements, the incoming
    ones waiting for a pairing, and the bank mail. Pair, unpair and the message open in dialogs over
    the list. The flash after a pairing made by hand offers Undo, for that pairing only.
#}
{% extends 'layout/app.html.twig' %}

{% set crumbs = [{label: 'nav.group.money'|trans}, {label: 'bank.movement.title'|trans}] %}
{% set messagesTab = tab == 'messages' %}

{% block title %}{{ 'bank.movement.title'|trans }}{% endblock %}

{% block content %}
    {% set alerts %}
        {% if paired %}
            {# No confirmation before pairing: Undo takes it back, as a person expects after a quick action. #}
            <twig:Ui:Alert tone="success" role="status" data-undo>
                <span class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                    <span>{{ paired.text }}</span>
                    <form method="post" action="{{ path('app_bank_movement_undo', {id: paired.movement}) }}" class="m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Banking\\Infrastructure\\Controller\\BankMovementController::ACTION_TOKEN')) }}">
                        <input type="hidden" name="return" value="{{ paired.return }}">
                        <twig:Ui:Button type="submit" size="sm" id="bank-undo">{{ 'bank.movement.flash.undo'|trans }}</twig:Ui:Button>
                    </form>
                </span>
            </twig:Ui:Alert>
        {% endif %}
        {% for message in app.flashes('success') %}<twig:Ui:Alert tone="success" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('warning') %}<twig:Ui:Alert tone="warning" role="status">{{ message }}</twig:Ui:Alert>{% endfor %}
        {% for message in app.flashes('error') %}<twig:Ui:Alert tone="error" role="alert">{{ message }}</twig:Ui:Alert>{% endfor %}
    {% endset %}
    {% if alerts|trim %}<div class="mb-4 grid gap-2">{{ alerts }}</div>{% endif %}

    {% if noAccounts %}
        <twig:Ui:EmptyState icon="landmark" :title="'bank.movement.empty.no_accounts_title'|trans" :text="'bank.movement.empty.no_accounts_text'|trans">
            <twig:Ui:Button :href="path('app_firm_index')">{{ 'bank.movement.empty.no_accounts_link'|trans }}</twig:Ui:Button>
        </twig:Ui:EmptyState>
    {% else %}
        <div class="grid grid-cols-1 gap-4">
            <div class="flex flex-wrap items-end justify-between gap-3">
                <twig:Ui:Tabs :items="tabs" :label="'bank.movement.views'|trans" class="min-w-0 flex-1" />
                <form method="get" action="{{ path('app_bank_movements') }}" role="search" class="flex w-full flex-wrap items-end gap-2 sm:w-auto max-sm:[&_button]:h-control-lg max-sm:[&_input]:h-control-lg max-sm:[&_select]:h-control-lg">
                    {% if tab != 'incoming' %}<input type="hidden" name="tab" value="{{ tab }}">{% endif %}
                    {% if firms is not empty %}
                        <div class="w-full sm:w-48"><twig:Ui:Select name="firm" id="bank-firm" :label="'bank.movement.list.firm'|trans" :options="firms" :value="firm" /></div>
                    {% endif %}
                    {% if accounts is not empty %}
                        <div class="w-full sm:w-48"><twig:Ui:Select name="account" id="bank-account" :label="'bank.movement.list.account'|trans" :options="accounts" :value="account" /></div>
                    {% endif %}
                    {% if not messagesTab %}
                        <twig:Ui:SearchField name="q" :value="text" :label="'bank.movement.list.search_label'|trans" :placeholder="'bank.movement.list.search_placeholder'|trans" maxlength="100" class="min-w-0 flex-1 sm:w-56 sm:flex-none" />
                    {% endif %}
                    <twig:Ui:Button type="submit" icon="search">{{ (messagesTab ? 'bank.movement.list.show' : 'bank.movement.list.search')|trans }}</twig:Ui:Button>
                </form>
            </div>

            {% set token = messagesTab
                ? csrf_token(constant('App\\Banking\\Infrastructure\\Controller\\InboundMessageController::ACTION_TOKEN'))
                : csrf_token(constant('App\\Banking\\Infrastructure\\Controller\\BankMovementController::ACTION_TOKEN')) %}
            <twig:Ui:DataTable :caption="('bank.movement.tab.' ~ tab)|trans" :columns="columns" :rows="rows" :actionToken="token">
                <twig:block name="empty">
                    {% if filtered %}
                        <twig:Ui:EmptyState icon="search" :title="'bank.movement.empty.filtered_title'|trans" :text="'bank.movement.empty.filtered_text'|trans">
                            <twig:Ui:Button :href="path('app_bank_movements', tab == 'incoming' ? {} : {tab: tab})">{{ 'bank.movement.empty.reset'|trans }}</twig:Ui:Button>
                        </twig:Ui:EmptyState>
                    {% else %}
                        <twig:Ui:EmptyState :icon="tab == 'unmatched' ? 'circle-check' : (messagesTab ? 'inbox' : 'landmark')" :title="('bank.movement.empty.' ~ tab ~ '_title')|trans" :text="('bank.movement.empty.' ~ tab ~ '_text')|trans" />
                    {% endif %}
                </twig:block>
                <twig:block name="footer">
                    <span class="num">{{ (messagesTab ? 'bank.message.list.summary' : 'bank.movement.list.summary')|trans({total: page.total}) }}</span>
                    <twig:Ui:Pagination :page="page.page" :pages="page.pages" :baseUrl="baseUrl" />
                </twig:block>
            </twig:Ui:DataTable>
        </div>
    {% endif %}
{% endblock %}
