{
    "name": "foresi/foresi",
    "type": "project",
    "description": "Open-source business system for small and medium firms.",
    "license": "AGPL-3.0-only",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "directorytree/imapengine": "~1.25.7",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.5",
        "foresi/attachment": "dev-main",
        "foresi/audit": "dev-main",
        "foresi/banking": "dev-main",
        "foresi/country": "dev-main",
        "foresi/exchange-rate": "dev-main",
        "foresi/identity": "dev-main",
        "foresi/idoklad": "dev-main",
        "foresi/import": "dev-main",
        "foresi/invoicing": "dev-main",
        "foresi/party": "dev-main",
        "foresi/purchasing": "dev-main",
        "foresi/shared": "dev-main",
        "foresi/tenancy": "dev-main",
        "foresi/timesheet": "dev-main",
        "foresi/ui": "dev-main",
        "foresi/work": "dev-main",
        "league/commonmark": "^2.10",
        "nelmio/api-doc-bundle": "^5.13",
        "openspout/openspout": "^5.12",
        "scheb/2fa-backup-code": "^8.7",
        "scheb/2fa-bundle": "^8.7",
        "scheb/2fa-totp": "^8.7",
        "scheb/2fa-trusted-device": "^8.7",
        "symfony/asset-mapper": "7.4.*",
        "symfony/cache": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "^7.4.23",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/lock": "^7.4.23",
        "symfony/mailer": "7.4.*",
        "symfony/mcp-bundle": "^0.15",
        "symfony/messenger": "^7.4.23",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/ux-icons": "^3.6",
        "symfony/ux-live-component": "^3.6",
        "symfony/ux-turbo": "^3.6",
        "symfony/ux-twig-component": "^3.6",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tecnickcom/tc-lib-barcode": "^2.17.2",
        "tecnickcom/tc-lib-pdf": "^8.82.2",
        "zbateson/mail-mime-parser": "^4.0.8"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs:check": "php-cs-fixer fix --dry-run --diff --ansi",
        "cs:fix": "php-cs-fixer fix --ansi",
        "rector": "rector process --dry-run --ansi",
        "lint": [
            "@php bin/console lint:twig templates",
            "@php bin/console lint:yaml config translations --parse-tags",
            "@php bin/console lint:container"
        ],
        "phpstan": [
            "@php bin/console cache:warmup --env=dev --quiet",
            "phpstan analyse --memory-limit=1G --ansi"
        ],
        "deptrac": "deptrac analyse --no-progress --ansi",
        "phpunit": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d max_execution_time=0 vendor/bin/phpunit"
        ],
        "phpunit:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d max_execution_time=0 -d memory_limit=2G vendor/bin/phpunit --coverage-xml=var/coverage/coverage-xml --log-junit=var/coverage/junit.xml"
        ],
        "isdoc:schema": "@php bin/fetch-isdoc-schema",
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d max_execution_time=0 -d memory_limit=2G vendor/bin/infection --threads=max --initial-tests-php-options='-d max_execution_time=0 -d memory_limit=2G' --min-msi=80 --min-covered-msi=90 --show-mutations --no-progress"
        ],
        "qa:static": [
            "@cs:check",
            "@rector",
            "@lint",
            "@phpstan",
            "@deptrac"
        ],
        "qa": [
            "@qa:static",
            "@phpunit"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        },
        "foresi": {
            "accepted-problems": []
        }
    },
    "require-dev": {
        "chillerlan/php-qrcode": "^6.0.1",
        "deptrac/deptrac": "^4.7.2",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "infection/infection": "^0.35.8",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.4",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.5",
        "rector/rector": "^2.8.3",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/process": "7.4.*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "src/*",
            "options": {
                "symlink": true,
                "versions": {
                    "foresi/attachment": "dev-main",
                    "foresi/audit": "dev-main",
                    "foresi/banking": "dev-main",
                    "foresi/country": "dev-main",
                    "foresi/exchange-rate": "dev-main",
                    "foresi/identity": "dev-main",
                    "foresi/idoklad": "dev-main",
                    "foresi/import": "dev-main",
                    "foresi/invoicing": "dev-main",
                    "foresi/party": "dev-main",
                    "foresi/purchasing": "dev-main",
                    "foresi/shared": "dev-main",
                    "foresi/tenancy": "dev-main",
                    "foresi/timesheet": "dev-main",
                    "foresi/ui": "dev-main",
                    "foresi/work": "dev-main"
                }
            }
        }
    ]
}
