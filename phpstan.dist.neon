# SPDX-License-Identifier: AGPL-3.0-only
# phpstan-strict-rules, phpstan-symfony, phpstan-doctrine and phpstan-phpunit
# are registered by phpstan/extension-installer.
parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        - tests/object-manager.php
        - tests/e2e/node_modules (?)
        # Boots the e2e environment and reads its public services; PHPStan only knows the dev container.
        - tests/e2e/seed.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
